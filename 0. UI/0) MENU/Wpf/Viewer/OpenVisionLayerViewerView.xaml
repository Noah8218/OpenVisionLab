<UserControl x:Class="OpenVisionLab.OpenVisionLayerViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:imageCanvasViews="clr-namespace:OpenVisionLab.ImageCanvas.Views;assembly=OpenVisionLab.ImageCanvas"
             MinWidth="420"
             MinHeight="300"
             Background="#071114"
             ClipToBounds="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#071114" ClipToBounds="True">
        <Grid x:Name="viewerRootGrid" Margin="10" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="headerRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="statusRow" Height="30" />
            </Grid.RowDefinitions>

            <Border x:Name="layerHeader"
                    Grid.Row="0"
                    Background="#101D22"
                    BorderBrush="#2A4D55"
                    BorderThickness="1"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                Kind="ImageMultipleOutline"
                                                Width="18"
                                                Height="18"
                                                Foreground="#157C86"
                                                VerticalAlignment="Center" />
                    <TextBlock x:Name="txtLayerTitle"
                               Grid.Column="2"
                               Text="-"
                               Foreground="#EAF7F8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="3"
                            Background="#0B272D"
                            BorderBrush="#287E87"
                            BorderThickness="1"
                            Padding="10,4">
                        <TextBlock x:Name="txtLayerMeta"
                                   Text="-"
                                   Foreground="#BFE8EA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="imageFrame"
                    Grid.Row="1"
                    Margin="0,8,0,6"
                    Background="#020506"
                    BorderBrush="#157C86"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid x:Name="layerImageSurface" ClipToBounds="True">
                    <imageCanvasViews:RoiImageCanvasView x:Name="layerCanvas"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        ClipToBounds="True"
                                                        Visibility="Collapsed" />
                    <Image x:Name="layerFallbackImage"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           Visibility="Collapsed" />
                    <Border x:Name="emptyOverlay"
                            Width="260"
                            Padding="18"
                            Background="#10242A"
                            BorderBrush="#2B7881"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <iconPacks:PackIconMaterial Kind="ImageOffOutline"
                                                        Width="24"
                                                        Height="24"
                                                        Foreground="#157C86"
                                                        Margin="0,0,0,8" />
                            <TextBlock x:Name="txtEmptyTitle"
                                       Text="No image"
                                       Foreground="#D7ECEE"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="statusFooter"
                    Grid.Row="2"
                    Background="#0D171B"
                    BorderBrush="#253D45"
                    BorderThickness="1"
                    Padding="10,0">
                <TextBlock x:Name="txtStatus"
                           Text="-"
                           Foreground="#C8DEE3"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</UserControl>
