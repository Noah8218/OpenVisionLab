<UserControl x:Class="OpenVisionLab.OpenVisionShellPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:OpenVisionLab"
             xmlns:mvvmBehaviors="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             MinWidth="1280"
             MinHeight="760"
             Background="#EEF2F6">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="Shell.ChromeBrush" Color="#30383B" />
            <SolidColorBrush x:Key="Shell.ChromeAltBrush" Color="#445057" />
            <SolidColorBrush x:Key="Shell.ChromeDarkBrush" Color="#121A1E" />
            <SolidColorBrush x:Key="Shell.SurfaceBrush" Color="#F3F6F8" />
            <SolidColorBrush x:Key="Shell.PanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Shell.BandBrush" Color="#EAF1F4" />
            <SolidColorBrush x:Key="Shell.LineBrush" Color="#D6E1E6" />
            <SolidColorBrush x:Key="Shell.StrongLineBrush" Color="#8BA0AD" />
            <SolidColorBrush x:Key="Shell.TextBrush" Color="#243040" />
            <SolidColorBrush x:Key="Shell.MutedTextBrush" Color="#657487" />
            <SolidColorBrush x:Key="Shell.AccentBrush" Color="#157C86" />
            <SolidColorBrush x:Key="Shell.AccentSoftBrush" Color="#D8ECEE" />
            <SolidColorBrush x:Key="Shell.OkBrush" Color="#0D7A55" />
            <SolidColorBrush x:Key="Shell.WarnBrush" Color="#9A6400" />
            <SolidColorBrush x:Key="Shell.FieldBrush" Color="#24363D" />
            <SolidColorBrush x:Key="Shell.FieldHoverBrush" Color="#2E454C" />
            <SolidColorBrush x:Key="Shell.FieldDropBrush" Color="#193038" />
            <SolidColorBrush x:Key="Shell.FieldBorderBrush" Color="#82969D" />
            <SolidColorBrush x:Key="Shell.FieldFocusBrush" Color="#8AD7DA" />
            <SolidColorBrush x:Key="Shell.FieldTextBrush" Color="#F5FAFC" />
            <SolidColorBrush x:Key="Shell.PreviewPanelBrush" Color="#101A1F" />
            <SolidColorBrush x:Key="Shell.PreviewPanelBorderBrush" Color="#2D434B" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Shell.TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource Shell.MutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PreviewPanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitleStyle}">
                <Setter Property="Foreground" Value="#D7ECEE" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Shell.AccentBrush}" />
                <Setter Property="Background" Value="{StaticResource Shell.PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Shell.AccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="NavToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <Style x:Key="LayerResultButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <Style x:Key="LayerResultMainRowStyle" TargetType="Border">
                <Setter Property="Background" Value="#1A2A30" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMainLayerResultSelected}" Value="True">
                        <Setter Property="Background" Value="#157C86" />
                        <Setter Property="BorderBrush" Value="#8AD7DA" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LayerResultLpvRowStyle" TargetType="Border">
                <Setter Property="Background" Value="#1A2A30" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLpvLayerResultSelected}" Value="True">
                        <Setter Property="Background" Value="#157C86" />
                        <Setter Property="BorderBrush" Value="#8AD7DA" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LayerResultSbARowStyle" TargetType="Border">
                <Setter Property="Background" Value="#1A2A30" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSbALayerResultSelected}" Value="True">
                        <Setter Property="Background" Value="#157C86" />
                        <Setter Property="BorderBrush" Value="#8AD7DA" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#EAF5F7" />
                <Setter Property="Background" Value="{StaticResource Shell.FieldDropBrush}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border x:Name="itemChrome"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="itemChrome" Property="Background" Value="{StaticResource Shell.FieldHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="itemChrome" Property="Background" Value="#1B5D66" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="130" />
                <Setter Property="mvvmBehaviors:ComboBoxInteractionBehavior.OpenOnFieldClick" Value="True" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Shell.FieldTextBrush}" />
                <Setter Property="Background" Value="{StaticResource Shell.FieldBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Shell.FieldBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="MaxDropDownHeight" Value="240" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}">
                                <Border x:Name="comboGlow"
                                        Margin="-1"
                                        BorderBrush="{StaticResource Shell.FieldFocusBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Opacity="0" />
                                <Border x:Name="comboChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" />
                                <Grid IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="contentSite"
                                                      Grid.Column="0"
                                                      Margin="9,0,4,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{StaticResource Shell.FieldTextBrush}" />
                                    <Border x:Name="arrowWell"
                                            Grid.Column="1"
                                            Background="#1A292F"
                                            BorderBrush="#465D65"
                                            BorderThickness="1,0,0,0"
                                            CornerRadius="0,2,2,0" />
                                    <Path x:Name="arrow"
                                          Grid.Column="1"
                                          Width="8"
                                          Height="5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 5 L 8 0 Z"
                                          Fill="{StaticResource Shell.FieldFocusBrush}" />
                                </Grid>
                                <ToggleButton Background="Transparent"
                                              BorderThickness="0"
                                              ClickMode="Press"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PopupAnimation="Slide">
                                    <Grid MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border Background="{StaticResource Shell.FieldDropBrush}"
                                                BorderBrush="{StaticResource Shell.FieldFocusBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3" />
                                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="comboChrome" Property="Background" Value="{StaticResource Shell.FieldHoverBrush}" />
                                    <Setter TargetName="comboChrome" Property="BorderBrush" Value="{StaticResource Shell.FieldFocusBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="comboGlow" Property="Opacity" Value="1" />
                                    <Setter TargetName="comboChrome" Property="BorderBrush" Value="{StaticResource Shell.FieldFocusBrush}" />
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="comboChrome" Property="Background" Value="{StaticResource Shell.FieldDropBrush}" />
                                    <Setter TargetName="comboChrome" Property="BorderBrush" Value="{StaticResource Shell.FieldFocusBrush}" />
                                    <Setter TargetName="arrowWell" Property="Background" Value="#14343B" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#7F9299" />
                                    <Setter TargetName="comboChrome" Property="Opacity" Value="0.55" />
                                    <Setter TargetName="arrow" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type local:OpenVisionShellNavItem}">
                <Button Style="{StaticResource NavToolButtonStyle}"
                        Command="{Binding DataContext.SelectToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding ToolTip}">
                    <Border Padding="9,7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#17252B" />
                                <Setter Property="BorderBrush" Value="#2D434B" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#20363D" />
                                        <Setter Property="BorderBrush" Value="#157C86" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="{Binding IconKind}"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="#8AD7DA"
                                                        VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Title}"
                                       Foreground="{Binding TextBrush}"
                                       FontWeight="{Binding FontWeight}"
                                       TextTrimming="None"
                                       TextWrapping="Wrap"
                                       LineHeight="14"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="4"
                                    Background="#101A1F"
                                    BorderBrush="{Binding StatusBrush}"
                                    BorderThickness="1"
                                    Padding="5,1"
                                    MinWidth="32"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="{Binding StatusBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Button>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:OpenVisionShellNavGroup}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Foreground="#92A8B0"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="6,10,6,4" />
                    <ItemsControl ItemsSource="{Binding Items}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="rootShell" Background="{StaticResource Shell.SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource Shell.ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="16,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock x:Name="txtShellMarker" Text="OpenVisionLab" Foreground="White" FontSize="20" FontWeight="Bold" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding SubtitleText}"
                       Foreground="#D3E0E3"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <ComboBox x:Name="cbShellLanguage"
                      Grid.Column="2"
                      Margin="0,11,10,11"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" />
            <Button x:Name="btnShellSettings" Grid.Column="3" Style="{StaticResource IconButtonStyle}" ToolTip="{Binding SettingsToolTipText}">
                <iconPacks:PackIconMaterial Kind="Cog" Width="20" Height="20" HorizontalAlignment="Center" />
            </Button>
            <Button x:Name="btnShellExport" Grid.Column="4" Style="{StaticResource IconButtonStyle}" ToolTip="{Binding ExportToolTipText}">
                <iconPacks:PackIconMaterial Kind="FileExport" Width="20" Height="20" HorizontalAlignment="Center" />
            </Button>
            <Button x:Name="btnShellMinimize" Grid.Column="5" Style="{StaticResource IconButtonStyle}" ToolTip="{Binding MinimizeToolTipText}">
                <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="18" Height="18" HorizontalAlignment="Center" />
            </Button>
            <Button x:Name="btnShellMaximize" Grid.Column="6" Style="{StaticResource IconButtonStyle}" ToolTip="{Binding MaximizeToolTipText}">
                <iconPacks:PackIconMaterial Kind="WindowMaximize" Width="18" Height="18" HorizontalAlignment="Center" />
            </Button>
            <Button x:Name="btnShellClose" Grid.Column="7" Style="{StaticResource IconButtonStyle}" ToolTip="{Binding CloseToolTipText}">
                <iconPacks:PackIconMaterial Kind="WindowClose" Width="18" Height="18" HorizontalAlignment="Center" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Background="{StaticResource Shell.ChromeAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0">
                <Button x:Name="btnImageProcessing" Content="{Binding ImageProcessingText}" Margin="0,3,6,3" Background="#157C86" Foreground="White" BorderBrush="#157C86" />
                <Button Content="{Binding AlgorithmText}" Margin="0,3,6,3" Background="#3D4A50" Foreground="#EAF1F4" BorderBrush="#82969D" />
                <Button Content="{Binding GuideText}" Margin="0,3,0,3" Background="#3D4A50" Foreground="#EAF1F4" BorderBrush="#82969D" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CameraText}" Foreground="#EAF1F4" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ComboBox Width="96" SelectedIndex="0">
                    <ComboBoxItem Content="Main" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LayerText}" Foreground="#EAF1F4" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ComboBox x:Name="cbShellLayer"
                          Width="118"
                          ItemsSource="{Binding LayerOptions}"
                          SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}" />
            </StackPanel>

            <CheckBox Grid.Column="3"
                      Content="{Binding LayerInputText}"
                      IsChecked="True"
                      Foreground="#F5F8FC"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button Content="{Binding SelectText}" Width="62" Margin="0,3,6,3" />
                <Button Content="{Binding AllText}" Width="54" Margin="0,3,6,3" />
                <Button Content="{Binding StopText}" Width="58" Margin="0,3,0,3" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="324" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#101B1F"
                    BorderBrush="#294148"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding WorkbenchText}"
                               Foreground="#D7ECEE"
                               FontWeight="SemiBold"
                               Margin="14,12,14,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="navToolViews"
                                      ItemsSource="{Binding NavigationGroups}"
                                      Margin="8,0,8,12" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="dockWorkspace" Grid.Column="1" Background="#05090A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#18252B">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#157C86" Padding="14,0" Height="32">
                            <TextBlock Text="Main" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#26383F" Padding="14,0" Height="32">
                            <TextBlock Text="NewPanel_sbA" Foreground="#D7ECEE" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#26383F" Padding="14,0" Height="32">
                            <TextBlock x:Name="txtShellPipelineTab"
                                       Text="{Binding PipelineText}"
                                       Foreground="#D7ECEE"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="Black" BorderBrush="#157C86" BorderThickness="1">
                        <Grid>
                            <Border Width="520"
                                    Height="360"
                                    Background="#DDE4EA"
                                    BorderBrush="#7D9298"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid Margin="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="txtShellCanvasLayerText"
                                               Text="{Binding SelectedCanvasLayerText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />
                                    <Grid Grid.Row="1">
                                        <Grid.Background>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="#EEF2F6">
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="#8AA2AA" Thickness="1" />
                                                        </GeometryDrawing.Pen>
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,40,40" />
                                                                <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                                                                <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Grid.Background>
                                        <Ellipse Width="64" Height="64" Fill="#314148" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0" />
                                        <Rectangle Width="138" Height="74" Fill="#445158" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="70" Height="70" Stroke="#00A7B3" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,42,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource Shell.PreviewPanelBrush}" BorderBrush="{StaticResource Shell.PreviewPanelBorderBrush}" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="txtSelectedToolPreviewTitle"
                                           Text="{Binding SelectedToolPreviewTitle}"
                                           Style="{StaticResource PreviewPanelTitleStyle}" />
                                <Border Grid.Row="1" Margin="0,8,0,0" Background="Black">
                                    <TextBlock Text="{Binding SelectedInputPreviewText}"
                                                Foreground="#A9BEC4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Background="{StaticResource Shell.PreviewPanelBrush}" BorderBrush="{StaticResource Shell.PreviewPanelBorderBrush}" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="txtSelectedResultPreviewTitle"
                                           Text="{Binding ResultPreviewText}"
                                           Style="{StaticResource PreviewPanelTitleStyle}" />
                                <Border Grid.Row="1" Margin="0,8,0,0" Background="Black">
                                    <TextBlock Text="{Binding SelectedOutputPreviewText}"
                                                Foreground="#A9BEC4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Background="#111A1D">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtShellCanvasLayerStatus"
                               Text="{Binding SelectedCanvasLayerStatusText}"
                               Foreground="#CFE0E4"
                               Margin="12,0"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Canvas X: 140 Y: 92" Foreground="#CFE0E4" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="GV 0 | RGB 0,0,0" Foreground="#CFE0E4" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid x:Name="pipelineRail" Grid.Column="2" Background="#18242A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="142" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>

                <Border Margin="10,10,10,6" BorderBrush="{StaticResource Shell.WarnBrush}" BorderThickness="1" Background="#223139" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="{Binding DirectResultText}" Foreground="#D7ECEE" FontWeight="SemiBold" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource Shell.WarnBrush}" Padding="8,1">
                                <TextBlock Text="{Binding DirectBadgeReadyText}" Foreground="White" FontWeight="Bold" FontSize="10" />
                            </Border>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock x:Name="txtSelectedDirectRun"
                                       Text="{Binding SelectedDirectRunText}"
                                       Foreground="#F5F8FC"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="txtShellDirectStatus"
                                       Text="{Binding DirectStatusReadyDetailText}"
                                       Foreground="#8AD7DA"
                                       Margin="0,8,0,0" />
                            <TextBlock x:Name="txtShellSelectedRoute"
                                       Text="{Binding SelectedRouteText}"
                                       Foreground="#CFE0E4"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="10,4,10,6" BorderBrush="#38535C" BorderThickness="1" Background="#223139" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding LayersResultsText}" Foreground="#D7ECEE" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button x:Name="btnShellLayerMain"
                                    Style="{StaticResource LayerResultButtonStyle}"
                                    Command="{Binding SelectLayerResultCommand}"
                                    CommandParameter="Main">
                                <Border Style="{StaticResource LayerResultMainRowStyle}">
                                    <TextBlock Text="{Binding LayerResultMainText}" Foreground="White" />
                                </Border>
                            </Button>
                            <Button x:Name="btnShellLayerLpv"
                                    Style="{StaticResource LayerResultButtonStyle}"
                                    Command="{Binding SelectLayerResultCommand}"
                                    CommandParameter="NewPanel_LPV">
                                <Border Style="{StaticResource LayerResultLpvRowStyle}">
                                    <TextBlock Text="{Binding LayerResultNoneText}" Foreground="#CFE0E4" />
                                </Border>
                            </Button>
                            <Button x:Name="btnShellLayerSbA"
                                    Style="{StaticResource LayerResultButtonStyle}"
                                    Command="{Binding SelectLayerResultCommand}"
                                    CommandParameter="NewPanel_sbA">
                                <Border Style="{StaticResource LayerResultSbARowStyle}">
                                    <TextBlock x:Name="txtShellLayerDisplay" Text="{Binding LayerResultDisplayText}" Foreground="White" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="10,4,10,6" BorderBrush="#38535C" BorderThickness="1" Background="#223139" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding PipelineText}" Foreground="#D7ECEE" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <Border Background="#1A2A30" Padding="8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding PipelineFilterPassedText}" Foreground="#D7ECEE" />
                            </Border>
                            <Border Background="#1A2A30" Padding="8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding PipelineMorphologyPassedText}" Foreground="#D7ECEE" />
                            </Border>
                            <Border Background="#24515C" BorderBrush="#8AD7DA" BorderThickness="1" Padding="8">
                                <TextBlock x:Name="txtShellPipelineNeedsPreview" Text="{Binding PipelineContourNeedsPreviewText}" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Margin="10,4,10,10" BorderBrush="#38535C" BorderThickness="1" Background="#223139" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding RunLogText}" Foreground="#D7ECEE" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="15:58:38.406  ToolResultPublished" Foreground="#CFE0E4" />
                            <TextBlock Text="15:58:38.441  ToolRunCompleted" Foreground="#CFE0E4" Margin="0,5,0,0" />
                            <TextBlock Text="15:58:38.470  PipelineReady" Foreground="#CFE0E4" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Background="{StaticResource Shell.ChromeDarkBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="C:" Foreground="#CFE0E4" FontWeight="SemiBold" Margin="0,0,6,0" />
                <Border Width="150" Height="5" Background="#34484F">
                    <Border Width="62" Background="#157C86" HorizontalAlignment="Left" />
                </Border>
                <TextBlock Text="27.7%" Foreground="#CFE0E4" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBlock Text="D:" Foreground="#CFE0E4" FontWeight="SemiBold" Margin="0,0,6,0" />
                <Border Width="150" Height="5" Background="#34484F">
                    <Border Width="86" Background="#0D7A55" HorizontalAlignment="Left" />
                </Border>
                <TextBlock Text="57.6%" Foreground="#CFE0E4" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="statusReady"
                       Grid.Column="2"
                       Text="{Binding StatusText}"
                       Foreground="#CFE0E4"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3"
                       Text="OpenVisionLab 2.1.0 | Updated 2026/06/08 | NOAH"
                       Foreground="#CFE0E4"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
        </Grid>
    </Grid>
</UserControl>
