<Window x:Class="OpenVisionLab.OpenVisionWorkspaceSamplePickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenVisionLab"
        Title="{Binding DialogTitleText}"
        Width="1040"
        Height="700"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0D171B"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="WorkspaceSamplePickerWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <local:OpenVisionWorkspaceSamplePickerView Grid.Row="0" />

        <Border Grid.Row="1"
                Background="#182D34"
                BorderBrush="#2B5E69"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Text="{Binding SelectionSummaryText}"
                           Foreground="#9AB0BA" />
                <Button DockPanel.Dock="Right"
                        MinWidth="124"
                        Height="32"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        IsEnabled="{Binding CanSelect}"
                        Background="#157C86"
                        BorderBrush="#89F1F7"
                        Click="Select_Click"
                        AutomationProperties.AutomationId="WorkspaceSamplePickerOpenButton">
                    <TextBlock Text="{Binding OpenButtonText}"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF" />
                </Button>
                <Button DockPanel.Dock="Right"
                        MinWidth="150"
                        Height="32"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding CanOpenLearnAndSample}"
                        Background="#173B43"
                        BorderBrush="#89F1F7"
                        Click="OpenGuideAndSelect_Click"
                        AutomationProperties.AutomationId="WorkspaceSamplePickerOpenGuideAndSampleButton">
                    <TextBlock Text="{Binding OpenLearnAndSampleButtonText}"
                               FontWeight="SemiBold"
                               Foreground="#E9F7F8" />
                </Button>
                <Button DockPanel.Dock="Right"
                        MinWidth="92"
                        Height="32"
                        IsCancel="True"
                        Background="#223036"
                        BorderBrush="#4A6470"
                        Click="Cancel_Click"
                        AutomationProperties.AutomationId="WorkspaceSamplePickerCancelButton">
                    <TextBlock Text="{Binding CancelButtonText}"
                               Foreground="#D7E8EC" />
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
