                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ListBox x:Name="legacyHostLayerRowsList"
                                     Tag="{Binding LayerCommands, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#D7ECEE"
                                     ItemContainerStyle="{StaticResource HostLayerListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     mvvmBehaviors:InputCommandBehaviors.SelectionChangedCommand="{Binding LayerCommands.HandleSelectedLayerChangedCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                     mvvmBehaviors:InputCommandBehaviors.MouseDoubleClickCommand="{Binding LayerCommands.OpenSelectedLayerWindowCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <ListBox.ContextMenu>
                                    <StaticResource ResourceKey="LayerRowsContextMenu" />
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#D7ECEE"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="10,4,10,6" BorderBrush="#38535C" BorderThickness="1" Background="#223139" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedLayerDetailText}" Foreground="#D7ECEE" FontWeight="SemiBold" />
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Background="#17262D"
                                BorderBrush="#304D57"
                                BorderThickness="1"
                                Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#05090A" BorderBrush="#48636C" BorderThickness="1">
                                    <Image x:Name="imgHostSelectedLayerPreview"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SelectedLayerDetailText}" Foreground="#8FD5DB" FontWeight="SemiBold" FontSize="11" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtHostSelectedLayerTitle"
                                                 Grid.Column="0"
                                                 MinHeight="24"
                                                 Padding="6,2"
                                                 VerticalContentAlignment="Center"
                                                 AutomationProperties.AutomationId="HostSelectedLayerNameEditor"
                                                 Text="-"
                                                 Foreground="#F5F8FC"
                                                 CaretBrush="#8FE8F0"
                                                 FontWeight="SemiBold"
                                                 BorderBrush="#42626B"
                                                 Background="#12262D" />
                                        <Button x:Name="btnRenameSelectedLayer"
                                                Grid.Column="2"
                                                Width="28"
                                                Height="24"
                                                Padding="0"
                                                AutomationProperties.AutomationId="HostRenameLayerButton"
                                                Style="{StaticResource LayerDetailActionButtonStyle}"
                                                ToolTip="{Binding LayerCommands.RenameLayerText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                                Command="{Binding LayerCommands.RenameSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                                CommandParameter="{Binding Text, ElementName=txtHostSelectedLayerTitle}">
                                            <iconPacks:PackIconMaterial Kind="PencilOutline"
                                                                        Width="14"
                                                                        Height="14"
                                                                        HorizontalAlignment="Center"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="txtHostSelectedLayerMeta"
                                               Text="-"
                                               Foreground="#CFE0E4"
                                               Margin="0,5,0,0" />
                                    <TextBlock x:Name="txtHostSelectedLayerRoute"
                                               Text="-"
                                               Foreground="#AFC5CC"
                                               FontSize="11"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnCreateLayer"
                                    Grid.Column="0"
                                    AutomationProperties.AutomationId="HostCreateLayerButton"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Command="{Binding LayerCommands.CreateLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="LayersPlus"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding LayerCommands.CreateLayerShortText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLoadImageIntoSelectedLayer"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="HostLoadImageIntoLayerButton"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Command="{Binding LayerCommands.LoadImageIntoSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ImagePlusOutline"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding LayerCommands.LoadImageIntoLayerShortText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDeleteSelectedLayer"
                                    Grid.Column="4"
                                    AutomationProperties.AutomationId="HostDeleteLayerButton"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    ToolTip="{Binding LayerCommands.DeleteLayerText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                    Command="{Binding LayerCommands.DeleteSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <iconPacks:PackIconMaterial Kind="LayersOffOutline"
                                                            Width="15"
                                                            Height="15"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="btnOpenSelectedLayerWindow"
                                    Grid.Column="6"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Command="{Binding LayerCommands.OpenSelectedLayerWindowCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ImageMultipleOutline"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="txtOpenSelectedLayerWindowButton"
                                               Text="팝업"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDockSelectedLayer"
                                    Grid.Column="6"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Visibility="Collapsed"
                                    Command="{Binding LayerCommands.DockSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="LayersPlus"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="txtDockSelectedLayerButton"
                                               Text="도킹"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnClearDockedLayers"
                                    Grid.Column="8"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Visibility="Collapsed"
                                    ToolTip="도킹 해제"
                                    Command="{Binding LayerCommands.ClearDockedLayersCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <iconPacks:PackIconMaterial Kind="LayersOffOutline"
                                                            Width="15"
                                                            Height="15"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <Border x:Name="recipeManagerPanel"
                Grid.Row="0"
                Grid.RowSpan="4"
                Panel.ZIndex="40"
                Margin="72,8,16,12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#17262D"
                BorderBrush="{StaticResource ShellHost.FieldFocusBrush}"
                BorderThickness="1"
                Padding="14"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                AutomationProperties.AutomationId="HostRecipeManagerPanel"
                Visibility="{Binding IsChecked, ElementName=btnHostRecipeManager, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="recipeManagerPanelTransform" />
            </Border.RenderTransform>
            <Border.Resources>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource LayerDetailActionButtonStyle}">
                    <Setter Property="Foreground" Value="#EAFBFC" />
                    <Setter Property="Background" Value="#233840" />
                    <Setter Property="BorderBrush" Value="#6C98A1" />
                    <Setter Property="Padding" Value="8,0" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7F969C" />
                            <Setter Property="Background" Value="#203238" />
                            <Setter Property="BorderBrush" Value="#405963" />
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="#F5FAFC" />
                </Style>
                <Style TargetType="{x:Type TabControl}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="#B9D6DC" />
                    <Setter Property="Background" Value="#223840" />
                    <Setter Property="BorderBrush" Value="#38535C" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="12,5" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="tabChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabChrome" Property="Background" Value="#157C86" />
                                        <Setter TargetName="tabChrome" Property="BorderBrush" Value="#8AD7DA" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="tabChrome" Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="recipeManagerTitleBar"
                      Grid.Row="0"
                      Height="34"
                      Margin="-14,-14,-14,10"
                      Background="#223840"
                      Cursor="SizeAll"
                      AutomationProperties.AutomationId="HostRecipeManagerTitleBar"
                      MouseLeftButtonDown="HandleRecipeManagerTitleBarMouseLeftButtonDown"
                      MouseMove="HandleRecipeManagerTitleBarMouseMove"
                      MouseLeftButtonUp="HandleRecipeManagerTitleBarMouseLeftButtonUp"
                      LostMouseCapture="HandleRecipeManagerTitleBarLostMouseCapture">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="DragHorizontalVariant"
                                                Width="16"
                                                Height="16"
                                                Margin="10,0,8,0"
                                                Foreground="#8AD7DA"
                                                VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding RecipeCommands.ManagerTitleText}"
                               Foreground="#F5FAFC"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding RecipeCommands.ManagerWorkbenchText}"
                               Foreground="#A8CBD1"
                               Margin="0,0,10,0"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            Width="28"
                            Height="24"
                            Margin="0,0,8,0"
                            Padding="0"
                            Cursor="Hand"
                            AutomationProperties.AutomationId="HostRecipeManagerCloseButton"
                            ToolTip="Close"
                            Click="HandleRecipeManagerCloseClick">
                        <iconPacks:PackIconMaterial Kind="WindowClose"
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1"
                      Margin="0,4,0,0"
                      AutomationProperties.AutomationId="HostRecipeManagerWorkbenchHeader">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RecipeCommands.RecipeFilterLabelText}"
                                   Foreground="#A8CBD1"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Height="26"
                                 Padding="7,2"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="HostRecipeFilterTextBox"
                                 Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                 CaretBrush="#8FE8F0"
                                 BorderBrush="{StaticResource ShellHost.FieldBorderBrush}"
                                 Background="{StaticResource ShellHost.FieldBrush}"
                                 Text="{Binding RecipeCommands.RecipeFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="{Binding RecipeCommands.ReviewWorkspaceText}"
                               Foreground="#A8CBD1"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="2"
                      Margin="0,12,0,0"
                      AutomationProperties.AutomationId="HostRecipeManagerWorkbenchGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          AutomationProperties.AutomationId="HostRecipeManagerLibraryPane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock AutomationProperties.AutomationId="HostRecipeLibrarySummaryText"
                                   Text="{Binding RecipeCommands.RecipeLibrarySummaryText}"
                                   Foreground="#A8CBD1"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5" />
                        <ListBox Grid.Row="1"
                                 AutomationProperties.AutomationId="HostRecipeManagerList"
                                 Background="#101A1F"
                                 BorderBrush="#38535C"
                                 BorderThickness="1"
                                 Foreground="#F5FAFC"
                                 ItemsSource="{Binding RecipeCommands.FilteredRecipeOptions}"
                                 SelectedItem="{Binding RecipeCommands.SelectedRecipeName, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               ToolTip="{Binding}"
                                               Foreground="#F5FAFC"
                                               MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Column="2"
                          AutomationProperties.AutomationId="HostRecipeDetailPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border MinHeight="50"
                                 Padding="8"
                                 BorderBrush="#38535C"
                                 BorderThickness="1"
                                 Background="#101A1F"
                                 AutomationProperties.AutomationId="HostRecipeDetailText">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding RecipeCommands.SelectedRecipeSummary.HeaderText, Mode=OneWay}"
                                           ToolTip="{Binding RecipeCommands.SelectedRecipeSummary.HeaderText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource ShellHost.FieldTextBrush}" />
                                <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                    <Border Margin="0,0,6,0" Padding="7,2" Background="#1B3037" BorderBrush="#38535C" BorderThickness="1">
                                        <TextBlock Text="{Binding RecipeCommands.SelectedRecipeSummary.ActivePipelineDisplay, Mode=OneWay}"
                                                   ToolTip="{Binding RecipeCommands.SelectedRecipeSummary.ActivePipelineDisplay, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="#A8CBD1"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="360" />
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="7,2" Background="#1B3037" BorderBrush="#38535C" BorderThickness="1">
                                        <TextBlock Text="{Binding RecipeCommands.SelectedRecipeSummary.PipelineCountDisplay, Mode=OneWay}" FontSize="11" Foreground="#A8CBD1" />
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="7,2" Background="#1B3037" BorderBrush="#38535C" BorderThickness="1">
                                        <TextBlock Text="{Binding RecipeCommands.SelectedRecipeSummary.StepCountDisplay, Mode=OneWay}" FontSize="11" Foreground="#A8CBD1" />
                                    </Border>
                                    <Border Margin="0,0,6,0" Padding="7,2" Background="#143B35" BorderBrush="#45967F" BorderThickness="1">
                                        <TextBlock Text="{Binding RecipeCommands.SelectedRecipeSummary.XmlStatusDisplay, Mode=OneWay}" FontSize="11" Foreground="#D7FFF4" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Grid.Row="2"
                                           Margin="0,5,0,0"
                                           Foreground="#A8CBD1"
                                           FontSize="10"
                                           Text="{Binding RecipeCommands.StatusText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="3"
                                           Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="HostRecipePipelineHeaderStepFlow"
                                           Foreground="#95D6B8"
                                           FontSize="10"
                                           Text="{Binding RecipeCommands.PipelineStepFlowReviewText}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="4"
                                      Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock AutomationProperties.AutomationId="HostRecipeGuidedSetupStrip"
                                               Foreground="#C9EDEE"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Text="{Binding RecipeCommands.RecipeGuidedSetupText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            MinWidth="88"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            AutomationProperties.AutomationId="HostRecipeGuidedNextActionButton"
                                            Command="{Binding RecipeCommands.RunRecipeGuidedNextActionCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Play" Width="12" Height="12" Margin="0,1,4,0" />
                                            <TextBlock Text="{Binding RecipeCommands.RecipeGuidedNextActionText}" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <TabControl x:Name="recipeManagerDetailTabs"
                                    Grid.Row="1"
                                    Margin="0,6,0,0"
                                    AutomationProperties.AutomationId="HostRecipeDetailTabs">
                            <TabItem x:Name="tabRecipePipeline"
                                     Header="{Binding RecipeCommands.RecipePipelineTabText}"
                                     AutomationProperties.AutomationId="HostRecipePipelineTab">
                                <ScrollViewer Margin="0,8,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" MinWidth="280" MaxWidth="360" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" MinWidth="560" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="148" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock AutomationProperties.AutomationId="HostRecipePipelineListSummaryText"
                                                   Text="{Binding RecipeCommands.PipelineListSummaryText}"
                                                   Foreground="#A8CBD1"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RecipeCommands.PipelineFilterLabelText}"
                                                       Foreground="#A8CBD1"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Height="24"
                                                     Padding="7,1"
                                                     AutomationProperties.AutomationId="HostRecipePipelineFilterTextBox"
                                                     Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                     CaretBrush="#8FE8F0"
                                                     BorderBrush="{StaticResource ShellHost.FieldBorderBrush}"
                                                     Background="{StaticResource ShellHost.FieldBrush}"
                                                     Text="{Binding RecipeCommands.PipelineFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <ListBox Grid.Row="2"
                                                 Margin="0,4,0,0"
                                                 AutomationProperties.AutomationId="HostRecipePipelineManagerList"
                                                 Background="#101A1F"
                                                 BorderBrush="#38535C"
                                                 BorderThickness="1"
                                                 ItemsSource="{Binding RecipeCommands.FilteredPipelineOptions}"
                                                 SelectedItem="{Binding RecipeCommands.SelectedPipelineOption, Mode=TwoWay}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="5,4">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   ToolTip="{Binding PipelineName}"
                                                                   Foreground="#F5FAFC"
                                                                   FontWeight="SemiBold"
                                                                   MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
