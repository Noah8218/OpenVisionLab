<Window x:Class="OpenVisionLab.ImageCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1280"
        Height="760"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <SolidColorBrush x:Key="Compare.ChromeBrush" Color="#30383B" />
        <SolidColorBrush x:Key="Compare.SurfaceBrush" Color="#F3F6F8" />
        <SolidColorBrush x:Key="Compare.PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Compare.LineBrush" Color="#D6E1E6" />
        <SolidColorBrush x:Key="Compare.StrongLineBrush" Color="#8BA0AD" />
        <SolidColorBrush x:Key="Compare.TextBrush" Color="#243040" />
        <SolidColorBrush x:Key="Compare.MutedBrush" Color="#657487" />
        <SolidColorBrush x:Key="Compare.AccentBrush" Color="#157C86" />
        <SolidColorBrush x:Key="Compare.WarningBrush" Color="#8A5B13" />

        <Style x:Key="CompareChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EAF5F7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonChrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonChrome" Property="Background" Value="#405057" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonChrome" Property="Background" Value="#157C86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompareToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Compare.StrongLineBrush}" />
            <Setter Property="Background" Value="#F9FBFC" />
            <Setter Property="Foreground" Value="{StaticResource Compare.TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#E6F1F2" />
                                <Setter Property="BorderBrush" Value="{StaticResource Compare.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#D8ECEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComparePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CompareToolButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Compare.AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Compare.AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="CompareStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE7EF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Compare.AccentBrush}"
            BorderThickness="1"
            Background="{StaticResource Compare.SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid x:Name="titleBar"
                  Background="{StaticResource Compare.ChromeBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Compare"
                                                Width="18"
                                                Height="18"
                                                Foreground="#8AD7DA"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TitleText}"
                               Foreground="#F5FAFC"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CompareChromeButtonStyle}" ToolTip="Minimize" Click="Minimize_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource CompareChromeButtonStyle}" ToolTip="Maximize" Click="MaximizeRestore_Click">
                        <iconPacks:PackIconMaterial x:Name="maximizeIcon" Kind="WindowMaximize" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource CompareChromeButtonStyle}" ToolTip="Close" Click="Close_Click">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource Compare.PanelBrush}"
                    BorderBrush="{StaticResource Compare.LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource ComparePrimaryButtonStyle}" Click="LoadImages_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LoadImagesText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CompareToolButtonStyle}" Margin="8,0,0,0" Click="FitAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FitToScreenOutline" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FitAllText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CompareToolButtonStyle}" Margin="8,0,0,0" Click="ToggleSync_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="LinkVariant" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SyncText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource Compare.MutedBrush}"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Slots}"
                          Margin="12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5"
                                Background="#111820"
                                BorderThickness="2"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#263646" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Compare.AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSizeMismatch}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Compare.WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#172230"
                                        BorderBrush="#2C3B4A"
                                        BorderThickness="0,0,0,1"
                                        Padding="9,0">
                                    <TextBlock Text="{Binding HeaderText}"
                                               Foreground="#EAF1F6"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Grid Grid.Row="1" Background="#05070A" ClipToBounds="True">
                                    <Image Source="{Binding Source}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           RenderTransformOrigin="0.5,0.5"
                                           SnapsToDevicePixels="True"
                                           MouseMove="SlotImage_MouseMove"
                                           MouseLeave="SlotImage_MouseLeave"
                                           MouseWheel="SlotImage_MouseWheel"
                                           MouseLeftButtonDown="SlotImage_MouseLeftButtonDown">
                                        <Image.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <TextBlock Text="{Binding EmptyText}"
                                               Foreground="#798895"
                                               FontFamily="Segoe UI"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" Background="#101821">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <Border Margin="8,6"
                        Background="{Binding SwatchBrush}"
                        BorderBrush="#738292"
                        BorderThickness="1" />
                <TextBlock Grid.Column="1" Style="{StaticResource CompareStatusTextStyle}" Text="{Binding StatusText}" />
                <TextBlock Grid.Column="2" Style="{StaticResource CompareStatusTextStyle}" Text="{Binding XyText}" />
                <TextBlock Grid.Column="3" Style="{StaticResource CompareStatusTextStyle}" Text="{Binding ColorText}" />
                <TextBlock Grid.Column="4" Style="{StaticResource CompareStatusTextStyle}" Text="{Binding DeltaText}" />
            </Grid>
        </Grid>
    </Border>
</Window>
