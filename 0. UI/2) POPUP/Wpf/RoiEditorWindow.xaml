<Window x:Class="OpenVisionLab.RoiEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="1040"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RoiChromeButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#EAF5F7" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonChrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonChrome" Property="Background" Value="#405057" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="buttonChrome" Property="Background" Value="#157C86" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoiToolButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenVision.StrongLineBrush}" />
                <Setter Property="Background" Value="#F9FBFC" />
                <Setter Property="Foreground" Value="{StaticResource OpenVision.TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#E6F1F2" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OpenVision.AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#D8ECEE" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoiPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoiToolButtonStyle}">
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="{StaticResource OpenVision.AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenVision.AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="RoiFieldStyle" TargetType="TextBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource OpenVision.TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenVision.StrongLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="RoiLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource OpenVision.MutedTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="BorderBrush" Value="{StaticResource OpenVision.LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource OpenVision.AccentBrush}"
            BorderThickness="1"
            Background="{StaticResource OpenVision.SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid x:Name="titleBar"
                  Background="{StaticResource OpenVision.ChromeBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CropFree"
                                                Width="18"
                                                Height="18"
                                                Foreground="#8AD7DA"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               Foreground="#F5FAFC"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource RoiChromeButtonStyle}" ToolTip="Minimize" Click="Minimize_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource RoiChromeButtonStyle}" ToolTip="Maximize" Click="MaximizeRestore_Click">
                        <iconPacks:PackIconMaterial x:Name="maximizeIcon" Kind="WindowMaximize" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource RoiChromeButtonStyle}" ToolTip="Close" Click="Cancel_Click">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#07090B"
                        BorderBrush="{StaticResource OpenVision.StrongLineBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Canvas x:Name="viewportCanvas"
                                Background="#07090B"
                                ClipToBounds="True"
                                Focusable="True"
                                SizeChanged="ViewportCanvas_SizeChanged"
                                MouseDown="ViewportCanvas_MouseDown"
                                MouseMove="ViewportCanvas_MouseMove"
                                MouseUp="ViewportCanvas_MouseUp"
                                MouseLeave="ViewportCanvas_MouseLeave">
                            <Image x:Name="sourceImage"
                                   Source="{Binding SourceImage}"
                                   Stretch="Fill"
                                   IsHitTestVisible="False"
                                   SnapsToDevicePixels="True" />
                            <Canvas x:Name="overlayCanvas"
                                    Background="Transparent"
                                    Focusable="False"
                                    ClipToBounds="True" />
                        </Canvas>

                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="#B0121A1E"
                                BorderBrush="#553E8F98"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,4">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#F5FAFC"
                                       FontFamily="Segoe UI"
                                       FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource OpenVision.BandBrush}"
                            BorderBrush="{StaticResource OpenVision.LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{Binding CoordinateText}"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource OpenVision.TextBrush}" />
                            <TextBlock Text="{Binding HelpText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="{StaticResource OpenVision.MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource OpenVision.PanelBrush}"
                            BorderBrush="{StaticResource OpenVision.LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Selection"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OpenVision.TextBrush}" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="X" Style="{StaticResource RoiLabelStyle}" />
                                <TextBox x:Name="txtX"
                                         Grid.Column="1"
                                         Style="{StaticResource RoiFieldStyle}"
                                         Text="{Binding SelectedX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="CoordinateField_KeyDown" />
                                <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource RoiLabelStyle}" />
                                <TextBox x:Name="txtY"
                                         Grid.Column="4"
                                         Style="{StaticResource RoiFieldStyle}"
                                         Text="{Binding SelectedY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="CoordinateField_KeyDown" />
                                <TextBlock Grid.Row="2" Text="W" Style="{StaticResource RoiLabelStyle}" />
                                <TextBox x:Name="txtWidth"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Style="{StaticResource RoiFieldStyle}"
                                         Text="{Binding SelectedWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="CoordinateField_KeyDown" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="H" Style="{StaticResource RoiLabelStyle}" />
                                <TextBox x:Name="txtHeight"
                                         Grid.Row="2"
                                         Grid.Column="4"
                                         Style="{StaticResource RoiFieldStyle}"
                                         Text="{Binding SelectedHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="CoordinateField_KeyDown" />
                            </Grid>
                            <UniformGrid Grid.Row="4" Columns="3">
                                <Button Style="{StaticResource RoiToolButtonStyle}" Margin="0,0,6,0" Click="Fit_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Fullscreen" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="Full" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RoiToolButtonStyle}" Margin="0,0,6,0" Click="Center_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ImageFilterCenterFocus" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RoiToolButtonStyle}" Click="Clear_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CloseBoxOutline" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="Clear" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            Visibility="{Binding TrainingPreviewVisibility}"
                            Background="{StaticResource OpenVision.PanelBrush}"
                            BorderBrush="{StaticResource OpenVision.LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="120" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Pattern Preview"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OpenVision.TextBrush}" />
                            <Border Grid.Row="2"
                                    Background="#07090B"
                                    BorderBrush="{StaticResource OpenVision.StrongLineBrush}"
                                    BorderThickness="1">
                                <Image Source="{Binding PatternPreviewImage}" Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="6"
                            Visibility="{Binding MultiRoiVisibility}"
                            Background="{StaticResource OpenVision.PanelBrush}"
                            BorderBrush="{StaticResource OpenVision.LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="ROI List"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OpenVision.TextBrush}" />
                            <ListBox x:Name="roiList"
                                     Grid.Row="2"
                                     ItemsSource="{Binding Regions}"
                                     DisplayMemberPath="DisplayText"
                                     SelectionChanged="RoiList_SelectionChanged" />
                            <Button Grid.Row="4"
                                    Style="{StaticResource RoiToolButtonStyle}"
                                    Click="DeleteSelected_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Delete Selected" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2"
                  Background="{StaticResource OpenVision.BandBrush}"
                  Margin="1,0,1,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CoordinateText}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource OpenVision.MutedTextBrush}" />
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="btnCancel"
                        Style="{StaticResource RoiToolButtonStyle}"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        AutomationProperties.AutomationId="btnOk"
                        Style="{StaticResource RoiPrimaryButtonStyle}"
                        Click="Ok_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Check" Width="15" Height="15" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding PrimaryActionText}" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
