<UserControl x:Class="OpenVisionLab.SimplePreprocessToolWpfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab"
             MinWidth="860"
             MinHeight="560"
             Background="#EEF2F6">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <local:VisionToolSingleInputPropertyToolShell x:Name="toolShell"
                                                      TitleIconKind="Tune"
                                                      PropertyGridHostVisibility="Collapsed"
                                                      ParameterContentVisibility="Visible" />

        <ScrollViewer x:Name="parameterContentHost"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="parameterPanel" Margin="0,0,10,0" />
        </ScrollViewer>
    </Grid>
</UserControl>
