<Window x:Class="OpenVisionLab.OpenVisionLearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenVisionLab"
        Title="OpenVisionLab Learn"
        Width="1040"
        Height="700"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F6"
        AutomationProperties.AutomationId="OpenVisionLearnWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LearnPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource VisionTool.HeaderBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="LearnMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource VisionTool.SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource LearnPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Learn"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               Text="Tool은 작업 공간이고, Learn은 개념과 실습을 확인하는 공간입니다." />
                </StackPanel>
                <ListBox x:Name="topicList"
                         Grid.Row="2"
                         AutomationProperties.AutomationId="OpenVisionLearnTopicList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectedIndex="2"
                         SelectionChanged="TopicList_SelectionChanged">
                    <ListBoxItem Content="0. 커리큘럼 / 영상 기초" />
                    <ListBoxItem Content="1. 밝기와 히스토그램" />
                    <ListBoxItem Content="2. 이진화 / Threshold" />
                    <ListBoxItem Content="3. 필터링" />
                    <ListBoxItem Content="4. 모폴로지" />
                    <ListBoxItem Content="5. Blob / 영역 검출" />
                    <ListBoxItem Content="6. Contour / 외곽선" />
                    <ListBoxItem Content="7. Edge / Line" />
                    <ListBoxItem Content="8. LineDistance 측정" />
                    <ListBoxItem Content="9. Matching" />
                    <ListBoxItem Content="10. Feature Matching" />
                    <ListBoxItem Content="11. Layer / Pipeline / Recipe" />
                    <ListBoxItem Content="12. EdgeBasedMatching" />
                    <ListBoxItem Content="13. Metrics / Acceptance" />
                    <ListBoxItem Content="14. Arithmetic / Logic" />
                    <ListBoxItem Content="15. Geometry Transform" />
                    <ListBoxItem Content="16. Color / HSV" />
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource LearnPanelStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtTopicTitle"
                               Text="3. 이진화 / Threshold"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="txtTopicSubtitle"
                               Margin="0,4,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               Text="세부 문서: Arithmetic, RotateScale, Color/HSV, Pipeline/Layer, Metrics/Acceptance." />
                    <StackPanel Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="92"
                                Padding="12,6"
                                Content="Topic Docs"
                                ToolTip="Open the current Learn topic document"
                                Click="OpenLearnDocsButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnOpenDocsButton" />
                        <Button MinWidth="112"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Content="Foundation Docs"
                                ToolTip="Open OpenCvSharp foundation terms: Point, Rect, Mat, ROI, layer"
                                Click="OpenFoundationDocsButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnOpenFoundationDocsButton" />
                        <Button x:Name="btnPracticeSamples"
                                MinWidth="118"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Content="Practice Samples"
                                IsEnabled="False"
                                ToolTip="Open Sample Picker with the current Learn path"
                                Click="OpenPracticeSamplesButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnPracticeSamplesButton" />
                    </StackPanel>
                    <TextBlock x:Name="txtTopicPractice"
                               Margin="0,8,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               TextWrapping="Wrap"
                               Text="Practice: use Sample Picker Learn paths, then open the related Tool View and run Preview manually." />
                </StackPanel>
            </Border>

            <Border x:Name="pixelTopicPanel"
                    Grid.Row="2"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnFoundationTypeCards">
                            <StackPanel>
                                <TextBlock Text="OpenCvSharp operator basics"
                                           FontWeight="SemiBold" />
                                <UniformGrid Margin="0,8,0,0"
                                             Columns="2"
                                             Rows="2">
                                    <TextBlock Text="Point = X,Y -> center / edge / keypoint" />
                                    <TextBlock Text="Rect ROI = X,Y,W,H -> CvROI" />
                                    <TextBlock Text="Size = W,H -> kernel / template / output" />
                                    <TextBlock Text="Mat = rows x cols x channels -> layer image" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="PropertyGrid values such as CvROI, kernel size, template path, threshold, and output size are easier to tune after these four shapes are clear." />
                        <Border Margin="0,10,0,0"
                                Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnBeginnerPathPanel">
                            <StackPanel>
                                <TextBlock Text="Beginner path: Foundation -> Brightness/GV -> Threshold -> Filter/Morphology -> Blob/Contour/LineDistance"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="Read the concept, open a public sample, then use the related Tool View and click Preview/Run manually. Do not skip the metric or Good/Bad check." />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="전체 목차를 먼저 봅니다"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="OpenVisionLab Learn은 설치나 카메라 프로그래밍 교재가 아니라, 현재 프로그램의 툴을 이해하고 검증하기 위한 OpenCvSharp 기초 목차입니다. 영상/GV/ROI/Layer와 Point, Size, Rect, Mat를 먼저 잡고, 전처리와 검출, 측정과 매칭, Pipeline/Metric/Good-Bad/LLM XML 순서로 봅니다." />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="세부 문서: Arithmetic, RotateScale, Color/HSV, EdgeDetection, Pipeline/Layer, Metrics/Acceptance." />
                        <TextBlock Margin="0,14,0,0"
                                   Text="핵심 키워드"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Pixel: 이미지의 가장 작은 칸입니다. 각 칸은 위치 X/Y와 밝기 또는 색상 값을 가집니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="GV: Gray Value입니다. 흑백 영상에서 0은 검정, 255는 흰색에 가까운 밝기입니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="ROI: 검사할 영역입니다. ROI를 좁히면 불필요한 배경을 줄이고 검출 안정성을 높일 수 있습니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Layer: 원본, 중간 결과, 최종 결과를 나누어 보는 이름 있는 이미지입니다. Output 레이어를 만든다고 Input 레이어가 자동으로 바뀌면 안 됩니다." />
                        <TextBlock Margin="0,14,0,0"
                                   Text="OpenCvSharp 기본 타입"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Point: X/Y 위치입니다. edge point, keypoint, match center, line endpoint를 읽을 때 필요합니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Size: 폭과 높이입니다. 이미지 크기, template 크기, kernel 크기, resize 결과를 이해할 때 씁니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Rect: x, y, width, height로 표현하는 사각 영역입니다. ROI, bounding box, template crop은 대부분 Rect로 생각하면 됩니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Mat: 이미지를 행렬처럼 담는 OpenCvSharp의 기본 이미지 객체입니다. row/column, channel, ROI slice를 이해하면 툴 파라미터가 더 명확해집니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="행렬 연산: filter kernel, morphology kernel, affine/rotate/scale transform은 픽셀 주변값이나 좌표를 행렬식으로 바꾸는 작업입니다." />
                        <TextBlock Margin="0,14,0,0"
                                   Text="목차 구성"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="아래 순서대로 보면 개념, 샘플, 툴, metric, Good/Bad 판정이 하나의 작업 흐름으로 이어집니다." />
                        <Border Margin="0,14,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="추천 학습 경로"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="0-4장: 영상, 픽셀, GV, Point/Size/Rect/Mat, ROI, Layer, 명시 Preview/Run 원칙을 잡습니다." />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="4-7장: 밝기/히스토그램, Threshold, Filter, Morphology로 입력을 정리합니다." />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="8-11장: Blob, Contour, Edge, LineDistance로 후보와 치수를 검증합니다." />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="12-14장: Matching, EdgeBasedMatching, FeatureMatching으로 템플릿/형상/특징을 비교합니다." />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="15-20장: Pipeline route, metric gate, Good/Bad 검증, Recipe Manager, LLM XML correction loop를 연결합니다." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="brightnessTopicPanel"
                    Grid.Row="2"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="왜 밝기와 히스토그램을 먼저 보나요?"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="밝기는 각 픽셀의 GV가 얼마나 큰지를 뜻합니다. 조명이 변하거나 대상이 어두워지면 같은 Threshold 값도 전혀 다른 결과를 만들 수 있습니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="히스토그램은 이미지 안에 어떤 밝기 값이 얼마나 많은지 세어 놓은 표입니다. 어두운 값에 몰려 있으면 전체가 어둡고, 밝은 값에 몰려 있으면 전체가 밝습니다." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="원본 GV 샘플"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="각 칸은 이미지 안의 픽셀 밝기 예시입니다."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="brightnessInputGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="밝기 보정 후"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtBrightnessFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="brightnessOutputGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="미니 히스토그램"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtBrightnessOffset"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="brightnessOffsetSlider"
                                        Grid.Row="2"
                                        Minimum="-80"
                                        Maximum="80"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="BrightnessOffsetSlider_ValueChanged"
                                        AutomationProperties.AutomationId="OpenVisionLearnBrightnessOffsetSlider" />
                                <UniformGrid x:Name="histogramGrid"
                                             Grid.Row="4"
                                             Columns="8"
                                             Rows="1" />
                                <TextBlock Grid.Row="5"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="Threshold를 정하기 전에는 대상과 배경의 밝기 분포가 떨어져 있는지 확인합니다. 분포가 겹치면 Threshold 하나로 안정적인 검출이 어렵습니다." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="arithmeticTopicPanel"
                    Grid.Row="2"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Arithmetic combines pixel values from one or two layers."
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Use this topic when you need to brighten, darken, compare, mask, or combine result layers. Arithmetic is useful only when the input layers and binary polarity are clear." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Opening this guide does not run Preview/Run, create layers, or change InputLayer/InputLayerB/OutputLayer. Open the Arithmetic Tool View and click Preview explicitly when you want to test the operation." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="InputLayer A"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="First image or mask"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="arithmeticInputAGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="InputLayer B"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="Second image, mask, or constant source"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="arithmeticInputBGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="OutputLayer"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtArithmeticFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="arithmeticResultGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Operation"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="arithmeticModeCombo"
                                              Grid.Column="2"
                                              SelectedIndex="2"
                                              SelectionChanged="ArithmeticModeCombo_SelectionChanged"
                                              AutomationProperties.AutomationId="OpenVisionLearnArithmeticModeCombo">
                                        <ComboBoxItem Content="Add" />
                                        <ComboBoxItem Content="Subtract" />
                                        <ComboBoxItem Content="AbsDiff" />
                                        <ComboBoxItem Content="Bitwise AND" />
                                        <ComboBoxItem Content="Bitwise OR" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="txtArithmeticMeaning"
                                           Grid.Row="2"
                                           Style="{StaticResource LearnMutedTextStyle}" />
                                <TextBlock Grid.Row="4"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="Common checks: InputLayerA and InputLayerB must be the intended layers, binary white/black meaning must be known, and OutputLayer should be a separate review layer." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="geometryTopicPanel"
                    Grid.Row="2"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Geometry transforms move pixels and coordinates."
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="RotateScale is useful when the recipe intentionally normalizes orientation or size before detection. After rotation or scaling, ROI, measurement distance, template position, and pixel/mm gates must be reviewed again." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Opening this guide does not run Preview/Run, create layers, or rewrite routing. Use the Rotate / Scale Tool View and click Preview explicitly to create the transformed output layer." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Before / after concept"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="Dashed box is the original ROI. Blue box is the transformed review area."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <Canvas Width="250"
                                            Height="112"
                                            Background="#F8FAFC">
                                        <Rectangle Width="92"
                                                   Height="54"
                                                   Canvas.Left="79"
                                                   Canvas.Top="30"
                                                   Stroke="#94A3B8"
                                                   StrokeDashArray="4 3"
                                                   StrokeThickness="2"
                                                   Fill="#FFFFFF" />
                                        <Border x:Name="geometryTargetBox"
                                                Width="92"
                                                Height="54"
                                                Canvas.Left="79"
                                                Canvas.Top="30"
                                                Background="#2563EB"
                                                Opacity="0.78"
                                                CornerRadius="5"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="geometryScaleTransform" />
                                                    <RotateTransform x:Name="geometryRotateTransform" />
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <TextBlock Text="ROI"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Canvas>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
