                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="GV: Gray Value입니다. 0은 검정, 255는 흰색에 가까운 밝기 숫자입니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Threshold: 픽셀 GV와 비교하는 기준값입니다. 기준보다 밝은지 어두운지로 결과가 갈립니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="MaxValue: 조건을 만족한 픽셀을 흰색으로 만들 때 쓰는 값입니다. 보통 255입니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Binary: GV가 기준값 이상이면 MaxValue, 아니면 0입니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="BinaryInv: Binary의 반대입니다. 밝은 영역을 검정으로, 어두운 영역을 흰색으로 만듭니다." />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="OpenVisionLab에서의 의미"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Threshold는 보통 Blob, Contour, Morphology 앞에서 밝은 대상과 어두운 배경을 분리할 때 사용합니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Learn 화면의 Apply는 tool parameter만 바꿉니다. 실제 결과 이미지는 Tool의 Run Preview를 명시적으로 눌러 확인합니다." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="애니메이션">
                    <Grid Margin="0,10,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtThresholdValue"
                                               FontWeight="SemiBold"
                                               Text="Threshold = 127" />
                                    <TextBlock x:Name="txtMaxValue"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                                               Text="MaxValue = 255" />
                                </Grid>

                                <Grid x:Name="thresholdBarHost"
                                      Grid.Row="2"
                                      SizeChanged="ThresholdBarHost_SizeChanged">
                                    <Border CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#111827" Offset="0" />
                                                <GradientStop Color="#6B7280" Offset="0.50" />
                                                <GradientStop Color="#FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="thresholdMarker"
                                            Width="4"
                                            Background="#EF4444"
                                            HorizontalAlignment="Left"
                                            CornerRadius="2">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="thresholdMarkerTransform" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>

                                <Slider x:Name="thresholdSlider"
                                        Grid.Row="4"
                                        Minimum="0"
                                        Maximum="255"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="ThresholdSlider_ValueChanged"
                                        AutomationProperties.AutomationId="OpenVisionLearnThresholdSlider" />

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="0 black"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="255 white"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Sample GV"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="Each cell is one example pixel."
                                               FontSize="11"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                    <UniformGrid x:Name="sampleGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Binary result"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtFormula"
                                               Margin="0,3,0,10"
                                               FontSize="11"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                    <UniformGrid x:Name="resultGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="툴 적용">
                    <Border Margin="0,10,8,0"
                            Style="{StaticResource LearnPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Tool로 돌아가는 방법"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="1. 애니메이션 탭에서 Threshold와 BinaryInv를 조정합니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="2. Apply to tool을 누르면 현재 열린 Threshold Tool의 값만 바뀝니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="3. 실제 결과 이미지는 Threshold Tool에서 Run Preview를 눌러 확인합니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="4. 결과가 좋으면 Add Pipeline으로 recipe step을 저장합니다." />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <Grid x:Name="thresholdControls"
                  Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkInvert"
                          Grid.Column="0"
                          Content="BinaryInv"
                          VerticalAlignment="Center"
                          Checked="InvertCheckBox_Changed"
                          Unchecked="InvertCheckBox_Changed"
                          AutomationProperties.AutomationId="OpenVisionLearnThresholdInvertCheckBox" />
                <Button x:Name="btnAnimate"
                        Grid.Column="1"
                        MinWidth="84"
                        Height="32"
                        Content="Play"
                        Click="AnimateButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnThresholdAnimationButton" />
                <Button x:Name="btnApply"
                        Grid.Column="3"
                        MinWidth="122"
                        Height="32"
                        Content="Apply to tool"
                        Click="ApplyButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnThresholdApplyButton" />
                <Button Grid.Column="5"
                        MinWidth="78"
                        Height="32"
                        Content="Close"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
