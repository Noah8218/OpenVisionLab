<UserControl x:Class="OpenVisionLab.VisionToolDoubleInputCustomToolShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:OpenVisionLab"
             MinWidth="920"
             MinHeight="620"
             AutomationProperties.AutomationId="VisionToolDoubleInputCustomToolShell">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="shellRoot"
          Background="{StaticResource VisionTool.SurfaceBrush}"
          Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="previewColumn" Width="390" />
            <ColumnDefinition x:Name="flowColumn" Width="16" />
            <ColumnDefinition x:Name="parameterColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="rowInputA" Height="*" />
            <RowDefinition x:Name="rowInputBGap" Height="8" />
            <RowDefinition x:Name="rowInputB" Height="*" />
            <RowDefinition x:Name="rowOutputGap" Height="8" />
            <RowDefinition x:Name="rowOutput" Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="flowRail"
              Grid.Row="0"
              Grid.RowSpan="5"
              Grid.Column="1"
              IsHitTestVisible="False">
            <Rectangle Width="2"
                       Margin="0,24"
                       HorizontalAlignment="Center"
                       Fill="{StaticResource VisionTool.FlowRailBrush}" />
            <Ellipse Width="8"
                     Height="8"
                     Margin="0,32,0,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Fill="{StaticResource VisionTool.FlowNodeBrush}" />
            <Path Width="10"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M 0 0 L 5 7 L 10 0 Z"
                  Fill="{StaticResource VisionTool.FlowNodeBrush}"
                  Stretch="Fill" />
            <Ellipse Width="8"
                     Height="8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{StaticResource VisionTool.FlowNodeBrush}" />
            <Path Width="10"
                  Height="7"
                  Margin="0,0,0,84"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Data="M 0 0 L 5 7 L 10 0 Z"
                  Fill="{StaticResource VisionTool.FlowNodeBrush}"
                  Stretch="Fill" />
            <Ellipse Width="8"
                     Height="8"
                     Margin="0,0,0,32"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Fill="{StaticResource VisionTool.FlowNodeBrush}" />
        </Grid>

        <GroupBox x:Name="gbInputA"
                  Grid.Row="0"
                  Grid.Column="0"
                  Header="Input A"
                  Padding="8"
                  AutomationProperties.AutomationId="gbInputA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Border x:Name="bdInputAPreview"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="VisionToolInputAPreviewFrame"
                        Style="{StaticResource VisionTool.PreviewFrameStyle}">
                    <local:VisionToolInlinePreviewSlot x:Name="imgInputA"
                                                       AutomationProperties.AutomationId="VisionToolInputAPreviewSlot" />
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cbInputA" Grid.Column="0" />
                    <Button x:Name="btnLoadInputAImage"
                            Grid.Column="2"
                            Style="{StaticResource VisionTool.IconButtonStyle}"
                            ToolTip="Load input A image">
                        <iconPacks:PackIconMaterial Kind="ImagePlusOutline"
                                                    Width="19"
                                                    Height="19"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox x:Name="gbInputB"
                  Grid.Row="2"
                  Grid.Column="0"
                  Header="Input B"
                  Padding="8"
                  AutomationProperties.AutomationId="gbInputB">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Border x:Name="bdInputBPreview"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="VisionToolInputBPreviewFrame"
                        Style="{StaticResource VisionTool.PreviewFrameStyle}">
                    <local:VisionToolInlinePreviewSlot x:Name="imgInputB"
                                                       AutomationProperties.AutomationId="VisionToolInputBPreviewSlot" />
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cbInputB" Grid.Column="0" />
                    <Button x:Name="btnLoadInputBImage"
                            Grid.Column="2"
                            Style="{StaticResource VisionTool.IconButtonStyle}"
                            ToolTip="Load input B image">
                        <iconPacks:PackIconMaterial Kind="ImagePlusOutline"
                                                    Width="19"
                                                    Height="19"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox x:Name="gbOutputLayer"
                  Grid.Row="4"
                  Grid.Column="0"
                  Header="결과 쓰기 레이어"
                  Padding="8"
                  AutomationProperties.AutomationId="gbOutputLayer">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Border x:Name="bdOutputPreview"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="VisionToolOutputPreviewFrame"
                        Style="{StaticResource VisionTool.PreviewFrameStyle}">
                    <local:VisionToolInlinePreviewSlot x:Name="imgOutputPreview"
                                                       AutomationProperties.AutomationId="VisionToolOutputPreviewSlot" />
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cbOutputLayer" Grid.Column="0" />
                    <Button x:Name="btnCreateOutputLayer"
                            Grid.Column="2"
                            Style="{StaticResource VisionTool.IconButtonStyle}"
                            ToolTip="Create new output layer">
                        <iconPacks:PackIconMaterial Kind="ImagePlusOutline"
                                                    Width="19"
                                                    Height="19"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Grid>
        </GroupBox>

        <Grid x:Name="parameterPanel"
              Grid.Row="0"
              Grid.RowSpan="5"
              Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="titleRow" Height="Auto" />
                <RowDefinition x:Name="titleGapRow" Height="14" />
                <RowDefinition x:Name="parameterContentRow" Height="*" />
                <RowDefinition x:Name="summaryGapRow" Height="12" />
                <RowDefinition x:Name="summaryRow" Height="Auto" />
                <RowDefinition x:Name="statusRow" Height="Auto" />
                <RowDefinition x:Name="actionGapRow" Height="14" />
                <RowDefinition x:Name="actionRow" Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource VisionTool.HeaderBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                Kind="{Binding TitleIconKind, RelativeSource={RelativeSource AncestorType=local:VisionToolDoubleInputCustomToolShell}}"
                                                Width="18"
                                                Height="18"
                                                Foreground="{StaticResource VisionTool.AccentBrush}" />
                    <TextBlock x:Name="txtTitle"
                               Grid.Column="2"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>

            <ContentPresenter Grid.Row="2"
                              AutomationProperties.AutomationId="VisionToolParametersGroup"
                              Content="{Binding ParameterContent, RelativeSource={RelativeSource AncestorType=local:VisionToolDoubleInputCustomToolShell}}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

            <Border x:Name="bdSummary"
                    Grid.Row="4"
                    Background="{StaticResource VisionTool.HeaderBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    Padding="12,8">
                <TextBlock x:Name="txtSummary"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <Border x:Name="bdStatus"
                    Grid.Row="5"
                    Background="{StaticResource VisionTool.PanelBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    Margin="0,8,0,0"
                    Padding="8,4">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=txtStatus}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="txtStatus"
                           Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                           MinHeight="14"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid Grid.Row="7">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="rowAddPipelineAction" Height="40" />
                    <RowDefinition x:Name="rowRunPreviewGap" Height="8" />
                    <RowDefinition x:Name="rowRunPreviewAction" Height="40" />
                    <RowDefinition x:Name="rowRunOffsetGap" Height="0" />
                    <RowDefinition x:Name="rowRunOffsetAction" Height="0" />
                </Grid.RowDefinitions>
                <Button x:Name="btnAddPipeline" Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="PlaylistPlus" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="txtAddPipelineText" Text="Add Pipeline" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="btnRunPreview"
                        Grid.Row="2"
                        Style="{StaticResource VisionTool.PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Play" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="txtRunPreviewText" Text="Run Preview" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="btnRunOffset"
                        Grid.Row="4"
                        Style="{StaticResource VisionTool.PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ArrowRight" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="txtRunOffsetText" Text="Run Offset" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
