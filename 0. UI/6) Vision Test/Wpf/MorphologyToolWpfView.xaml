<UserControl x:Class="OpenVisionLab.MorphologyToolWpfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:OpenVisionLab"
             MinWidth="860"
             MinHeight="560"
             Background="#EEF2F6">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="72" />
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Margin" Value="0,0,18,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <local:VisionToolSingleInputPropertyToolShell x:Name="toolShell"
                                                      TitleIconKind="ShapeOutline"
                                                      PropertyGridHostVisibility="Collapsed"
                                                      ParameterContentVisibility="Visible"
                                                      ResultReviewVisibility="Collapsed" />

        <Grid x:Name="parameterContentHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <GroupBox x:Name="gbOperation" Grid.Row="0" Header="Operation" Padding="12" Foreground="{StaticResource PrimaryTextBrush}">
                                <UniformGrid Columns="4" Rows="2">
                                    <Button x:Name="btnMorphOperationErode" Content="Erode" Tag="Erode" Margin="0,0,8,10" Click="Operation_Click" />
                                    <Button x:Name="btnMorphOperationDilate" Content="Dilate" Tag="Dilate" Margin="0,0,8,10" Click="Operation_Click" />
                                    <Button x:Name="btnMorphOperationOpen" Content="Open" Tag="Open" Margin="0,0,8,10" Click="Operation_Click" />
                                    <Button x:Name="btnMorphOperationClose" Content="Close" Tag="Close" Margin="0,0,0,10" Click="Operation_Click" />
                                    <Button x:Name="btnMorphOperationTopHat" Content="TopHat" Tag="TopHat" Margin="0,0,8,0" Click="Operation_Click" />
                                    <Button x:Name="btnMorphOperationBlackHat" Content="BlackHat" Tag="BlackHat" Margin="0,0,8,0" Click="Operation_Click" />
                                    <Button x:Name="btnMorphOperationHitMiss" Content="HitMiss" Tag="HitMiss" Margin="0,0,8,0" Click="Operation_Click" />
                                    <Button x:Name="btnMorphOperationGradient" Content="Gradient" Tag="Gradient" Click="Operation_Click" />
                                </UniformGrid>
                            </GroupBox>

                <GroupBox x:Name="gbKernel" Grid.Row="2" Header="Kernel" Padding="12" Foreground="{StaticResource PrimaryTextBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,-8">
                            <StackPanel x:Name="panelKernelWidth" Width="136" Margin="0,0,16,12">
                                <TextBlock x:Name="lblKernelWidth" Text="Width" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                <TextBox x:Name="txtWidth" MinWidth="72" HorizontalAlignment="Left" Text="{Binding KernelWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="panelKernelHeight" Width="136" Margin="0,0,16,12">
                                <TextBlock x:Name="lblKernelHeight" Text="Height" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                <TextBox x:Name="txtHeight" MinWidth="72" HorizontalAlignment="Left" Text="{Binding KernelHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                            </StackPanel>

                            <StackPanel x:Name="panelKernelLock" Width="90" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,19,16,12">
                                <CheckBox x:Name="chkLockSize"
                                          Content="W=H"
                                          IsChecked="True"
                                          Checked="LockSize_Changed"
                                          Unchecked="LockSize_Changed" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel x:Name="panelKernelPresets" Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnKernelPreset3" Content="3 x 3" MinWidth="64" Margin="0,0,8,0" Click="Preset3_Click" />
                            <Button x:Name="btnKernelPreset5" Content="5 x 5" MinWidth="64" Margin="0,0,8,0" Click="Preset5_Click" />
                            <Button x:Name="btnKernelPreset7" Content="7 x 7" MinWidth="64" Click="Preset7_Click" />
                        </StackPanel>

                        <Grid x:Name="panelShape" Grid.Row="4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblShape" Grid.Column="0" Text="Shape" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="rdoShapeRect" Content="Rect" Tag="Rect" GroupName="MorphShape" IsChecked="True" Margin="0,0,10,0" Checked="Shape_Checked" />
                                <RadioButton x:Name="rdoShapeEllipse" Content="Ellipse" Tag="Ellipse" GroupName="MorphShape" Margin="0,0,10,0" Checked="Shape_Checked" />
                                <RadioButton x:Name="rdoShapeCross" Content="Cross" Tag="Cross" GroupName="MorphShape" Margin="0" Checked="Shape_Checked" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
        </Grid>
    </Grid>
</UserControl>
