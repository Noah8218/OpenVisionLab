<UserControl x:Class="OpenVisionLab.FilterToolWpfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:OpenVisionLab"
             MinWidth="860"
             MinHeight="560"
             Background="#EEF2F6">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="70" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <local:VisionToolSingleInputPropertyToolShell x:Name="toolShell"
                                                      TitleIconKind="FilterVariant"
                                                      PropertyGridHostVisibility="Collapsed"
                                                      ParameterContentVisibility="Visible" />

        <Grid x:Name="parameterContentHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <GroupBox x:Name="gbFilterOptions" Grid.Row="0" Header="Operations" Padding="12" Foreground="{StaticResource PrimaryTextBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="lblFilterType" Text="Filter Type" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="cbFilterType" SelectedItem="{Binding FilterType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="FilterType_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="lblBorderType" Text="Border Type" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="cbBorderType" SelectedItem="{Binding BorderType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="BorderType_SelectionChanged" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                <GroupBox x:Name="gbKernel" Grid.Row="2" Header="Kernel" Padding="12" Foreground="{StaticResource PrimaryTextBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,-8">
                                        <StackPanel x:Name="panelWidth" Width="136" Margin="0,0,16,12">
                                            <TextBlock x:Name="lblKernelWidth" Text="Width" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBox x:Name="txtWidth" HorizontalAlignment="Left" Text="{Binding KernelWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="panelHeight" Width="136" Margin="0,0,16,12">
                                            <TextBlock x:Name="lblKernelHeight" Text="Height" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBox x:Name="txtHeight" HorizontalAlignment="Left" Text="{Binding KernelHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="panelKernelLock"
                                                    Width="90"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,19,16,12">
                                            <CheckBox x:Name="chkLockSize"
                                                      Content="W=H"
                                                      IsChecked="True"
                                                      Checked="LockSize_Changed"
                                                      Unchecked="LockSize_Changed" />
                                        </StackPanel>

                                        <StackPanel x:Name="panelMedian" Width="156" Margin="0,0,16,12">
                                            <TextBlock x:Name="lblMedianKernel" Text="Median Kernel" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBox x:Name="txtMedianKernel" HorizontalAlignment="Left" Text="{Binding MedianKernelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="panelDiameter" Width="136" Margin="0,0,16,12">
                                            <TextBlock x:Name="lblDiameter" Text="Diameter" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBox x:Name="txtDiameter" HorizontalAlignment="Left" Text="{Binding Diameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="panelSigmaColor" Width="148" Margin="0,0,16,12">
                                            <TextBlock x:Name="lblSigmaColor" Text="Sigma Color" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBox x:Name="txtSigmaColor" HorizontalAlignment="Left" Text="{Binding SigmaColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="panelSigmaSpace" Width="148" Margin="0,0,16,12">
                                            <TextBlock x:Name="lblSigmaSpace" Text="Sigma Space" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBox x:Name="txtSigmaSpace" HorizontalAlignment="Left" Text="{Binding SigmaSpace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" local:VisionToolTextInputBehavior.Mode="UnsignedInteger" TextChanged="Parameter_TextChanged" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <StackPanel x:Name="panelKernelPresets" Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="3 x 3" MinWidth="64" Margin="0,0,8,0" Click="Preset3_Click" />
                                        <Button Content="5 x 5" MinWidth="64" Margin="0,0,8,0" Click="Preset5_Click" />
                                        <Button Content="7 x 7" MinWidth="64" Click="Preset7_Click" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
