      "MergeSourceCount"
    ],
    "bounds": [
      "BoundsWidthMin",
      "BoundsWidthMax",
      "BoundsWidthAvg",
      "BoundsWidthMmMin",
      "BoundsWidthMmMax",
      "BoundsWidthMmAvg",
      "BoundsHeightMin",
      "BoundsHeightMax",
      "BoundsHeightAvg",
      "BoundsHeightMmMin",
      "BoundsHeightMmMax",
      "BoundsHeightMmAvg"
    ],
    "image": [
