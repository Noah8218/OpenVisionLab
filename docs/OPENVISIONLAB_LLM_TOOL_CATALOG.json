      "SourceImageHeight",
      "SourceImageChannels",
      "ResultImageWidth",
      "ResultImageHeight",
      "ResultImageChannels"
    ]
  },
  "tools": [
    {
      "toolType": "Threshold",
      "role": "Create a binary or range-thresholded layer from an input image.",
      "category": "preprocess",
      "commonParameters": [
        "Mode",
        "Threshold",
        "MaxValue",
        "ThresholdType",
        "Invert",
        "RangeMin",
        "RangeMax"
      ],
      "validationHints": [
        "Threshold, MaxValue, RangeMin, and RangeMax must be 0..255.",
        "Typical OutputLayer: Binary_Result or Threshold_Result."
      ],
      "recommendedMetrics": [
        "ResultImageWidth",
        "ResultImageHeight",
        "ResultImageChannels"
      ]
    },
    {
      "toolType": "Morphology",
      "role": "Clean binary regions with morphological operations.",
      "category": "preprocess",
      "commonParameters": [
        "Shape",
        "Operator",
        "KernelWidth",
        "KernelHeight",
        "Iterations"
      ],
      "validationHints": [
        "KernelWidth, KernelHeight, and Iterations must be positive.",
        "Use after Threshold when blobs or contours need noise cleanup."
      ],
      "recommendedMetrics": [
        "ResultImageWidth",
        "ResultImageHeight",
        "ResultImageChannels"
      ]
    },
    {
      "toolType": "Filter",
      "role": "Apply image filtering before inspection.",
      "category": "preprocess",
      "commonParameters": [
        "FilterType",
        "KernelWidth",
        "KernelHeight",
        "MedianKernelSize",
        "Diameter",
        "SigmaColor",
        "SigmaSpace",
        "BorderType"
      ],
      "validationHints": [
        "KernelWidth and KernelHeight must be positive for Blur, GaussianBlur, and BoxFilter.",
        "MedianBlur requires an odd positive MedianKernelSize such as 3, 5, or 7.",
        "BilateralFilter uses positive Diameter, SigmaColor, and SigmaSpace values."
      ],
      "recommendedMetrics": [
        "ResultImageWidth",
        "ResultImageHeight",
        "ResultImageChannels"
      ]
    },
    {
      "toolType": "EdgeDetection",
      "aliases": [
        "Edge"
      ],
      "role": "Create an edge image for downstream measurement or review.",
      "category": "preprocess",
      "commonParameters": [
        "EdgeType",
        "CannyThresholdLow",
        "CannyThresholdHigh",
        "CannyApertureSize",
        "UseL2Gradient"
      ],
      "validationHints": [
        "Canny thresholds must be 0..255.",
        "CannyThresholdLow must be less than or equal to CannyThresholdHigh."
      ],
      "recommendedMetrics": [
        "ResultImageWidth",
        "ResultImageHeight",
        "ResultImageChannels"
      ]
    },
    {
      "toolType": "Blob",
      "role": "Detect connected bright/dark regions and measure area/count/position.",
      "category": "inspection",
      "commonParameters": [
        "USE_THRESHOLD",
        "USE_ADAPTIVE_THRESHOLD",
        "USE_BITWISENOT",
        "USE_ROI",
        "USE_MULTI_ROI",
        "MIN_AREA",
        "MAX_AREA",
        "PIXELPERMM",
        "Name"
      ],
      "validationHints": [
        "MIN_AREA must be less than or equal to MAX_AREA.",
        "Disable internal threshold options when InputLayer is already a processed binary layer."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "AreaMin",
        "AreaMax",
        "AreaAvg",
        "BoundsWidthMax",
        "BoundsHeightMax"
      ]
    },
    {
      "toolType": "Contour",
      "role": "Detect contour regions and produce shape overlays.",
      "category": "inspection",
      "commonParameters": [
        "USE_THRESHOLD",
        "USE_ADAPTIVE_THRESHOLD",
        "USE_BITWISENOT",
        "USE_ROI",
        "USE_MULTI_ROI",
        "CvROI",
        "CvROIS",
        "MIN_AREA",
        "MAX_AREA",
        "ApproximationModes",
        "DetectMode",
        "USE_DRAW_IMAGE",
        "DrawThickness",
        "ClrGridHtml",
        "PIXELPERMM",
        "Name"
      ],
      "validationHints": [
        "Use CvROI as x,y,width,height.",
        "MIN_AREA must be less than or equal to MAX_AREA.",
        "Use ALLOW_BRANCH_INPUT=true for intentional parallel contour checks from the same prepared layer."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "AreaMin",
        "AreaMax",
        "AreaAvg",
        "BoundsWidthMax",
        "BoundsHeightMax"
      ]
    },
    {
      "toolType": "Matching",
      "aliases": [
        "TemplateMatching"
      ],
      "role": "Find a template in the input image.",
      "category": "inspection",
      "commonParameters": [
        "TemplatePath",
        "PATTERN_PATH",
        "MATCH_MODE",
        "SCORE_MIN",
        "NUM_MATCH",
        "MAGNIFIATION",
        "USE_FIND_ANGLE",
        "FIND_ANGLE",
        "FIND_ANGLE_MIN",
        "FIND_ANGLE_MAX",
        "USE_AS_FIXTURE_FRAME",
        "FIXTURE_FRAME_NAME",
        "FIXTURE_REFERENCE_X",
        "FIXTURE_REFERENCE_Y",
        "FIXTURE_REFERENCE_ANGLE",
        "FIXTURE_MAX_ANGLE_DELTA",
        "USE_CANNY",
        "USE_THRESHOLD",
        "USE_ADAPTIVE_THRESHOLD",
        "USE_ROI",
        "Name"
      ],
      "validationHints": [
        "TemplatePath and PATTERN_PATH must point to existing files before import.",
                                              "SCORE_MIN is a 0..1 decimal.",
                                              "MAGNIFIATION must be positive.",
        "FIND_ANGLE_MIN must be less than or equal to FIND_ANGLE_MAX.",
        "Fixture producers require NUM_MATCH=1, a unique FIXTURE_FRAME_NAME, and a reviewed numeric reference pose."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "ScoreMin",
        "ScoreMax",
        "ScoreAvg",
        "AngleMin",
        "AngleMax",
        "AngleAvg",
        "FixtureCenterX",
        "FixtureCenterY",
        "FixtureAngle",
        "FixtureOffsetX",
        "FixtureOffsetY",
        "FixtureAngleDelta"
      ]
    },
    {
      "toolType": "EdgeBasedMatching",
      "aliases": [
        "EdgeBasedTemplateMatching",
        "EdgeTemplateMatching"
      ],
      "role": "Find a template using contour/edge shape when intensity matching is less reliable.",
      "category": "inspection",
      "commonParameters": [
        "TemplatePath",
        "PATTERN_PATH",
        "SCORE_MIN",
        "NUM_MATCH",
        "GREEDINESS",
        "CANNY_LOW",
        "CANNY_HIGH",
        "CANNY_APERTURE_SIZE",
        "MIN_GRADIENT_MAGNITUDE",
        "MAX_TEMPLATE_POINTS",
        "USE_FIND_ANGLE",
        "FIND_ANGLE",
        "FIND_ANGLE_MIN",
        "FIND_ANGLE_MAX",
        "SEARCH_STEP",
        "USE_COARSE_TO_FINE_ANGLE_SEARCH",
        "HYBRID_VERIFY_IMAGE_WEIGHT",
        "USE_HYBRID_VERIFY",
        "USE_ROI",
        "Name"
      ],
      "validationHints": [
        "TemplatePath and PATTERN_PATH must point to existing files before import.",
        "SCORE_MIN, GREEDINESS, and HYBRID_VERIFY_IMAGE_WEIGHT are 0..1 decimals.",
        "CANNY_LOW and CANNY_HIGH are 0..255 and low must be less than or equal to high.",
        "CANNY_APERTURE_SIZE must be odd and in the supported Canny range."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "ScoreMin",
        "ScoreMax",
        "ScoreAvg",
        "AngleMin",
        "AngleMax",
        "AngleAvg"
      ]
    },
    {
      "toolType": "FeatureMatching",
      "aliases": [
        "Feature",
        "Sift"
      ],
      "role": "Find a target by feature points and geometric verification.",
      "category": "inspection",
      "commonParameters": [
        "TemplatePath",
        "PATTERN_PATH",
        "SCORE_MIN",
        "RANSAC_REPROJ_THRESHOLD",
        "USE_THRESHOLD",
        "USE_ADAPTIVE_THRESHOLD",
        "USE_ROI",
        "Name"
      ],
      "validationHints": [
        "TemplatePath and PATTERN_PATH must point to existing files before import.",
                                              "SCORE_MIN is the Lowe descriptor-ratio threshold in the 0..1 range; smaller values are stricter and it is not the final ScoreMax acceptance value.",
                                              "RANSAC_REPROJ_THRESHOLD must be positive."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "ScoreMin",
        "ScoreMax",
        "ScoreAvg"
      ]
    },
    {
      "toolType": "Mean",
      "role": "Measure average brightness or channel intensity in a region.",
      "category": "measurement",
      "commonParameters": [
        "USE_THRESHOLD",
        "USE_ADAPTIVE_THRESHOLD",
        "USE_BITWISENOT",
        "USE_ROI",
        "USE_MULTI_ROI",
        "CvROI",
        "MEAN_TYPES",
        "Name"
      ],
      "validationHints": [
        "Use MEAN_TYPES from the supported enum.",
        "Use MeanValueAvg or min/max mean metrics for judgement."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "MeanValueMin",
        "MeanValueMax",
        "MeanValueAvg"
      ]
    },
    {
      "toolType": "HSV",
      "aliases": [
        "HsvMask",
        "ColorHSV",
        "ColorMask"
      ],
      "role": "Create a binary mask for one HSV color range and review color coverage.",
      "category": "color",
      "commonParameters": [
        "HueMin",
        "HueMax",
        "SaturationMin",
        "SaturationMax",
        "ValueMin",
        "ValueMax",
        "USE_ROI",
        "CvROI",
        "Name"
      ],
      "validationHints": [
        "HueMin and HueMax are integer values in OpenCV's 0..179 hue scale.",
        "HueMin greater than HueMax intentionally wraps through the 179/0 boundary for colors such as red.",
        "SaturationMin must not exceed SaturationMax and ValueMin must not exceed ValueMax; both ranges are 0..255.",
        "Keep the HSV mask in a distinct OutputLayer. A downstream Blob or Contour Step must explicitly use that mask as InputLayer.",
        "Use MaskPixelRatio for a coverage gate and MaskPixelCount when the absolute selected area matters."
      ],
      "recommendedMetrics": [
        "MaskPixelCount",
        "MaskPixelRatio",
        "ResultImageWidth",
        "ResultImageHeight",
        "ResultImageChannels"
      ]
    },
    {
      "toolType": "LineGauge",
      "aliases": [
        "Line"
      ],
      "role": "Find line/edge features for gauge-style measurement.",
      "category": "measurement",
      "commonParameters": [
