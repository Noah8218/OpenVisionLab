        "CvROI",
        "CONTRAST",
        "THICKNESS",
        "SAMPLING_STEP",
        "PRJ_DIR",
        "PRJ_PORALITY",
        "SHOW_EDGE",
        "SHOW_FITLINE",
        "PIXELPERMM",
        "Name"
      ],
      "validationHints": [
        "CONTRAST, THICKNESS, SAMPLING_STEP, and PIXELPERMM are numeric; PIXELPERMM must be positive.",
        "Use line metrics for acceptance."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "EdgeCount",
        "EdgePointCount",
        "LineLengthMax",
        "LineAngleAvg"
      ]
    },
    {
      "toolType": "LineDistance",
      "aliases": [
        "LineDistanceGauge"
      ],
      "role": "Measure distance between paired edge/line projections.",
      "category": "measurement",
      "commonParameters": [
        "USE_ROI",
        "CvROI",
        "CONTRAST",
        "THICKNESS",
        "SAMPLING_STEP",
        "POINT_RANGE",
        "LeftPRJ_DIR",
        "RightPRJ_DIR",
        "VER_PRJ_DIR",
        "PRJ_PORALITY",
        "SHOW_EDGE",
        "SHOW_VERTICAL_LINE",
        "USE_MANUAL_ANGLE",
        "MANUAL_ANGLE_VALUE",
        "PIXELPERMM",
        "Name"
      ],
      "validationHints": [
        "POINT_RANGE is an integer.",
        "PIXELPERMM must be positive when mm metrics are used.",
        "Do not accept pin-to-pin or edge-to-edge distance using DistancePxAvg/DistanceMmAvg alone. Add a DistancePxRange/DistanceMmRange or DistancePxMax/DistanceMmMax gate so one long outlier distance line fails."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "DistancePxAvg",
        "DistancePxRange",
        "DistanceMmAvg",
        "DistanceMmRange",
        "DistanceMmMax",
        "EdgeCount"
      ]
    },
    {
      "toolType": "LineIntersection",
      "aliases": [
        "LineIntersectionGauge"
      ],
      "role": "Review intersection-style line geometry.",
      "category": "measurement",
      "commonParameters": [
        "USE_ROI",
        "CvROI",
        "CONTRAST",
        "THICKNESS",
        "SAMPLING_STEP",
        "PIXELPERMM"
      ],
      "validationHints": [
        "Use only when the recipe intent needs an intersection/gauge result."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "EdgeCount",
        "LineLengthMax",
        "LineAngleAvg"
      ]
    },
    {
      "toolType": "RotateScale",
      "aliases": [
        "RotateAndScale"
      ],
      "role": "Rotate and/or resize an image layer.",
      "category": "preprocess",
      "commonParameters": [
        "Angle",
        "ScaleXPercent",
        "ScaleYPercent",
        "Interpolation",
        "BorderType"
      ],
      "validationHints": [
        "ScaleXPercent and ScaleYPercent must be positive."
      ],
      "recommendedMetrics": [
        "ResultImageWidth",
        "ResultImageHeight",
        "ResultImageChannels"
      ]
    },
    {
      "toolType": "Arithmetic",
      "role": "Combine, compare, invert, or offset image layers.",
      "category": "preprocess",
      "commonParameters": [
        "ArithmeticMode",
        "ArithmeticOperation",
        "InputLayerB",
        "UseConstantInput",
        "UseColorConstant",
        "Gray",
        "B",
        "G",
        "R",
        "OffsetX",
        "OffsetY"
      ],
      "validationHints": [
        "ArithmeticMode must be Operation or Offset.",
        "ArithmeticOperation supports Bitwise_AND, Bitwise_OR, Bitwise_XOR, Bitwise_NOT, ADD, SUBTRACT, MULTIPLY, DIVIDE, MAX, MIN, ABS, ABSDIFF.",
        "Operation mode requires InputLayerB unless the operation is Bitwise_NOT or ABS, or UseConstantInput is true.",
        "InputLayerB must already exist before this Step.",
        "Gray, B, G, and R are 0..255."
      ],
      "recommendedMetrics": [
        "ResultImageWidth",
        "ResultImageHeight",
        "ResultImageChannels"
      ]
    },
    {
      "toolType": "OverlayMerge",
      "aliases": [
        "ResultMerge",
        "MergeResult"
      ],
      "role": "Merge previous Step overlays into one operator review result image.",
      "category": "review",
      "commonParameters": [
        "SourceLayers",
        "SourceSteps",
        "BurnIn",
        "DrawLabels",
        "AllowEmpty",
        "MaxPoints"
      ],
      "validationHints": [
        "SourceLayers is a semicolon-separated list of previous output layer names.",
        "SourceSteps is a semicolon-separated list of previous Step names.",
        "At least one source filter is preferred.",
        "Put OverlayMerge last when it is the final review image."
      ],
      "recommendedMetrics": [
        "ResultCount",
        "MergeOverlayCount",
        "MergeSourceCount"
      ]
    }
  ],
  "sourceEvidence": [
    "0. UI/0) MENU/Wpf/OpenVisionShellHostRecipeCommandSurface.cs",
    "1. Core/Pipeline/Validation/VisionPipelineValidation.cs",
    "1. Core/Pipeline/Definition/VisionPipelineStepParameterSchema.cs",
    "1. Core/Pipeline/Validation/VisionPipelineKnownMetrics.cs",
    "1. Core/Pipeline/Tools/VisionPipelineHsvMaskTool.cs",
    "1. Core/Pipeline/Tools/VisionPipelineArithmeticStep.cs",
    "docs/samples/*.pipeline.xml",
    "OpenVisionLabDirectSmokeRunner.cs"
  ]
}
