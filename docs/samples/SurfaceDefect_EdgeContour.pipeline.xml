<?xml version="1.0" encoding="utf-8"?>
<VisionPipeline>
  <Name>SurfaceDefect_EdgeContour</Name>
  <Steps>
    <Step>
      <Name>01 Surface Smooth</Name>
      <ToolType>Filter</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Main</InputLayer>
      <OutputLayer>Surface_Smooth</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>FilterType</Key>
          <Value>GaussianBlur</Value>
        </Parameter>
        <Parameter>
          <Key>KernelWidth</Key>
          <Value>5</Value>
        </Parameter>
        <Parameter>
          <Key>KernelHeight</Key>
          <Value>5</Value>
        </Parameter>
        <Parameter>
          <Key>BorderType</Key>
          <Value>Reflect101</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>02 Surface Edge</Name>
      <ToolType>EdgeDetection</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Surface_Smooth</InputLayer>
      <OutputLayer>Surface_Edge</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>EdgeType</Key>
          <Value>Canny</Value>
        </Parameter>
        <Parameter>
          <Key>CannyThresholdLow</Key>
          <Value>12</Value>
        </Parameter>
        <Parameter>
          <Key>CannyThresholdHigh</Key>
          <Value>36</Value>
        </Parameter>
        <Parameter>
          <Key>CannyApertureSize</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>UseL2Gradient</Key>
          <Value>true</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>03 Surface Edge Join</Name>
      <ToolType>Morphology</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Surface_Edge</InputLayer>
      <OutputLayer>Surface_EdgeJoin</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Shape</Key>
          <Value>Rect</Value>
        </Parameter>
        <Parameter>
          <Key>Operator</Key>
          <Value>Close</Value>
        </Parameter>
        <Parameter>
          <Key>KernelWidth</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>KernelHeight</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>Iterations</Key>
          <Value>1</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>04 Surface Defect Contour</Name>
      <ToolType>Contour</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Surface_EdgeJoin</InputLayer>
      <OutputLayer>SurfaceDefect_Contour</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Name</Key>
          <Value>Contour_SurfaceDefect</Value>
        </Parameter>
        <Parameter>
          <Key>PIXELPERMM</Key>
          <Value>0.006</Value>
        </Parameter>
        <Parameter>
          <Key>USE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ADAPTIVE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_BITWISENOT</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ROI</Key>
          <Value>true</Value>
        </Parameter>
        <Parameter>
          <Key>USE_MULTI_ROI</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>CvROI</Key>
          <Value>120,8,1760,240</Value>
        </Parameter>
        <Parameter>
          <Key>USE_DRAW_IMAGE</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>ApproximationModes</Key>
          <Value>ApproxSimple</Value>
        </Parameter>
        <Parameter>
          <Key>DetectMode</Key>
          <Value>List</Value>
        </Parameter>
        <Parameter>
          <Key>MIN_AREA</Key>
          <Value>10</Value>
        </Parameter>
        <Parameter>
          <Key>MAX_AREA</Key>
          <Value>12000</Value>
        </Parameter>
        <Parameter>
          <Key>ClrGridHtml</Key>
          <Value>#00ff00</Value>
        </Parameter>
        <Parameter>
          <Key>DrawThickness</Key>
          <Value>2</Value>
        </Parameter>
      </Parameters>
      <UseAcceptance>true</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <MaxElapsedMilliseconds>1000</MaxElapsedMilliseconds>
      <AcceptanceMetricName>ResultCount</AcceptanceMetricName>
      <UseAcceptanceMetricMinimum>true</UseAcceptanceMetricMinimum>
      <AcceptanceMetricMinimum>1</AcceptanceMetricMinimum>
      <UseAcceptanceMetricMaximum>true</UseAcceptanceMetricMaximum>
      <AcceptanceMetricMaximum>60</AcceptanceMetricMaximum>
    </Step>
  </Steps>
</VisionPipeline>
