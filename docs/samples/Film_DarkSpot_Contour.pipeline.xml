<?xml version="1.0" encoding="utf-8"?>
<VisionPipeline>
  <Name>Film_DarkSpot_Contour</Name>
  <Steps>
    <Step>
      <Name>01 Film Dark Spot Binary</Name>
      <ToolType>Threshold</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Main</InputLayer>
      <OutputLayer>FilmSpot_Binary</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Mode</Key>
          <Value>Threshold</Value>
        </Parameter>
        <Parameter>
          <Key>Threshold</Key>
          <Value>95</Value>
        </Parameter>
        <Parameter>
          <Key>MaxValue</Key>
          <Value>255</Value>
        </Parameter>
        <Parameter>
          <Key>ThresholdType</Key>
          <Value>BinaryInv</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>02 Film Spot Clean</Name>
      <ToolType>Morphology</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>FilmSpot_Binary</InputLayer>
      <OutputLayer>FilmSpot_Clean</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Shape</Key>
          <Value>Ellipse</Value>
        </Parameter>
        <Parameter>
          <Key>Operator</Key>
          <Value>Open</Value>
        </Parameter>
        <Parameter>
          <Key>KernelWidth</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>KernelHeight</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>Iterations</Key>
          <Value>1</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>03 Film Dark Spot Contour</Name>
      <ToolType>Contour</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>FilmSpot_Clean</InputLayer>
      <OutputLayer>FilmSpot_Contour</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Name</Key>
          <Value>Contour_FilmDarkSpot</Value>
        </Parameter>
        <Parameter>
          <Key>PIXELPERMM</Key>
          <Value>0.006</Value>
        </Parameter>
        <Parameter>
          <Key>USE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ADAPTIVE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_BITWISENOT</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ROI</Key>
          <Value>true</Value>
        </Parameter>
        <Parameter>
          <Key>USE_MULTI_ROI</Key>
          <Value>true</Value>
        </Parameter>
        <Parameter>
          <Key>CvROIS</Key>
          <Value>470,300,58,52;655,238,58,58</Value>
        </Parameter>
        <Parameter>
          <Key>USE_DRAW_IMAGE</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>ApproximationModes</Key>
          <Value>ApproxSimple</Value>
        </Parameter>
        <Parameter>
          <Key>DetectMode</Key>
          <Value>External</Value>
        </Parameter>
        <Parameter>
          <Key>MIN_AREA</Key>
          <Value>5</Value>
        </Parameter>
        <Parameter>
          <Key>MAX_AREA</Key>
          <Value>700</Value>
        </Parameter>
        <Parameter>
          <Key>ClrGridHtml</Key>
          <Value>#00ff00</Value>
        </Parameter>
        <Parameter>
          <Key>DrawThickness</Key>
          <Value>2</Value>
        </Parameter>
      </Parameters>
      <UseAcceptance>true</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <MaxElapsedMilliseconds>1000</MaxElapsedMilliseconds>
      <AcceptanceMetricName>AreaMax</AcceptanceMetricName>
      <UseAcceptanceMetricMinimum>true</UseAcceptanceMetricMinimum>
      <AcceptanceMetricMinimum>0</AcceptanceMetricMinimum>
      <UseAcceptanceMetricMaximum>true</UseAcceptanceMetricMaximum>
      <AcceptanceMetricMaximum>20</AcceptanceMetricMaximum>
    </Step>
  </Steps>
</VisionPipeline>
