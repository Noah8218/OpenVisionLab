<?xml version="1.0" encoding="utf-8"?>
<VisionPipeline>
  <Name>Pins_Edge_LineGauge</Name>
  <Steps>
    <Step>
      <Name>01 Smooth Pins</Name>
      <ToolType>Filter</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Main</InputLayer>
      <OutputLayer>Pins_Filtered</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>FilterType</Key>
          <Value>GaussianBlur</Value>
        </Parameter>
        <Parameter>
          <Key>KernelWidth</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>KernelHeight</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>BorderType</Key>
          <Value>Default</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>02 Pin Rail Edge</Name>
      <ToolType>EdgeDetection</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Pins_Filtered</InputLayer>
      <OutputLayer>Pins_Edge</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>EdgeType</Key>
          <Value>Canny</Value>
        </Parameter>
        <Parameter>
          <Key>CannyThresholdLow</Key>
          <Value>45</Value>
        </Parameter>
        <Parameter>
          <Key>CannyThresholdHigh</Key>
          <Value>120</Value>
        </Parameter>
        <Parameter>
          <Key>CannyApertureSize</Key>
          <Value>3</Value>
        </Parameter>
        <Parameter>
          <Key>UseL2Gradient</Key>
          <Value>true</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>03 Rail Line Gauge</Name>
      <ToolType>LineGauge</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Pins_Edge</InputLayer>
      <OutputLayer>Pins_LineGauge</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Name</Key>
          <Value>LineGauge</Value>
        </Parameter>
        <Parameter>
          <Key>PIXELPERMM</Key>
          <Value>0.006</Value>
        </Parameter>
        <Parameter>
          <Key>PRJ_DIR</Key>
          <Value>Y_TTOB</Value>
        </Parameter>
        <Parameter>
          <Key>PRJ_PORALITY</Key>
          <Value>BTOW</Value>
        </Parameter>
        <Parameter>
          <Key>CONTRAST</Key>
          <Value>30</Value>
        </Parameter>
        <Parameter>
          <Key>THICKNESS</Key>
          <Value>1</Value>
        </Parameter>
        <Parameter>
          <Key>SAMPLING_STEP</Key>
          <Value>16</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ROI</Key>
          <Value>true</Value>
        </Parameter>
        <Parameter>
          <Key>CvROI</Key>
          <Value>0,250,768,140</Value>
        </Parameter>
        <Parameter>
          <Key>SHOW_EDGE</Key>
          <Value>true</Value>
        </Parameter>
        <Parameter>
          <Key>SHOW_FITLINE</Key>
          <Value>true</Value>
        </Parameter>
      </Parameters>
      <UseAcceptance>true</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <AcceptanceMetricName>LineAngleAvg</AcceptanceMetricName>
      <UseAcceptanceMetricMinimum>true</UseAcceptanceMetricMinimum>
      <AcceptanceMetricMinimum>-2</AcceptanceMetricMinimum>
      <UseAcceptanceMetricMaximum>true</UseAcceptanceMetricMaximum>
      <AcceptanceMetricMaximum>2</AcceptanceMetricMaximum>
      <MaxElapsedMilliseconds>300</MaxElapsedMilliseconds>
    </Step>
  </Steps>
</VisionPipeline>
