<?xml version="1.0" encoding="utf-8"?>
<VisionPipeline>
  <Name>Feature_Template_Review</Name>
  <Steps>
    <Step>
      <Name>01 Feature Template Review</Name>
      <ToolType>FeatureMatching</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Main</InputLayer>
      <OutputLayer>Feature_Result</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Name</Key>
          <Value>Feature_Template</Value>
        </Parameter>
        <Parameter>
          <Key>TemplatePath</Key>
          <Value>docs\samples\templates\Feature_OVL_Template.png</Value>
        </Parameter>
        <Parameter>
          <Key>PATTERN_PATH</Key>
          <Value>docs\samples\templates\Feature_OVL_Template.png</Value>
        </Parameter>
        <Parameter>
          <Key>SCORE_MIN</Key>
          <Value>0.95</Value>
        </Parameter>
        <Parameter>
          <Key>RANSAC_REPROJ_THRESHOLD</Key>
          <Value>5</Value>
        </Parameter>
        <Parameter>
          <Key>USE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ADAPTIVE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ROI</Key>
          <Value>false</Value>
        </Parameter>
      </Parameters>
      <UseAcceptance>true</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <MaxElapsedMilliseconds>3000</MaxElapsedMilliseconds>
      <AcceptanceMetricName>ScoreMax</AcceptanceMetricName>
      <UseAcceptanceMetricMinimum>true</UseAcceptanceMetricMinimum>
      <AcceptanceMetricMinimum>90</AcceptanceMetricMinimum>
      <UseAcceptanceMetricMaximum>true</UseAcceptanceMetricMaximum>
      <AcceptanceMetricMaximum>100</AcceptanceMetricMaximum>
    </Step>
  </Steps>
</VisionPipeline>
