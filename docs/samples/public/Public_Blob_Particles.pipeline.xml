        </Parameter>
        <Parameter>
          <Key>USE_BITWISENOT</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ROI</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_MULTI_ROI</Key>
          <Value>false</Value>
