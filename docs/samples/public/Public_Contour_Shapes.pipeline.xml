      <Name>01 Synthetic Shape Binary</Name>
      <ToolType>Threshold</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Main</InputLayer>
      <OutputLayer>Contour_Binary</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Mode</Key>
          <Value>Threshold</Value>
        </Parameter>
        <Parameter>
          <Key>Threshold</Key>
          <Value>150</Value>
        </Parameter>
        <Parameter>
          <Key>MaxValue</Key>
          <Value>255</Value>
        </Parameter>
        <Parameter>
          <Key>ThresholdType</Key>
          <Value>Binary</Value>
        </Parameter>
      </Parameters>
    </Step>
    <Step>
      <Name>02 Synthetic Shape Count</Name>
      <ToolType>Contour</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Contour_Binary</InputLayer>
      <OutputLayer>Contour_Preview</OutputLayer>
      <Parameters>
        <Parameter>
          <Key>Name</Key>
          <Value>Public_Contour_Shapes</Value>
        </Parameter>
        <Parameter>
          <Key>PIXELPERMM</Key>
          <Value>0.006</Value>
        </Parameter>
        <Parameter>
          <Key>USE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ADAPTIVE_THRESHOLD</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_BITWISENOT</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_ROI</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_MULTI_ROI</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>USE_DRAW_IMAGE</Key>
          <Value>false</Value>
        </Parameter>
        <Parameter>
          <Key>ApproximationModes</Key>
          <Value>ApproxSimple</Value>
        </Parameter>
        <Parameter>
          <Key>DetectMode</Key>
          <Value>External</Value>
        </Parameter>
        <Parameter>
          <Key>MIN_AREA</Key>
          <Value>700</Value>
        </Parameter>
        <Parameter>
          <Key>MAX_AREA</Key>
          <Value>9000</Value>
