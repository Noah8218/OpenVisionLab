<?xml version="1.0" encoding="utf-8"?>
<VisionPipeline>
  <Name>Public_Matching_NormalizeImage_RelativeRoi</Name>
  <Steps>
    <Step>
      <Name>01 Locate And Publish Reference Pose</Name>
      <ToolType>Matching</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Main</InputLayer>
      <OutputLayer>FixtureMatch</OutputLayer>
      <Parameters>
        <Parameter><Key>Name</Key><Value>Public_Fixture_Locator</Value></Parameter>
        <Parameter><Key>TemplatePath</Key><Value>docs\samples\public\templates\Fixture_Locator_Synthetic_Template.png</Value></Parameter>
        <Parameter><Key>PATTERN_PATH</Key><Value>docs\samples\public\templates\Fixture_Locator_Synthetic_Template.png</Value></Parameter>
        <Parameter><Key>MATCH_MODE</Key><Value>CCoeffNormed</Value></Parameter>
        <Parameter><Key>SCORE_MIN</Key><Value>0.80</Value></Parameter>
        <Parameter><Key>MAGNIFIATION</Key><Value>1</Value></Parameter>
        <Parameter><Key>NUM_MATCH</Key><Value>1</Value></Parameter>
        <Parameter><Key>USE_FIND_ANGLE</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_FIND_SCALE</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_THRESHOLD</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_ADAPTIVE_THRESHOLD</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_ROI</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_AS_FIXTURE_FRAME</Key><Value>true</Value></Parameter>
        <Parameter><Key>FIXTURE_FRAME_NAME</Key><Value>PartFrame</Value></Parameter>
        <Parameter><Key>FIXTURE_REFERENCE_X</Key><Value>120</Value></Parameter>
        <Parameter><Key>FIXTURE_REFERENCE_Y</Key><Value>100</Value></Parameter>
        <Parameter><Key>FIXTURE_REFERENCE_ANGLE</Key><Value>0</Value></Parameter>
        <Parameter><Key>FIXTURE_REFERENCE_SCALE</Key><Value>1</Value></Parameter>
        <Parameter><Key>FIXTURE_MAX_ANGLE_DELTA</Key><Value>1</Value></Parameter>
        <Parameter><Key>FIXTURE_REFERENCE_IMAGE_WIDTH</Key><Value>572</Value></Parameter>
        <Parameter><Key>FIXTURE_REFERENCE_IMAGE_HEIGHT</Key><Value>420</Value></Parameter>
      </Parameters>
      <UseAcceptance>true</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <MaxElapsedMilliseconds>2000</MaxElapsedMilliseconds>
      <AcceptanceMetricName>ResultCount</AcceptanceMetricName>
      <UseAcceptanceMetricMinimum>true</UseAcceptanceMetricMinimum>
      <AcceptanceMetricMinimum>1</AcceptanceMetricMinimum>
      <UseAcceptanceMetricMaximum>true</UseAcceptanceMetricMaximum>
      <AcceptanceMetricMaximum>1</AcceptanceMetricMaximum>
    </Step>
    <Step>
      <Name>02 Normalize To Reference Coordinates</Name>
      <ToolType>RotateScale</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>Main</InputLayer>
      <OutputLayer>DeviceAligned</OutputLayer>
      <Parameters>
        <Parameter><Key>Name</Key><Value>Public_Fixture_NormalizeImage</Value></Parameter>
        <Parameter><Key>Angle</Key><Value>0</Value></Parameter>
        <Parameter><Key>ScaleXPercent</Key><Value>100</Value></Parameter>
        <Parameter><Key>ScaleYPercent</Key><Value>100</Value></Parameter>
        <Parameter><Key>Interpolation</Key><Value>Linear</Value></Parameter>
        <Parameter><Key>BorderType</Key><Value>Constant</Value></Parameter>
        <Parameter><Key>ALLOW_BRANCH_INPUT</Key><Value>true</Value></Parameter>
        <Parameter><Key>USE_FIXTURE_FRAME</Key><Value>true</Value></Parameter>
        <Parameter><Key>FIXTURE_FRAME_NAME</Key><Value>PartFrame</Value></Parameter>
        <Parameter><Key>FIXTURE_APPLY_MODE</Key><Value>NormalizeImage</Value></Parameter>
        <Parameter><Key>FIXTURE_MIN_VALID_PIXEL_RATIO</Key><Value>0.25</Value></Parameter>
      </Parameters>
      <UseAcceptance>false</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <MaxElapsedMilliseconds>1000</MaxElapsedMilliseconds>
    </Step>
    <Step>
      <Name>03 Threshold Reference Image</Name>
      <ToolType>Threshold</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>DeviceAligned</InputLayer>
      <OutputLayer>AlignedPadBinary</OutputLayer>
      <Parameters>
        <Parameter><Key>Mode</Key><Value>Threshold</Value></Parameter>
        <Parameter><Key>Threshold</Key><Value>170</Value></Parameter>
        <Parameter><Key>MaxValue</Key><Value>255</Value></Parameter>
        <Parameter><Key>ThresholdType</Key><Value>Binary</Value></Parameter>
      </Parameters>
      <UseAcceptance>false</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <MaxElapsedMilliseconds>1000</MaxElapsedMilliseconds>
    </Step>
    <Step>
      <Name>04 Inspect Pad In Reference ROI</Name>
      <ToolType>Blob</ToolType>
      <Enabled>true</Enabled>
      <InputLayer>AlignedPadBinary</InputLayer>
      <OutputLayer>AlignedPadBlob</OutputLayer>
      <Parameters>
        <Parameter><Key>Name</Key><Value>Public_Aligned_Fixture_Pad</Value></Parameter>
        <Parameter><Key>MIN_AREA</Key><Value>700</Value></Parameter>
        <Parameter><Key>MAX_AREA</Key><Value>1300</Value></Parameter>
        <Parameter><Key>USE_THRESHOLD</Key><Value>false</Value></Parameter>
        <Parameter><Key>THRESHOLD_TYPES</Key><Value>Binary</Value></Parameter>
        <Parameter><Key>THRESHOLD</Key><Value>170</Value></Parameter>
        <Parameter><Key>USE_ADAPTIVE_THRESHOLD</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_BITWISENOT</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_ROI</Key><Value>true</Value></Parameter>
        <Parameter><Key>USE_MULTI_ROI</Key><Value>false</Value></Parameter>
        <Parameter><Key>USE_MASKING</Key><Value>false</Value></Parameter>
        <Parameter><Key>CvROI</Key><Value>320,180,60,50</Value></Parameter>
      </Parameters>
      <UseAcceptance>true</UseAcceptance>
      <ExpectedSuccess>true</ExpectedSuccess>
      <MaxElapsedMilliseconds>1000</MaxElapsedMilliseconds>
      <AcceptanceMetricName>ResultCount</AcceptanceMetricName>
      <UseAcceptanceMetricMinimum>true</UseAcceptanceMetricMinimum>
      <AcceptanceMetricMinimum>1</AcceptanceMetricMinimum>
      <UseAcceptanceMetricMaximum>true</UseAcceptanceMetricMaximum>
      <AcceptanceMetricMaximum>1</AcceptanceMetricMaximum>
    </Step>
  </Steps>
</VisionPipeline>
