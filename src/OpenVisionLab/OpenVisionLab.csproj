<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Version>2.2.0-dev</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationIcon>lens.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <OpenVisionLabOutputRoot>$(OpenVisionLabRepoRoot)bin\</OpenVisionLabOutputRoot>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' and ('$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU') ">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>$(OpenVisionLabOutputRoot)Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' and ('$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU') ">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>$(OpenVisionLabOutputRoot)Release\</OutputPath>
    <DefineConstants>TRACE;RELEASE;OPENCV</DefineConstants>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>$(OpenVisionLabOutputRoot)x86\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>$(OpenVisionLabOutputRoot)x86\Release\</OutputPath>
    <DefineConstants>TRACE;RELEASE;OPENCV</DefineConstants>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>$(OpenVisionLabOutputRoot)x64\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>$(OpenVisionLabOutputRoot)x64\Release\</OutputPath>
    <DefineConstants>TRACE;RELEASE;OPENCV</DefineConstants>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Side_2' and ('$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU')">
    <OutputPath>$(OpenVisionLabOutputRoot)Side_2\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Side_2|x86'">
    <OutputPath>$(OpenVisionLabOutputRoot)x86\Side_2\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Side_2|x64'">
    <OutputPath>$(OpenVisionLabOutputRoot)x64\Side_2\</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <OpenVisionLabEnableEmbeddedSmokeRunner Condition="'$(OpenVisionLabEnableEmbeddedSmokeRunner)' == ''">false</OpenVisionLabEnableEmbeddedSmokeRunner>
    <OpenVisionIntegrationApplicationId>OpenVisionLab.2DStudio</OpenVisionIntegrationApplicationId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OpenVisionLabEnableEmbeddedSmokeRunner)' == 'true' ">
    <DefineConstants>$(DefineConstants);OPENVISIONLAB_EMBEDDED_SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FontAwesome.Sharp">
      <HintPath>$(OpenVisionLabDllRoot)FontAwesome.Sharp.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Controls.WpfPropertyGrid">
      <HintPath>$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll</HintPath>
      <Private>True</Private>
      <Aliases>WpfPropertyGridOriginal</Aliases>
    </Reference>
    <Reference Include="OpenVisionLab.Core">
      <HintPath>$(OpenVisionLabVisionSdkDllRoot)OpenVisionLab.Core.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenVisionLab.Vision2D">
      <HintPath>$(OpenVisionLabVisionSdkDllRoot)OpenVisionLab.Vision2D.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenVisionLab.Vision2D.Blob">
      <HintPath>$(OpenVisionLabVisionSdkDllRoot)OpenVisionLab.Vision2D.Blob.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenCvSharp">
      <HintPath>$(OpenVisionLabVisionSdkDllRoot)OpenCvSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenCvSharp.Blob">
      <HintPath>$(OpenVisionLabVisionSdkDllRoot)OpenCvSharp.Blob.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.27" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
    <PackageReference Include="OpenVisionLab.Integration.Contracts" Version="[0.2.0-alpha.2]" />
    <PackageReference Include="OpenVisionLab.Integration.Transport.Tcp" Version="[0.1.0-alpha.2]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Libraries\PropertyGrid.Abstractions\PropertyGrid.Abstractions.csproj" />
    <ProjectReference Include="..\Libraries\WpfPropertyGridBridge\WpfPropertyGridBridge.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.Display.Core\OpenVisionLab.Display.Core.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.ImageCanvas\OpenVisionLab.ImageCanvas.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.ImageSpace.Core\OpenVisionLab.ImageSpace.Core.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.Logging\OpenVisionLab.Logging.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.Logging.Controls\OpenVisionLab.Logging.Controls.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.Pipeline.Controls\OpenVisionLab.Pipeline.Controls.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.Localization\OpenVisionLab.Localization.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.History\OpenVisionLab.History.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.Mvvm\OpenVisionLab.Mvvm.csproj" />
    <ProjectReference Include="..\Libraries\OpenVisionLab.Docking.Controls\OpenVisionLab.Docking.Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(OpenVisionLabRepoRoot)tools\OpenVisionLab.DirectSmokeRunner\OpenVisionLabDirectSmokeRunner.cs"
             Link="OpenVisionLabDirectSmokeRunner.cs"
             Condition=" '$(OpenVisionLabEnableEmbeddedSmokeRunner)' == 'true' " />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(OpenVisionLabVisionSdkDllRoot)OpenCvSharp.dll">
      <Link>OpenCvSharp.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenVisionLabVisionSdkDllRoot)OpenCvSharp.Blob.dll">
      <Link>OpenCvSharp.Blob.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenVisionLabOpenCvSharpDllRoot)OpenCvSharpExtern.dll">
      <Link>OpenCvSharpExtern.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenVisionLabRepoRoot)docs\manual\generated\OpenVisionLab_User_Manual.ko.html">
      <Link>Guide\OpenVisionLab_User_Manual.ko.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(OpenVisionLabRepoRoot)docs\manual\generated\OpenVisionLab_User_Manual.en.html">
      <Link>Guide\OpenVisionLab_User_Manual.en.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(OpenVisionLabRepoRoot)docs\manual\generated\guide-manifest.json">
      <Link>Guide\guide-manifest.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="lens.ico" />
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <Target Name="ValidateVendoredVisionSdkReferences" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <RequiredVisionSdkRuntime Include="$(OpenVisionLabVisionSdkDllRoot)OpenVisionLab.Core.dll" />
      <RequiredVisionSdkRuntime Include="$(OpenVisionLabVisionSdkDllRoot)OpenVisionLab.Vision2D.dll" />
      <RequiredVisionSdkRuntime Include="$(OpenVisionLabVisionSdkDllRoot)OpenVisionLab.Vision2D.Blob.dll" />
      <RequiredVisionSdkRuntime Include="$(OpenVisionLabVisionSdkDllRoot)OpenCvSharp.dll" />
      <RequiredVisionSdkRuntime Include="$(OpenVisionLabVisionSdkDllRoot)OpenCvSharp.Blob.dll" />
      <RequiredOpenCvSharpRuntime Include="$(OpenVisionLabOpenCvSharpDllRoot)OpenCvSharpExtern.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredVisionSdkRuntime.Identity)')" Text="Missing vendored OpenVisionLab Vision SDK runtime: %(RequiredVisionSdkRuntime.Identity). Restore dll\OpenVisionLab-Vision-SDK from the repository or refresh the SDK DLLs." />
    <Error Condition="!Exists('%(RequiredOpenCvSharpRuntime.Identity)')" Text="Missing shared OpenCVSharp native runtime: %(RequiredOpenCvSharpRuntime.Identity). Restore dll\OpenCVSharp\OpenCvSharpExtern.dll from the repository." />
  </Target>
  <Target Name="ValidateGeneratedUserManual" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(OpenVisionLabRepoRoot)docs\manual\generated\OpenVisionLab_User_Manual.ko.html')" Text="Generated Korean user manual is missing. Run tools\OpenVisionUserManualBuilder before building OpenVisionLab." />
    <Error Condition="!Exists('$(OpenVisionLabRepoRoot)docs\manual\generated\OpenVisionLab_User_Manual.en.html')" Text="Generated English user manual is missing. Run tools\OpenVisionUserManualBuilder before building OpenVisionLab." />
    <Error Condition="!Exists('$(OpenVisionLabRepoRoot)docs\manual\generated\guide-manifest.json')" Text="Generated user manual manifest is missing. Run tools\OpenVisionUserManualBuilder before building OpenVisionLab." />
  </Target>

  <Target Name="ValidateWpgPropertyGridReference" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll')">
    <Error Text="Missing WPG runtime: $(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll. Restore the prepared WPG DLL from the repository." />
  </Target>

  <Target Name="CopyWpgPropertyGridToRuntimeOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="Exists('$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll')">
    <ItemGroup>
      <WpgRuntimeArtifacts Include="$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll" />
      <WpgRuntimeArtifacts Include="$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.xml" Condition="Exists('$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.xml')" />
    </ItemGroup>

    <Copy SourceFiles="@(WpgRuntimeArtifacts)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ResolveOpenVisionIntegrationRuntimeBuildIdentity"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\..&quot; rev-parse --verify HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_OpenVisionSourceCommitOutput" />
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\..&quot; status --porcelain=v1 --untracked-files=normal --ignore-submodules=none"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_OpenVisionSourceStatusOutput" />
    </Exec>

    <PropertyGroup>
      <_OpenVisionSourceCommit>@(_OpenVisionSourceCommitOutput-&gt;'%(Identity)','')</_OpenVisionSourceCommit>
      <_OpenVisionSourceState Condition="'@(_OpenVisionSourceStatusOutput)' == ''">clean</_OpenVisionSourceState>
      <_OpenVisionSourceState Condition="'@(_OpenVisionSourceStatusOutput)' != ''">dirty</_OpenVisionSourceState>
    </PropertyGroup>
    <Error Condition="$([System.String]::Copy('$(_OpenVisionSourceCommit)').Length) != 40"
           Text="OpenVisionLab integration build identity requires a 40-character Git source commit." />

    <ItemGroup>
      <AssemblyMetadata Remove="OpenVisionIntegrationApplicationId;OpenVisionApplicationVersion;OpenVisionSourceCommit;OpenVisionSourceState" />
      <AssemblyMetadata Include="OpenVisionIntegrationApplicationId" Value="$(OpenVisionIntegrationApplicationId)" />
      <AssemblyMetadata Include="OpenVisionApplicationVersion" Value="$(Version)" />
      <AssemblyMetadata Include="OpenVisionSourceCommit" Value="$(_OpenVisionSourceCommit)" />
      <AssemblyMetadata Include="OpenVisionSourceState" Value="$(_OpenVisionSourceState)" />
    </ItemGroup>
  </Target>

  <Target Name="WriteOpenVisionIntegrationRuntimeBuildManifest"
          AfterTargets="Build"
          DependsOnTargets="ResolveOpenVisionIntegrationRuntimeBuildIdentity"
          Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(TargetPath)')">
    <ItemGroup>
      <_OpenVisionRuntimeEntryAssembly Include="$(TargetPath)" />
    </ItemGroup>
    <GetFileHash Files="@(_OpenVisionRuntimeEntryAssembly)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_OpenVisionRuntimeEntryAssemblyWithHash" />
    </GetFileHash>
    <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;(Get-Item -LiteralPath &apos;$(TargetPath)&apos;).Length&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_OpenVisionRuntimeEntryAssemblyLengthOutput" />
    </Exec>

    <PropertyGroup>
      <_OpenVisionRuntimeEntryAssemblyHash>@(_OpenVisionRuntimeEntryAssemblyWithHash-&gt;'%(FileHash)','')</_OpenVisionRuntimeEntryAssemblyHash>
      <_OpenVisionRuntimeEntryAssemblyLength>@(_OpenVisionRuntimeEntryAssemblyLengthOutput-&gt;'%(Identity)','')</_OpenVisionRuntimeEntryAssemblyLength>
      <_OpenVisionRuntimeManifestPath>$(TargetDir)openvisionlab.runtime.json</_OpenVisionRuntimeManifestPath>
      <_OpenVisionRuntimeManifestJson>{&quot;schemaVersion&quot;:&quot;1.0&quot;,&quot;identity&quot;:{&quot;applicationId&quot;:&quot;$(OpenVisionIntegrationApplicationId)&quot;,&quot;applicationVersion&quot;:&quot;$(Version)&quot;,&quot;sourceCommit&quot;:&quot;$(_OpenVisionSourceCommit)&quot;,&quot;sourceState&quot;:&quot;$(_OpenVisionSourceState)&quot;},&quot;entryAssembly&quot;:{&quot;relativePath&quot;:&quot;$(TargetFileName)&quot;,&quot;byteLength&quot;:$(_OpenVisionRuntimeEntryAssemblyLength),&quot;sha256&quot;:&quot;$(_OpenVisionRuntimeEntryAssemblyHash)&quot;}}</_OpenVisionRuntimeManifestJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(_OpenVisionRuntimeManifestPath)"
                      Lines="$(_OpenVisionRuntimeManifestJson)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="ASCII" />
    <ItemGroup>
      <FileWrites Include="$(_OpenVisionRuntimeManifestPath)" />
    </ItemGroup>
  </Target>

  <Target Name="CopyOpenVisionIntegrationRuntimeBuildManifestToPublish"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != '' and Exists('$(TargetDir)openvisionlab.runtime.json')">
    <Copy SourceFiles="$(TargetDir)openvisionlab.runtime.json"
          DestinationFiles="$(PublishDir)openvisionlab.runtime.json"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
