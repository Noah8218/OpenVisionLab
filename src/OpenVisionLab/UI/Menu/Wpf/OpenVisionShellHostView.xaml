                </DataTemplate.Triggers>
            </DataTemplate>
            <ControlTemplate x:Key="ShellHost.MainRecipeSelectorTemplate" TargetType="ComboBox">
                <Grid Height="{TemplateBinding Height}">
                    <Border x:Name="comboFocusGlow" Margin="-2" BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}" BorderThickness="2" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="comboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                    <Grid Margin="8,0,22,0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline" Width="20" Height="20" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
