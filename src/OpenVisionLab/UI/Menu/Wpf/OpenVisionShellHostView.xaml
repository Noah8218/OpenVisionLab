<UserControl x:Class="OpenVisionLab.OpenVisionShellHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:docking="clr-namespace:OpenVisionLab.Docking.Controls;assembly=OpenVisionLab.Docking.Controls"
             xmlns:imageCanvasViews="clr-namespace:OpenVisionLab.ImageCanvas.Views;assembly=OpenVisionLab.ImageCanvas"
             xmlns:logView="clr-namespace:OpenVisionLab.Logging.Controls.View;assembly=OpenVisionLab.Logging.Controls"
             xmlns:mvvmBehaviors="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             xmlns:local="clr-namespace:OpenVisionLab"
             xmlns:webView2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             local:OpenVisionWorkbenchThemeBehavior.ThemeName="{Binding Workbench.ThemeName, RelativeSource={RelativeSource Self}}"
             Background="{DynamicResource OpenVision.Workbench.BackgroundBrush}"
             FontFamily="{DynamicResource OpenVision.Workbench.FontFamily}"
             FontSize="13"
             mvvmBehaviors:InputCommandBehaviors.PreviewPageNavigation="True"
             mvvmBehaviors:InputCommandBehaviors.SizeChangedCommand="{Binding Workbench.UpdateViewportCommand, RelativeSource={RelativeSource Self}}"
             mvvmBehaviors:InputCommandBehaviors.LoadedCommand="{Binding SessionCommands.LoadedCommand, RelativeSource={RelativeSource Self}}"
             mvvmBehaviors:InputCommandBehaviors.UnloadedCommand="{Binding SessionCommands.UnloadedCommand, RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ToolTip" BasedOn="{StaticResource OpenVision.Workbench.ToolTipStyle}"/>

            <BooleanToVisibilityConverter x:Key="ShellHost.BooleanToVisibilityConverter" />

      <Style x:Key="ShellHost.MainScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"/>
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}"/>
        <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton x:Name="decrease" Style="{x:Null}" Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{x:Null}" Background="{TemplateBinding Foreground}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="scrollThumb" Background="{TemplateBinding Background}" Margin="2" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="scrollThumb" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="scrollThumb" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton x:Name="increase" Style="{x:Null}" Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <ControlTemplate x:Key="ShellHost.MainImagesScrollViewerTemplate" TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="10" Style="{StaticResource ShellHost.MainScrollBarStyle}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
          <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Height="10" Style="{StaticResource ShellHost.MainScrollBarStyle}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"/>
        </Grid>
      </ControlTemplate>
            <Style x:Key="ShellHost.MainImageResultBadgeStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}"/><Setter Property="Padding" Value="5,1"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultKind}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.OkSoftBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding ResultKind}" Value="Ng"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.NgSoftBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding ResultKind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.ErrorSoftBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding ResultKind}" Value="Done"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.DoneBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.DoneSoftBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding ResultKind}" Value="Previous"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.StaleSoftBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ShellHost.MainResultCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Border x:Name="focus" BorderBrush="Transparent" BorderThickness="1" Padding="2">
                        <DockPanel>
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" Margin="0,0,6,0" VerticalAlignment="Top">
                                <Path x:Name="check" Data="M 2,7 L 5,10 L 11,3" Stroke="{DynamicResource OpenVision.Workbench.AccentTextBrush}" StrokeThickness="2" Width="12" Height="12" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="box" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <Style x:Key="ShellHost.MainResultCellStyle" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShellHost.MainResultHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="ShellHost.MainResultRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShellHost.MainResultGridStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="BorderThickness" Value="0"/><Setter Property="MinRowHeight" Value="26"/><Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}"/>
                <Setter Property="CellStyle" Value="{StaticResource ShellHost.MainResultCellStyle}"/><Setter Property="ColumnHeaderStyle" Value="{StaticResource ShellHost.MainResultHeaderStyle}"/><Setter Property="RowStyle" Value="{StaticResource ShellHost.MainResultRowStyle}"/>
            </Style>
            <Style x:Key="ShellHost.MainResultTextStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ShellHost.MainResultChipStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="20"/><Setter Property="Padding" Value="7,0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineAltBrush}"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter Property="TextElement.FontSize" Value="11"/><Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Ok"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.OkSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Ng"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.NgSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.ErrorSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Done"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.DoneBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.DoneSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Previous"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.StaleBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.StaleSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Skipped"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.SkipBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.SkipSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Disabled"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.SkipBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.SkipSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Cancelled"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.SkipBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.SkipSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="BorderThickness" Value="0"/></DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ShellHost.MainRecipeSaveStatusTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Workbench.RecipeSaveState, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Unsaved"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Workbench.RecipeSaveState, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShellHost.MainRecipeSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
                <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Workbench.IsRecipeDirty, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="True"/><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></MultiDataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="ShellHost.MainFitButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
                <Setter Property="Padding" Value="8,0"/><Style.Triggers><DataTrigger Binding="{Binding Workbench.ShowViewerFitCaption, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="False"><Setter Property="Padding" Value="4,0"/></DataTrigger></Style.Triggers>
            </Style>

            <Style x:Key="ShellHost.MainImageLabelChipStyle" TargetType="Border" BasedOn="{StaticResource ShellHost.MainResultChipStyle}">
                <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Label}" Value="good"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Label}" Value="bad"><Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/></DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="ShellHost.MainPipelineDraftTemplate">
                <Grid Margin="0,4,0,0" MinHeight="52" IsHitTestVisible="False" AutomationProperties.AutomationId="WorkbenchMainDraftRow">
                    <Rectangle Stroke="{DynamicResource OpenVision.Workbench.AccentBrush}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="4" RadiusY="4">
                        <Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,9,9" ViewportUnits="Absolute"><DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M0,9 L9,0"><GeometryDrawing.Pen><Pen Brush="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing>
                        </DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill>
                    </Rectangle>
                    <Grid Margin="6,7,8,7"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="＋" FontSize="11" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}" VerticalAlignment="Center"><iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="mainDraftTitle" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"/>
                            <TextBlock x:Name="mainDraftRoute" Text="{Binding MainDraftRouteText}" ToolTip="{Binding MainDraftRouteText}" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/>
                        </StackPanel>
                        <Border x:Name="mainDraftStatus" Grid.Column="3" Style="{StaticResource ShellHost.MainResultChipStyle}" Tag="{Binding ResultKind}" HorizontalAlignment="Right"><TextBlock Text="{Binding ResultStatusText}" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Grid>
            </DataTemplate>

            <Style x:Key="ShellHost.MainRunProgressStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/>
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.LineAltBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                    </Grid>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="ShellHost.RecipeSwitchProgressStyle" TargetType="{x:Type ProgressBar}">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineAltBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True">
                                <Rectangle Fill="{TemplateBinding Foreground}"
                                           RadiusX="1"
                                           RadiusY="1">
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.32"
                                                                     To="1"
                                                                     Duration="0:0:0.45" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ShellHost.MainLogCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource ShellHost.MainResultCheckBoxStyle}">
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ShellHost.MainLogSearchStyle" TargetType="TextBox" BasedOn="{StaticResource OpenVision.ControlTextBoxStyle}">
                <Setter Property="Height" Value="25" /><Setter Property="MinHeight" Value="25" /><Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
            </Style>
            <Style x:Key="ShellHost.DarkTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource OpenVision.ControlTextBoxDarkStyle}">
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CaretBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter Property="SelectionOpacity" Value="0.85" />
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>
            <Style x:Key="ShellHost.PinGapIntentVisibilityStyle" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RecipeCommands.SelectedLlmToolTemplate}" Value="Pin gap / edge distance (LineDistance)">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShellHost.PinArrayGapIntentVisibilityStyle" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RecipeCommands.SelectedLlmToolTemplate}" Value="Pin row edge-gap consistency (PinArrayGap)">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShellHost.DarkBandGapIntentVisibilityStyle" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RecipeCommands.SelectedLlmToolTemplate}" Value="Dark band thickness / Gap (LineDistance)">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShellHost.HybridRelativeRoiIntentVisibilityStyle" TargetType="{x:Type FrameworkElement}">
                <Setter Property="Visibility" Value="Collapsed" />
