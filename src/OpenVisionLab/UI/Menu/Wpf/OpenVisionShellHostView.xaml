                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding SelectedLayerDetailText}" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" FontWeight="SemiBold" />
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                BorderThickness="1"
                                Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource OpenVision.Workbench.CanvasBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1">
