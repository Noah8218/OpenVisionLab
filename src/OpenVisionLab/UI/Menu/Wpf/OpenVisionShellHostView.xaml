                        <TextBlock x:Name="legacyTxtHostSelectedRoute"
                                   Text="{Binding SelectedRouteText}"
                                   Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="legacyTxtHostDirectStatus"
                                   Text="{Binding DirectStatusNoToolText}"
                                   Foreground="{DynamicResource OpenVision.Workbench.OkBrush}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="10,4,10,6" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding LayersResultsText}" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" FontWeight="SemiBold" />
                        <ScrollViewer x:Name="legacyHostLayerRowsScrollViewer"
                                      Grid.Row="1"
                                      Margin="0,8,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ListBox x:Name="legacyHostLayerRowsList"
                                     Tag="{Binding LayerCommands, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                     ItemContainerStyle="{StaticResource HostLayerListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     mvvmBehaviors:InputCommandBehaviors.SelectItemOnRightClick="True"
                                     mvvmBehaviors:InputCommandBehaviors.SelectionChangedCommand="{Binding LayerCommands.HandleSelectedLayerChangedCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                     mvvmBehaviors:InputCommandBehaviors.MouseDoubleClickCommand="{Binding LayerCommands.OpenSelectedLayerWindowCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <ListBox.ContextMenu>
                                    <StaticResource ResourceKey="LayerRowsContextMenu" />
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="10,4,10,6" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" Padding="10">
