                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Workbench.Tool.Subtitle, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                               FontSize="11.5" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="WorkbenchToolSubtitle"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="5,2" Margin="6,0,0,0" BorderThickness="1" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="WorkbenchToolBadge">
                                        <Border.Style><Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineAltBrush}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Workbench.Tool.BadgeKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Testing">
                                                    <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.AccentOnSoftBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Workbench.Tool.BadgeKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Changed">
                                                    <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.StaleSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.StaleSoftBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OpenVision.Workbench.StaleBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style></Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="{Binding Workbench.Tool.BadgeIcon, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                                                        Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <TextBlock Text="{Binding Workbench.Tool.BadgeText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" FontSize="10" TextTrimming="None" VerticalAlignment="Center"
                                                       Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource TopLayerIconButtonStyle}" Width="32" Height="32" Margin="0"
