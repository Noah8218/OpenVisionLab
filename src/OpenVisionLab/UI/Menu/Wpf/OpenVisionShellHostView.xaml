                        <Setter TargetName="navItemStatus" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="navItemLearnColumn" Property="Width" Value="0" />
                        <Setter TargetName="navItemLearnButton" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="navItemSamplesColumn" Property="Width" Value="0" />
                        <Setter TargetName="navItemSamplesButton" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="navItemGuidedSetupColumn" Property="Width" Value="0" />
                        <Setter TargetName="navItemGuidedSetupButton" Property="Visibility" Value="Collapsed" />
