                    MaxWidth="560"
                    Height="22"
                    Margin="8,0"
                    BorderBrush="{DynamicResource OpenVision.Workbench.StaleBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                    Padding="8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="directResultBadge"
                            Grid.Column="0"
                            Background="{DynamicResource OpenVision.Workbench.StaleBrush}"
                            Padding="8,1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtHostDirectBadge"
                                   Text="{Binding DirectBadgeReadyText}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="10" />
                    </Border>
                    <TextBlock x:Name="txtHostSelectedTool"
                               Grid.Column="2"
                               Text="{Binding SelectedDirectRunText}"
                               Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtHostSelectedRoute"
                                   Text="{Binding SelectedRouteText}"
                                   Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="txtHostDirectStatus"
                                   Grid.Column="1"
                                   Text="{Binding DirectStatusNoToolText}"
                                   Foreground="{DynamicResource OpenVision.Workbench.OkBrush}"
                                   Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border><TextBlock Grid.Column="3" Text="{Binding Workbench.LayoutStatusText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}" FontSize="12" Margin="8,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,1,0" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="WorkbenchStatusInput">
                <iconPacks:PackIconMaterial Kind="ImageOutline" Width="16" Height="16" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                <TextBlock FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                           Visibility="{Binding Workbench.Shell.HasWorkspaceInputImage, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"
                           Margin="0,0,6,0"
                           AutomationProperties.AutomationId="WorkbenchStatusInputPosition">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}/{1} · ">
                            <Binding Path="Workbench.Images.CurrentImage.Index" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=local:OpenVisionShellHostView}" />
                            <Binding Path="Workbench.Images.Count" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=local:OpenVisionShellHostView}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{Binding Workbench.Shell.WorkspaceInputStatusName, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                           ToolTip="{Binding Workbench.Shell.WorkspaceInputName, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                           MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                           AutomationProperties.AutomationId="WorkbenchStatusInputName" />
                <TextBlock Text=" · " Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                           Visibility="{Binding Workbench.Shell.HasWorkspaceInputImage, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding Workbench.Shell.WorkspaceInputSizeText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                           FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                           Visibility="{Binding Workbench.Shell.HasWorkspaceInputImage, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"
                           AutomationProperties.AutomationId="WorkbenchStatusInputSize" />
            </StackPanel>
            </Border>
            <Border Grid.Column="2" MinWidth="170" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,1,0" Padding="10,0">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                       Text="{Binding Workbench.Workspace.PointerText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                       FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                       AutomationProperties.AutomationId="WorkbenchStatusPointer" />
            </Border>
            <Border Grid.Column="3" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,1,0" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkbenchStatusVerdict">
                    <TextBlock Text="{Binding Workbench[Workbench.Verdict.Previous], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                               Visibility="{Binding Workbench.Pipeline.IsVerdictPrevious, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="WorkbenchStatusVerdictPrevious" />
                    <Border Tag="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" AutomationProperties.AutomationId="WorkbenchStatusVerdictChip">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ShellHost.MainResultChipStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Ng">
                                        <Setter Property="Background"><Setter.Value><SolidColorBrush Color="{DynamicResource OpenVision.Workbench.NgSoftBrush.Color}" Opacity="0.5" /></Setter.Value></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Previous">
                                        <Setter Property="Background"><Setter.Value><SolidColorBrush Color="{DynamicResource OpenVision.Workbench.StaleSoftBrush.Color}" Opacity="0.25" /></Setter.Value></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Workbench.Pipeline.HasVerdict, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="False">
                                        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock VerticalAlignment="Center" ToolTip="{Binding Workbench.Pipeline.VerdictDetail, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                   AutomationProperties.AutomationId="WorkbenchStatusVerdictValue">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Workbench.Pipeline.VerdictValue, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                                    <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Workbench.Pipeline.HasVerdict, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="True">
                                            <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictValue, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="—">
                                            <Setter Property="Text" Value="{Binding Workbench[Workbench.Status.NoVerdict], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Ok">
                                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Ng">
                                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Error">
                                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Done">
                                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.DoneBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Workbench.Pipeline.VerdictKind, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="Previous">
                                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SkipBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding Workbench.Pipeline.VerdictElapsedText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                               Visibility="{Binding Workbench.Pipeline.HasVerdict, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="WorkbenchStatusVerdictElapsed" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,1,0" Padding="0">
            <Button MinHeight="0" Padding="10,0" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" FontWeight="Normal"
                    Command="{Binding Workbench.OpenLogCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                    ToolTip="{Binding DataContext.LatestSummaryText, ElementName=shellLogPanel}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.AutomationId="WorkbenchOpenLog"
                    AutomationProperties.Name="{Binding DataContext.ErrorSummaryText, ElementName=shellLogPanel}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="TextBoxOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial.Style>
                            <Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </iconPacks:PackIconMaterial.Style>
                    </iconPacks:PackIconMaterial>
                    <TextBlock Text="{Binding DataContext.ErrorSummaryText, ElementName=shellLogPanel}"
                               FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasErrors, ElementName=shellLogPanel}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
            </Border>
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
            <TextBlock Text="{Binding RecipeCommands.MainRecipeName, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                       ToolTip="{Binding RecipeCommands.MainRecipeName, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                       MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" AutomationProperties.AutomationId="WorkbenchStatusRecipe" />
                <TextBlock Text="{Binding Workbench.SavedRecipeRevision, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, StringFormat=r{0}}"
                           Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" AutomationProperties.AutomationId="WorkbenchStatusRecipeRevision" />
                <TextBlock Text="{Binding Workbench[Workbench.Tool.BadgeChanged], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                           Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="WorkbenchStatusRecipeDirty">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecipeCommands.IsSelectedStepEditDirty, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RecipeCommands.IsWorkbenchPipelineDirty, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
 <TextBlock x:Name="txtToolOpenTimingDiagnostics" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False" AutomationProperties.AutomationId="OpenVisionToolOpenTimingDiagnostics"/>
</Grid>
        </Border>
        <Border x:Name="shellBusyOverlay"
                Grid.RowSpan="4"
                Panel.ZIndex="1000"
                Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ShellBusyOverlay"
                AutomationProperties.LiveSetting="Assertive">
            <Border Width="420"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                    BorderBrush="{DynamicResource OpenVision.Workbench.AccentLineBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <iconPacks:PackIconMaterial Kind="ProgressClock"
                                                Width="28"
                                                Height="28"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                    <TextBlock x:Name="txtShellBusyTitle"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock x:Name="txtShellBusyDetail"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <ProgressBar Style="{StaticResource ShellHost.RecipeSwitchProgressStyle}"
                                 Height="5"
                                 Margin="0,18,0,0"
                                 IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
