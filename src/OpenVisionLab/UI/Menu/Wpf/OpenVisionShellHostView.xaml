                  <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/><Condition Binding="{Binding Workbench.Tool.IsMainDraftVisible, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                </Style.Triggers></Style></ContentControl.Style></ContentControl>
              </StackPanel>
              <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="rowChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="rowChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter TargetName="rowChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="rowChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="rowChrome" Property="BorderThickness" Value="2"/></Trigger>
              <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding Workbench.Tool.IsMainDraftVisible, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="rowChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}"/><Setter TargetName="rowChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.StrongLineBrush}"/></MultiDataTrigger>
              </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Border x:Name="stepRow" Padding="8" Tag="{Binding Workbench, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                    mvvmBehaviors:InputCommandBehaviors.MouseLeftButtonUpCommand="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    mvvmBehaviors:InputCommandBehaviors.MouseLeftButtonUpCommandParameter="{Binding Index}">
              <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.Tag.Pipeline, RelativeSource={RelativeSource Self}}" FontWeight="Normal" Background="{DynamicResource OpenVision.Workbench.RaisedBrush}" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"><ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource OpenVision.Workbench.MenuItemStyle}"/></ContextMenu.Resources>
                <MenuItem Header="{Binding [Workbench.Command.RunStepOnly]}" Command="{Binding PlacementTarget.Tag.Tool.RunSelectedStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext.Index, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="F8" AutomationProperties.AutomationId="WorkbenchStepRunOnly"/>
                <MenuItem Header="{Binding [Workbench.Command.RunToStep]}" Command="{Binding RunToSelectedCommand}" ToolTipService.ShowOnDisabled="True" InputGestureText="Ctrl+F5"><MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource OpenVision.Workbench.MenuItemStyle}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding RunToDisabledReason}"/></Trigger></Style.Triggers></Style></MenuItem.Style></MenuItem>
                <Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.ToggleStep]}" Command="{Binding ToggleEnabledCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="{Binding [Workbench.Menu.DuplicateStep]}" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D"/>
                <MenuItem Header="{Binding [Workbench.Menu.RenameStep]}" Command="{Binding RenameCommand}" InputGestureText="F2"/>
                <MenuItem Header="{Binding [Workbench.Menu.MoveUp]}" Command="{Binding MoveUpCommand}" InputGestureText="Alt+↑"/>
                <MenuItem Header="{Binding [Workbench.Menu.MoveDown]}" Command="{Binding MoveDownCommand}" InputGestureText="Alt+↓"/>
                <MenuItem Header="{Binding [Workbench.Tool.SameToolNewTest]}" Command="{Binding NewTestCommand}"/>
                <Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.DeleteStep]}" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
              </ContextMenu></Border.ContextMenu>
              <Grid x:Name="workbenchStepColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border x:Name="workbenchStepToolTile" Grid.Column="1" Width="26" Height="26" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel x:Name="workbenchStepMain" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,6,0" VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ContentControl Margin="0,0,12,0" Focusable="False" mvvmBehaviors:InputCommandBehaviors.MouseDoubleClickCommand="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <TextBlock x:Name="workbenchStepName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"/>
                      </ContentControl>
                      <TextBlock Grid.Column="1" Text="●" HorizontalAlignment="Right" Margin="3,0,0,0" Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}" Visibility="{Binding IsDirty, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <StackPanel x:Name="workbenchStepStatusSide" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <Border x:Name="statusChip" ToolTip="{Binding StatusText}" Height="20" CornerRadius="10" Padding="7,0" BorderThickness="1" BorderBrush="Transparent" Background="{DynamicResource OpenVision.Workbench.SkipSoftBrush}" Visibility="{Binding HasStatus, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <iconPacks:PackIconMaterial x:Name="workbenchStepStatusIcon" Kind="MinusCircleOutline" Width="13" Height="13" Margin="0,0,4,0" Foreground="{Binding Foreground, ElementName=statusText}"/>
                          <TextBlock x:Name="statusText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.SkipBrush}"/>
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="workbenchStepElapsed" Text="{Binding ElapsedText}" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" Visibility="{Binding HasElapsed, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <StackPanel x:Name="quickActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{DynamicResource OpenVision.Workbench.HoverBrush}" Visibility="Hidden">
                      <Button Style="{StaticResource OpenVision.Workbench.ButtonStyle}" Width="26" Height="26" Padding="0" Command="{Binding DataContext.RunToRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Index}" ToolTip="{Binding DataContext[Workbench.Command.RunToStep], RelativeSource={RelativeSource AncestorType=ListBox}}" AutomationProperties.Name="{Binding DataContext[Workbench.Command.RunToStep], RelativeSource={RelativeSource AncestorType=ListBox}}"><iconPacks:PackIconMaterial Kind="DebugStepOver" Width="14" Height="14"/></Button>
                      <Button Style="{StaticResource OpenVision.Workbench.ButtonStyle}" Width="26" Height="26" Padding="0" Command="{Binding DataContext.ToggleRowEnabledCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Index}" ToolTip="{Binding DataContext[Workbench.Menu.ToggleStep], RelativeSource={RelativeSource AncestorType=ListBox}}" AutomationProperties.Name="{Binding DataContext[Workbench.Menu.ToggleStep], RelativeSource={RelativeSource AncestorType=ListBox}}"><iconPacks:PackIconMaterial x:Name="workbenchStepEnabledIcon" Kind="Eye" Width="14" Height="14"/></Button>
                      <Button Style="{StaticResource OpenVision.Workbench.ButtonStyle}" Width="26" Height="26" Padding="0" ContextMenu="{Binding ContextMenu, ElementName=stepRow}" Tag="{Binding Tag, ElementName=stepRow}" Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Index}" Click="WorkbenchStepMenu_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"><iconPacks:PackIconMaterial Kind="DotsVertical" Width="14" Height="14"/></Button>
                    </StackPanel>
                  </Grid>
                  <TextBox Text="{Binding DataContext.RenameText, RelativeSource={RelativeSource AncestorType=ListBox}, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,4,0,0" IsVisibleChanged="WorkbenchRenameEditor_IsVisibleChanged" AutomationProperties.AutomationId="WorkbenchStepRenameEditor">
                    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource ShellHost.DarkTextBoxStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding DataContext.IsRenaming, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                    </Style.Triggers></Style></TextBox.Style>
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/><KeyBinding Key="Escape" Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/></TextBox.InputBindings>
                  </TextBox>
                  <Grid x:Name="workbenchStepRoute" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="workbenchStepToolName" Text="{Binding ToolName}" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="·" Margin="4,0" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/>
                    <iconPacks:PackIconMaterial x:Name="workbenchStepBranchIcon" Grid.Column="2" Kind="SourceBranch" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.DoneBrush}" ToolTip="{Binding BranchTooltip}" Visibility="{Binding IsBranch, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"/>
                    <TextBlock x:Name="workbenchStepPath" Grid.Column="3" Text="{Binding PathText}" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"/>
                  </Grid>
                  <TextBlock x:Name="workbenchStepReadiness" Text="{Binding ReadinessText}" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" Visibility="{Binding ShowReadiness, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="WorkbenchStepReadiness">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Style.Triggers>
                      <DataTrigger Binding="{Binding IsInputMissing}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <Grid Margin="0,4,0,0" Visibility="{Binding HasAcceptance, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial x:Name="workbenchStepAcceptanceIcon" Kind="ScaleBalance" Width="13" Height="13" VerticalAlignment="Top" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding AcceptanceText}" Margin="3,0,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/>
                  </Grid>
                </StackPanel>
                  <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,5,0,0" Visibility="{Binding HasError, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial x:Name="workbenchStepErrorIcon" Kind="AlertCircleOutline" Width="13" Height="13" VerticalAlignment="Top" Foreground="{Binding Foreground, ElementName=workbenchStepErrorText}"/>
                    <TextBlock x:Name="workbenchStepErrorText" Grid.Column="1" Text="{Binding ErrorText}" Margin="5,0,0,0" FontSize="11.5" TextWrapping="Wrap">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding StatusKind}" Value="Ng"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/></DataTrigger></Style.Triggers>
                      </Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, ElementName=stepRow}" Value="True"><Setter TargetName="quickActions" Property="Visibility" Value="Visible"/><Setter TargetName="workbenchStepStatusSide" Property="Visibility" Value="Hidden"/></DataTrigger>
              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="quickActions" Property="Visibility" Value="Visible"/><Setter TargetName="workbenchStepStatusSide" Property="Visibility" Value="Hidden"/></DataTrigger>
              <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter TargetName="stepRow" Property="Opacity" Value="0.5"/><Setter TargetName="workbenchStepEnabledIcon" Property="Kind" Value="EyeOff"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Ok"><Setter TargetName="statusChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.OkSoftBrush}"/><Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}"/><Setter TargetName="workbenchStepStatusIcon" Property="Kind" Value="CheckCircle"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Ng"><Setter TargetName="statusChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.NgSoftBrush}"/><Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/><Setter TargetName="workbenchStepStatusIcon" Property="Kind" Value="CloseCircle"/><Setter TargetName="workbenchStepErrorIcon" Property="Kind" Value="CloseCircleOutline"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Error"><Setter TargetName="statusChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.ErrorSoftBrush}"/><Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/><Setter TargetName="workbenchStepStatusIcon" Property="Kind" Value="AlertCircle"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Done"><Setter TargetName="statusChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.DoneSoftBrush}"/><Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.DoneBrush}"/><Setter TargetName="workbenchStepStatusIcon" Property="Kind" Value="CheckCircleOutline"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Previous"><Setter TargetName="statusChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.StaleSoftBrush}"/><Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.StaleBrush}"/><Setter TargetName="workbenchStepStatusIcon" Property="Kind" Value="AlertOutline"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="Running"><Setter TargetName="statusChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="workbenchStepStatusIcon" Property="Kind" Value="TimerOutline"/></DataTrigger>
              <DataTrigger Binding="{Binding StatusKind}" Value="NotRun"><Setter TargetName="statusChip" Property="Background" Value="Transparent"/><Setter TargetName="statusChip" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineAltBrush}"/><Setter TargetName="statusText" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="workbenchStepStatusIcon" Property="Kind" Value="CircleSmall"/></DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <TextBlock Grid.Row="4" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource OpenVision.Workbench.ErrorBrush}" Visibility="{Binding HasStatus, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"/>
      <Grid Grid.Row="5" Margin="0,10,0,0" AutomationProperties.AutomationId="WorkbenchFinalVerdict">
        <Border Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
          <Grid x:Name="workbenchVerdictContent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="workbenchVerdictValue" Text="{Binding VerdictValue}" MinWidth="34" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding VerdictKind}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding VerdictKind}" Value="Ng"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding VerdictKind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding VerdictKind}" Value="Previous"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SkipBrush}"/></DataTrigger>
              </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="workbenchVerdictTitle" Text="{Binding [Workbench.Verdict.Title]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"/>
              <TextBlock x:Name="workbenchVerdictDetail" Text="{Binding VerdictDetail}" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="34" LineHeight="16" FontSize="11" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" ToolTip="{Binding VerdictDetail}"/>
            </StackPanel>
          </Grid>
        </Border>
        <Rectangle Stroke="{DynamicResource OpenVision.Workbench.SkipBrush}" StrokeDashArray="4,3" RadiusX="4" RadiusY="4" IsHitTestVisible="False" Visibility="{Binding IsVerdictPrevious, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"/>
      </Grid>
    </Grid>
  </Border>
  <Border x:Name="toolRailBorder" Grid.Row="1" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" Padding="8" MaxHeight="{Binding Workbench.ToolPaletteMaximum, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="btnToggleToolRail"
                            Grid.Row="0"
                            Height="30"
                            Padding="8,0"
                            Margin="0,0,0,8"
                            Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.AccentLineBrush}"
                            Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                            BorderThickness="1"
                            HorizontalContentAlignment="Center"
                            ToolTip="{Binding Workbench[Workbench.Tools.Title], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                            Command="{Binding Workbench.ToggleToolPaletteCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                        <StackPanel x:Name="toolRailToggleContent"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial x:Name="iconToolRailToggle"
                                                        Kind="{Binding Workbench.ToolPaletteChevron, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,6,0"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock x:Name="txtToolRailToggle"
                                       Text="{Binding Workbench[Workbench.Tools.Title], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Grid Visibility="{Binding Workbench.IsToolPaletteSearchVisible, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" x:Name="toolSearchPanel"
                          Grid.Row="1"
                          Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Height="30"
                                Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                                BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Magnify"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="txtToolSearch"
                                             AutomationProperties.AutomationId="HostToolSearchTextBox"
                                             AutomationProperties.Name="{Binding ToolSearchHintText}"
                                             ToolTip="{Binding ToolSearchHintText}"
                                             Text="{Binding ToolSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ShellHost.DarkTextBoxStyle}"
                                             Padding="0,4"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Text="{Binding ToolSearchHintText}"
                                               Margin="1,0,0,0"
                                               Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtToolSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="2"
                                        AutomationProperties.AutomationId="HostToolSearchClearButton"
                                        Command="{Binding ClearToolSearchCommand}"
                                        ToolTip="{Binding ToolSearchClearToolTipText}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToolSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconMaterial Kind="Close"
                                                                Width="13"
                                                                Height="13"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   AutomationProperties.AutomationId="HostToolSearchSummary"
                                   Text="{Binding ToolSearchSummaryText}"
                                   Margin="2,4,2,2"
                                   Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToolSearchSummaryText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToolRailCompact, RelativeSource={RelativeSource AncestorType={x:Type local:OpenVisionShellHostView}}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <ScrollViewer Visibility="{Binding Workbench.IsToolPaletteExpanded, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" x:Name="toolRailScroll"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="navHostToolViews" ItemsSource="{Binding WorkbenchToolGroups}" />
                            <Button x:Name="mainToolLlmAssistant" AutomationProperties.AutomationId="MainToolLlmAssistant"
                                    AutomationProperties.Name="{Binding Workbench[Workbench.Llm.ToolPalette], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                    Command="{Binding Workbench.OpenMainLlmCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Margin="0,8,0,0" Height="26" MinHeight="26" Padding="9,0" FontSize="12"
                                    HorizontalContentAlignment="Left" Cursor="Hand">
                                <Button.Style>
