                                    Style="{StaticResource TopLayerIconButtonStyle}"
                                    Width="32"
                                    Height="32"
                                    Margin="0"
                                    Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                                    BorderBrush="{DynamicResource OpenVision.Workbench.AccentLineBrush}"
                                    Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                    ToolTip="Float tool window"
                                    AutomationProperties.AutomationId="OpenVisionDockedToolFloatButton"
                                    AutomationProperties.Name="Float tool window"
                                    Command="{Binding ChromeCommands.FloatDockedToolCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <iconPacks:PackIconMaterial Kind="OpenInNew"
                                                            Width="15"
                                                            Height="15"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Grid.Column="7" Style="{StaticResource TopLayerIconButtonStyle}" Width="32" Height="32" Margin="0"
                                    ToolTip="{Binding Workbench[Workbench.Tool.Menu], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                    AutomationProperties.Name="{Binding Workbench[Workbench.Tool.Menu], RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                    AutomationProperties.AutomationId="WorkbenchToolMenuButton"
                                    Tag="{Binding Workbench.Tool, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}" Click="WorkbenchStepMenu_Click">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                 Background="{DynamicResource OpenVision.Workbench.RaisedBrush}" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}">
                                        <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource OpenVision.Workbench.MenuItemStyle}"/></ContextMenu.Resources>
                                        <MenuItem Header="{Binding [Workbench.Tool.ParameterGuide]}" Command="{Binding ParameterGuideCommand}" AutomationProperties.AutomationId="WorkbenchToolGuideMenu">
                                            <MenuItem.Icon><iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding LearnText}" Command="{Binding LearnCommand}" AutomationProperties.AutomationId="WorkbenchToolLearnMenu">
                                            <MenuItem.Icon><iconPacks:PackIconMaterial Kind="BookOpenVariant" Width="16" Height="16"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/>
                                        <MenuItem Header="{Binding [Workbench.Tool.RestoreDefaults]}" Command="{Binding RestoreDefaultsCommand}" Visibility="{Binding IsNewTest, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="WorkbenchToolDefaultsMenu">
                                            <MenuItem.Icon><iconPacks:PackIconMaterial Kind="Restore" Width="16" Height="16"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding [Workbench.Menu.RenameStep]}" Command="{Binding RenameCommand}" Visibility="{Binding IsStepEditing, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" InputGestureText="F2"/>
                                        <MenuItem Header="{Binding [Workbench.Tool.DuplicateStep]}" Command="{Binding DuplicateCommand}" Visibility="{Binding IsStepEditing, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" InputGestureText="Ctrl+D"/>
                                        <MenuItem Header="{Binding [Workbench.Tool.SameToolNewTest]}" Command="{Binding NewTestCommand}" Visibility="{Binding IsStepEditing, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="WorkbenchToolNewTestMenu">
                                            <MenuItem.Icon><iconPacks:PackIconMaterial Kind="TestTube" Width="16" Height="16"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}" Visibility="{Binding IsStepEditing, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"/>
                                        <MenuItem Header="{Binding [Workbench.Tool.DeleteStep]}" Command="{Binding DeleteCommand}" Visibility="{Binding IsStepEditing, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}" InputGestureText="Del"/>
                                    </ContextMenu>
