                                                 Text="-"
                                                 Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                                 CaretBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                                 FontWeight="SemiBold"
                                                 BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                                 Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                                        <Button x:Name="btnRenameSelectedLayer"
                                                Grid.Column="2"
                                                Width="28"
                                                Height="24"
                                                Padding="0"
                                                AutomationProperties.AutomationId="HostRenameLayerButton"
                                                Style="{StaticResource LayerDetailActionButtonStyle}"
                                                ToolTip="{Binding LayerCommands.RenameLayerText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                                Command="{Binding LayerCommands.RenameSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                                CommandParameter="{Binding Text, ElementName=txtHostSelectedLayerTitle}">
                                            <iconPacks:PackIconMaterial Kind="PencilOutline"
                                                                        Width="14"
                                                                        Height="14"
                                                                        HorizontalAlignment="Center"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="txtHostSelectedLayerMeta"
                                               Text="-"
                                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                               Margin="0,5,0,0" />
                                    <TextBlock x:Name="txtHostSelectedLayerRoute"
                                               Text="-"
                                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                               FontSize="11"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnCreateLayer"
                                    Grid.Column="0"
                                    AutomationProperties.AutomationId="HostCreateLayerButton"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Command="{Binding LayerCommands.CreateLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="LayersPlus"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding LayerCommands.CreateLayerShortText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLoadImageIntoSelectedLayer"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="HostLoadImageIntoLayerButton"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Command="{Binding LayerCommands.LoadImageIntoSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ImagePlusOutline"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding LayerCommands.LoadImageIntoLayerShortText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDeleteSelectedLayer"
                                    Grid.Column="4"
                                    AutomationProperties.AutomationId="HostDeleteLayerButton"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    ToolTip="{Binding LayerCommands.DeleteLayerText, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                                    Command="{Binding LayerCommands.DeleteSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <iconPacks:PackIconMaterial Kind="LayersOffOutline"
                                                            Width="15"
                                                            Height="15"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="btnOpenSelectedLayerWindow"
                                    Grid.Column="6"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Command="{Binding LayerCommands.OpenSelectedLayerWindowCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="ImageMultipleOutline"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="txtOpenSelectedLayerWindowButton"
                                               Text="팝업"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDockSelectedLayer"
                                    Grid.Column="6"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Visibility="Collapsed"
                                    Command="{Binding LayerCommands.DockSelectedLayerCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="LayersPlus"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,5,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="txtDockSelectedLayerButton"
                                               Text="도킹"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnClearDockedLayers"
                                    Grid.Column="8"
                                    Style="{StaticResource LayerDetailActionButtonStyle}"
                                    Visibility="Collapsed"
                                    ToolTip="도킹 해제"
                                    Command="{Binding LayerCommands.ClearDockedLayersCommand, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}">
                                <iconPacks:PackIconMaterial Kind="LayersOffOutline"
                                                            Width="15"
                                                            Height="15"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
