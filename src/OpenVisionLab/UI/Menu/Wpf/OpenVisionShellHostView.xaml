                            <TextBlock Text="{Binding Tag.Workbench[Workbench.Recipe.Label], RelativeSource={RelativeSource TemplatedParent}}" FontSize="10.5" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/>
