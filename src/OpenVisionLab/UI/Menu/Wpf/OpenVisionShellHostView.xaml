                    </Grid>
                    <Path x:Name="comboDropGlyph" Width="8" Height="5" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0 0 L 4 5 L 8 0 Z" Fill="{TemplateBinding Foreground}" IsHitTestVisible="False"/>
                    <ToggleButton Background="Transparent" BorderThickness="0" ClickMode="Press" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Slide">
                        <Border Width="330" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ScrollViewer Margin="1" SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,1,0,0" Padding="4" DataContext="{Binding Tag.Workbench, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Resources><Style x:Key="ShellHost.MainRecipeMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/><Setter Property="mvvmBehaviors:ComboBoxInteractionBehavior.CloseOnClick" Value="{Binding RelativeSource={RelativeSource TemplatedParent}}"/></Style></Border.Resources>
                                    <StackPanel>
                                        <Button Style="{StaticResource ShellHost.MainRecipeMenuButtonStyle}" HorizontalContentAlignment="Left" Command="{Binding OpenMainNewRecipeCommand}" AutomationProperties.AutomationId="MainRecipeMenuNew">
                                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding [Workbench.Menu.NewRecipe]}"/></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ShellHost.MainRecipeMenuButtonStyle}" HorizontalContentAlignment="Left" Command="{Binding OpenMainSaveAsCommand}" AutomationProperties.AutomationId="MainRecipeMenuSaveAs">
                                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding [Workbench.Menu.SaveAs]}"/></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ShellHost.MainRecipeMenuButtonStyle}" HorizontalContentAlignment="Left" Command="{Binding OpenRecipeManagerCommand}" AutomationProperties.AutomationId="MainRecipeMenuManage">
                                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding [Workbench.Menu.RecipeManager]}"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/><Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                    <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}"/><Setter TargetName="comboDropGlyph" Property="Fill" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="comboFocusGlow" Property="Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}"/><Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"/></Trigger>
                    <DataTrigger Binding="{Binding Tag.Workbench.IsMainRecipeOpen, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="IsDropDownOpen" Value="False"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

