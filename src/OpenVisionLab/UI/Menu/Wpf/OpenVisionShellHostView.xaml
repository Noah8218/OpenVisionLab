                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <Border x:Name="recipeManagerPanel"
                mvvmBehaviors:InputCommandBehaviors.FocusOnKey="F2"
                mvvmBehaviors:InputCommandBehaviors.FocusTarget="{Binding ElementName=recipeBasicLifecyclePanel}"
                Grid.Row="0"
                Grid.RowSpan="4"
                Panel.ZIndex="40"
                VerticalAlignment="Stretch"
                Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                BorderThickness="1"
                Padding="14"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostView}}"
                AutomationProperties.AutomationId="HostRecipeManagerPanel">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Margin" Value="72,8,16,12" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=btnHostRecipeManager}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <Setter Property="Margin" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RecipeCommands.IsRecipeManagerDetailContextActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, ElementName=recipeAdvancedReviewToggle}" Value="True" />
                                <Condition Binding="{Binding IsSelected, ElementName=tabRecipePipeline}" Value="True" />
                                <Condition Binding="{Binding IsSelected, ElementName=tabRecipePipelineStepSettings}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Margin" Value="16,8,16,12" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Width" Value="700" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform x:Name="recipeManagerPanelTransform" />
            </Border.RenderTransform>
            <Border.Resources>
                <local:RecipeManagerLibraryItemConverter x:Key="RecipeManagerLibraryItemConverter" />
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource ShellHost.DarkTextBoxStyle}" />
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
                <Style x:Key="RecipeManagerListItemStyle" TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="itemChrome" Padding="{TemplateBinding Padding}" Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                                        BorderBrush="Transparent" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
                                        <Setter TargetName="itemChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" />
                                        <Setter TargetName="itemChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="itemChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                                        <Setter TargetName="itemChrome" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
