                                           SnapsToDevicePixels="True" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SelectedLayerDetailText}" Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                                    <Grid Margin="0,5,0,0">
