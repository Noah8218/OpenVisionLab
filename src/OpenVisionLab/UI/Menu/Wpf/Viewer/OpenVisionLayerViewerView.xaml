<UserControl x:Class="OpenVisionLab.OpenVisionLayerViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mvvmBehaviors="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             xmlns:imageCanvasViews="clr-namespace:OpenVisionLab.ImageCanvas.Views;assembly=OpenVisionLab.ImageCanvas"
             local:OpenVisionWorkbenchThemeBehavior.ThemeName="{Binding DataContext.ThemeName, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostWindow}}"
             MinWidth="420"
             MinHeight="300"
             Background="#071114"
             ClipToBounds="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MainPane.FrameStyle" TargetType="Border"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.CanvasBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></DataTrigger></Style.Triggers></Style>
            <Style x:Key="MainPane.SourceStyle" TargetType="ComboBox" BasedOn="{StaticResource OpenVision.Workbench.LanguageComboBoxStyle}">
                <Setter Property="mvvmBehaviors:ComboBoxInteractionBehavior.OpenOnFieldClick" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="sourceChrome" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="1" CornerRadius="3"/>
                        <Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNarrow}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <iconPacks:PackIconMaterial Grid.Column="2" Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="220" MaxWidth="420" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}" BorderThickness="1" Padding="2">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="sourceChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="sourceChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="sourceChrome" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="sourceChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}"/><Setter TargetName="sourceChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="sourceChrome" Property="Opacity" Value="0.6"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="layerViewerFrame" Background="#071114" ClipToBounds="True">
        <Grid x:Name="viewerRootGrid" Margin="10" ClipToBounds="True" mvvmBehaviors:InputCommandBehaviors.SizeChangedCommand="{Binding DataContext.UpdateSizeCommand, ElementName=mainPaneHeader}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="headerRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="statusRow" Height="30" />
            </Grid.RowDefinitions>

            <Border x:Name="mainPaneHeader" Grid.Row="0" Height="32" Visibility="Collapsed" Padding="4,2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" Background="{DynamicResource OpenVision.Workbench.PanelBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="26"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="14" Height="14" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="mainPaneSource" Grid.Column="1" ItemsSource="{Binding Sources}" SelectedValuePath="Key" SelectedValue="{Binding Source, Mode=TwoWay}" Style="{StaticResource MainPane.SourceStyle}" MinHeight="26" MinWidth="0" Padding="4,0" ToolTip="{Binding Title}" AutomationProperties.AutomationId="MainPaneSource"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" TextWrapping="Wrap" MaxWidth="390"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" VerticalAlignment="Center" Margin="3,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNarrow}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <Button x:Name="mainPanePin" Grid.Column="3" Command="{Binding PinCommand}" ToolTip="{Binding [Workbench.Pane.Pin]}" Style="{StaticResource OpenVision.Workbench.ButtonStyle}" Width="24" MinWidth="0" Height="26" MinHeight="0" Padding="0" AutomationProperties.AutomationId="MainPanePin"><iconPacks:PackIconMaterial Kind="{Binding PinIcon}" Width="14" Height="14"/></Button>
                    <Menu Grid.Column="4" Background="Transparent" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"><Menu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource OpenVision.Workbench.MenuItemStyle}"/></Menu.Resources>
                        <MenuItem x:Name="mainPaneMenu" Height="26" MinHeight="0" Padding="5,2" ToolTip="{Binding [Workbench.Pane.Menu]}" AutomationProperties.AutomationId="MainPaneMenu">
                            <MenuItem.Header><iconPacks:PackIconMaterial Kind="DotsVertical" Width="14" Height="14"/></MenuItem.Header>
                            <MenuItem Header="{Binding [Workbench.Pane.Snapshot]}" Command="{Binding SnapshotCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Camera" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{Binding [Workbench.Pane.Save]}" Command="{Binding SaveCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="FileExport" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{Binding [Workbench.Pane.Open]}" Command="{Binding OpenCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="OpenInNew" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="{Binding [Workbench.Pane.ClearSnapshots]}" Command="{Binding ClearSnapshotsCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="DeleteSweepOutline" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{Binding [Workbench.Viewer.Fit]}" Command="{Binding FitCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="FitToScreenOutline" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        </MenuItem>
                    </Menu>
                </Grid>
            </Border>

            <Border x:Name="layerHeader"
                    Grid.Row="0"
                    Background="#101D22"
                    BorderBrush="#2A4D55"
                    BorderThickness="1"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                Kind="ImageMultipleOutline"
                                                Width="18"
                                                Height="18"
                                                Foreground="#157C86"
                                                VerticalAlignment="Center" />
                    <TextBlock x:Name="txtLayerTitle"
                               Grid.Column="2"
                               Text="-"
                               Foreground="#EAF7F8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="3"
                            Background="#0B272D"
                            BorderBrush="#287E87"
                            BorderThickness="1"
                            Padding="10,4">
                        <TextBlock x:Name="txtLayerMeta"
                                   Text="-"
                                   Foreground="#BFE8EA"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="imageFrame"
                    Grid.Row="1"
                    Margin="0,8,0,6"
                    Background="#020506"
                    BorderBrush="#157C86"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid x:Name="layerImageSurface" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <imageCanvasViews:RoiImageCanvasView x:Name="layerCanvas" Grid.RowSpan="2"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        ClipToBounds="True"
                                                        Visibility="Collapsed" />
                    <Image x:Name="layerFallbackImage" Grid.RowSpan="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           Visibility="Collapsed" />
                    <Canvas x:Name="mainDisplayOverlays" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>
                    <Grid x:Name="mainPaneFinalPresentation" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="8">
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowFinalVerdict}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="mainPaneFinalBadge" HorizontalAlignment="Left" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" IsHitTestVisible="False">
                            <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.OkBrush}"/><Style.Triggers><DataTrigger Binding="{Binding FinalVerdictKind}" Value="Ng"><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/></DataTrigger><DataTrigger Binding="{Binding FinalVerdictKind}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock x:Name="mainPaneFinalVerdictText" Text="{Binding FinalVerdictValue}" FontSize="13" FontWeight="Bold">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}"/><Style.Triggers><DataTrigger Binding="{Binding FinalVerdictKind}" Value="Ng"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/></DataTrigger><DataTrigger Binding="{Binding FinalVerdictKind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <ScrollViewer x:Name="mainPaneFinalReasonsScroll" Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFinalReasons}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                            <ItemsControl x:Name="mainPaneFinalReasons" ItemsSource="{Binding FinalFailureRows}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="{DynamicResource OpenVision.Workbench.PanelBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,0,4">
                                        <TextBlock TextWrapping="Wrap" FontSize="11">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ResultStatusKind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            <Run Text="{Binding Number, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding ErrorText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Orientation="Vertical" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" IsHitTestVisible="False">
                        <Border x:Name="mainPaneSnapshotMarker" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.DoneBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSnapshot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding [Workbench.Pane.Snapshot]}" Foreground="{DynamicResource OpenVision.Workbench.DoneBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="mainPanePreviousMarker" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.StaleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPrevious}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding [Workbench.Status.Previous]}" Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Border x:Name="mainPaneEmpty" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource OpenVision.Workbench.PaneEmptyBackgroundBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.PaneEmptyBorderBrush}" BorderThickness="1" CornerRadius="10" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="20,16"/><Setter Property="Margin" Value="10,10,10,34"/><Style.Triggers><DataTrigger Binding="{Binding IsMediumHeight}" Value="True"><Setter Property="Padding" Value="14,10"/></DataTrigger><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="8,6,8,30"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid>
                            <Grid.Style><Style TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Stretch"/><Style.Triggers><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="HorizontalAlignment" Value="Center"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Width" Value="Auto"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                                <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Width" Value="Auto"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.ColumnSpan" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1"/></DataTrigger><DataTrigger Binding="{Binding IsEmptyActionsStacked}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <iconPacks:PackIconMaterial x:Name="mainPaneEmptyIcon" Kind="{Binding EmptyIcon}" HorizontalAlignment="Center" Foreground="{DynamicResource OpenVision.Workbench.PaneEmptyDetailBrush}">
                                    <iconPacks:PackIconMaterial.Style><Style TargetType="iconPacks:PackIconMaterial"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Style.Triggers><DataTrigger Binding="{Binding IsMediumHeight}" Value="True"><Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/></DataTrigger><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>
                                <TextBlock x:Name="mainPaneEmptyTitleText" Text="{Binding EmptyTitle}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource OpenVision.Workbench.PaneEmptyTitleBrush}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="LineHeight" Value="21.75"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="Margin" Value="0,8,0,4"/><Style.Triggers><DataTrigger Binding="{Binding IsMediumHeight}" Value="True"><Setter Property="FontSize" Value="13.5"/><Setter Property="LineHeight" Value="19.575"/><Setter Property="Margin" Value="0,4,0,2"/></DataTrigger><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="FontSize" Value="12.5"/><Setter Property="LineHeight" Value="18.125"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="mainPaneEmptyDetailText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource OpenVision.Workbench.PaneEmptyDetailBrush}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="LineHeight" Value="19.375"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="Margin" Value="0,0,0,12"/><Style.Triggers><DataTrigger Binding="{Binding IsMediumHeight}" Value="True"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="18.6"/><Setter Property="Margin" Value="0,0,0,8"/></DataTrigger><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    <Run Text="{Binding EmptyDetailPrefix, Mode=OneWay}"/><Run Text="{Binding EmptyDetailAction, Mode=OneWay}" FontWeight="Bold"/><Run Text="{Binding EmptyDetailSuffix, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button x:Name="mainPaneRunToSource" Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding [Workbench.Command.RunToStep]}" Command="{Binding RunToSourceCommand}" HorizontalAlignment="Center" Margin="0,4,0,0" AutomationProperties.AutomationId="MainPaneRunToSource">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowRunToAction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <WrapPanel x:Name="mainPaneOpenActions" HorizontalAlignment="Center">
                                <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowOpenActions}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="8,0,0,0"/></DataTrigger><DataTrigger Binding="{Binding IsEmptyActionsStacked}" Value="True"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                                <Button AutomationProperties.AutomationId="MainPaneEmptyOpenImage" Command="{Binding LoadImageCommand}" Padding="9,0" FontSize="12">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}"><Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="26"/><Setter Property="Margin" Value="0,0,6,0"/><Style.Triggers><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ImagePlusOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="{Binding [Workbench.Viewer.OpenImage]}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
                                </Button>
                                <Button AutomationProperties.AutomationId="MainPaneEmptyOpenFolder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" Padding="9,0" FontSize="12">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}"><Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="26"/><Style.Triggers><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="FolderImage" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="{Binding [Workbench.Viewer.OpenFolder]}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel>
                                </Button>
                                <Button AutomationProperties.AutomationId="MainPaneEmptyOpenSamples" Content="{Binding [Workbench.Viewer.OpenSamples]}" Command="{Binding OpenSampleCommand}" Padding="9,0" FontSize="12">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}"><Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="26"/><Style.Triggers><DataTrigger Binding="{Binding IsShort}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="emptyOverlay" Grid.RowSpan="2"
                            Width="260"
                            Padding="18"
                            Background="#10242A"
                            BorderBrush="#2B7881"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <iconPacks:PackIconMaterial Kind="ImageOffOutline"
                                                        Width="24"
                                                        Height="24"
                                                        Foreground="#157C86"
                                                        Margin="0,0,0,8" />
                            <TextBlock x:Name="txtEmptyTitle"
                                       Text="No image"
                                       Foreground="#D7ECEE"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="mainPaneFooter" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="6,0,6,6" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Left" Padding="7,2" CornerRadius="4" Background="{DynamicResource OpenVision.Workbench.PaneReadoutBackgroundBrush}">
                            <TextBlock x:Name="mainPanePointerText" Text="{Binding PointerText}" Foreground="{DynamicResource OpenVision.Workbench.PaneReadoutTextBrush}" FontFamily="{DynamicResource OpenVision.Workbench.MonospaceFontFamily}" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                        <Border Grid.Column="2" Padding="7,2" CornerRadius="4" Background="{DynamicResource OpenVision.Workbench.PaneReadoutBackgroundBrush}">
                            <TextBlock x:Name="mainPaneZoomText" Text="{Binding ZoomText}" Foreground="{DynamicResource OpenVision.Workbench.PaneReadoutTextBrush}" FontFamily="{DynamicResource OpenVision.Workbench.MonospaceFontFamily}" FontSize="11"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="statusFooter"
                    Grid.Row="2"
                    Background="#0D171B"
                    BorderBrush="#253D45"
                    BorderThickness="1"
                    Padding="10,0">
                <TextBlock x:Name="txtStatus"
                           Text="-"
                           Foreground="#C8DEE3"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</UserControl>
