<UserControl x:Class="OpenVisionLab.OpenVisionRecipeBasicLifecycleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding RecipeCommands.RecipeManagerNameEditHintText}"
                   TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                   VerticalAlignment="Center" />
        <TextBox x:Name="recipeNameEditor" Grid.Row="1"
                 Height="32"
                 Style="{DynamicResource OpenVision.ControlTextBoxDarkStyle}"
                 Margin="0,4,0,0"
                 Padding="7,2"
                 VerticalContentAlignment="Center"
                 AutomationProperties.AutomationId="HostRecipeNameEditor"
                 Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                 CaretBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                 BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"
                 Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                 Text="{Binding RecipeCommands.EditRecipeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding RecipeCommands.RenameRecipeCommand}" />
                <KeyBinding Key="Escape" Command="{Binding RecipeCommands.CancelRecipeNameEditCommand}" />
            </TextBox.InputBindings>
        </TextBox>
        <WrapPanel Grid.Row="2"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Stretch"
                   AutomationProperties.AutomationId="HostRecipeManagerCommandStrip">
            <Button MinWidth="86"
                    Height="32"
                    Style="{DynamicResource OpenVision.Workbench.PrimaryButtonStyle}"
                    Margin="0,0,6,6"
                    AutomationProperties.AutomationId="HostRecipeCreateNamedButton"
                    Command="{Binding RecipeCommands.CreateNamedRecipeCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Plus" Width="13" Height="13" Margin="0,1,5,0" />
                    <TextBlock Text="{Binding RecipeCommands.CreateNamedRecipeText}" />
                </StackPanel>
            </Button>
            <Button MinWidth="74"
                    Height="32"
                    Style="{DynamicResource OpenVision.Workbench.ButtonStyle}"
                    Margin="0,0,6,6"
                    AutomationProperties.AutomationId="HostRecipeDuplicateButton"
                    Command="{Binding RecipeCommands.DuplicateRecipeCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ImageMultipleOutline" Width="13" Height="13" Margin="0,1,5,0" />
                    <TextBlock Text="{Binding RecipeCommands.DuplicateRecipeText}" />
                </StackPanel>
            </Button>
            <Button MinWidth="86"
                    Height="32"
                    Style="{DynamicResource OpenVision.Workbench.ButtonStyle}"
                    Margin="0,0,6,6"
                    AutomationProperties.AutomationId="HostRecipeRenameButton"
                    Command="{Binding RecipeCommands.RenameRecipeCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="PencilOutline" Width="13" Height="13" Margin="0,1,5,0" />
                    <TextBlock Text="{Binding RecipeCommands.RenameRecipeText}" />
                </StackPanel>
            </Button>
            <Button MinWidth="72"
                    Height="32"
                    Style="{DynamicResource OpenVision.Workbench.DangerButtonStyle}"
                    Margin="0,0,0,6"
                    AutomationProperties.AutomationId="HostRecipeDeleteButton"
                    Command="{Binding RecipeCommands.DeleteRecipeCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="LayersOffOutline" Width="13" Height="13" Margin="0,1,5,0" />
                    <TextBlock Text="{Binding RecipeCommands.DeleteRecipeText}" />
                </StackPanel>
            </Button>
        </WrapPanel>
        <TextBlock Grid.Row="3"
                   Margin="0,0,0,0"
                   AutomationProperties.AutomationId="HostRecipeEditValidation"
                   Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                   FontSize="10"
                   Text="{Binding RecipeCommands.RecipeEditValidationText}"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="4"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                   FontSize="10"
                   Text="{Binding RecipeCommands.StatusText}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
