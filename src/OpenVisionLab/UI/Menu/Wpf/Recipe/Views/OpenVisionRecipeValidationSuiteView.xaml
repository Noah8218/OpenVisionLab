<UserControl x:Class="OpenVisionLab.OpenVisionRecipeValidationSuiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ShellHost.BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <TextBlock Text="{Binding RecipeCommands.ValidationSuiteText}"
            Foreground="#A8CBD1"
            FontSize="11"
            FontWeight="SemiBold" />
        <Border Margin="0,4,0,10"
            Padding="8,6"
            AutomationProperties.AutomationId="HostRecipeValidationSuitePanel"
            Background="#102329"
            BorderBrush="#4C8790"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RecipeCommands.ValidationSuiteScopeLabelText}"
                    VerticalAlignment="Center"
                    Foreground="#A8CBD1"
                    FontSize="10"
                    FontWeight="SemiBold" />
                <ComboBox Grid.Column="1"
                    Height="24"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="HostRecipeValidationSuiteScopeCombo"
                    AutomationProperties.Name="{Binding RecipeCommands.ValidationSuiteScopeLabelText}"
                    DisplayMemberPath="DisplayText"
                    ItemsSource="{Binding RecipeCommands.ValidationSuiteScopeOptions}"
                    SelectedItem="{Binding RecipeCommands.SelectedValidationSuiteScopeOption, Mode=TwoWay}" />
                <StackPanel Grid.Column="2"
                    Margin="8,0,0,0"
                    Orientation="Horizontal">
                    <Button MinWidth="104"
                        Height="24"
                        AutomationProperties.AutomationId="HostRecipeRunValidationSuiteButton"
                        Command="{Binding RecipeCommands.RunValidationSuiteCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="PlayCircleOutline" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.RunValidationSuiteText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="76"
                        Height="24"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="HostRecipeStopValidationSuiteButton"
                        AutomationProperties.Name="{Binding RecipeCommands.StopValidationSuiteText}"
                        ToolTip="현재 이미지 완료 후 중지하고 부분 결과를 저장합니다."
                        Visibility="{Binding RecipeCommands.IsLocalValidationSetRunning, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"
                        Command="{Binding RecipeCommands.StopValidationSuiteCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="StopCircleOutline" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.StopValidationSuiteText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="3"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="HostRecipeValidationSuiteStatus"
                    Text="{Binding RecipeCommands.ValidationSuiteStatusText, Mode=OneWay}"
                    ToolTip="{Binding RecipeCommands.ValidationSuiteStatusText, Mode=OneWay}"
                    Foreground="#95D6B8"
                    FontSize="10"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <Border Grid.Row="1"
                    Grid.ColumnSpan="4"
                    Margin="0,7,0,0"
                    Padding="8,6"
                    AutomationProperties.AutomationId="HostRecipeValidationSetEvidenceBoard"
                    Background="#0C1D22"
                    BorderBrush="#356A73"
                    BorderThickness="1"
                    Visibility="{Binding RecipeCommands.IsLocalValidationSetSelected, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RecipeCommands.ValidationSetExpectedLabelText}"
                            Foreground="#89E0E5"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                            AutomationProperties.AutomationId="HostRecipeValidationSetExpectedEvidence"
                            Text="{Binding RecipeCommands.ValidationSetExpectedText, Mode=OneWay}"
                            Foreground="#EAFBFC"
                            FontSize="10"
                            TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2"
                            Text="{Binding RecipeCommands.ValidationSetAcceptanceLabelText}"
                            Foreground="#89E0E5"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3"
                            AutomationProperties.AutomationId="HostRecipeValidationSetAcceptanceEvidence"
                            Text="{Binding RecipeCommands.ValidationSetAcceptanceText, Mode=OneWay}"
                            Foreground="#EAFBFC"
                            FontSize="10"
                            TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1"
                            Margin="0,5,0,0"
                            Text="{Binding RecipeCommands.ValidationSetCalibrationLabelText}"
                            Foreground="#89E0E5"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,5,0,0"
                            AutomationProperties.AutomationId="HostRecipeValidationSetCalibrationEvidence"
                            Text="{Binding RecipeCommands.ValidationSetCalibrationText, Mode=OneWay}"
                            Foreground="#D7FFF4"
                            FontSize="10"
                            TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,5,0,0"
                            Text="{Binding RecipeCommands.ValidationSetNextActionLabelText}"
                            Foreground="#89E0E5"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1"
                            Grid.Column="3"
                            Margin="0,5,0,0"
                            AutomationProperties.AutomationId="HostRecipeValidationSetNextActionEvidence"
                            Text="{Binding RecipeCommands.ValidationSetNextActionText, Mode=OneWay}"
                            Foreground="#FFF1AF"
                            FontSize="10"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2"
                    Grid.ColumnSpan="4"
                    Margin="0,7,0,0"
                    AutomationProperties.AutomationId="HostRecipeLocalValidationSetEditor"
                    Visibility="{Binding RecipeCommands.IsLocalValidationSetSelected, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RecipeCommands.ValidationSetSelectionLabelText}"
                        VerticalAlignment="Center"
                        Foreground="#A8CBD1"
                        FontSize="10"
                        FontWeight="SemiBold" />
                    <ComboBox Grid.Column="1"
                        Height="24"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="HostRecipeValidationSetCombo"
                        AutomationProperties.Name="{Binding RecipeCommands.ValidationSetSelectionLabelText}"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding RecipeCommands.ValidationSetOptions}"
                        SelectedItem="{Binding RecipeCommands.SelectedValidationSetOption, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2"
                        Margin="10,0,0,0"
                        Text="{Binding RecipeCommands.NewValidationSetNameLabelText}"
                        VerticalAlignment="Center"
                        Foreground="#A8CBD1"
                        FontSize="10"
                        FontWeight="SemiBold" />
                    <TextBox Grid.Column="3"
                        Height="24"
                        Margin="8,0,0,0"
                        Padding="5,2"
                        AutomationProperties.AutomationId="HostRecipeNewValidationSetNameTextBox"
                        Text="{Binding RecipeCommands.NewValidationSetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="4"
                        MinWidth="68"
                        Height="24"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="HostRecipeCreateValidationSetButton"
                        Command="{Binding RecipeCommands.CreateValidationSetCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.CreateValidationSetText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5"
                        MinWidth="78"
                        Height="24"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="HostRecipeDeleteValidationSetButton"
                        Command="{Binding RecipeCommands.DeleteValidationSetCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.DeleteValidationSetText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="1"
                        Text="{Binding RecipeCommands.ValidationSetPendingNotesLabelText}"
                        VerticalAlignment="Center"
                        Foreground="#A8CBD1"
                        FontSize="10"
                        FontWeight="SemiBold" />
                    <TextBox Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Height="24"
                        Margin="8,5,0,0"
                        Padding="5,2"
                        AutomationProperties.AutomationId="HostRecipeValidationSetNotesTextBox"
                        Text="{Binding RecipeCommands.ValidationSetPendingNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Row="1"
                        Grid.Column="3"
                        MinWidth="112"
                        Height="24"
                        Margin="8,5,0,0"
                        AutomationProperties.AutomationId="HostRecipeAddValidationSetOkImagesButton"
                        Command="{Binding RecipeCommands.AddValidationSetOkImagesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImagePlus" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.AddValidationSetOkImagesText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1"
                        Grid.Column="4"
                        Grid.ColumnSpan="2"
                        MinWidth="112"
                        Height="24"
                        Margin="6,5,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="HostRecipeAddValidationSetNgImagesButton"
                        Command="{Binding RecipeCommands.AddValidationSetNgImagesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ImagePlus" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.AddValidationSetNgImagesText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1"
                        Grid.Column="6"
                        MinWidth="94"
                        Height="24"
                        Margin="6,5,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="HostRecipeRemoveValidationSetImageButton"
                        Command="{Binding RecipeCommands.RemoveValidationSetImageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="MinusCircleOutline" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.RemoveValidationSetImageText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="2"
                        Text="{Binding RecipeCommands.ValidationSetFolderBatchLabelText}"
                        VerticalAlignment="Center"
                        Foreground="#A8CBD1"
                        FontSize="10"
                        FontWeight="SemiBold" />
                    <Button Grid.Row="2"
                        Grid.Column="1"
                        MinWidth="112"
                        Height="24"
                        Margin="8,5,0,0"
                        HorizontalAlignment="Left"
                        ToolTip="{Binding RecipeCommands.AddValidationSetFolderToolTipText}"
                        AutomationProperties.AutomationId="HostRecipeAddValidationSetOkFolderButton"
                        Command="{Binding RecipeCommands.AddValidationSetOkFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FolderOutline" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.AddValidationSetOkFolderText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2"
                        Grid.Column="3"
                        MinWidth="112"
                        Height="24"
                        Margin="8,5,0,0"
                        HorizontalAlignment="Left"
                        ToolTip="{Binding RecipeCommands.AddValidationSetFolderToolTipText}"
                        AutomationProperties.AutomationId="HostRecipeAddValidationSetNgFolderButton"
                        Command="{Binding RecipeCommands.AddValidationSetNgFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FolderOutline" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.AddValidationSetNgFolderText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2"
                        Grid.Column="4"
                        Grid.ColumnSpan="2"
                        MinWidth="118"
                        Height="24"
                        Margin="6,5,0,0"
                        HorizontalAlignment="Left"
                        ToolTip="{Binding RecipeCommands.RepairValidationSetImagePathToolTipText}"
                        AutomationProperties.AutomationId="HostRecipeRepairValidationSetImagePathButton"
                        Command="{Binding RecipeCommands.RepairValidationSetImagePathCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="12" Height="12" Margin="0,1,4,0" />
                            <TextBlock Text="{Binding RecipeCommands.RepairValidationSetImagePathText}" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Grid Grid.Row="3"
                        Grid.ColumnSpan="7"
                        Margin="0,5,0,0"
                        ToolTip="{Binding RecipeCommands.ValidationSetVariantContractToolTipText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                            Text="{Binding RecipeCommands.ValidationSetVariantIdLabelText}"
                            Foreground="#A8CBD1"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBox Grid.Column="1"
                            Height="24"
                            Margin="8,0,0,0"
                            Padding="5,2"
                            AutomationProperties.AutomationId="HostRecipeValidationVariantIdTextBox"
                            Text="{Binding RecipeCommands.ValidationSetPendingVariantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding RecipeCommands.ValidationSetMetricNameLabelText}"
                            Foreground="#A8CBD1"
                            FontSize="10"
                            FontWeight="SemiBold" />
                        <TextBox Grid.Column="3"
                            Height="24"
                            Margin="8,0,0,0"
                            Padding="5,2"
                            AutomationProperties.AutomationId="HostRecipeValidationMetricNameTextBox"
                            Text="{Binding RecipeCommands.ValidationSetPendingMetricName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="4"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding RecipeCommands.ValidationSetMetricMinimumLabelText}"
                            Foreground="#A8CBD1"
                            FontSize="10" />
                        <TextBox Grid.Column="5"
                            Height="24"
                            Margin="5,0,0,0"
                            Padding="5,2"
                            AutomationProperties.AutomationId="HostRecipeValidationMetricMinimumTextBox"
                            Text="{Binding RecipeCommands.ValidationSetPendingMetricMinimum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="6"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding RecipeCommands.ValidationSetMetricMaximumLabelText}"
                            Foreground="#A8CBD1"
                            FontSize="10" />
                        <TextBox Grid.Column="7"
                            Height="24"
                            Margin="5,0,0,0"
                            Padding="5,2"
                            AutomationProperties.AutomationId="HostRecipeValidationMetricMaximumTextBox"
                            Text="{Binding RecipeCommands.ValidationSetPendingMetricMaximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="8"
                            Height="24"
                            MinWidth="88"
                            Margin="8,0,0,0"
                            AutomationProperties.AutomationId="HostRecipeApplyValidationVariantButton"
                            Command="{Binding RecipeCommands.ApplyValidationSetVariantContractCommand}"
                            Content="{Binding RecipeCommands.ApplyValidationSetVariantContractText}"
                            FontSize="10" />
                        <Button Grid.Column="9"
                            Height="24"
                            MinWidth="58"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="HostRecipeResetValidationVariantButton"
                            Command="{Binding RecipeCommands.ResetValidationSetVariantContractCommand}"
                            Content="{Binding RecipeCommands.ResetValidationSetVariantContractText}"
                            FontSize="10" />
                    </Grid>
                </Grid>
                <ListBox Grid.Row="3"
                    Grid.ColumnSpan="4"
                    MaxHeight="168"
                    Margin="0,6,0,0"
                    AutomationProperties.AutomationId="HostRecipeValidationSetImageList"
                    ItemsSource="{Binding RecipeCommands.ValidationSetImageRows}"
                    SelectedItem="{Binding RecipeCommands.SelectedValidationSetImageRow, Mode=TwoWay}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    Visibility="{Binding RecipeCommands.IsLocalValidationSetSelected, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Expected}"
                                    Foreground="#95D6B8"
                                    FontSize="10"
                                    FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                    Text="{Binding StateText}"
                                    Foreground="#A8CBD1"
                                    FontSize="10" />
                                <TextBlock Grid.Column="2"
                                    Text="{Binding FileName}"
                                    ToolTip="{Binding Path}"
                                    Foreground="#EAFBFC"
                                    FontSize="10"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3"
                                    Text="{Binding VariantId}"
                                    ToolTip="{Binding ExpectedMetricText}"
                                    Foreground="#FFF1AF"
                                    FontSize="10"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4"
                                    Text="{Binding Notes}"
                                    ToolTip="{Binding Notes}"
                                    Foreground="#D7FFF4"
                                    FontSize="10"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="4"
                    Grid.ColumnSpan="4"
                    Margin="0,6,0,0"
                    AutomationProperties.AutomationId="HostRecipeValidationSuiteSummary"
                    Text="{Binding RecipeCommands.ValidationSuiteSummaryText, Mode=OneWay}"
                    ToolTip="{Binding RecipeCommands.ValidationSuiteSummaryText, Mode=OneWay}"
                    Foreground="#EAFBFC"
                    FontSize="10"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
