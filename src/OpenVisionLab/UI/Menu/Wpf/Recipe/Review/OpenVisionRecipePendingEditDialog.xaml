<Window x:Class="OpenVisionLab.OpenVisionRecipePendingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="560"
        Height="330"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="RecipePendingEditDialog"
        FontFamily="{DynamicResource OpenVision.Workbench.FontFamily}">
    <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/></Window.InputBindings>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PendingEditButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PendingEditPrimaryButtonStyle"
               TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentLineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentTextBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding ShowDiscard}" Value="False">
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.NgSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
            </DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="PendingEditDangerButtonStyle"
               TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.DangerButtonStyle}">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.NgSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
            BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
            BorderThickness="1"
            AutomationProperties.AutomationId="RecipePendingEditDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource OpenVision.Workbench.ChromeBrush}"
                    BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Width="18"
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}">
                            <iconPacks:PackIconMaterial.Style><Style TargetType="iconPacks:PackIconMaterial">
                                <Setter Property="Kind" Value="ContentSaveAlertOutline" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsDeleteConfirmation}" Value="True"><Setter Property="Kind" Value="DeleteOutline" /></DataTrigger></Style.Triggers>
                            </Style></iconPacks:PackIconMaterial.Style>
                        </iconPacks:PackIconMaterial>
                        <TextBlock Text="{Binding TitleText}"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="42"
                            Height="42"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                            ToolTip="{Binding CancelButtonText}"
                            AutomationProperties.AutomationId="RecipePendingEditCloseButton"
                            AutomationProperties.Name="{Binding CancelButtonText}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding CancelCommand}">
                        <iconPacks:PackIconMaterial Kind="Close"
                                                    Width="16"
                                                    Height="16" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding HeadingText}"
                           Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="1"
                           Margin="0,9,0,0"
                           Text="{Binding DetailText}"
                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                           FontSize="12"
                           LineHeight="19"
                           TextWrapping="Wrap" />

                <Border Grid.Row="2"
                        Visibility="{Binding ShowLegacyContext, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}"
                        Margin="0,16,0,18"
                        Padding="12,10"
                        Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                        BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="True"
                                  AutomationProperties.AutomationId="RecipePendingEditContextScroll">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CurrentContextText}"
                                       AutomationProperties.AutomationId="RecipePendingEditCurrentContext"
                                       Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,5,0,0"
                                       Text="{Binding TargetContextText}"
                                       AutomationProperties.AutomationId="RecipePendingEditTargetContext"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                </Border>

                <ScrollViewer Grid.Row="2" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasError, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource OpenVision.Workbench.ErrorBrush}"
                               AutomationProperties.AutomationId="RecipePendingEditSaveError"/>
                </ScrollViewer>
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="pendingCancelButton" Style="{StaticResource PendingEditButtonStyle}"
                            IsCancel="True"
                            IsDefault="{Binding IsCancelDefault}"
                            AutomationProperties.AutomationId="RecipePendingEditCancelButton"
                            Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CancelButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PendingEditDangerButtonStyle}"
                            AutomationProperties.AutomationId="RecipePendingEditDiscardButton"
                            Visibility="{Binding ShowDiscard, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}"
                            Command="{Binding DiscardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DeleteSweepOutline"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DiscardButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PendingEditPrimaryButtonStyle}"
                            IsDefault="{Binding IsApplyDefault}"
                            AutomationProperties.AutomationId="RecipePendingEditApplyButton"
                            Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="15" Height="15" Margin="0,0,6,0">
                                <iconPacks:PackIconMaterial.Style><Style TargetType="iconPacks:PackIconMaterial">
                                    <Setter Property="Kind" Value="ContentSaveCheckOutline" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsDeleteConfirmation}" Value="True"><Setter Property="Kind" Value="DeleteOutline" /></DataTrigger></Style.Triggers>
                                </Style></iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                            <TextBlock Text="{Binding ApplyButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
