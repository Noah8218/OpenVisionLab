<UserControl x:Class="OpenVisionLab.OpenVisionWindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="42"
             Background="{DynamicResource OpenVision.Workbench.ChromeBrush}"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="titleBar"
          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
            <iconPacks:PackIconMaterial x:Name="titleIcon"
                                        Kind="Tune"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                        VerticalAlignment="Center" />
            <TextBlock x:Name="txtTitle"
                       Text="OpenVisionLab"
                       Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                       FontFamily="{DynamicResource OpenVision.Workbench.FontFamily}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Margin="9,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ContentPresenter Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Stretch"
                          Content="{Binding HeaderContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True" />

        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="btnDock"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTip="Dock to right"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="OpenVisionDockToolButton"
                    Click="Dock_Click">
                <iconPacks:PackIconMaterial Kind="WindowRestore" Width="14" Height="14" />
            </Button>
            <Button x:Name="btnMinimize"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTip="Minimize"
                    AutomationProperties.AutomationId="OpenVisionWindowMinimizeButton"
                    Click="Minimize_Click">
                <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="15" Height="15" />
            </Button>
            <Button x:Name="btnMaximize"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTip="Maximize"
                    AutomationProperties.AutomationId="OpenVisionWindowMaximizeRestoreButton"
                    Click="MaximizeRestore_Click">
                <iconPacks:PackIconMaterial x:Name="maximizeIcon" Kind="WindowMaximize" Width="14" Height="14" />
            </Button>
            <Button x:Name="btnClose"
                    Style="{StaticResource ChromeButtonStyle}"
                    ToolTip="Close"
                    AutomationProperties.AutomationId="OpenVisionWindowCloseButton"
                    Click="Close_Click">
                <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
