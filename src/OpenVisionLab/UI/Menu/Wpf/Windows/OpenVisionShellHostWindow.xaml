<Window x:Class="OpenVisionLab.OpenVisionShellHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenVisionLab"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
        Title="OpenVisionLab"
        Width="1600"
        Height="900"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        local:OpenVisionWorkbenchThemeBehavior.ThemeName="{Binding ThemeName}"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ToggleLeftPanelCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ToggleRightPanelCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ToggleBottomPanelCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenRecipeManagerCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenMainNewRecipeCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding OpenMainSaveAsCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding Workspace.LoadImageCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Recipes.SaveRecipeCommand}" />
        <KeyBinding Key="F6" Command="{Binding Images.RunBatchCommand}" CommandParameter="all" />
        <KeyBinding Key="F8" Command="{Binding Tool.RunCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Tool.AddAfterCommand}" />
        <KeyBinding Key="F5" Command="{Binding Pipeline.RunCommand}" />
        <KeyBinding Key="F5" Modifiers="Control" Command="{Binding Pipeline.RunToSelectedCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding Pipeline.StopCommand}" />
        <KeyBinding Key="F1" Command="{Binding Chrome.OpenTutorialCommand}" />
        <KeyBinding Key="OemQuestion" Modifiers="Control" Command="{Binding OpenShortcutsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ToolTip" BasedOn="{StaticResource OpenVision.Workbench.ToolTipStyle}"/>
            <Storyboard x:Key="Main.ProductInfoAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/><DiscreteObjectKeyFrame KeyTime="0:0:3.2" Value="{x:Static Visibility.Collapsed}"/></ObjectAnimationUsingKeyFrames>
            </Storyboard>

            <Style x:Key="Main.LlmCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Border x:Name="focus" BorderBrush="Transparent" BorderThickness="1" Padding="2">
                        <DockPanel>
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" Margin="0,0,6,0" VerticalAlignment="Top">
                                <Path x:Name="check" Data="M 2,7 L 5,10 L 11,3" Stroke="{DynamicResource OpenVision.Workbench.AccentTextBrush}" StrokeThickness="2" Width="12" Height="12" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="box" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="Main.LlmCombo" TargetType="ComboBox" BasedOn="{StaticResource OpenVision.Workbench.LanguageComboBoxStyle}">
                <Setter Property="MinHeight" Value="30"/><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="Main.RecipeTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.RaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineAltBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,0"/><Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}"/><Setter Property="FontSize" Value="13"/><Setter Property="CaretBrush" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="fieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost"/></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="fieldBorder" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="fieldBorder" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="fieldBorder" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="Main.RecipeRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="0,4"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="radioFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="radioRing" Width="14" Height="14" Stroke="{DynamicResource OpenVision.Workbench.LineAltBrush}" Fill="{DynamicResource OpenVision.Workbench.RaisedBrush}" VerticalAlignment="Center"/><Ellipse x:Name="radioDot" Width="6" Height="6" Fill="{DynamicResource OpenVision.Workbench.AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="radioDot" Property="Visibility" Value="Visible"/><Setter TargetName="radioRing" Property="Stroke" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="radioFocus" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="radioFocus" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="radioFocus" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="Main.MenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}"/>
        <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Grid><Border x:Name="menuChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="menuIconColumn" Width="24"/><ColumnDefinition Width="Auto" SharedSizeGroup="MainMenuHeader"/><ColumnDefinition Width="Auto" SharedSizeGroup="MainMenuGesture"/><ColumnDefinition x:Name="menuArrowColumn" Width="16"/></Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="menuIcon" ContentSource="Icon" VerticalAlignment="Center"/>
                    <iconPacks:PackIconMaterial x:Name="menuCheck" Kind="CheckCircle" Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}" Width="16" Height="16" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <ContentPresenter x:Name="menuHeader" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="menuGesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    <iconPacks:PackIconMaterial x:Name="menuArrow" Kind="ChevronRight" Grid.Column="3" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" Width="14" Height="14" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <Border Background="{DynamicResource OpenVision.Workbench.RaisedBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="240" Grid.IsSharedSizeScope="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
                </Border>
            </Popup></Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="menuIconColumn" Property="Width" Value="0"/><Setter TargetName="menuArrowColumn" Property="Width" Value="0"/><Setter TargetName="menuGesture" Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Right"/><Setter TargetName="menuArrow" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="menuChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="menuChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="menuChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="menuCheck" Property="Visibility" Value="Visible"/><Setter TargetName="menuIcon" Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding [Workbench.Tool.Unavailable]}"/><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="menuChrome" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="shellWindowChrome"
                            CaptionHeight="40"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
            BorderThickness="1"
            Background="{DynamicResource OpenVision.Workbench.ChromeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="titleBarRow" Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:OpenVisionWindowTitleBar x:Name="shellTitleBar" IsEnabled="{Binding IsMainInteractive}" Height="40" local:OpenVisionWorkbenchThemeBehavior.ThemeName="{Binding DataContext.ThemeName, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostWindow}}">
  <local:OpenVisionWindowTitleBar.HeaderContent>
    <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:OpenVisionShellHostWindow}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
      <Menu Background="Transparent" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkbenchMainMenu"><Menu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource Main.MenuItemStyle}"/></Menu.Resources><MenuItem Header="{Binding [Workbench.Menu.File]}" AutomationProperties.AutomationId="WorkbenchFileMenu"><MenuItem Header="{Binding [Workbench.Menu.NewRecipe]}" Command="{Binding OpenMainNewRecipeCommand}" InputGestureText="Ctrl+N"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.RecipeManager]}" Command="{Binding OpenRecipeManagerCommand}" InputGestureText="Ctrl+O"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem AutomationProperties.AutomationId="WorkbenchRecentRecipesHeading" Header="{Binding [Workbench.Menu.RecentRecipes]}" IsEnabled="False"/><MenuItem AutomationProperties.AutomationId="WorkbenchRecentRecipesEmpty" Header="{Binding [Workbench.Menu.NoRecentRecipes]}" IsEnabled="False"/><Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.SaveRecipe]}" Command="{Binding Recipes.SaveRecipeCommand}" InputGestureText="Ctrl+S"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.SaveAs]}" Command="{Binding OpenMainSaveAsCommand}" InputGestureText="Ctrl+Shift+S"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.OpenImage]}" Command="{Binding Workspace.LoadImageCommand}" InputGestureText="Ctrl+I"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="ImagePlusOutline" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.OpenFolder]}" Command="{Binding Workspace.OpenFolderCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="FolderImage" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Images.AddSamples]}" Command="{Binding Workspace.OpenSampleCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="ImageMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.SaveImage]}" Command="{Binding Workspace.SaveImageCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="FileExport" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.ImportXml]}" Command="{Binding Recipes.ImportPipelineXmlCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Import" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.ExportXml]}" Command="{Binding ExportMainPipelineXmlCommand}" IsEnabled="{Binding IsMainInteractive}" AutomationProperties.AutomationId="WorkbenchMenuExportXml"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Export" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{Binding [Workbench.Menu.Edit]}"><MenuItem Header="{Binding [Workbench.Menu.Undo]}" Command="{Binding Pipeline.UndoCommand}" InputGestureText="Ctrl+Z"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Undo" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.Redo]}" Command="{Binding Pipeline.RedoCommand}" InputGestureText="Ctrl+Y"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Redo" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.RenameStep]}" Command="{Binding Pipeline.RenameCommand}" InputGestureText="F2"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="PencilOutline" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.DuplicateStep]}" Command="{Binding Pipeline.DuplicateCommand}" InputGestureText="Ctrl+D"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.ToggleStep]}" Command="{Binding Pipeline.ToggleEnabledCommand}" InputGestureText="Ctrl+E"><MenuItem.Icon><iconPacks:PackIconMaterial Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"><iconPacks:PackIconMaterial.Style><Style TargetType="iconPacks:PackIconMaterial"><Setter Property="Kind" Value="EyeOff"/><Style.Triggers><DataTrigger Binding="{Binding Pipeline.SelectedRow.IsEnabled}" Value="False"><Setter Property="Kind" Value="Eye"/></DataTrigger></Style.Triggers></Style></iconPacks:PackIconMaterial.Style></iconPacks:PackIconMaterial></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.MoveUp]}" Command="{Binding Pipeline.MoveUpCommand}" InputGestureText="Alt+↑"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="ArrowUp" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.MoveDown]}" Command="{Binding Pipeline.MoveDownCommand}" InputGestureText="Alt+↓"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="ArrowDown" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.DeleteStep]}" Command="{Binding Pipeline.DeleteCommand}" InputGestureText="Del"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{Binding [Workbench.Menu.View]}" AutomationProperties.AutomationId="WorkbenchViewMenu"><MenuItem Header="{Binding [Workbench.Viewer.Single]}" Command="{Binding Viewer.SingleCommand}" InputGestureText="1" AutomationProperties.AutomationId="WorkbenchMenuSingle" IsCheckable="True" IsChecked="{Binding Viewer.IsSingle, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Viewer.Split2]}" Command="{Binding Viewer.Split2Command}" InputGestureText="2" AutomationProperties.AutomationId="WorkbenchMenuSplit2" IsCheckable="True" IsChecked="{Binding Viewer.IsSplit2, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Viewer.Split4]}" Command="{Binding Viewer.Split4Command}" InputGestureText="4" AutomationProperties.AutomationId="WorkbenchMenuSplit4" IsCheckable="True" IsChecked="{Binding Viewer.IsSplit4, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Viewer.Sync]}" Command="{Binding Viewer.ToggleSyncCommand}" AutomationProperties.AutomationId="WorkbenchMenuSync" IsCheckable="True" IsChecked="{Binding Viewer.IsSyncEnabled, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Viewer.Overlay]}" Command="{Binding Viewer.ToggleOverlayCommand}" AutomationProperties.AutomationId="WorkbenchMenuOverlay" IsCheckable="True" IsChecked="{Binding Viewer.IsOverlayVisible, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Viewer.Roi]}" Command="{Binding Viewer.ToggleRoiCommand}" AutomationProperties.AutomationId="WorkbenchMenuRoi" IsCheckable="True" IsChecked="{Binding Viewer.IsRoiVisible, Mode=OneWay}"/><Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.PipelinePanel]}" Command="{Binding ToggleLeftPanelCommand}" InputGestureText="Ctrl+1" IsCheckable="True" IsChecked="{Binding IsLeftExpanded, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Menu.ToolPanel]}" Command="{Binding ToggleRightPanelCommand}" InputGestureText="Ctrl+2" IsCheckable="True" IsChecked="{Binding IsRightExpanded, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Menu.BottomPanel]}" Command="{Binding ToggleBottomPanelCommand}" InputGestureText="Ctrl+3" IsCheckable="True" IsChecked="{Binding IsBottomExpanded, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Menu.ToolPanelWide]}" Command="{Binding ToggleToolPanelWideCommand}" IsCheckable="True" IsChecked="{Binding IsToolPanelWide, Mode=OneWay}"/><Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.Dark]}" Command="{Binding SelectDarkThemeCommand}" AutomationProperties.AutomationId="WorkbenchMenuDark" IsCheckable="True" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Menu.Light]}" Command="{Binding SelectLightThemeCommand}" AutomationProperties.AutomationId="WorkbenchMenuLight" IsCheckable="True" IsChecked="{Binding IsLightTheme, Mode=OneWay}"/><MenuItem Header="{Binding [Workbench.Menu.ResetLayout]}" Command="{Binding ResetLayoutCommand}" AutomationProperties.AutomationId="WorkbenchResetLayout"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Restore" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="{Binding [Workbench.Menu.Run]}"><MenuItem Header="{Binding [Workbench.Command.RunPipelineCurrent]}" Command="{Binding Pipeline.RunCommand}" ToolTipService.ShowOnDisabled="True" InputGestureText="F5"><MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource Main.MenuItemStyle}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding Pipeline.RunDisabledReason}"/></Trigger></Style.Triggers></Style></MenuItem.Style><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Play" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Command.RunToStep]}" Command="{Binding Pipeline.RunToSelectedCommand}" ToolTipService.ShowOnDisabled="True" InputGestureText="Ctrl+F5"><MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource Main.MenuItemStyle}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding Pipeline.RunToDisabledReason}"/></Trigger></Style.Triggers></Style></MenuItem.Style><MenuItem.Icon><iconPacks:PackIconMaterial Kind="DebugStepOver" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Command.RunStepOnly]}" Command="{Binding Tool.RunCommand}" InputGestureText="F8"><MenuItem.Icon><iconPacks:PackIconMaterial Kind="PlayOutline" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Command.BatchAll]}" Command="{Binding Images.RunBatchCommand}" ToolTipService.ShowOnDisabled="True" InputGestureText="F6" CommandParameter="all" AutomationProperties.AutomationId="WorkbenchMenuBatchAll"><MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource Main.MenuItemStyle}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding Images.BatchDisabledReason}"/></Trigger></Style.Triggers></Style></MenuItem.Style><MenuItem.Icon><iconPacks:PackIconMaterial Kind="PlaylistPlay" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Command.BatchSelected]}" Command="{Binding Images.RunBatchCommand}" ToolTipService.ShowOnDisabled="True" CommandParameter="selected" AutomationProperties.AutomationId="WorkbenchMenuBatchSelected"><MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource Main.MenuItemStyle}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding Images.SelectedBatchDisabledReason}"/></Trigger></Style.Triggers></Style></MenuItem.Style><MenuItem.Icon><iconPacks:PackIconMaterial Kind="PlaylistPlay" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><MenuItem Header="{Binding [Workbench.Menu.Stop]}" Command="{Binding Pipeline.StopCommand}" ToolTipService.ShowOnDisabled="True" InputGestureText="Shift+F5"><MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource Main.MenuItemStyle}"><Setter Property="ToolTip" Value="{Binding [Workbench.Command.StopTooltip]}"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding Pipeline.StopDisabledReason}"/></Trigger></Style.Triggers></Style></MenuItem.Style><MenuItem.Icon><iconPacks:PackIconMaterial Kind="Stop" Width="16" Height="16" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></MenuItem.Icon></MenuItem><Separator Style="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/><MenuItem Header="{Binding [Workbench.Menu.RunHistory]}" Command="{Binding OpenMainHistoryCommand}"><MenuItem.Icon><iconPacks:PackIconMaterial K