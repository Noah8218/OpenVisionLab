                        <StackPanel Margin="16"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="RobotOutline" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock Text="{Binding [Workbench.Llm.Title]}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding [Workbench.Llm.ManualNote]}" TextWrapping="Wrap" Margin="0,8,0,4"/><TextBlock Text="{Binding MainLlmContext}" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" TextWrapping="Wrap"/>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="{Binding [Workbench.Llm.Request]}" Command="{Binding SelectMainLlmStageCommand}" CommandParameter="1" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding MainLlmStage}" Value="1"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="1" Content="{Binding [Workbench.Llm.Response]}" Command="{Binding SelectMainLlmStageCommand}" CommandParameter="2" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding MainLlmStage}" Value="2"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="2" Content="{Binding [Workbench.Llm.Review]}" Command="{Binding SelectMainLlmStageCommand}" CommandParameter="3" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding MainLlmStage}" Value="3"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Padding="16,0,16,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                            <StackPanel Visibility="{Binding IsMainLlmRequest, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding [Workbench.Llm.Goal]}" Margin="0,0,0,5"/><TextBox x:Name="mainLlmGoal" Text="{Binding Recipes.LlmInspectionGoalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="74" VerticalScrollBarVisibility="Auto" Style="{StaticResource Main.RecipeTextBox}" AutomationProperties.Name="{Binding [Workbench.Llm.Goal]}"/>
                                <TextBlock Text="{Binding [Workbench.Llm.Intent]}" Margin="0,10,0,5"/><ComboBox x:Name="mainLlmIntent" ItemsSource="{Binding Recipes.LlmToolTemplateOptions}" SelectedItem="{Binding Recipes.SelectedLlmToolTemplate, Mode=TwoWay}" Style="{StaticResource Main.LlmCombo}" HorizontalAlignment="Left" Width="320"/>
                                <WrapPanel Margin="0,10,0,8"><CheckBox x:Name="mainLlmIncludePipeline" Content="{Binding [Workbench.Llm.IncludePipeline]}" IsChecked="{Binding MainLlmIncludePipeline, Mode=TwoWay}" Style="{StaticResource Main.LlmCheckBox}" Margin="0,0,16,0"/><CheckBox x:Name="mainLlmIncludeImage" Content="{Binding [Workbench.Llm.IncludeImage]}" IsChecked="{Binding MainLlmIncludeImage, Mode=TwoWay}" Style="{StaticResource Main.LlmCheckBox}"/></WrapPanel>
                                <TextBlock Text="{Binding [Workbench.Llm.PendingPromptBoundary]}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/><TextBlock Text="{Binding [Workbench.Llm.ImageBoundary]}" TextWrapping="Wrap" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="mainLlmBuildPrompt" Content="{Binding [Workbench.Llm.BuildPrompt]}" Command="{Binding BuildMainLlmPromptCommand}" Style="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="{Binding [Workbench.Llm.CopyPrompt]}" Command="{Binding Recipes.CopyLlmPromptCommand}" Style="{StaticResource OpenVision.Workbench.ButtonStyle}"/></StackPanel>
                                <TextBox x:Name="mainLlmPrompt" Text="{Binding Recipes.LlmPromptText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" Style="{StaticResource Main.RecipeTextBox}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsMainLlmResponse, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}" IsVisibleChanged="MainLlmResponse_IsVisibleChanged">
                                <TextBlock Text="{Binding [Workbench.Llm.Xml]}" Margin="0,0,0,5"/><TextBox x:Name="mainLlmXml" Text="{Binding Recipes.LlmXmlDraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" Height="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource Main.RecipeTextBox}" AutomationProperties.Name="{Binding [Workbench.Llm.Xml]}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10"><Button x:Name="mainLlmValidate" Content="{Binding [Workbench.Llm.Validate]}" Command="{Binding ValidateMainLlmCommand}" Style="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="{Binding [Workbench.Llm.Paste]}" Command="{Binding Recipes.PasteLlmXmlDraftFromClipboardCommand}" Style="{StaticResource OpenVision.Workbench.ButtonStyle}"/></StackPanel>
                                <TextBox x:Name="mainLlmValidation" Text="{Binding Recipes.LlmXmlDraftValidationReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" Style="{StaticResource Main.RecipeTextBox}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsMainLlmReview, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}" IsVisibleChanged="MainLlmReview_IsVisibleChanged">
                                <TextBlock x:Name="mainLlmReviewNotReady" Text="{Binding [Workbench.Llm.ValidateBeforeSave]}" TextWrapping="Wrap" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Recipes.IsLlmXmlDraftReady}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBlock Text="{Binding [Workbench.Llm.NewName]}" Margin="0,0,0,5"/><TextBox x:Name="mainLlmName" Text="{Binding MainLlmName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" Style="{StaticResource Main.RecipeTextBox}" AutomationProperties.Name="{Binding [Workbench.Llm.NewName]}"/>
                                <TextBlock Text="{Binding [Workbench.Llm.CompareBoundary]}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,8" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/>
                                <Grid Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding [Workbench.Llm.Index]}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="1" Text="{Binding [Workbench.Llm.StepName]}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="2" Text="{Binding [Workbench.Llm.Tool]}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="3" Text="{Binding [Workbench.Llm.Route]}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="4" Text="{Binding [Workbench.Llm.Judgment]}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="5" Text="{Binding [Workbench.Llm.Compare]}" TextWrapping="Wrap" Margin="4,8"/></Grid>
                                <ItemsControl x:Name="mainLlmReviewRows" ItemsSource="{Binding Recipes.LlmDraftReviewRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Key.Index}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="1" Text="{Binding Key.Name}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="2" Text="{Binding Key.ToolType}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="3" Text="{Binding Key.LayerRouteText}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="4" Text="{Binding Key.AcceptanceDetailText}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="5" Text="{Binding Value}" TextWrapping="Wrap" Margin="4,8"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="{Binding Recipes.LlmXmlDraftDependencyReport}" TextWrapping="Wrap" Margin="0,8" FontSize="12"/>
                                <CheckBox x:Name="mainLlmOpenSaved" Content="{Binding [Workbench.Llm.OpenSaved]}" IsChecked="{Binding MainLlmOpenSaved, Mode=TwoWay}" Style="{StaticResource Main.LlmCheckBox}" Margin="0,10,0,6"/>
                                <TextBlock Text="{Binding [Workbench.Llm.SaveBoundary]}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="mainLlmError" Text="{Binding MainLlmError}" Foreground="{DynamicResource OpenVision.Workbench.NgBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel></ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,1,0,0" Padding="16,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="mainLlmClose" Content="{Binding [Common.Close]}" Command="{Binding CloseMainLlmCommand}" Style="{StaticResource OpenVision.Workbench.ButtonStyle}" Margin="0,0,8,0"/><Button x:Name="mainLlmNext" Content="{Binding [Workbench.Llm.Next]}" Command="{Binding NextMainLlmStageCommand}" Visibility="{Binding IsMainLlmNext, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}" Style="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}"/><Button x:Name="mainLlmSave" Content="{Binding [Workbench.Llm.SaveNew]}" Command="{Binding SaveMainLlmCommand}" Visibility="{Binding IsMainLlmReview, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}" Style="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}" IsDefault="True"/></StackPanel></Border>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="mainHistoryOverlay" Grid.RowSpan="2" Panel.ZIndex="50" Background="#8C05070A" Visibility="{Binding IsMainHistoryOpen, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}" IsVisibleChanged="MainHistory_IsVisibleChanged">
                <Button Command="{Binding CloseMainHistoryCommand}" Background="Transparent" Focusable="False" IsTabStop="False"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template></Button>
                <Border x:Name="mainHistoryFrame" Width="1170" MaxWidth="{Binding MainHistoryMaximumWidth}" MaxHeight="{Binding MainRecipeMaximumHeight}" Margin="20,30" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource OpenVision.Workbench.PanelBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" TextElement.FontFamily="{DynamicResource OpenVision.Workbench.FontFamily}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="16"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="History" Width="24" Height="24" Margin="0,0,10,0"/><TextBlock Text="{Binding [Workbench.History.Title]}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding [Workbench.History.Note]}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/></StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="12,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="{Binding [Workbench.History.Empty]}" Visibility="{Binding HasNoMainHistory, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}" Margin="8"/>
                            <TextBlock Text="{Binding MainHistoryError}" Foreground="{DynamicResource OpenVision.Workbench.NgBrush}" TextWrapping="Wrap"/>
                            <Grid Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="250"/><ColumnDefinition Width="45"/><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding [Workbench.History.Date]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="1" Text="{Binding [Workbench.History.Pipeline]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="2" Text="{Binding [Workbench.History.N]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="3" Text="{Binding [Workbench.History.OK]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="4" Text="{Binding [Workbench.History.NG]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="5" Text="{Binding [Workbench.History.Error]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="6" Text="{Binding [Workbench.History.Match]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="7" Text="{Binding [Workbench.History.FalseAccept]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="8" Text="{Binding [Workbench.History.FalseReject]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="9" Text="{Binding [Workbench.History.Average]}" TextWrapping="Wrap" Margin="4"/><TextBlock Grid.Column="10" Text="{Binding [Workbench.History.P95]}" TextWrapping="Wrap" Margin="4"/></Grid>
                            <ListBox x:Name="mainHistoryRows" ItemsSource="{Binding MainHistoryRows}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"/><Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="250"/><ColumnDefinition Width="45"/><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="65"/><ColumnDefinition Width="65"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding HistoryStarted}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="2" Text="{Binding HistoryCount}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="3" Text="{Binding HistoryOk}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="4" Text="{Binding HistoryNg}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="5" Text="{Binding HistoryError}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="6" Text="{Binding HistoryMatch}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="7" Text="{Binding HistoryFalseAccept}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="8" Text="{Binding HistoryFalseReject}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="9" Text="{Binding HistoryAverage}" TextWrapping="Wrap" Margin="4,8"/><TextBlock Grid.Column="10" Text="{Binding HistoryP95}" TextWrapping="Wrap" Margin="4,8"/><StackPanel Grid.Column="1" Margin="4,8"><TextBlock Text="{Binding HistoryPipeline}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding HistorySource}" TextWrapping="Wrap"/><TextBlock Text="{Binding HistorySnapshot}" TextWrapping="Wrap" FontSize="10"/><TextBlock Text="{Binding HistoryCoverage}" TextWrapping="Wrap" FontSize="10"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </StackPanel></ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,1,0,0" Padding="16,12"><Button x:Name="mainHistoryClose" Command="{Binding CloseMainHistoryCommand}" Content="{Binding [Common.Close]}" Style="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}" HorizontalAlignment="Right" IsDefault="True"/></Border>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="mainShortcutsOverlay" Grid.RowSpan="2" Panel.ZIndex="50" Background="#8C05070A"
                  Visibility="{Binding IsShortcutsOpen, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}"
                  IsVisibleChanged="MainShortcuts_IsVisibleChanged">
                <Button x:Name="mainShortcutsScrim" Command="{Binding CloseShortcutsCommand}" Background="Transparent" Focusable="False" IsTabStop="False">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template>
                </Button>
                <Border x:Name="mainShortcutsFrame" Width="560" MaxHeight="{Binding ShortcutsMaximumHeight}" Margin="20,30"
                        HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"
                        Background="{DynamicResource OpenVision.Workbench.PanelBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1"
                        KeyboardNavigation.TabNavigation="Cycle" TextElement.FontFamily="{DynamicResource OpenVision.Workbench.FontFamily}" TextElement.Foreground="{DynamicResource OpenVision.Workbench.TextBrush}">
                    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="12" Opacity="0.35"/></Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="KeyboardOutline" Width="24" Height="24" Margin="0,0,10,0" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="mainShortcutsTitle" Grid.Column="1" Text="{Binding [Workbench.Menu.Shortcuts]}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="mainShortcutsHeaderClose" Grid.Column="2" Command="{Binding CloseShortcutsCommand}" Style="{StaticResource OpenVision.Workbench.ButtonStyle}"
                                        Width="28" Height="28" Padding="0" ToolTip="{Binding ShortcutsCloseText}" AutomationProperties.Name="{Binding ShortcutsCloseText}">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="mainShortcutsScroll" Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="mainShortcutsRows" ItemsSource="{Binding ShortcutRows}" FontSize="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,0,1">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger></Style.Triggers></Style></Border.Style>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontFamily="{DynamicResource OpenVision.Workbench.MonospaceFontFamily}" Padding="8,5"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Padding="8,5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                            <Button x:Name="mainShortcutsClose" Command="{Binding CloseShortcutsCommand}" Content="{Binding [Common.Close]}" Style="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}" HorizontalAlignment="Right" IsDefault="True"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="mainProductInfoToast" Grid.RowSpan="2" Panel.ZIndex="40" Visibility="Collapsed" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" MinWidth="260" MaxWidth="{Binding ProductInfoMaximumWidth}"
                    CornerRadius="4" Background="{DynamicResource OpenVision.Workbench.RaisedBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1">
                <Border.RenderTransform><TranslateTransform X="{Binding ProductInfoHorizontalOffset}"/></Border.RenderTransform>
                <Border BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}" BorderThickness="3,0,0,0" Padding="12,9">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"/>
                        <TextBlock x:Name="mainProductInfoText" Grid.Column="1" Text="{Binding MainNoticeText}" FontFamily="{DynamicResource OpenVision.Workbench.FontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
