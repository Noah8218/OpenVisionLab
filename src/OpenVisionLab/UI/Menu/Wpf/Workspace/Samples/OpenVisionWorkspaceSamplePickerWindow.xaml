<Window x:Class="OpenVisionLab.OpenVisionWorkspaceSamplePickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenVisionLab"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding DialogTitleText}"
        Width="1040" Height="742" MinWidth="940" MinHeight="662"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="WorkspaceSamplePickerWindow">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../../../Wpf/OpenVisionLabWpfTheme.xaml"/><ResourceDictionary Source="../../../../Wpf/OpenVisionWorkbenchDark.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}"/></ResourceDictionary></Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
            BorderThickness="1"
            Background="{DynamicResource OpenVision.Workbench.BackgroundBrush}">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <local:OpenVisionWindowTitleBar x:Name="samplePickerTitleBar"
                                        Grid.Row="0"
                                        AutomationProperties.AutomationId="WorkspaceSamplePickerTitleBar" />

        <local:OpenVisionWorkspaceSamplePickerView Grid.Row="1" />

        <Border Grid.Row="2"
                Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0"
                              Margin="0,0,12,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="True"
                              AutomationProperties.AutomationId="WorkspaceSamplePickerSelectionSummaryScroll">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding SelectionSummaryText}"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <Button Grid.Column="3"
                        MinWidth="124"
                        Height="32"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        IsEnabled="{Binding CanSelect}"
                        Command="{Binding AcceptSelectionCommand}"
                        Style="{StaticResource OpenVision.Workbench.PrimaryButtonStyle}"
                        AutomationProperties.AutomationId="WorkspaceSamplePickerOpenButton">
                    <TextBlock Text="{Binding OpenButtonText}"
                               FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Grid.Column="2"
                        MinWidth="150"
                        Height="32"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding CanOpenLearnAndSample}"
                        Command="{Binding OpenLearnAndSelectCommand}"
                        Background="{DynamicResource OpenVision.Workbench.AccentSoftBrush}"
                        BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                        AutomationProperties.AutomationId="WorkspaceSamplePickerOpenGuideAndSampleButton"
                        Visibility="{Binding LearnWorkflowVisibility}">
                    <TextBlock Text="{Binding OpenLearnAndSampleButtonText}"
                               FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Grid.Column="1"
                        MinWidth="92"
                        Height="32"
                        IsCancel="True"
                        Background="{DynamicResource OpenVision.Workbench.PanelBrush}"
                        BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                        Click="Cancel_Click"
                        AutomationProperties.AutomationId="WorkspaceSamplePickerCancelButton">
                    <TextBlock Text="{Binding CancelButtonText}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
        </Border>
      </Grid>
    </Border>
</Window>
