<UserControl x:Class="OpenVisionLab.OpenVisionWorkspaceSamplePickerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:local="clr-namespace:OpenVisionLab"
             local:OpenVisionWorkbenchThemeBehavior.ThemeName="{Binding Path=(local:OpenVisionWorkbenchThemeBehavior.ThemeName), RelativeSource={RelativeSource AncestorType=Window}}"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource OpenVision.Workbench.BackgroundBrush}"
             AutomationProperties.AutomationId="WorkspaceSamplePickerView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="SamplePicker.DarkPreviewBrush" Color="#05090A" />

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="0,4"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="radioFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse x:Name="radioRing" Width="14" Height="14" Stroke="{DynamicResource OpenVision.Workbench.LineAltBrush}" Fill="{DynamicResource OpenVision.Workbench.RaisedBrush}" VerticalAlignment="Center"/><Ellipse x:Name="radioDot" Width="6" Height="6" Fill="{DynamicResource OpenVision.Workbench.AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="radioDot" Property="Visibility" Value="Visible"/><Setter TargetName="radioRing" Property="Stroke" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="radioFocus" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="radioFocus" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="radioFocus" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SamplePicker.SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
        </Style>

        <Style x:Key="SamplePicker.PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SamplePicker.TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource OpenVision.ControlTextBoxStyle}">
                <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.BackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
        </Style>

        <Style x:Key="SamplePicker.SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SamplePicker.ListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter>
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="16" Visibility="{Binding ImageWorkflowVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding ImageSelectionNotice}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,12"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="imageOnlySamples" ItemsSource="{Binding SamplesView}" SelectedItem="{Binding SelectedSample, Mode=TwoWay}" Style="{StaticResource SamplePicker.ListBoxStyle}" Margin="0,0,12,0" AutomationProperties.AutomationId="SampleImageChoiceList">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding SampleName}" TextWrapping="Wrap" TextTrimming="None" Margin="8"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1"><Image Source="{Binding SelectedImageSource}" Height="150" Stretch="Uniform" Margin="0,0,0,10"/><TextBlock Text="{Binding SelectionSummaryText}" TextWrapping="Wrap" TextTrimming="None"/></StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <RadioButton Content="{Binding ImageSetText}" IsChecked="{Binding SelectSet, Mode=TwoWay}" GroupName="ImageRole" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" Margin="0,0,0,8"/>
            <RadioButton Content="{Binding ImageOneText}" IsChecked="{Binding SelectOne, Mode=TwoWay}" GroupName="ImageRole" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" Margin="0,0,0,8"/>
            <RadioButton Content="{Binding ImageUnlabeledText}" IsChecked="{Binding SelectUnlabeled, Mode=TwoWay}" GroupName="ImageRole" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"/>
            <TextBlock Text="{Binding ImageRoleSummary}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
    <Grid Background="{DynamicResource OpenVision.Workbench.BackgroundBrush}" Margin="16" Visibility="{Binding LearnWorkflowVisibility}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SamplePicker.PanelStyle}"
                Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding HeaderText}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding IntroText}"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               Margin="0,4,22,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SearchLabelText}"
                               Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                    <TextBox AutomationProperties.AutomationId="WorkspaceSamplePickerSearchBox"
                             Style="{StaticResource SamplePicker.TextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding SearchHintText}"
                             Margin="0,5,0,0" />
                    <TextBlock Text="{Binding ResultCountText}"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource SamplePicker.PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" MinHeight="280" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,9">
                        <TextBlock Text="{Binding CatalogSourceLabelText}"
                                   Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerRouteSummary"
                                       Text="{Binding ActiveRouteSummaryText}"
                                       Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,0,0,6" />
                            <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerCatalogSourceSummary"
                                       Text="{Binding ActiveCatalogSourceText}"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />
                            <ListBox AutomationProperties.AutomationId="WorkspaceSamplePickerCatalogSourceList"
                                     Style="{StaticResource SamplePicker.ListBoxStyle}"
                                     ItemsSource="{Binding CatalogSourceOptions}"
                                     SelectedItem="{Binding SelectedCatalogSourceOption, Mode=TwoWay}"
                                     Margin="0,8,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="126"
                                              Margin="8,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SampleCountText}"
                                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,9">
                        <TextBlock Text="{Binding SampleFocusLabelText}"
                                   Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerSampleFocusSummary"
                                       Text="{Binding ActiveSampleFocusText}"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />
                            <ListBox AutomationProperties.AutomationId="WorkspaceSamplePickerSampleFocusList"
                                     Style="{StaticResource SamplePicker.ListBoxStyle}"
                                     ItemsSource="{Binding SampleFocusOptions}"
                                     SelectedItem="{Binding SelectedSampleFocusOption, Mode=TwoWay}"
                                     MaxHeight="118"
                                     Margin="0,8,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="88"
                                              Margin="8,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SampleCountText}"
                                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4"
                            Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,9">
                        <TextBlock Text="{Binding LearnPathLabelText}"
                                   Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                    </Border>

                    <Border Grid.Row="5"
                            Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerLearnPathSummary"
                                       Text="{Binding ActiveLearnPathText}"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />
                            <ListBox AutomationProperties.AutomationId="WorkspaceSamplePickerLearnPathList"
                                     Style="{StaticResource SamplePicker.ListBoxStyle}"
                                     ItemsSource="{Binding LearnPathOptions}"
                                     SelectedItem="{Binding SelectedLearnPathOption, Mode=TwoWay}"
                                     MaxHeight="150"
                                     Margin="0,8,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="92"
                                              Margin="8,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SampleCountText}"
                                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <TextBlock Text="{Binding ListTitleText}"
                                   Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                    </Border>

                    <ListBox Grid.Row="2"
                             AutomationProperties.AutomationId="WorkspaceSamplePickerList"
                             Style="{StaticResource SamplePicker.ListBoxStyle}"
                             ItemsSource="{Binding SamplesView}"
                             SelectedItem="{Binding SelectedSample, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding SampleName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Category}"
                                               Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Goal}"
                                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               MaxHeight="34"
                                               Margin="0,4,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource SamplePicker.PanelStyle}"
                    AutomationProperties.AutomationId="WorkspaceSamplePickerDetail">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DetailTitleText}"
                                           Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                                <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerSelectedSummary"
                                           Text="{Binding SelectionSummaryText}"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                                <Border AutomationProperties.AutomationId="WorkspaceSamplePickerBenchmarkStrip"
                                        Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                        BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                        BorderThickness="1"
                                        Padding="8,6"
                                        Margin="0,8,24,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding BenchmarkLabelText}"
                                                   Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BenchmarkOutcomeText}"
                                                       Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" / "
                                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding BenchmarkPairText}"
                                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding BenchmarkSummaryText}"
                                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   AutomationProperties.AutomationId="WorkspaceSamplePickerExploreGuide"
                                                   Text="{Binding ExploratoryGuideText}"
                                                   Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   MaxHeight="44"
                                                   Margin="0,7,0,0"
                                                   Visibility="{Binding ExploratoryGuideVisibility}" />
                                        <Grid Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              Margin="0,7,0,0"
                                              Visibility="{Binding PairDecisionVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerPairDecisionQuickAction"
                                                       Text="{Binding PairDecisionQuickActionText}"
                                                       Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None"
                                                       MaxHeight="44" />
                                            <Button Grid.Column="1"
                                                    AutomationProperties.AutomationId="WorkspaceSamplePickerSelectCounterpartQuickButton"
                                                    Style="{StaticResource SamplePicker.SecondaryButtonStyle}"
                                                    Command="{Binding SelectCounterpartSampleCommand}"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding SelectCounterpartSampleButtonText}"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Row="3"
                                                   Grid.ColumnSpan="2"
                                                   AutomationProperties.AutomationId="WorkspaceSamplePickerPairDecisionQuickMetric"
                                                   Text="{Binding PairDecisionMetricText}"
                                                   Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   MaxHeight="42"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding PairDecisionVisibility}" />
                                        <TextBlock Grid.Row="4"
                                                   Grid.ColumnSpan="2"
                                                   AutomationProperties.AutomationId="WorkspaceSamplePickerPairDecisionQuickWorkflow"
                                                   Text="{Binding PairDecisionQuickWorkflowText}"
                                                   Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   MaxHeight="34"
                                                   Margin="0,5,0,0"
                                                   Visibility="{Binding PairDecisionVisibility}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Width="300">
                                <TextBlock Text="{Binding ManualPreviewNoticeText}" Visibility="{Binding LearnWorkflowVisibility}"
                                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                                <Border AutomationProperties.AutomationId="WorkspaceSamplePickerPracticeWorkflowStrip"
                                        Visibility="{Binding LearnWorkflowVisibility}"
                                        Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                        BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                        BorderThickness="1"
                                        Padding="8,6"
                                        Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PracticeWorkflowLabelText}"
                                                   Style="{StaticResource SamplePicker.SectionTitleStyle}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding PracticeWorkflowText}"
                                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                        BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                        BorderThickness="1"
                                        Padding="8,6"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding LearnDocumentLabelText}"
                                                   Style="{StaticResource SamplePicker.SectionTitleStyle}"
                                                   FontSize="11" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding LearnDocumentDescriptionText}"
                                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None"
                                                   Margin="0,4,0,0" />
                                        <Button Grid.Row="2"
                                                AutomationProperties.AutomationId="WorkspaceSamplePickerOpenLearnDocumentButton"
                                                Style="{StaticResource SamplePicker.SecondaryButtonStyle}"
                                                Command="{Binding OpenLearnDocumentCommand}"
                                                IsEnabled="{Binding HasLearnDocument}"
                                                HorizontalAlignment="Right"
                                                Margin="0,7,0,0">
                                            <TextBlock Text="{Binding OpenLearnDocumentButtonText}"
                                                       FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SamplePicker.DarkPreviewBrush}"
                                BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                BorderThickness="1">
                            <Image AutomationProperties.AutomationId="WorkspaceSamplePickerPreviewImage"
                                   Source="{Binding SelectedImageSource}"
                                   Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding ImageLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock Text="{Binding SelectedImageText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="{Binding PipelineLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock Text="{Binding SelectedPipelineText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="{Binding PairLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock Text="{Binding SelectedSample.PairText}"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                       Margin="0,4,0,0" />
                            <Border AutomationProperties.AutomationId="WorkspaceSamplePickerPairComparisonStrip"
                                    Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                    BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                    BorderThickness="1"
                                    Padding="8,6"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding PairComparisonVisibility}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PairComparisonLabelText}"
                                               Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PairComparisonSummaryText}"
                                               Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="11" />
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding PairComparisonDetailText}"
                                               Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               FontSize="11"
                                               MaxHeight="48"
                                               Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="12,0,12,12">
                        <StackPanel>
                            <Border AutomationProperties.AutomationId="WorkspaceSamplePickerPairDecisionGuide"
                                    Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                    BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                    BorderThickness="1"
                                    Padding="10,8"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding PairDecisionVisibility}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding PairDecisionLabelText}"
                                               Style="{StaticResource SamplePicker.SectionTitleStyle}"
                                               FontSize="11" />
                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="WorkspaceSamplePickerSelectCounterpartButton"
                                            Style="{StaticResource SamplePicker.SecondaryButtonStyle}"
                                            Command="{Binding SelectCounterpartSampleCommand}"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding SelectCounterpartSampleButtonText}"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding PairDecisionSummaryText}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,5,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               AutomationProperties.AutomationId="WorkspaceSamplePickerPairDecisionNextAction"
                                               Text="{Binding PairDecisionNextActionText}"
                                               Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="3"
                                               Grid.ColumnSpan="2"
                                               AutomationProperties.AutomationId="WorkspaceSamplePickerPairDecisionChecklist"
                                               Text="{Binding PairDecisionChecklistText}"
                                               Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="4"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding PairDecisionMetricText}"
                                               Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="5"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding PairDecisionWorkflowText}"
                                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,6,0,0" />
                                </Grid>
                            </Border>

                            <Border AutomationProperties.AutomationId="WorkspaceSamplePickerLearnModeStrip"
                                    Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                    BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                                    BorderThickness="1"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding LearnModeLabelText}"
                                               Style="{StaticResource SamplePicker.SectionTitleStyle}"
                                               FontSize="11" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding LearnModeText}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="{Binding RecommendedStartLabelText}"
                                               Style="{StaticResource SamplePicker.SectionTitleStyle}"
                                               FontSize="11"
                                               Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding RecommendedStartText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="{Binding ResultExplanationLabelText}"
                                               Style="{StaticResource SamplePicker.SectionTitleStyle}"
                                               FontSize="11"
                                               Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding ResultExplanationText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="{Binding FailureCauseLabelText}"
                                               Style="{StaticResource SamplePicker.SectionTitleStyle}"
                                               FontSize="11"
                                               Margin="0,7,0,0" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding FailureCauseText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,7,0,0" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding GoalLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock Text="{Binding SelectedSample.Goal}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,4,0,12" />

                            <TextBlock Text="{Binding FlowLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerToolFlow"
                                       Text="{Binding SelectedSample.ToolFlowText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,4,0,12" />

                            <TextBlock Text="{Binding ExpectedLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock AutomationProperties.AutomationId="WorkspaceSamplePickerExpected"
                                       Text="{Binding SelectedSample.ExpectedText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,4,0,12" />

                            <TextBlock Text="{Binding CheckLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock Text="{Binding SelectedSample.CheckGuideText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,4,0,12" />

                            <TextBlock Text="{Binding FixLabelText}"
                                       Style="{StaticResource SamplePicker.SectionTitleStyle}" />
                            <TextBlock Text="{Binding SelectedSample.FixGuideText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
