<Window x:Class="OpenVisionLab.OpenGlTemplateEditorWindow"
        x:Name="root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:imageCanvasViews="clr-namespace:OpenVisionLab.ImageCanvas.Views;assembly=OpenVisionLab.ImageCanvas"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Template registration"
        Width="1040"
        Height="700"
        MinWidth="840"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TemplateChromeButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#EAF5F7" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonChrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonChrome" Property="Background" Value="#405057" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="buttonChrome" Property="Background" Value="#157C86" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TemplateToolButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenVision.StrongLineBrush}" />
                <Setter Property="Background" Value="#F9FBFC" />
                <Setter Property="Foreground" Value="{StaticResource OpenVision.TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#E6F1F2" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OpenVision.AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#D8ECEE" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TemplatePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TemplateToolButtonStyle}">
                <Setter Property="Height" Value="38" />
                <Setter Property="Background" Value="{StaticResource OpenVision.AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenVision.AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="TemplateFieldStyle" TargetType="TextBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource OpenVision.TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OpenVision.StrongLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>

            <Style x:Key="TemplateLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource OpenVision.MutedTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource OpenVision.AccentBrush}"
            BorderThickness="1"
            Background="{StaticResource OpenVision.SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid x:Name="titleBar"
                  Background="{StaticResource OpenVision.ChromeBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CropFree"
                                                Width="18"
                                                Height="18"
                                                Foreground="#8AD7DA"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="Template registration"
                               Foreground="#F5FAFC"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TemplateChromeButtonStyle}" ToolTip="Minimize" Click="Minimize_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource TemplateChromeButtonStyle}" ToolTip="Maximize" Click="MaximizeRestore_Click">
                        <iconPacks:PackIconMaterial x:Name="maximizeIcon" Kind="WindowMaximize" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource TemplateChromeButtonStyle}" ToolTip="Close" Click="Cancel_Click">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#07090B"
                        BorderBrush="{StaticResource OpenVision.StrongLineBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        ClipToBounds="True">
                    <Grid x:Name="viewerHost"
                          Background="#07090B"
                          ClipToBounds="True"
                          Focusable="True"
                          SizeChanged="ViewerHost_SizeChanged"
                          MouseWheel="ViewerHost_MouseWheel"
                          MouseLeftButtonDown="ViewerHost_MouseLeftButtonDown"
                          MouseLeftButtonUp="ViewerHost_MouseLeftButtonUp"
                          MouseMove="ViewerHost_MouseMove"
                          MouseDown="ViewerHost_MouseDown"
                          MouseUp="ViewerHost_MouseUp">
                        <imageCanvasViews:RoiImageCanvasView x:Name="glCanvas"
                                                             Visibility="Collapsed"
                                                             ShowStatusBar="True"
                                                             ShowToolBar="False"
                                                             ClipToBounds="True" />
                        <Canvas x:Name="wpfViewerCanvas"
                                Background="#07090B"
                                ClipToBounds="True">
                            <Canvas x:Name="wpfImageLayer">
                                <Image x:Name="wpfSourceImage"
                                       Stretch="Fill"
                                       SnapsToDevicePixels="True" />
                                <Rectangle x:Name="wpfRoiRectangle"
                                           Stroke="#FFFFD200"
                                           StrokeThickness="2"
                                           Fill="#22FFD200"
                                           IsHitTestVisible="False" />
                                <Canvas x:Name="wpfRoiHandleLayer"
                                        IsHitTestVisible="False" />
                            </Canvas>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource OpenVision.BandBrush}"
                            BorderBrush="{StaticResource OpenVision.LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Template ROI"
                                       FontFamily="Segoe UI"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource OpenVision.TextBrush}" />
                            <TextBlock x:Name="statusText"
                                       Text="Ready"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="{StaticResource OpenVision.MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource OpenVision.PanelBrush}"
                            BorderBrush="{StaticResource OpenVision.LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Selection"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OpenVision.TextBrush}" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="X" Style="{StaticResource TemplateLabelStyle}" />
                                <TextBox x:Name="txtX" Grid.Column="1" Style="{StaticResource TemplateFieldStyle}" />
                                <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource TemplateLabelStyle}" />
                                <TextBox x:Name="txtY" Grid.Column="4" Style="{StaticResource TemplateFieldStyle}" />
                                <TextBlock Grid.Row="2" Text="W" Style="{StaticResource TemplateLabelStyle}" />
                                <TextBox x:Name="txtWidth" Grid.Row="2" Grid.Column="1" Style="{StaticResource TemplateFieldStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="H" Style="{StaticResource TemplateLabelStyle}" />
                                <TextBox x:Name="txtHeight" Grid.Row="2" Grid.Column="4" Style="{StaticResource TemplateFieldStyle}" />
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rotation"
                                           Style="{StaticResource TemplateLabelStyle}" />
                                <TextBox x:Name="txtRotation"
                                         Grid.Column="1"
                                         Style="{StaticResource TemplateFieldStyle}"
                                         IsReadOnly="False"
                                         ToolTip="Selected ROI rotation angle. Drag the rotation handle beside the ROI or enter a value."
                                         TextChanged="RotationText_TextChanged" />
                                <Button Grid.Column="3"
                                        Style="{StaticResource TemplateToolButtonStyle}"
                                        Padding="0"
                                        ToolTip="Rotate ROI left 90 degrees"
                                        Click="RotateLeft_Click">
                                    <TextBlock Text="-90" />
                                </Button>
                                <Button Grid.Column="5"
                                        Style="{StaticResource TemplateToolButtonStyle}"
                                        Padding="0"
                                        ToolTip="Rotate ROI right 90 degrees"
                                        Click="RotateRight_Click">
                                    <TextBlock Text="+90" />
                                </Button>
                                <Button Grid.Column="7"
                                        Style="{StaticResource TemplateToolButtonStyle}"
                                        Padding="0"
                                        ToolTip="Reset ROI rotation"
                                        Click="ResetRotation_Click">
                                    <TextBlock Text="0" />
                                </Button>
                            </Grid>
                            <UniformGrid Grid.Row="6" Columns="3">
                                <Button Style="{StaticResource TemplateToolButtonStyle}" Margin="0,0,6,0" ToolTip="Fit image to view" Click="FitView_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Fullscreen" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="Fit" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TemplateToolButtonStyle}" Margin="0,0,6,0" ToolTip="Center template ROI" Click="CenterRoi_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ImageFilterCenterFocus" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource TemplateToolButtonStyle}" ToolTip="Use full image" Click="FullRoi_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CropFree" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="Full" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            Background="{StaticResource OpenVision.PanelBrush}"
                            BorderBrush="{StaticResource OpenVision.LineBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="150" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Pattern Preview"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OpenVision.TextBrush}" />
                            <Border Grid.Row="2"
                                    Background="#07090B"
                                    BorderBrush="{StaticResource OpenVision.StrongLineBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="patternPreviewImage" Stretch="Uniform" />
                                    <TextBlock x:Name="patternPreviewEmptyText"
                                               Text="No pattern preview"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               Foreground="#9AAEB8" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2"
                  Background="{StaticResource OpenVision.BandBrush}"
                  Margin="1,0,1,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="footerText"
                           Grid.Column="0"
                           Text="Ready"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource OpenVision.MutedTextBrush}" />
                <Button Grid.Column="1"
                        Style="{StaticResource TemplateToolButtonStyle}"
                        Click="Cancel_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource TemplatePrimaryButtonStyle}"
                        Click="Ok_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Check" Width="15" Height="15" Margin="0,0,7,0" />
                        <TextBlock Text="Register" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
