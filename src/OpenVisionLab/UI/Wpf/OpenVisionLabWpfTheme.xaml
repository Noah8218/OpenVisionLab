<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="OpenVisionWorkbenchDark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="OpenVision.ChromeBrush" Color="#30383B" />
    <SolidColorBrush x:Key="OpenVision.ChromeAltBrush" Color="#445057" />
    <SolidColorBrush x:Key="OpenVision.ChromeDarkBrush" Color="#121A1E" />
    <SolidColorBrush x:Key="OpenVision.WorkspaceBrush" Color="#05090A" />
    <SolidColorBrush x:Key="OpenVision.RailBrush" Color="#101A1F" />
    <SolidColorBrush x:Key="OpenVision.SurfaceBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="OpenVision.PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OpenVision.BandBrush" Color="#EAF1F4" />
    <SolidColorBrush x:Key="OpenVision.InspectorSurfaceBrush" Color="#E7EEF1" />
    <SolidColorBrush x:Key="OpenVision.InspectorPanelBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="OpenVision.InspectorBandBrush" Color="#DDE8ED" />
    <SolidColorBrush x:Key="OpenVision.InspectorFieldBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OpenVision.InspectorLineBrush" Color="#BFD0D8" />
    <SolidColorBrush x:Key="OpenVision.LineBrush" Color="#D6E1E6" />
    <SolidColorBrush x:Key="OpenVision.StrongLineBrush" Color="#8BA0AD" />
    <SolidColorBrush x:Key="OpenVision.TextBrush" Color="#243040" />
    <SolidColorBrush x:Key="OpenVision.MutedTextBrush" Color="#657487" />
    <SolidColorBrush x:Key="OpenVision.AccentBrush" Color="#157C86" />
    <SolidColorBrush x:Key="OpenVision.AccentSoftBrush" Color="#D8ECEE" />
    <SolidColorBrush x:Key="OpenVision.OkBrush" Color="#0D7A55" />
    <SolidColorBrush x:Key="OpenVision.WarnBrush" Color="#9A6400" />

    <!-- Explicit opt-in controls: parameter editors retain their own resources. -->
    <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="#E8F2F3" />
    <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="#CCE5E8" />
    <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="#E8EEF1" />
    <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="#5D6B76" />
    <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="#B8C7CE" />
    <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="#157C86" />
    <SolidColorBrush x:Key="OpenVision.ControlErrorBrush" Color="#B42318" />

    <Style x:Key="OpenVision.ControlButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.StrongLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="buttonChrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="focusCue" Margin="2" CornerRadius="4"
                                BorderThickness="2" BorderBrush="{DynamicResource OpenVision.ControlFocusBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{DynamicResource OpenVision.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{DynamicResource OpenVision.ControlPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusCue" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.ControlFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{DynamicResource OpenVision.ControlDisabledBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.ControlDisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.ControlDisabledTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OpenVision.ControlPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.ControlButtonStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="#116A72" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="#0E5960" />
            <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="#A8D8DE" />
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource OpenVision.AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.AccentBrush}" />
    </Style>
    <Style x:Key="OpenVision.ControlButtonDarkStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.ControlButtonStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="#36505A" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="#193B43" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="#252F34" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="#ADBDC4" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="#50626A" />
            <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="#8AD7DA" />
        </Style.Resources>
        <Setter Property="Foreground" Value="#EAF5F7" />
        <Setter Property="Background" Value="#26383F" />
        <Setter Property="BorderBrush" Value="#65818C" />
    </Style>
    <Style x:Key="OpenVision.ControlPrimaryButtonDarkStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.ControlButtonDarkStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="#116A72" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="#0E5960" />
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource OpenVision.AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#64BAC3" />
    </Style>
    <Style x:Key="OpenVision.ControlDangerButtonDarkStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.ControlButtonDarkStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="#733C43" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="#542930" />
        </Style.Resources>
        <Setter Property="Background" Value="#482C32" />
        <Setter Property="BorderBrush" Value="#C68188" />
        <Setter Property="Foreground" Value="#FFE1E4" />
    </Style>
    <Style x:Key="OpenVision.ControlTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.StrongLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource OpenVision.AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="fieldChrome" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <Border x:Name="focusCue" CornerRadius="6" BorderThickness="2"
                                BorderBrush="{DynamicResource OpenVision.ControlFocusBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fieldChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.ControlFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="fieldChrome" Property="Background" Value="{DynamicResource OpenVision.ControlDisabledBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="focusCue" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="fieldChrome" Property="Background" Value="{DynamicResource OpenVision.ControlDisabledBrush}" />
                            <Setter TargetName="fieldChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.ControlDisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.ControlDisabledTextBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="fieldChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.ControlErrorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OpenVision.ControlTextBoxDarkStyle" TargetType="TextBox" BasedOn="{StaticResource OpenVision.ControlTextBoxStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="#252F34" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="#ADBDC4" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="#50626A" />
            <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="#8AD7DA" />
            <SolidColorBrush x:Key="OpenVision.ControlErrorBrush" Color="#FFADB4" />
        </Style.Resources>
        <Setter Property="Background" Value="#24363D" />
        <Setter Property="Foreground" Value="#F5FAFC" />
        <Setter Property="CaretBrush" Value="#8FE8F0" />
        <Setter Property="BorderBrush" Value="#82969D" />
    </Style>

    <Style x:Key="OpenVision.ControlComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.PanelBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="itemChrome"
                            Background="{TemplateBinding Background}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.ControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OpenVision.ControlComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OpenVision.ControlComboBoxItemStyle}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="9,0,30,0" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.StrongLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MaxDropDownHeight" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid Height="{TemplateBinding Height}"
                          MinWidth="{TemplateBinding MinWidth}"
                          HorizontalAlignment="Stretch">
                        <Border x:Name="comboFocusGlow"
                                Margin="-2"
                                BorderBrush="{DynamicResource OpenVision.ControlFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Opacity="0" />
                        <Border x:Name="comboChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="contentSite"
                                              Grid.Column="0"
                                              Margin="9,0,4,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="arrowBackground"
                                    Grid.Column="1"
                                    Background="{DynamicResource OpenVision.BandBrush}"
                                    BorderBrush="{DynamicResource OpenVision.LineBrush}"
                                    BorderThickness="1,0,0,0"
                                    CornerRadius="0,3,3,0" />
                            <Path x:Name="comboDropGlyph"
                                  Grid.Column="1"
                                  Width="8"
                                  Height="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 5 L 8 0 Z"
                                  Fill="{DynamicResource OpenVision.MutedTextBrush}" />
                        </Grid>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="9,0,30,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 Focusable="True"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Style="{x:Null}"
                                 Visibility="Hidden" />
                        <ToggleButton x:Name="toggleButton"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Slide">
                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{DynamicResource OpenVision.PanelBrush}"
                                        BorderBrush="{DynamicResource OpenVision.AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          Color="#40515A"
                                                          Direction="270"
                                                          Opacity="0.18"
                                                          ShadowDepth="3" />
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.ControlFocusBrush}" />
                            <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.AccentBrush}" />
                            <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.ControlPressedBrush}" />
                            <Setter TargetName="arrowBackground" Property="Background" Value="{DynamicResource OpenVision.AccentSoftBrush}" />
                            <Setter TargetName="comboDropGlyph" Property="Fill" Value="{DynamicResource OpenVision.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.AccentBrush}" />
                            <Setter TargetName="comboFocusGlow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="contentSite" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="toggleButton" Property="Width" Value="30" />
                            <Setter TargetName="toggleButton" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="MinHeight" Value="44" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.ControlDisabledTextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource OpenVision.ControlDisabledBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.ControlDisabledBorderBrush}" />
                            <Setter TargetName="comboChrome" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="comboDropGlyph" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="arrowBackground" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="arrowBackground" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OpenVision.ControlComboBoxDarkStyle" TargetType="ComboBox" BasedOn="{StaticResource OpenVision.ControlComboBoxStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.PanelBrush" Color="#193038" />
            <SolidColorBrush x:Key="OpenVision.TextBrush" Color="#F5FAFC" />
            <SolidColorBrush x:Key="OpenVision.MutedTextBrush" Color="#CADCE0" />
            <SolidColorBrush x:Key="OpenVision.BandBrush" Color="#24363D" />
            <SolidColorBrush x:Key="OpenVision.LineBrush" Color="#506E79" />
            <SolidColorBrush x:Key="OpenVision.AccentSoftBrush" Color="#105F68" />
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="#36505A" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="#193B43" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="#252F34" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="#ADBDC4" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="#50626A" />
            <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="#8AD7DA" />
        </Style.Resources>
        <Setter Property="Background" Value="#24363D" />
        <Setter Property="Foreground" Value="#F5FAFC" />
        <Setter Property="BorderBrush" Value="#82969D" />
    </Style>
    <ControlTemplate x:Key="OpenVision.Workbench.LanguageComboBoxTemplate" TargetType="ComboBox">
        <Grid Height="{TemplateBinding Height}" MinWidth="{TemplateBinding MinWidth}">
            <Border x:Name="comboFocusGlow" Margin="-2" BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}" BorderThickness="2" CornerRadius="5" Opacity="0" />
            <Border x:Name="comboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
            <ContentPresenter x:Name="contentSite" Margin="6,0,18,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectedItem}" ContentTemplate="{TemplateBinding ItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
            <Path x:Name="comboDropGlyph" Width="8" Height="5" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Data="M 0 0 L 4 5 L 8 0 Z" Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" />
            <ToggleButton Background="Transparent" BorderThickness="0" ClickMode="Press" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Slide">
                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer Margin="1" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}" />
                <Setter TargetName="comboDropGlyph" Property="Fill" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter TargetName="comboFocusGlow" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
                <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
                <Setter TargetName="comboDropGlyph" Property="Fill" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="OpenVision.Workbench.LanguageComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="itemChrome" Background="{TemplateBinding Background}" MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OpenVision.Workbench.LanguageComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource OpenVision.ControlComboBoxStyle}">
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="9,0,18,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OpenVision.Workbench.LanguageComboBoxItemStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
        <Setter Property="Template" Value="{StaticResource OpenVision.Workbench.LanguageComboBoxTemplate}" />
        <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OpenVision.ControlToggleStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.StrongLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="buttonChrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="selectedCue" Height="3" Margin="7,0,7,2" CornerRadius="1" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="focusCue" Margin="2" CornerRadius="4"
                                BorderThickness="2" BorderBrush="{DynamicResource OpenVision.ControlFocusBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="selectedCue" Property="Visibility" Value="Visible" />
                            <Setter TargetName="buttonChrome" Property="Background" Value="{DynamicResource OpenVision.AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{DynamicResource OpenVision.ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{DynamicResource OpenVision.ControlPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusCue" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{DynamicResource OpenVision.ControlDisabledBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.ControlDisabledBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.ControlDisabledTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OpenVision.ControlToggleDarkStyle" TargetType="ToggleButton" BasedOn="{StaticResource OpenVision.ControlToggleStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.AccentSoftBrush" Color="#105F68" />
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="#36505A" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="#193B43" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="#252F34" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="#ADBDC4" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="#50626A" />
            <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="#8AD7DA" />
        </Style.Resources>
        <Setter Property="Foreground" Value="#EAF5F7" />
        <Setter Property="Background" Value="#26383F" />
        <Setter Property="BorderBrush" Value="#65818C" />
    </Style>

    <Style x:Key="OpenVision.ResultCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource OpenVision.AccentSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.AccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OpenVision.ResultHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.BandBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OpenVision.ResultGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{DynamicResource OpenVision.PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.LineBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource OpenVision.LineBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="MinRowHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CellStyle" Value="{StaticResource OpenVision.ResultCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource OpenVision.ResultHeaderStyle}" />
    </Style>

    <Style x:Key="OpenVision.Workbench.ButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.ControlButtonStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="buttonChrome" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="focusCue" Margin="2" CornerRadius="4"
                                BorderThickness="2" BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusCue" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OpenVision.Workbench.PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentHoverBrush}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentHoverBrush}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" /><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OpenVision.Workbench.DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.Workbench.ButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.NgSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.NgBrush}" />
    </Style>

    <BooleanToVisibilityConverter x:Key="OpenVision.Workbench.BooleanToVisibilityConverter" />
    <Style x:Key="OpenVision.Workbench.ToolTipStyle" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.RaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}"/><Setter Property="FontSize" Value="12"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter></Border></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="OpenVision.Workbench.MenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.LineAltBrush}"/>
        <Setter Property="Height" Value="1"/><Setter Property="Margin" Value="4,4"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="OpenVision.Workbench.MenuItemStyle" TargetType="MenuItem">
        <Style.Resources>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource OpenVision.Workbench.MenuSeparatorStyle}"/>
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}"/>
        <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Grid><Border x:Name="menuChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="menuIconColumn" Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="menuArrowColumn" Width="16"/></Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="menuIcon" ContentSource="Icon" VerticalAlignment="Center"/>
                    <iconPacks:PackIconMaterial x:Name="menuCheck" Kind="Check" Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}" Width="14" Height="14" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="menuGesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    <iconPacks:PackIconMaterial x:Name="menuArrow" Kind="ChevronRight" Grid.Column="3" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" Width="14" Height="14" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <Border Background="{DynamicResource OpenVision.Workbench.RaisedBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="240">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
                </Border>
            </Popup></Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="menuIconColumn" Property="Width" Value="0"/><Setter TargetName="menuArrowColumn" Property="Width" Value="0"/><Setter TargetName="menuGesture" Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Right"/><Setter TargetName="menuArrow" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="menuChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="menuChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="menuChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="menuCheck" Property="Visibility" Value="Visible"/><Setter TargetName="menuIcon" Property="Visibility" Value="Collapsed"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="{Binding [Workbench.Tool.Unavailable]}"/><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/><Setter TargetName="menuChrome" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OpenVision.Workbench.BottomTabsStyle" TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="64"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tabChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tabChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="tabChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="tabChrome" Property="BorderThickness" Value="1,1,1,2"/><Setter TargetName="tabChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource OpenVision.Workbench.LineBrush}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True" Margin="4,0,40,0"/></Border>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="8" Visibility="{Binding Tag.IsBottomExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource OpenVision.Workbench.BooleanToVisibilityConverter}}"/>
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
