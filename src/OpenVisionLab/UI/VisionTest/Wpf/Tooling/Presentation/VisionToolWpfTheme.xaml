<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:behaviors="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
                    xmlns:local="clr-namespace:OpenVisionLab">
    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary Source="../../../../Wpf/OpenVisionLabWpfTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="VisionTool.SurfaceBrush" Color="{DynamicResource OpenVision.Workbench.PanelBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.PanelBrush" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.HeaderBrush" Color="{DynamicResource OpenVision.Workbench.RaisedBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.HeaderBorderBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.LineBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.FieldBorderBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.PrimaryTextBrush" Color="{DynamicResource OpenVision.Workbench.TextBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SecondaryTextBrush" Color="{DynamicResource OpenVision.Workbench.SecondaryTextBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.DisabledTextBrush" Color="{DynamicResource OpenVision.Workbench.MutedTextBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.AccentBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.ActionTextBrush" Color="{DynamicResource OpenVision.Workbench.AccentOnSoftBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.HoverBrush" Color="{DynamicResource OpenVision.Workbench.HoverBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.DownBrush" Color="{DynamicResource OpenVision.Workbench.PressedBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SelectionBrush" Color="{DynamicResource OpenVision.Workbench.AccentSoftBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SelectedButtonTextBrush" Color="{DynamicResource OpenVision.Workbench.TextBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.FieldHoverBorderBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.FieldFocusGlowBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.FieldArrowBrush" Color="{DynamicResource OpenVision.Workbench.SecondaryTextBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.FieldArrowBackgroundBrush" Color="{DynamicResource OpenVision.Workbench.RaisedBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.IconButtonFillBrush" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.IconButtonHoverFillBrush" Color="{DynamicResource OpenVision.Workbench.HoverBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.IconButtonDownFillBrush" Color="{DynamicResource OpenVision.Workbench.PressedBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SliderTrackGrooveBrush" Color="{DynamicResource OpenVision.Workbench.LineAltBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SliderTrackBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SliderHoverTrackBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SliderThumbBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.SliderThumbBorderBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{DynamicResource OpenVision.Workbench.ScrollBrush.Color}" />
    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="{DynamicResource OpenVision.Workbench.SecondaryTextBrush.Color}" />
    <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="{DynamicResource OpenVision.Workbench.PanelBrush.Color}" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.PreviewBackgroundBrush" Color="{DynamicResource OpenVision.Workbench.CanvasBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.PreviewBorderBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.PreviewHoverBorderBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.ActionFillBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.ActionFillHoverBrush" Color="{DynamicResource OpenVision.Workbench.AccentHoverBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.ActionFillDownBrush" Color="{DynamicResource OpenVision.Workbench.AccentHoverBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.ActionFillTextBrush" Color="{DynamicResource OpenVision.Workbench.AccentTextBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.FlowRailBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.FlowNodeBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.StatusSuccessBrush" Color="{DynamicResource OpenVision.Workbench.OkBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.StatusWarningBrush" Color="{DynamicResource OpenVision.Workbench.StaleBrush.Color}" />
    <SolidColorBrush x:Key="VisionTool.StatusErrorBrush" Color="{DynamicResource OpenVision.Workbench.NgBrush.Color}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource OpenVision.Workbench.PanelBrush.Color}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
    <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource OpenVision.Workbench.TextBrush.Color}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource OpenVision.Workbench.SecondaryTextBrush.Color}" />
    <SolidColorBrush x:Key="ActionBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />

    <Style TargetType="ToolTip" BasedOn="{StaticResource OpenVision.Workbench.ToolTipStyle}" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.SecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.HeaderBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                          ContentSource="Header"
                                          Margin="8,0,8,-1"
                                          RecognizesAccessKey="True" />
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionTool.WorkbenchRouteStyle" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border>
                        <DockPanel LastChildFill="True">
                            <ContentPresenter DockPanel.Dock="Left" ContentSource="Header" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="VisionTool.WorkbenchLayerNameTemplate">
        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="Normal" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Text" Value="{Binding}" />
                    <Style.Triggers><DataTrigger Binding="{Binding}" Value="Main"><Setter Property="Text" Value="{DynamicResource VisionTool.WorkbenchOriginalText}" /></DataTrigger></Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="VisionTool.WorkbenchInputLayerTemplate">
        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="Normal" ToolTip="{Binding Value}" />
    </DataTemplate>

    <ControlTemplate x:Key="VisionTool.WorkbenchComboBoxTemplate" TargetType="{x:Type ComboBox}">
        <Grid Height="{TemplateBinding Height}"
              MinWidth="{TemplateBinding MinWidth}"
              HorizontalAlignment="Stretch">
            <Border x:Name="comboFocusGlow"
                    Margin="-2"
                    BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    Opacity="0" />
            <Border x:Name="comboChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" />
            <Grid IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="contentSite"
                                  Grid.Column="0"
                                  Margin="9,0,4,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding SelectedItem}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  ContentTemplate="{TemplateBinding ItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <Border x:Name="arrowBackground"
                        Grid.Column="1"
                        Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                        BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,3,3,0" />
                <Path x:Name="comboDropGlyph"
                      Grid.Column="1"
                      Width="8"
                      Height="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 5 L 8 0 Z"
                      Fill="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
            </Grid>
            <TextBox x:Name="PART_EditableTextBox"
                     Margin="9,0,30,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Background="Transparent"
                     Foreground="{TemplateBinding Foreground}"
                     CaretBrush="{TemplateBinding Foreground}"
                     Focusable="True"
                     IsReadOnly="{TemplateBinding IsReadOnly}"
                     Style="{x:Null}"
                     Visibility="Hidden" />
            <ToggleButton x:Name="toggleButton"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          ClickMode="Press"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                   PopupAnimation="Slide">
                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <Border Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14"
                                              Color="#40515A"
                                              Direction="270"
                                              Opacity="0.18"
                                              ShadowDepth="3" />
                        </Border.Effect>
                    </Border>
                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}" />
                <Setter TargetName="arrowBackground" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" />
                <Setter TargetName="comboDropGlyph" Property="Fill" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter TargetName="comboFocusGlow" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="contentSite" Property="Visibility" Value="Hidden" />
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="toggleButton" Property="Width" Value="30" />
                <Setter TargetName="toggleButton" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="PART_Popup" Property="MinHeight" Value="44" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
                <Setter TargetName="comboChrome" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="comboChrome" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="comboDropGlyph" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="arrowBackground" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="arrowBackground" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="VisionTool.WorkbenchRouteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource OpenVision.ControlComboBoxStyle}">
        <Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="Template" Value="{StaticResource VisionTool.WorkbenchComboBoxTemplate}" />
        <Setter Property="ItemTemplate" Value="{StaticResource VisionTool.WorkbenchLayerNameTemplate}" />
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" /></Style></Setter.Value></Setter>
    </Style>

    <Style x:Key="VisionTool.PreviewFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VisionTool.PreviewBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.PreviewBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource VisionTool.PreviewHoverBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="29" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.FieldBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="itemChrome"
                            Background="{TemplateBinding Background}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="9,0,30,0" />
        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MaxDropDownHeight" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid Height="{TemplateBinding Height}"
                          MinWidth="{TemplateBinding MinWidth}"
                          HorizontalAlignment="Stretch">
                        <Border x:Name="comboFocusGlow"
                                Margin="-2"
                                BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Opacity="0" />
                        <Border x:Name="comboChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="contentSite"
                                              Grid.Column="0"
                                              Margin="9,0,4,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Border x:Name="arrowBackground"
                                    Grid.Column="1"
                                    Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                                    BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"
                                    BorderThickness="1,0,0,0"
                                    CornerRadius="0,3,3,0" />
                            <Path x:Name="arrow"
                                  Grid.Column="1"
                                  Width="8"
                                  Height="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 5 L 8 0 Z"
                                  Fill="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                        </Grid>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="9,0,30,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 Focusable="True"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Style="{x:Null}"
                                 Visibility="Hidden" />
                        <ToggleButton x:Name="toggleButton"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Slide">
                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                                        BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          Color="#40515A"
                                                          Direction="270"
                                                          Opacity="0.18"
                                                          ShadowDepth="3" />
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                            <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                            <Setter TargetName="comboChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}" />
                            <Setter TargetName="arrowBackground" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                            <Setter TargetName="comboFocusGlow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="contentSite" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="toggleButton" Property="Width" Value="30" />
                            <Setter TargetName="toggleButton" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="MinHeight" Value="44" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
                            <Setter TargetName="comboChrome" Property="Opacity" Value="0.55" />
                            <Setter TargetName="arrowBackground" Property="Opacity" Value="0.55" />
                            <Setter TargetName="arrow" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionTool.LayerComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource OpenVision.ControlComboBoxStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.PanelBrush" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.TextBrush" Color="{DynamicResource OpenVision.Workbench.TextBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.MutedTextBrush" Color="{DynamicResource OpenVision.Workbench.SecondaryTextBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.LineBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.StrongLineBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.BandBrush" Color="{DynamicResource OpenVision.Workbench.RaisedBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.AccentBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.AccentSoftBrush" Color="{DynamicResource OpenVision.Workbench.AccentSoftBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="{DynamicResource OpenVision.Workbench.HoverBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="{DynamicResource OpenVision.Workbench.PressedBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="{DynamicResource OpenVision.Workbench.MutedTextBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
            <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.FieldBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
    </Style>

    <Style x:Key="VisionTool.ButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenVision.ControlButtonStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="{Binding Color, Source={StaticResource VisionTool.HoverBrush}}" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="{Binding Color, Source={StaticResource VisionTool.DownBrush}}" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="{Binding Color, Source={StaticResource VisionTool.PanelBrush}}" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="{Binding Color, Source={StaticResource VisionTool.DisabledTextBrush}}" />
            <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="{Binding Color, Source={StaticResource VisionTool.FieldBorderBrush}}" />
            <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="{Binding Color, Source={StaticResource VisionTool.AccentBrush}}" />
        </Style.Resources>
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource VisionTool.ButtonStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.ActionTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="VisionTool.IconButtonStyle" TargetType="Button" BasedOn="{StaticResource VisionTool.ButtonStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource VisionTool.IconButtonFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="VisionTool.PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource VisionTool.ButtonStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="{Binding Color, Source={StaticResource VisionTool.ActionFillHoverBrush}}" />
            <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="{Binding Color, Source={StaticResource VisionTool.ActionFillDownBrush}}" />
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource VisionTool.ActionFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.ActionFillTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.ActionFillBrush}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="checkChrome"
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource VisionTool.PanelBrush}"
                                BorderBrush="{StaticResource VisionTool.FieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Path x:Name="checkMark"
                                  Width="9"
                                  Height="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1 3.5 L 3.5 6 L 8 1"
                                  Stretch="Fill"
                                  Stroke="{StaticResource VisionTool.ActionFillTextBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2"
                                  Opacity="0" />
                        </Border>
                        <ContentPresenter Grid.Column="2"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldHoverBorderBrush}" />
                            <Setter TargetName="checkChrome" Property="Background" Value="{StaticResource VisionTool.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkChrome" Property="Background" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="checkChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="checkMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="checkChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <Style x:Key="VisionTool.SegmentedRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="segmentChrome"
                            MinWidth="{TemplateBinding MinWidth}"
                            Height="{TemplateBinding Height}"
                            Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                            BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            <Border x:Name="selectionIndicator"
                                    Height="2"
                                    Margin="6,0,6,2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource OpenVision.Workbench.TextBrush}"
                                    CornerRadius="1"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="segmentChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}" />
                            <Setter TargetName="segmentChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="segmentChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentSoftBrush}" />
                            <Setter TargetName="segmentChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                            <Setter TargetName="selectionIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="segmentChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionToolSliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="8"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionToolSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Width="18" Height="24" ClipToBounds="False">
                        <Border x:Name="thumbChrome"
                                Width="18"
                                Height="22"
                                Margin="0,1"
                                Background="{StaticResource VisionTool.SliderThumbBrush}"
                                BorderBrush="{StaticResource VisionTool.SliderThumbBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="5" />
                        <Border x:Name="thumbGrip"
                                Width="2"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource VisionTool.SliderThumbBorderBrush}"
                                CornerRadius="1"
                                Opacity="0.45" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbChrome" Property="Background" Value="White" />
                            <Setter TargetName="thumbGrip" Property="Background" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbGrip" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbChrome" Property="Background" Value="{StaticResource VisionTool.DownBrush}" />
                            <Setter TargetName="thumbChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbGrip" Property="Background" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbGrip" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="thumbChrome" Property="Opacity" Value="0.45" />
                            <Setter TargetName="thumbGrip" Property="Opacity" Value="0.25" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource VisionTool.SliderTrackBrush}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Height="{TemplateBinding Height}"
                          ClipToBounds="False"
                          SnapsToDevicePixels="True">
                        <Border Height="12"
                                Margin="9,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource VisionTool.SliderTrackGrooveBrush}"
                                BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6" />
                        <Track x:Name="PART_Track"
                               Margin="9,0"
                               VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Background="{TemplateBinding Foreground}"
                                              Command="Slider.DecreaseLarge"
                                              Style="{StaticResource VisionToolSliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Background="{TemplateBinding Background}"
                                              Command="Slider.IncreaseLarge"
                                              Style="{StaticResource VisionToolSliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VisionToolSliderThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource VisionTool.SliderHoverTrackBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="VisionTool.WorkbenchSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="switchRail" CornerRadius="9" Background="{DynamicResource OpenVision.Workbench.StrongLineBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" BorderThickness="1" />
                        <Ellipse x:Name="switchThumb" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        <Border x:Name="switchFocus" Margin="-3" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource OpenVision.Workbench.AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="switchRail" Property="Background" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                            <Setter TargetName="switchRail" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                            <Setter TargetName="switchThumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="switchThumb" Property="Fill" Value="{DynamicResource OpenVision.Workbench.AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="switchRail" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="switchRail" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="switchFocus" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="VisionTool.WorkbenchTemplateCard">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <iconPacks:PackIconMaterial Kind="ImageSearch" Width="14" Height="14" Margin="0,0,6,0"
                                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [Workbench.Tool.Template]}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="72" Height="56" Background="{DynamicResource OpenVision.Workbench.CanvasBrush}"
                        BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                    <Grid>
                        <Image x:Name="templateThumbnail" Source="{Binding TemplateThumbnail}" Stretch="Uniform" Margin="1"
                               AutomationProperties.AutomationId="WorkbenchTemplateThumbnail" />
                        <iconPacks:PackIconMaterial x:Name="templateMissingIcon" Kind="ImageOffOutline" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OpenVision.Workbench.MutedTextBrush}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="templateInfo" Text="{Binding TemplateInfo}" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding TemplatePath}" Margin="0,0,0,6"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" AutomationProperties.AutomationId="WorkbenchTemplateInfo" />
                    <WrapPanel>
                        <Button x:Name="templateDrawButton" Command="{Binding DrawTemplateCommand}" Style="{DynamicResource OpenVision.Workbench.PrimaryButtonStyle}"
                                Padding="8,2" Height="32" FontSize="12" Margin="0,0,6,0" AutomationProperties.AutomationId="WorkbenchTemplateDraw">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="SelectionDrag" Width="14" Height="14" Margin="0,0,5,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding DrawTemplateText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="templateFileButton" Command="{Binding TemplateFileCommand}" Style="{DynamicResource OpenVision.Workbench.ButtonStyle}"
                                Padding="8,2" Height="32" FontSize="12" AutomationProperties.AutomationId="WorkbenchTemplateFile">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" Margin="0,0,5,0"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding [Workbench.Tool.TemplateFile]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="templateError" Text="{Binding TemplateErrorText}" Foreground="{DynamicResource OpenVision.Workbench.ErrorBrush}"
                       FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="WorkbenchTemplateError" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasTemplateError}" Value="True"><Setter TargetName="templateError" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding HasTemplate}" Value="True"><Setter TargetName="templateMissingIcon" Property="Visibility" Value="Collapsed" /><Setter TargetName="templateDrawButton" Property="Style" Value="{DynamicResource OpenVision.Workbench.ButtonStyle}" /></DataTrigger>
            <DataTrigger Binding="{Binding HasTemplate}" Value="False"><Setter TargetName="templateInfo" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.StaleBrush}" /><Setter TargetName="templateThumbnail" Property="Visibility" Value="Collapsed" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="VisionTool.WorkbenchResultTemplate">
        <Border Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}"
                BorderThickness="1" CornerRadius="5" Padding="10,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                    <Border x:Name="resultChip" CornerRadius="4" Padding="7,2" Background="{DynamicResource OpenVision.Workbench.RaisedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial x:Name="previousIcon" Kind="AlertOutline" Width="13" Height="13" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="resultStatus" Text="{Binding ResultStatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" AutomationProperties.AutomationId="WorkbenchResultStatus" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ResultElapsedText}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" AutomationProperties.AutomationId="WorkbenchResultElapsed" />
                    </StackPanel>
                    <StackPanel x:Name="autoRunOption" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding [Workbench.Result.AutoRunTooltip]}">
                        <TextBlock Text="{Binding [Workbench.Result.AutoRun]}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                        <ToggleButton Style="{StaticResource VisionTool.WorkbenchSwitchStyle}" IsChecked="{Binding IsAutoRunEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanToggleAutoRun}" AutomationProperties.Name="{Binding [Workbench.Result.AutoRun]}" AutomationProperties.AutomationId="WorkbenchAutoRun" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="resultSummary" Text="{Binding ResultSummaryText}" Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" AutomationProperties.AutomationId="WorkbenchResultSummary" />
                <ItemsControl ItemsSource="{Binding ResultMetrics}" Margin="0,4,0,0" AutomationProperties.AutomationId="WorkbenchResultMetrics">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,8,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" TextWrapping="Wrap" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="resultReason" Text="{Binding ResultReason}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource OpenVision.Workbench.ErrorBrush}" AutomationProperties.AutomationId="WorkbenchResultReason" />
                <TextBlock x:Name="resultHint" Text="{Binding ResultHint}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" AutomationProperties.AutomationId="WorkbenchResultHint" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasAutoRunOption}" Value="False"><Setter TargetName="autoRunOption" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultSummaryText}" Value=""><Setter TargetName="resultSummary" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultReason}" Value=""><Setter TargetName="resultReason" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultHint}" Value=""><Setter TargetName="resultHint" Property="Visibility" Value="Collapsed" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultKind}" Value="Ok"><Setter TargetName="resultChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.OkSoftBrush}" /><Setter TargetName="resultStatus" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.OkBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultKind}" Value="Ng"><Setter TargetName="resultChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.NgSoftBrush}" /><Setter TargetName="resultStatus" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}" /><Setter TargetName="resultReason" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.NgBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultKind}" Value="Error"><Setter TargetName="resultChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.ErrorSoftBrush}" /><Setter TargetName="resultStatus" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.ErrorBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultKind}" Value="Previous"><Setter TargetName="resultChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.StaleSoftBrush}" /><Setter TargetName="resultStatus" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.StaleBrush}" /><Setter TargetName="previousIcon" Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding ResultKind}" Value="Done"><Setter TargetName="resultChip" Property="Background" Value="{DynamicResource OpenVision.Workbench.DoneSoftBrush}" /><Setter TargetName="resultStatus" Property="Foreground" Value="{DynamicResource OpenVision.Workbench.DoneBrush}" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="VisionTool.WorkbenchAcceptanceTemplate">
        <DataTemplate.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="AcceptanceNumberStyle" TargetType="TextBox" BasedOn="{StaticResource OpenVision.ControlTextBoxStyle}">

                <Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="6,2" />
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.MonospaceFontFamily}" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style x:Key="AcceptanceMetricStyle" TargetType="ComboBox" BasedOn="{StaticResource OpenVision.ControlComboBoxStyle}">
                <Setter Property="Template" Value="{StaticResource VisionTool.WorkbenchComboBoxTemplate}" />
                <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" /></DataTemplate></Setter.Value></Setter>
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource OpenVision.ControlComboBoxItemStyle}">
                            <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </DataTemplate.Resources>
        <Border Background="{DynamicResource OpenVision.Workbench.RaisedBrush}" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="1" CornerRadius="7">
            <Border.Resources>
                <SolidColorBrush x:Key="OpenVision.PanelBrush" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.TextBrush" Color="{DynamicResource OpenVision.Workbench.TextBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.MutedTextBrush" Color="{DynamicResource OpenVision.Workbench.SecondaryTextBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.LineBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.StrongLineBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.BandBrush" Color="{DynamicResource OpenVision.Workbench.RaisedBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.AccentBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.AccentSoftBrush" Color="{DynamicResource OpenVision.Workbench.AccentSoftBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.ControlHoverBrush" Color="{DynamicResource OpenVision.Workbench.HoverBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.ControlPressedBrush" Color="{DynamicResource OpenVision.Workbench.PressedBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.ControlDisabledBrush" Color="{DynamicResource OpenVision.Workbench.PanelAltBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.ControlDisabledTextBrush" Color="{DynamicResource OpenVision.Workbench.MutedTextBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.ControlDisabledBorderBrush" Color="{DynamicResource OpenVision.Workbench.FieldBorderBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.ControlFocusBrush" Color="{DynamicResource OpenVision.Workbench.AccentBrush.Color}" />
                <SolidColorBrush x:Key="OpenVision.ControlErrorBrush" Color="{DynamicResource OpenVision.Workbench.NgBrush.Color}" />
            </Border.Resources>
            <StackPanel>
                <Border Padding="10,8" BorderBrush="{DynamicResource OpenVision.Workbench.LineAltBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding UseAcceptance, Mode=TwoWay}" IsEnabled="{Binding CanToggleAcceptance}"
                                      Style="{StaticResource VisionTool.WorkbenchSwitchStyle}" AutomationProperties.AutomationId="WorkbenchToolAcceptanceToggle" AutomationProperties.Name="{Binding [Workbench.Acc.Title]}" />
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ScaleBalance" Width="14" Height="14" Margin="0,0,5,0" Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}" />
                            <TextBlock Text="{Binding [Workbench.Acc.Title]}" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Margin="10,8" IsEnabled="{Binding CanEditAcceptance}">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="1" /><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding [Workbench.Acc.Metric]}" />
                    <ComboBox Grid.Row="0" Grid.Column="2" Height="28" MinHeight="28" Padding="6,2" FontSize="12"
                              Style="{StaticResource AcceptanceMetricStyle}" behaviors:ComboBoxInteractionBehavior.OpenOnFieldClick="True"
                              ItemsSource="{Binding AcceptanceMetrics}" SelectedValuePath="Key"
                              SelectedItem="{Binding SelectedAcceptanceMetric, Mode=TwoWay}" AutomationProperties.AutomationId="WorkbenchToolAcceptanceMetric" AutomationProperties.Name="{Binding [Workbench.Acc.Metric]}" />
                    <TextBlock Grid.Row="2" Text="{Binding [Workbench.Acc.Limits]}" />
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                        <CheckBox Content="{Binding [Workbench.Acc.Lower]}" IsChecked="{Binding UseAcceptanceMinimum, Mode=TwoWay}" AutomationProperties.AutomationId="WorkbenchToolAcceptanceUseMinimum" />
                        <TextBox Width="58" Margin="4,0,0,0" Style="{StaticResource AcceptanceNumberStyle}" IsEnabled="{Binding CanEditAcceptanceMinimum}"
                                 Text="{Binding AcceptanceMinimumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 AutomationProperties.AutomationId="WorkbenchToolAcceptanceMinimum" AutomationProperties.Name="{Binding [Workbench.Acc.Lower]}">
                            <TextBox.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelAcceptanceEditCommand}" CommandParameter="AcceptanceMinimumText" /></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="~" Margin="6,0" />
                        <CheckBox Content="{Binding [Workbench.Acc.Upper]}" IsChecked="{Binding UseAcceptanceMaximum, Mode=TwoWay}" AutomationProperties.AutomationId="WorkbenchToolAcceptanceUseMaximum" />
                        <TextBox Width="58" Margin="4,0,0,0" Style="{StaticResource AcceptanceNumberStyle}" IsEnabled="{Binding CanEditAcceptanceMaximum}"
                                 Text="{Binding AcceptanceMaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 AutomationProperties.AutomationId="WorkbenchToolAcceptanceMaximum" AutomationProperties.Name="{Binding [Workbench.Acc.Upper]}">
                            <TextBox.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelAcceptanceEditCommand}" CommandParameter="AcceptanceMaximumText" /></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding AcceptanceUnit}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="4" Text="{Binding [Workbench.Acc.TimeLimit]}" />
                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal">
                        <TextBox Width="72" Style="{StaticResource AcceptanceNumberStyle}" Text="{Binding AcceptanceTimeLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                 AutomationProperties.AutomationId="WorkbenchToolAcceptanceTime" AutomationProperties.Name="{Binding [Workbench.Acc.TimeLimit]}">
                            <TextBox.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelAcceptanceEditCommand}" CommandParameter="AcceptanceTimeLimitText" /></TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding [Workbench.Acc.TimeUnit]}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
                <Border Margin="10,0,10,8" Padding="6" CornerRadius="4" Background="{DynamicResource OpenVision.Workbench.NgSoftBrush}">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasAcceptanceError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding AcceptanceError}" TextWrapping="Wrap" Foreground="{DynamicResource OpenVision.Workbench.NgBrush}" AutomationProperties.AutomationId="WorkbenchToolAcceptanceError" />
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
