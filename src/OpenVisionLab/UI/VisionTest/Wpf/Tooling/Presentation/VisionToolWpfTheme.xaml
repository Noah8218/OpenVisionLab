<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:OpenVisionLab">
    <ResourceDictionary.MergedDictionaries>
        <local:SharedResourceDictionary Source="../../../../Wpf/OpenVisionLabWpfTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="VisionTool.SurfaceBrush" Color="#E7EEF1" />
    <SolidColorBrush x:Key="VisionTool.PanelBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="VisionTool.HeaderBrush" Color="#DDE8ED" />
    <SolidColorBrush x:Key="VisionTool.HeaderBorderBrush" Color="#BFD0D8" />
    <SolidColorBrush x:Key="VisionTool.LineBrush" Color="#8BA0AD" />
    <SolidColorBrush x:Key="VisionTool.FieldBorderBrush" Color="#8BA0AD" />
    <SolidColorBrush x:Key="VisionTool.PrimaryTextBrush" Color="#243040" />
    <SolidColorBrush x:Key="VisionTool.SecondaryTextBrush" Color="#657487" />
    <SolidColorBrush x:Key="VisionTool.DisabledTextBrush" Color="#A2A0A2" />
    <SolidColorBrush x:Key="VisionTool.AccentBrush" Color="#157C86" />
    <SolidColorBrush x:Key="VisionTool.ActionTextBrush" Color="#145F68" />
    <SolidColorBrush x:Key="VisionTool.HoverBrush" Color="#DCEBED" />
    <SolidColorBrush x:Key="VisionTool.DownBrush" Color="#C8E0E4" />
    <SolidColorBrush x:Key="VisionTool.SelectionBrush" Color="#D8ECEE" />
    <SolidColorBrush x:Key="VisionTool.SelectedButtonTextBrush" Color="#104F57" />
    <SolidColorBrush x:Key="VisionTool.FieldHoverBorderBrush" Color="#3E8F98" />
    <SolidColorBrush x:Key="VisionTool.FieldFocusGlowBrush" Color="#A8D8DE" />
    <SolidColorBrush x:Key="VisionTool.FieldArrowBrush" Color="#50657A" />
    <SolidColorBrush x:Key="VisionTool.FieldArrowBackgroundBrush" Color="#E1EBEF" />
    <SolidColorBrush x:Key="VisionTool.IconButtonFillBrush" Color="#DCEBED" />
    <SolidColorBrush x:Key="VisionTool.IconButtonHoverFillBrush" Color="#157C86" />
    <SolidColorBrush x:Key="VisionTool.IconButtonDownFillBrush" Color="#0E5960" />
    <SolidColorBrush x:Key="VisionTool.SliderTrackGrooveBrush" Color="#DAE5EA" />
    <SolidColorBrush x:Key="VisionTool.SliderTrackBrush" Color="#B8C9D0" />
    <SolidColorBrush x:Key="VisionTool.SliderHoverTrackBrush" Color="#A9BEC7" />
    <SolidColorBrush x:Key="VisionTool.SliderThumbBrush" Color="#F9FBFD" />
    <SolidColorBrush x:Key="VisionTool.SliderThumbBorderBrush" Color="#4E8C95" />
    <SolidColorBrush x:Key="VisionTool.PreviewBackgroundBrush" Color="#07090B" />
    <SolidColorBrush x:Key="VisionTool.PreviewBorderBrush" Color="#79909D" />
    <SolidColorBrush x:Key="VisionTool.PreviewHoverBorderBrush" Color="#157C86" />
    <SolidColorBrush x:Key="VisionTool.ActionFillBrush" Color="#157C86" />
    <SolidColorBrush x:Key="VisionTool.ActionFillHoverBrush" Color="#116A72" />
    <SolidColorBrush x:Key="VisionTool.ActionFillDownBrush" Color="#0E5960" />
    <SolidColorBrush x:Key="VisionTool.ActionFillTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VisionTool.FlowRailBrush" Color="#9FB4BD" />
    <SolidColorBrush x:Key="VisionTool.FlowNodeBrush" Color="#157C86" />
    <SolidColorBrush x:Key="VisionTool.StatusSuccessBrush" Color="#0D7A55" />
    <SolidColorBrush x:Key="VisionTool.StatusWarningBrush" Color="#9A6400" />
    <SolidColorBrush x:Key="VisionTool.StatusErrorBrush" Color="#B42318" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="#E7EEF1" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="LineBrush" Color="#8BA0AD" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#243040" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#657487" />
    <SolidColorBrush x:Key="ActionBrush" Color="#157C86" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.SecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.HeaderBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                          ContentSource="Header"
                                          Margin="8,0,8,-1"
                                          RecognizesAccessKey="True" />
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionTool.PreviewFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VisionTool.PreviewBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.PreviewBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource VisionTool.PreviewHoverBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="29" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.FieldBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="itemChrome"
                            Background="{TemplateBinding Background}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemChrome" Property="Background" Value="{StaticResource VisionTool.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemChrome" Property="Background" Value="{StaticResource VisionTool.SelectionBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.SelectedButtonTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="9,0,30,0" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.FieldBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MaxDropDownHeight" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid Height="{TemplateBinding Height}"
                          MinWidth="{TemplateBinding MinWidth}"
                          HorizontalAlignment="Stretch">
                        <Border x:Name="comboFocusGlow"
                                Margin="-2"
                                BorderBrush="{StaticResource VisionTool.FieldFocusGlowBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Opacity="0" />
                        <Border x:Name="comboChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="contentSite"
                                              Grid.Column="0"
                                              Margin="9,0,4,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Border x:Name="arrowBackground"
                                    Grid.Column="1"
                                    Background="{StaticResource VisionTool.FieldArrowBackgroundBrush}"
                                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                                    BorderThickness="1,0,0,0"
                                    CornerRadius="0,3,3,0" />
                            <Path x:Name="arrow"
                                  Grid.Column="1"
                                  Width="8"
                                  Height="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 5 L 8 0 Z"
                                  Fill="{StaticResource VisionTool.FieldArrowBrush}" />
                        </Grid>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="9,0,30,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 Focusable="True"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Style="{x:Null}"
                                 Visibility="Hidden" />
                        <ToggleButton x:Name="toggleButton"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Slide">
                            <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="{StaticResource VisionTool.PanelBrush}"
                                        BorderBrush="{StaticResource VisionTool.AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14"
                                                          Color="#40515A"
                                                          Direction="270"
                                                          Opacity="0.18"
                                                          ShadowDepth="3" />
                                    </Border.Effect>
                                </Border>
                                <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldHoverBorderBrush}" />
                            <Setter TargetName="comboChrome" Property="Background" Value="{StaticResource VisionTool.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="comboChrome" Property="Background" Value="{StaticResource VisionTool.DownBrush}" />
                            <Setter TargetName="arrowBackground" Property="Background" Value="{StaticResource VisionTool.SelectionBrush}" />
                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource VisionTool.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="comboChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="comboFocusGlow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="contentSite" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="toggleButton" Property="Width" Value="30" />
                            <Setter TargetName="toggleButton" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="MinHeight" Value="44" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="comboChrome" Property="Opacity" Value="0.55" />
                            <Setter TargetName="arrowBackground" Property="Opacity" Value="0.55" />
                            <Setter TargetName="arrow" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.ActionTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="buttonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="buttonContent"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{StaticResource VisionTool.HoverBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{StaticResource VisionTool.DownBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="buttonContent" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldFocusGlowBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="buttonChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionTool.IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource VisionTool.IconButtonFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="iconButtonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="iconButtonContent"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="iconButtonChrome" Property="Background" Value="{StaticResource VisionTool.IconButtonHoverFillBrush}" />
                            <Setter TargetName="iconButtonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.IconButtonHoverFillBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="iconButtonChrome" Property="Background" Value="{StaticResource VisionTool.IconButtonDownFillBrush}" />
                            <Setter TargetName="iconButtonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.IconButtonDownFillBrush}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="iconButtonContent" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="iconButtonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldFocusGlowBrush}" />
                            <Setter TargetName="iconButtonChrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="iconButtonChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionTool.PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource VisionTool.ActionFillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VisionTool.ActionFillTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VisionTool.ActionFillBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="buttonChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="buttonContent"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{StaticResource VisionTool.ActionFillHoverBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.ActionFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonChrome" Property="Background" Value="{StaticResource VisionTool.ActionFillDownBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.ActionFillDownBrush}" />
                            <Setter TargetName="buttonContent" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="buttonChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldFocusGlowBrush}" />
                            <Setter TargetName="buttonChrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="buttonChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="checkChrome"
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource VisionTool.PanelBrush}"
                                BorderBrush="{StaticResource VisionTool.FieldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Path x:Name="checkMark"
                                  Width="9"
                                  Height="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1 3.5 L 3.5 6 L 8 1"
                                  Stretch="Fill"
                                  Stroke="White"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="2"
                                  Opacity="0" />
                        </Border>
                        <ContentPresenter Grid.Column="2"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldHoverBorderBrush}" />
                            <Setter TargetName="checkChrome" Property="Background" Value="{StaticResource VisionTool.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkChrome" Property="Background" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="checkChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="checkMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="checkChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <Style x:Key="VisionTool.SegmentedRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="segmentChrome"
                            MinWidth="{TemplateBinding MinWidth}"
                            Height="{TemplateBinding Height}"
                            Background="{StaticResource VisionTool.HeaderBrush}"
                            BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="segmentChrome" Property="Background" Value="{StaticResource VisionTool.HoverBrush}" />
                            <Setter TargetName="segmentChrome" Property="BorderBrush" Value="{StaticResource VisionTool.FieldHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="segmentChrome" Property="Background" Value="{StaticResource VisionTool.SelectionBrush}" />
                            <Setter TargetName="segmentChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.SelectedButtonTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource VisionTool.DisabledTextBrush}" />
                            <Setter TargetName="segmentChrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionToolSliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="8"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VisionToolSliderThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Width="18" Height="24" ClipToBounds="False">
                        <Border x:Name="thumbChrome"
                                Width="18"
                                Height="22"
                                Margin="0,1"
                                Background="{StaticResource VisionTool.SliderThumbBrush}"
                                BorderBrush="{StaticResource VisionTool.SliderThumbBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="5" />
                        <Border x:Name="thumbGrip"
                                Width="2"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource VisionTool.SliderThumbBorderBrush}"
                                CornerRadius="1"
                                Opacity="0.45" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="thumbChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbChrome" Property="Background" Value="White" />
                            <Setter TargetName="thumbGrip" Property="Background" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbGrip" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbChrome" Property="Background" Value="{StaticResource VisionTool.DownBrush}" />
                            <Setter TargetName="thumbChrome" Property="BorderBrush" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbGrip" Property="Background" Value="{StaticResource VisionTool.AccentBrush}" />
                            <Setter TargetName="thumbGrip" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="thumbChrome" Property="Opacity" Value="0.45" />
                            <Setter TargetName="thumbGrip" Property="Opacity" Value="0.25" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource VisionTool.AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource VisionTool.SliderTrackBrush}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Height="{TemplateBinding Height}"
                          ClipToBounds="False"
                          SnapsToDevicePixels="True">
                        <Border Height="12"
                                Margin="9,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource VisionTool.SliderTrackGrooveBrush}"
                                BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6" />
                        <Track x:Name="PART_Track"
                               Margin="9,0"
                               VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Background="{TemplateBinding Foreground}"
                                              Command="Slider.DecreaseLarge"
                                              Style="{StaticResource VisionToolSliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Background="{TemplateBinding Background}"
                                              Command="Slider.IncreaseLarge"
                                              Style="{StaticResource VisionToolSliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VisionToolSliderThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource VisionTool.SliderHoverTrackBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
