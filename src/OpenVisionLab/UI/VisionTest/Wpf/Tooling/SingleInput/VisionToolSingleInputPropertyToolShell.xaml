<UserControl x:Class="OpenVisionLab.VisionToolSingleInputPropertyToolShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:OpenVisionLab"
             MinWidth="900"
             MinHeight="620"
             AutomationProperties.AutomationId="VisionToolSingleInputPropertyToolShell">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="../Presentation/VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="shellRoot"
          Background="{StaticResource VisionTool.SurfaceBrush}"
          Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="previewColumn" Width="390" />
            <ColumnDefinition x:Name="flowColumn" Width="16" />
            <ColumnDefinition x:Name="parameterColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="previewInputRow" Height="*" />
            <RowDefinition x:Name="previewSpacerRow" Height="10" />
            <RowDefinition x:Name="previewOutputRow" Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="flowRail"
              Grid.Row="0"
              Grid.RowSpan="3"
              Grid.Column="1"
              IsHitTestVisible="False">
            <Rectangle Width="2"
                       Margin="0,24"
                       HorizontalAlignment="Center"
                       Fill="{StaticResource VisionTool.FlowRailBrush}" />
            <Ellipse Width="8"
                     Height="8"
                     Margin="0,42,0,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Fill="{StaticResource VisionTool.FlowNodeBrush}" />
            <Path Width="10"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M 0 0 L 5 7 L 10 0 Z"
                  Fill="{StaticResource VisionTool.FlowNodeBrush}"
                  Stretch="Fill" />
            <Ellipse Width="8"
                     Height="8"
                     Margin="0,0,0,42"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Fill="{StaticResource VisionTool.FlowNodeBrush}" />
        </Grid>

        <GroupBox x:Name="gbInputLayer" Grid.Row="0" Grid.Column="0" Header="Input Layer" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="inputPreviewRow" Height="*" />
                    <RowDefinition x:Name="inputPreviewSpacerRow" Height="8" />
                    <RowDefinition x:Name="inputComboRow" Height="32" />
                </Grid.RowDefinitions>
                <Border x:Name="bdInputPreview"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="VisionToolInputPreviewFrame"
                        Style="{StaticResource VisionTool.PreviewFrameStyle}">
                    <local:VisionToolInlinePreviewSlot x:Name="imgInputPreview"
                                                       AutomationProperties.AutomationId="VisionToolInputPreviewSlot" />
                </Border>
                <ComboBox x:Name="cbInputLayer"
                          Grid.Row="2" />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="gbOutputLayer" Grid.Row="2" Grid.Column="0" Header="결과 쓰기 레이어" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="outputPreviewRow" Height="*" />
                    <RowDefinition x:Name="outputPreviewSpacerRow" Height="8" />
                    <RowDefinition x:Name="outputComboRow" Height="32" />
                </Grid.RowDefinitions>
                <Border x:Name="bdOutputPreview"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="VisionToolOutputPreviewFrame"
                        Style="{StaticResource VisionTool.PreviewFrameStyle}">
                    <local:VisionToolInlinePreviewSlot x:Name="imgOutputPreview"
                                                       AutomationProperties.AutomationId="VisionToolOutputPreviewSlot" />
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cbOutputLayer"
                              Grid.Column="0" />
                    <Button x:Name="btnCreateOutputLayer"
                            Grid.Column="2"
                            Style="{StaticResource VisionTool.IconButtonStyle}"
                            ToolTip="Create new output layer">
                        <iconPacks:PackIconMaterial Kind="ImagePlusOutline"
                                                    Width="19"
                                                    Height="19"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Grid>
        </GroupBox>

        <Grid x:Name="parameterPanel"
              Grid.Row="0"
              Grid.RowSpan="3"
              Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="titleRow" Height="Auto" />
                <RowDefinition x:Name="titleGapRow" Height="6" />
                <RowDefinition x:Name="templateStatusRow" Height="Auto" />
                <RowDefinition x:Name="templateStatusGapRow" Height="Auto" />
                <RowDefinition x:Name="toolContentRow" Height="Auto" />
                <RowDefinition x:Name="toolContentGapRow" Height="Auto" />
                <RowDefinition x:Name="parameterGroupRow" Height="*" />
                <RowDefinition x:Name="summaryGapRow" Height="6" />
                <RowDefinition x:Name="summaryRow" Height="Auto" />
                <RowDefinition x:Name="resultReviewRow" Height="Auto" />
                <RowDefinition x:Name="statusRow" Height="Auto" />
                <RowDefinition x:Name="actionGapRow" Height="6" />
                <RowDefinition x:Name="actionRow" Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource VisionTool.HeaderBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                Kind="{Binding TitleIconKind, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                                                Width="18"
                                                Height="18"
                                                Foreground="{StaticResource VisionTool.AccentBrush}" />
                    <TextBlock x:Name="txtTitle"
                               Grid.Column="2"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>

            <Border x:Name="bdTemplateStatus"
                    Grid.Row="2"
                    Background="{StaticResource VisionTool.PanelBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    Padding="12,8"
                    Visibility="{Binding TemplateStatusVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial x:Name="icoTemplateStatus"
                                                Grid.Column="0"
                                                Kind="ImageSearch"
                                                Width="17"
                                                Height="17"
                                                Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                    <TextBlock x:Name="txtTemplateStatus"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Height="6"
                    Visibility="{Binding TemplateStatusVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}" />

            <ContentPresenter x:Name="toolContentHost"
                              Grid.Row="4"
                              Content="{Binding ToolContent, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                              Visibility="{Binding ToolContentVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

            <Border Grid.Row="5"
                    Height="6"
                    Visibility="{Binding ToolContentVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}" />

            <GroupBox x:Name="gbParameters"
                      Grid.Row="6"
                      MinHeight="400"
                      Padding="8"
                      AutomationProperties.AutomationId="VisionToolParametersGroup">
                <GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtParameterHeader"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Parameters" />
                        <Button x:Name="btnPresetMenu"
                                Grid.Column="2"
                                Width="24"
                                Height="22"
                                Padding="0"
                                Visibility="Collapsed"
                                Style="{StaticResource VisionTool.IconButtonStyle}"
                                AutomationProperties.AutomationId="VisionToolPresetMenu">
                            <iconPacks:PackIconMaterial Kind="TuneVariant"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="btnLearnTopic"
                                Grid.Column="4"
                                MinWidth="82"
                                Height="22"
                                Padding="8,0"
                                Click="LearnTopicButton_Click"
                                ToolTip="Open Learn topic"
                                Visibility="{Binding LearnButtonVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                                AutomationProperties.AutomationId="{Binding LearnButtonAutomationId, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                                AutomationProperties.Name="{Binding LearnButtonText, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ImageSearch"
                                                            Width="13"
                                                            Height="13"
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{Binding LearnButtonText, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                        </Button>
                        <Button x:Name="btnParameterGuide"
                                Grid.Column="6"
                                Width="24"
                                Height="22"
                                Padding="0"
                                Click="ParameterGuideButton_Click"
                                ToolTip="Parameter Guide"
                                Visibility="{Binding ParameterGuideVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                                Style="{StaticResource VisionTool.IconButtonStyle}"
                                AutomationProperties.Name="Parameter Guide"
                                AutomationProperties.AutomationId="VisionToolParameterGuideButton">
                            <iconPacks:PackIconMaterial Kind="HelpCircleOutline"
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="bdPresetHost"
                            Grid.Row="0"
                            Background="{StaticResource VisionTool.HeaderBrush}"
                            BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                            BorderThickness="1"
                            Padding="10,8"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="VisionToolPresetHost">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        MinWidth="160">
                                <TextBlock x:Name="txtPresetTitle"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="txtPresetDetail"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                            </StackPanel>
                            <UniformGrid Grid.Column="2"
                                         Rows="1"
                                         Columns="3"
                                         VerticalAlignment="Center">
                                <Button x:Name="btnPresetBasic"
                                        MinWidth="74"
                                        Height="28"
                                        Margin="0,0,6,0"
                                        Padding="8,0"
                                        AutomationProperties.AutomationId="VisionToolPresetBasic" />
                                <Button x:Name="btnPresetFast"
                                        MinWidth="74"
                                        Height="28"
                                        Margin="0,0,6,0"
                                        Padding="8,0"
                                        AutomationProperties.AutomationId="VisionToolPresetFast" />
                                <Button x:Name="btnPresetPrecise"
                                        MinWidth="74"
                                        Height="28"
                                        Padding="8,0"
                                        AutomationProperties.AutomationId="VisionToolPresetPrecise" />
                            </UniformGrid>
                        </Grid>
                    </Border>
                    <Border x:Name="bdPresetGap"
                            Grid.Row="1"
                            Height="6"
                            Visibility="Collapsed" />
                    <Border x:Name="propertyGridHost"
                            Grid.Row="2"
                            MinHeight="370"
                            Background="{StaticResource VisionTool.PanelBrush}"
                            BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                            BorderThickness="1"
                            AutomationProperties.AutomationId="VisionToolPropertyGridHost"
                            Visibility="{Binding PropertyGridHostVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}" />
                    <ContentPresenter Content="{Binding ParameterContent, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                                      Grid.Row="2"
                                      Visibility="{Binding ParameterContentVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                </Grid>
            </GroupBox>

            <Border x:Name="bdSummary"
                    Grid.Row="8"
                    Background="{StaticResource VisionTool.HeaderBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    Padding="12,8">
                <TextBlock x:Name="txtSummary"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <Border x:Name="bdResultReview"
                    Grid.Row="9"
                    Margin="0,6,0,0"
                    Background="{StaticResource VisionTool.PanelBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    MinHeight="48"
                    Padding="8,4"
                    ClipToBounds="True"
                    Visibility="{Binding ResultReviewVisibility, RelativeSource={RelativeSource AncestorType=local:VisionToolSingleInputPropertyToolShell}}">
                <StackPanel MinHeight="30">
                    <TextBlock x:Name="txtResultReview"
                               AutomationProperties.AutomationId="VisionToolResultReviewSummary"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="txtResultGuidance"
                               AutomationProperties.AutomationId="VisionToolResultReviewGuidance"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ScrollViewer x:Name="svResultReviewChips"
                                  Margin="0,4,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="resultReviewChips"
                                   MinHeight="20" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border x:Name="bdStatus"
                    Grid.Row="10"
                    Background="{StaticResource VisionTool.PanelBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1"
                    Margin="0,4,0,0"
                    Padding="8,4">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtStatus}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=txtStatus}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="txtStatus"
                           Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                           MinHeight="14"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.HelpText="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Border>

            <Grid x:Name="actionPanel" Grid.Row="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="addPipelineActionColumn" Width="*" />
                    <ColumnDefinition x:Name="addPipelineActionGapColumn" Width="4" />
                    <ColumnDefinition x:Name="nImageActionColumn" Width="*" />
                    <ColumnDefinition x:Name="runPreviewActionGapColumn" Width="0" />
                    <ColumnDefinition x:Name="runPreviewActionColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="rowAddPipelineAction" Height="36" />
                    <RowDefinition x:Name="rowRunPreviewGap" Height="4" />
                    <RowDefinition x:Name="rowRunPreviewAction" Height="36" />
                </Grid.RowDefinitions>
                <Button x:Name="btnAddPipeline"
                        Grid.Row="0"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="VisionToolAddPipelineButton"
                        AutomationProperties.Name="{Binding Text, ElementName=txtAddPipelineText}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="PlaylistPlus" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="txtAddPipelineText" Text="Add Pipeline" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="btnNImageVerification"
                        Grid.Row="0"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="VisionToolNImageVerificationButton">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ImageSearch" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="txtNImageVerificationText" Text="N-image verification" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="btnRunPreview"
                        AutomationProperties.AutomationId="VisionToolRunPreviewButton"
                        AutomationProperties.Name="{Binding Text, ElementName=txtRunPreviewText}"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Style="{StaticResource VisionTool.PrimaryActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Play" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="txtRunPreviewText" Text="Run Preview" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
