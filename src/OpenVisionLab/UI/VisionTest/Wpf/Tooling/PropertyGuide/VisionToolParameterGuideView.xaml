<UserControl x:Class="OpenVisionLab.VisionToolParameterGuideView"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:OpenVisionLab"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             AutomationProperties.AutomationId="VisionToolParameterGuide">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="../Presentation/VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}" />
            </Style>
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.PanelAltBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource OpenVision.Workbench.FontFamily}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ToggleButton x:Name="guideHeaderToggle" MinHeight="32" Padding="0" Cursor="Hand" HorizontalAlignment="Stretch"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="guideHeaderChrome" Background="{DynamicResource OpenVision.Workbench.RaisedBrush}"
                                                    BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                    <iconPacks:PackIconMaterial x:Name="guideChevron" Grid.Column="1" Kind="ChevronDown" Width="14" Height="14"
                                                                                Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="guideChevron" Property="Kind" Value="ChevronUp"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="guideHeaderChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.HoverBrush}"/></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="guideHeaderChrome" Property="Background" Value="{DynamicResource OpenVision.Workbench.PressedBrush}"/></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="guideHeaderChrome" Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.AccentBrush}"/><Setter TargetName="guideHeaderChrome" Property="BorderThickness" Value="1"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="guideHeaderChrome" Property="Opacity" Value="0.55"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="guideBody" Grid.Row="1" Background="{TemplateBinding Background}" Visibility="Collapsed">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True"><Setter TargetName="guideBody" Property="Visibility" Value="Visible"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
            BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="0">
        <Expander x:Name="guideExpander"
                  IsExpanded="False"
                  AutomationProperties.AutomationId="VisionToolParameterGuideExpander">
            <Expander.Header>
                <Grid Margin="8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Grid.Column="0"
                                                Kind="HelpCircleOutline"
                                                Width="15"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource OpenVision.Workbench.AccentBrush}" />
                    <TextBlock x:Name="txtHeader"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                               Text="Parameter Guide" />
                    <TextBlock x:Name="txtCoverage"
                               Grid.Column="3"
                               Margin="8,0,0,0"
                               Padding="5,1"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                               AutomationProperties.AutomationId="VisionToolParameterGuideCoverage" />
                </Grid>
            </Expander.Header>

            <ScrollViewer x:Name="guideScroll"
                          Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                          Foreground="{DynamicResource OpenVision.Workbench.TextBrush}"
                          MaxHeight="184"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,3,10,9">
                    <TextBlock x:Name="txtTitle"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="VisionToolParameterGuideTitle" />
                    <TextBlock x:Name="txtIdentity"
                               Margin="0,2,0,0"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="VisionToolParameterGuideIdentity" />
                    <TextBlock x:Name="txtApplicability"
                               Margin="0,5,0,0"
                               Padding="6,3"
                               Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                               Foreground="{DynamicResource OpenVision.Workbench.StaleBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               AutomationProperties.AutomationId="VisionToolParameterGuideApplicability" />

                    <StackPanel x:Name="summarySection" Margin="0,7,0,0">
                        <TextBlock x:Name="lblSummary"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        <TextBlock x:Name="txtSummary"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="VisionToolParameterGuideSummary" />
                    </StackPanel>

                    <StackPanel x:Name="impactSection" Margin="0,7,0,0">
                        <TextBlock x:Name="lblImpact"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        <TextBlock x:Name="txtImpact"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="VisionToolParameterGuideImpact" />
                    </StackPanel>

                    <StackPanel x:Name="bestWhenSection" Margin="0,7,0,0">
                        <TextBlock x:Name="lblBestWhen"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        <TextBlock x:Name="txtBestWhen"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="VisionToolParameterGuideBestWhen" />
                    </StackPanel>

                    <StackPanel x:Name="riskSection" Margin="0,7,0,0">
                        <TextBlock x:Name="lblRisk"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        <TextBlock x:Name="txtRisk"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="VisionToolParameterGuideRisk" />
                    </StackPanel>

                    <StackPanel x:Name="checkSection" Margin="0,7,0,0">
                        <TextBlock x:Name="lblCheck"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        <TextBlock x:Name="txtCheck"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="VisionToolParameterGuideCheck" />
                    </StackPanel>

                    <StackPanel x:Name="relatedSection"
                                Margin="0,7,0,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="lblRelated"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OpenVision.Workbench.TextBrush}" />
                        <WrapPanel x:Name="relatedButtons"
                                   Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="VisionToolParameterGuideRelated" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Expander>
    </Border>
</UserControl>
