<UserControl x:Class="OpenVisionLab.LayerRecipeLearnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab"
             Focusable="False">
    <UserControl.Resources>
        <local:SharedResourceDictionary Source="LearnResources.xaml" />
    </UserControl.Resources>
            <Border x:Name="layerRecipeTopicPanel"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Margin="0,0,0,12"
                                Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnLayerRoutingSafetyPanel">
                            <StackPanel>
                                <TextBlock Text="Layer 연결 원리"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="InputLayer는 Step이 읽는 이미지이고 OutputLayer는 처리 결과를 저장하는 이미지입니다." />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="다음 Step에서 이전 결과를 사용하려면 그 OutputLayer를 다음 InputLayer로 선택합니다." />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,12"
                                Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnLayerRouteReviewLoopPanel">
                            <StackPanel>
                                <TextBlock Text="Pipeline 검토 순서"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="1. InputLayer 선택 → 2. OutputLayer 지정 → 3. Preview/Run 실행 → 4. Main·Input·Output 비교 → 5. Good/Bad 지표 확인 후 Recipe 저장" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="뒤 Step의 결과가 예상과 다르면 바로 앞 OutputLayer부터 확인해 어느 처리 단계에서 영상이 달라졌는지 찾습니다." />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Layer는 이미지 이름, Pipeline은 Step 흐름, Recipe는 저장된 검사 계획입니다"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="각 Step의 InputLayer → ToolType → OutputLayer 순서를 따라가면 이미지가 어떤 처리 단계를 거쳤는지 확인할 수 있습니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Recipe는 Step 순서, 파라미터, acceptance gate, 샘플 검증 결과를 함께 저장해 다시 검토할 수 있게 합니다." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Layer 흐름"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="원본, 중간 결과, 리뷰 결과를 이름으로 분리합니다."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="layerRecipeLayerGrid"
                                                 Columns="4"
                                                 Rows="1" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Pipeline Step 연결"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtLayerRecipeFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="layerRecipeFlowGrid"
                                                 Columns="4"
                                                 Rows="4" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SELECTED_STEP"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtLayerRecipeSelectedStep"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="layerRecipeStepSlider"
                                        Grid.Row="2"
                                        Minimum="1"
                                        Maximum="4"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="LayerRecipeStepSlider_ValueChanged"
                                        AutomationProperties.Name="Selected pipeline step"
                                        AutomationProperties.AutomationId="OpenVisionLearnLayerRecipeStepSlider" />
                                <TextBlock x:Name="txtLayerRecipeMeaning"
                                           Grid.Row="4"
                                           Style="{StaticResource LearnMutedTextStyle}" />
                                <StackPanel Grid.Row="6"
                                            Orientation="Horizontal">
                                    <Button x:Name="btnLayerRecipePlay"
                                            MinWidth="72"
                                            Height="30"
                                            Content="Play"
                                            Click="LayerRecipePlayButton_Click"
                                            ToolTip="Main에서 중간 결과와 최종 판정까지 이어지는 Layer 경로를 보여줍니다."
                                            AutomationProperties.AutomationId="OpenVisionLearnLayerRecipePlayButton" />
                                    <Button MinWidth="78"
                                            Height="30"
                                            Margin="8,0,0,0"
                                            Content="Step"
                                            Click="LayerRecipeStepButton_Click"
                                            ToolTip="Advance one routing review step without executing a tool."
                                            AutomationProperties.AutomationId="OpenVisionLearnLayerRecipeStepButton" />
                                    <Button MinWidth="72"
                                            Height="30"
                                            Margin="8,0,0,0"
                                            Content="Reset"
                                            Click="LayerRecipeResetButton_Click"
                                            ToolTip="Return the routing diagram to its neutral state."
                                            AutomationProperties.AutomationId="OpenVisionLearnLayerRecipeResetButton" />
                                </StackPanel>
                                <TextBlock x:Name="txtLayerRecipeAnimationStatus"
                                           Grid.Row="8"
                                           Style="{StaticResource LearnAnimationStatusStyle}"
                                           AutomationProperties.Name="Layer and Recipe animation status"
                                           AutomationProperties.AutomationId="OpenVisionLearnLayerRecipeAnimationStatus" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
</UserControl>
