<UserControl x:Class="OpenVisionLab.MatchingLearnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab"
             Focusable="False">
    <UserControl.Resources>
        <local:SharedResourceDictionary Source="LearnResources.xaml" />
    </UserControl.Resources>
    <Grid>
            <Border x:Name="matchingTopicPanel"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txtMatchingConceptTitle"
                                   Text="Matching은 작은 Template을 찾아 점수로 판정합니다"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="txtMatchingConceptDescription"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Template Matching은 기준 모양을 검색 영역 위로 움직이며 가장 비슷한 위치와 Score를 찾습니다." />
                        <TextBlock x:Name="txtMatchingThresholdDescription"
                                   Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="ScoreThreshold가 낮으면 오검출이 늘고, 너무 높으면 조명이나 작은 흔들림에도 NG가 날 수 있습니다." />

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Expander x:Name="matchingFamilyDecisionExpander"
                                      Header="도구 선택: Matching / EdgeBasedMatching / FeatureMatching"
                                      IsExpanded="False"
                                      AutomationProperties.AutomationId="OpenVisionLearnMatchingFamilyDecisionPanel">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Matching: 밝기와 외관이 안정적인 Template을 찾습니다. 먼저 ScoreMax와 ResultCount를 봅니다." />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="EdgeBasedMatching: 조명은 흔들려도 edge 형상이 안정적인 fiducial이나 마크에 씁니다." />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="FeatureMatching: 회전, 크기, 일부 가림이 있고 keypoint가 충분할 때 씁니다. overlay 위치까지 확인합니다." />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="관련 Tool View"
                                       FontWeight="SemiBold" />
                            <Button x:Name="btnMatchingOpenTool"
                                    Grid.Column="1"
                                    MinWidth="142"
                                    Height="30"
                                    Padding="10,4"
                                    Content="Matching Tool 열기"
                                    IsEnabled="False"
                                    Tag="Matching"
                                    ToolTip="Matching Tool View의 Template, 검색 ROI, Min score, Match count 위치를 엽니다."
                                    Click="OpenRelatedToolButton_Click"
                                    AutomationProperties.AutomationId="OpenVisionLearnMatchingOpenToolButton" />
                        </Grid>
                        <StackPanel x:Name="matchingToolLocationPanel"
                                    Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="OpenVisionLearnMatchingToolLocationPanel">
                            <Separator Margin="0,0,0,7" />
                            <TextBlock x:Name="txtMatchingToolLocationTitle"
                                       FontWeight="SemiBold"
                                       Text="Matching Tool: Template Ready / Pattern path, Matching &gt; Min score / Match count, ROI"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnMatchingToolLocationTitle" />
                            <TextBlock x:Name="txtMatchingToolLocationDetail"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="Template과 검색 ROI, 필요한 Angle/Scale을 설정하고 Preview 또는 Pipeline Review에서 오버레이 위치, ScoreMax, ResultCount를 함께 확인하세요."
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnMatchingToolLocationDetail" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="txtMatchingSearchTitle"
                                               Text="검색 이미지와 Template"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtMatchingSearchSubtitle"
                                               Margin="0,3,0,10"
                                               Text="T는 기준 Template, B는 최고 점수 위치입니다."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <UniformGrid x:Name="matchingSearchGrid"
                                                     Columns="5"
                                                     Rows="5" />
                                        <UniformGrid x:Name="matchingTemplateGrid"
                                                     Grid.Column="2"
                                                     Columns="2"
                                                     Rows="2" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="txtMatchingScoreTitle"
                                               Text="후보 Score"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtMatchingFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="btnMatchingPlay"
                                                    MinWidth="72"
                                                    Height="30"
                                                    Content="Play"
                                                    Click="MatchingPlayButton_Click"
                                                    ToolTip="Show the Matching search and score steps."
                                                    AutomationProperties.AutomationId="OpenVisionLearnMatchingPlayButton" />
                                            <Button MinWidth="78"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Content="Step"
                                                    Click="MatchingStepButton_Click"
                                                    ToolTip="Advance one Matching score step."
                                                    AutomationProperties.AutomationId="OpenVisionLearnMatchingStepButton" />
                                            <Button MinWidth="72"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Content="Reset"
                                                    Click="MatchingResetButton_Click"
                                                    ToolTip="Return the Matching animation to the source/template step."
                                                    AutomationProperties.AutomationId="OpenVisionLearnMatchingResetButton" />
                                        </StackPanel>
                                        <TextBlock x:Name="txtMatchingAnimationStatus"
                                                   Grid.Row="1"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource LearnAnimationStatusStyle}"
                                                   AutomationProperties.Name="Matching animation status"
                                                   AutomationProperties.AutomationId="OpenVisionLearnMatchingAnimationStatus" />
                                    </Grid>
                                    <UniformGrid x:Name="matchingScoreGrid"
                                                 Columns="5"
                                                 Rows="1" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SCORE_THRESHOLD"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtMatchingThreshold"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="matchingThresholdSlider"
                                        Grid.Row="2"
                                        Minimum="0.50"
                                        Maximum="1.00"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="MatchingThresholdSlider_ValueChanged"
                                        AutomationProperties.Name="Minimum matching score"
                                        AutomationProperties.AutomationId="OpenVisionLearnMatchingThresholdSlider" />
                                <TextBlock x:Name="txtMatchingMeaning"
                                           Grid.Row="4"
                                           Style="{StaticResource LearnMutedTextStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="featureMatchingTopicPanel"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Feature Matching은 특징점끼리 대응시킵니다"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Template Matching이 픽셀 모양을 직접 비교한다면, Feature Matching은 코너 같은 keypoint와 descriptor를 찾아 서로 맞는 쌍을 셉니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="회전, 크기 변화, 일부 가림이 있는 대상은 점수 하나보다 GoodMatches, 위치 일관성, 최종 overlay를 같이 봐야 합니다." />

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Expander x:Name="featureMatchingFamilyDecisionExpander"
                                      Header="도구 선택: Matching / EdgeBasedMatching / FeatureMatching"
                                      IsExpanded="False"
                                      AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingFamilyDecisionPanel">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Matching: 같은 외관의 Template을 빠르게 찾을 때. ScoreMax와 ResultCount가 첫 증거입니다." />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="EdgeBasedMatching: 색보다 edge 형상이 안정적인 대상에 씁니다. Canny와 edge score가 핵심입니다." />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="FeatureMatching: keypoint와 descriptor가 충분할 때 쓰며, GoodMatches, ScoreMax, RANSAC/overlay 위치를 같이 봅니다." />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="관련 Tool View"
                                       FontWeight="SemiBold" />
                            <Button x:Name="btnFeatureMatchingOpenTool"
                                    Grid.Column="1"
                                    MinWidth="172"
                                    Height="30"
                                    Padding="10,4"
                                    Content="FeatureMatching Tool 열기"
                                    IsEnabled="False"
                                    Tag="FeatureMatching"
                                    ToolTip="FeatureMatching Tool View의 Template, Ratio threshold, RANSAC tolerance, ROI 위치를 엽니다."
                                    Click="OpenRelatedToolButton_Click"
                                    AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingOpenToolButton" />
                        </Grid>
                        <StackPanel x:Name="featureMatchingToolLocationPanel"
                                    Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingToolLocationPanel">
                            <Separator Margin="0,0,0,7" />
                            <TextBlock x:Name="txtFeatureMatchingToolLocationTitle"
                                       FontWeight="SemiBold"
                                       Text="FeatureMatching Tool: Template Ready / Feature template path, Matching &gt; Ratio threshold / RANSAC tolerance, ROI"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingToolLocationTitle" />
                            <TextBlock x:Name="txtFeatureMatchingToolLocationDetail"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="특징점이 충분한 Template과 검색 ROI를 정하고 Ratio와 RANSAC 기준을 조정한 뒤 오버레이 위치, GoodMatches, ScoreMax를 비교하세요."
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingToolLocationDetail" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Reference / Scene 특징점"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="K는 기준 특징점, M은 매칭된 장면 특징점입니다."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <UniformGrid x:Name="featureReferenceGrid"
                                                     Columns="5"
                                                     Rows="5" />
                                        <UniformGrid x:Name="featureSceneGrid"
                                                     Grid.Column="2"
                                                     Columns="5"
                                                     Rows="5" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Descriptor 일치 점수"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtFeatureMatchingFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="btnFeatureMatchingPlay"
                                                    MinWidth="72"
                                                    Height="30"
                                                    Content="Play"
                                                    Click="FeatureMatchingPlayButton_Click"
                                                    ToolTip="Show keypoint, descriptor, and geometric review steps."
                                                    AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingPlayButton" />
                                            <Button MinWidth="78"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Content="Step"
                                                    Click="FeatureMatchingStepButton_Click"
                                                    ToolTip="Advance one Feature Matching step."
                                                    AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingStepButton" />
                                            <Button MinWidth="72"
                                                    Height="30"
                                                    Margin="8,0,0,0"
                                                    Content="Reset"
                                                    Click="FeatureMatchingResetButton_Click"
                                                    ToolTip="Return to the source/reference step."
                                                    AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingResetButton" />
                                        </StackPanel>
                                        <TextBlock x:Name="txtFeatureMatchingAnimationStatus"
                                                   Grid.Row="1"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource LearnAnimationStatusStyle}"
                                                   AutomationProperties.Name="Feature Matching animation status"
                                                   AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchingAnimationStatus" />
                                    </Grid>
                                    <UniformGrid x:Name="featureMatchScoreGrid"
                                                 Columns="6"
                                                 Rows="1" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GOOD_MATCH_MIN"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtFeatureGoodMatchMin"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="featureGoodMatchMinSlider"
                                        Grid.Row="2"
                                        Minimum="1"
                                        Maximum="6"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="FeatureGoodMatchMinSlider_ValueChanged"
                                        AutomationProperties.Name="Minimum good feature matches"
                                        AutomationProperties.AutomationId="OpenVisionLearnFeatureMatchMinSlider" />
                                <TextBlock x:Name="txtFeatureMatchingMeaning"
                                           Grid.Row="4"
                                           Style="{StaticResource LearnMutedTextStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
    </Grid>
</UserControl>
