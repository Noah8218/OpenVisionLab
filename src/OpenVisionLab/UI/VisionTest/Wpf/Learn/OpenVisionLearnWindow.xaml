<Window x:Class="OpenVisionLab.OpenVisionLearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenVisionLab"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OpenVisionLab Learn"
        Width="1040"
        Height="700"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="OpenVisionLearnWindow">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="../Tooling/Presentation/VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LearnPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource VisionTool.PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource VisionTool.HeaderBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="LearnMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource VisionTool.SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LearnAnimationStatusStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource LearnMutedTextStyle}">
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            </Style>

            <SolidColorBrush x:Key="Learn.Animation.NeutralBrush" Color="#525B69" />
            <SolidColorBrush x:Key="Learn.Animation.CandidateBrush" Color="#228491" />
            <SolidColorBrush x:Key="Learn.Animation.PassBrush" Color="#408F4D" />
            <SolidColorBrush x:Key="Learn.Animation.WarningBrush" Color="#B07C2A" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#157C86"
            BorderThickness="1"
            Background="#EEF2F6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:OpenVisionWindowTitleBar x:Name="learnTitleBar"
                                            Grid.Row="0"
                                            TitleText="OpenVisionLab Learn"
                                            AutomationProperties.AutomationId="OpenVisionLearnTitleBar" />

    <Grid Grid.Row="1"
          Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource LearnPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Learn"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               Text="Learn에서 개념을 익히고 샘플과 도구를 연결합니다. 실제 파라미터는 각 Tool View에서 조정합니다." />
                </StackPanel>
                <ListBox x:Name="topicList"
                         Grid.Row="2"
                         AutomationProperties.AutomationId="OpenVisionLearnTopicList"
                         BorderThickness="0"
                         Background="Transparent"
                         DisplayMemberPath="."
                         SelectedIndex="2"
                         SelectionChanged="TopicList_SelectionChanged">
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource LearnPanelStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtTopicTitle"
                               Text="3. 이진화 / Threshold"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="txtTopicSubtitle"
                               Margin="0,4,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               Text="세부 문서: Arithmetic, RotateScale, Color/HSV, Pipeline/Layer, Metrics/Acceptance." />
                    <StackPanel Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="92"
                                Padding="12,6"
                                Content="현재 문서"
                                ToolTip="현재 학습 주제의 상세 문서를 엽니다."
                                Click="OpenLearnDocsButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnOpenDocsButton" />
                        <Button MinWidth="112"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Content="기초 용어"
                                ToolTip="Point, Rect, Mat, ROI, Layer 기초 문서를 엽니다."
                                Click="OpenFoundationDocsButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnOpenFoundationDocsButton" />
                        <Button x:Name="btnPracticeSamples"
                                MinWidth="118"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Content="실습 샘플"
                                IsEnabled="False"
                                ToolTip="현재 주제와 관련된 공개 실습 샘플을 엽니다."
                                Click="OpenPracticeSamplesButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnPracticeSamplesButton" />
                    </StackPanel>
                    <TextBlock x:Name="txtTopicPractice"
                               Margin="0,8,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               TextWrapping="Wrap"
                               Text="실습: 샘플에서 입력 이미지와 결과 지표를 확인한 뒤 관련 Tool View에서 같은 파라미터를 찾아보세요." />
                    <Expander x:Name="practiceWorkflowExpander"
                              Margin="0,8,0,0"
                              Header="실습 순서"
                              FontWeight="SemiBold"
                              IsExpanded="False"
                              AutomationProperties.AutomationId="OpenVisionLearnPracticeWorkflowPanel">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource LearnMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="실습 샘플 열기 → Good/Bad 쌍 선택 → 관련 도구 열기 → Preview 또는 Pipeline Review 실행 → 오버레이와 지표 비교 → 레시피 저장" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="결과를 판단할 때는 입력 이미지, 출력 이미지, 핵심 지표가 같은 검사 목적을 설명하는지 함께 확인하세요." />
                        </StackPanel>
                    </Expander>
                    <StackPanel x:Name="animationLegendPanel"
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="OpenVisionLearnAnimationLegend">
                        <TextBlock Text="애니메이션 색상"
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.NeutralBrush}" />
                        <TextBlock Text="중립" Margin="0,0,10,0" Style="{StaticResource LearnMutedTextStyle}" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.CandidateBrush}" />
                        <TextBlock Text="후보" Margin="0,0,10,0" Style="{StaticResource LearnMutedTextStyle}" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.PassBrush}" />
                        <TextBlock Text="OK" Margin="0,0,10,0" Style="{StaticResource LearnMutedTextStyle}" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.WarningBrush}" />
                        <TextBlock Text="주의/이상치" Style="{StaticResource LearnMutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="pixelTopicPanel"
                    Grid.Row="2"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnFoundationTypeCards">
                            <StackPanel>
                                <TextBlock Text="영상 도구에서 자주 만나는 네 가지 값"
                                           FontWeight="SemiBold" />
                                <UniformGrid Margin="0,8,0,0"
                                             Columns="2"
                                             Rows="2">
                                    <TextBlock Text="Point = X,Y → 중심점 / 에지점 / 특징점" />
                                    <TextBlock Text="Rect ROI = X,Y,W,H → 검사 영역" />
                                    <TextBlock Text="Size = W,H → Kernel / Template / 결과 크기" />
                                    <TextBlock Text="Mat = 행 x 열 x 채널 → 이미지 데이터" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnMatChannelPanel">
                            <StackPanel>
                                <TextBlock Text="1. 픽셀과 채널: BGR 한 픽셀을 Gray GV로 변환"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="예시 픽셀 B=220, G=110, R=40을 채널별로 나눈 뒤 OpenCV 가중식으로 Gray GV 102를 계산합니다." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnMatChannelPlay"
                                            MinWidth="72"
                                            Height="30"
                                            Content="자동 재생"
                                            Click="MatChannelPlayButton_Click"
                                            ToolTip="BGR 픽셀부터 Gray GV 계산까지 순서대로 보여줍니다."
                                            AutomationProperties.AutomationId="OpenVisionLearnMatChannelPlayButton" />
                                    <Button Grid.Column="2"
                                            MinWidth="78"
                                            Height="30"
                                            Content="한 단계"
                                            Click="MatChannelStepButton_Click"
                                            ToolTip="다음 채널 변환 단계를 보여줍니다."
                                            AutomationProperties.AutomationId="OpenVisionLearnMatChannelStepButton" />
                                    <Button Grid.Column="4"
                                            MinWidth="72"
                                            Height="30"
                                            Content="처음"
                                            Click="MatChannelResetButton_Click"
                                            ToolTip="BGR 원본 픽셀 단계로 돌아갑니다."
                                            AutomationProperties.AutomationId="OpenVisionLearnMatChannelResetButton" />
                                    <TextBlock x:Name="txtMatChannelAnimationStatus"
                                               Grid.Column="6"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource LearnAnimationStatusStyle}"
                                               AutomationProperties.Name="Mat channel animation status"
                                               AutomationProperties.AutomationId="OpenVisionLearnMatChannelAnimationStatus" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="270" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="matChannelBgrCell"
                                            MinHeight="92"
                                            Padding="10"
                                            Background="#286EDC"
                                            BorderThickness="2"
                                            CornerRadius="3">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="BGR 원본 픽셀"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="(B,G,R)"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="220, 110, 40"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="txtMatChannelBgrShape"
                                                       Margin="0,4,0,0"
                                              Text="행 x 열 x 3"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text=">"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <UniformGrid Grid.Column="2"
                                                 Columns="3"
                                                 Rows="1">
                                        <Border x:Name="matChannelBlueCell"
                                                Margin="0,0,4,0"
                                                Padding="6"
                                                Background="#DCDCDC"
                                                BorderThickness="2"
                                                CornerRadius="3">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="B 채널"
                                                           Foreground="#1755B5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="220"
                                                           Foreground="Black"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="matChannelGreenCell"
                                                Margin="2,0"
                                                Padding="6"
                                                Background="#6E6E6E"
                                                BorderThickness="2"
                                                CornerRadius="3">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="G 채널"
                                                           Foreground="#BDF4C7"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="110"
                                                           Foreground="White"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="matChannelRedCell"
                                                Margin="4,0,0,0"
                                                Padding="6"
                                                Background="#282828"
                                                BorderThickness="2"
                                                CornerRadius="3">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="R 채널"
                                                           Foreground="#FFB5B5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="40"
                                                           Foreground="White"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Grid.Column="3"
                                               Text=">"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Border x:Name="matChannelGrayCell"
                                            Grid.Column="4"
                                            MinHeight="92"
                                            Padding="10"
                                            Background="#666666"
                                            BorderThickness="2"
                                            CornerRadius="3">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Gray 밝기(GV)"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="102"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="txtMatChannelGrayShape"
                                                       Margin="0,4,0,0"
                                              Text="행 x 열 x 1"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid x:Name="matChannelTypeGuidePanel"
                                      Margin="0,8,0,0"
                                      AutomationProperties.AutomationId="OpenVisionLearnMatChannelTypeGuidePanel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtMatChannelTypeTitle"
                                               FontWeight="SemiBold"
                                               Text="Mat 형식 = 픽셀 깊이 + 채널 수"
                                               AutomationProperties.AutomationId="OpenVisionLearnMatChannelTypeTitle" />
                                    <TextBlock x:Name="txtMatChannelTypeDetail"
                                               Grid.Column="1"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="CV_8U = 0~255의 8비트 값 | C1/C3 = 채널 수 | Gray = CV_8UC1 | BGR = CV_8UC3"
                                               AutomationProperties.AutomationId="OpenVisionLearnMatChannelTypeDetail" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,14,0,0"
                                   Text="2. 좌표와 ROI: Point에서 Rect와 RotatedRect 만들기"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Point(2,1)과 Size(4,3)로 12픽셀 ROI를 만들고, 같은 중심과 크기에 25° 회전을 적용한 영역을 비교합니다." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnFoundationPlay"
                                    MinWidth="72"
                                    Height="30"
                                    Content="자동 재생"
                                    Click="FoundationPlayButton_Click"
                                    ToolTip="Point, Size, Rect, Mat ROI, RotatedRect 관계를 자동으로 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnFoundationPlayButton" />
                            <Button Grid.Column="2"
                                    MinWidth="78"
                                    Height="30"
                                    Content="한 단계"
                                    Click="FoundationStepButton_Click"
                                    ToolTip="다음 OpenCvSharp 기초 타입 단계를 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnFoundationStepButton" />
                            <Button Grid.Column="4"
                                    MinWidth="72"
                                    Height="30"
                                    Content="처음"
                                    Click="FoundationResetButton_Click"
                                    ToolTip="Point 확인 단계로 돌아갑니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnFoundationResetButton" />
                            <TextBlock x:Name="txtFoundationAnimationStatus"
                                       Grid.Column="6"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LearnAnimationStatusStyle}"
                                       AutomationProperties.Name="Foundation animation status"
                                       AutomationProperties.AutomationId="OpenVisionLearnFoundationAnimationStatus" />
                        </Grid>

                        <Border Margin="0,10,0,0"
                                Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnFoundationGeometryPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="6행 × 8열 Gray Mat 예시"
                                               FontWeight="SemiBold" />
                                    <Grid Width="320"
                                          Height="192"
                                          Margin="0,8,0,0">
                                        <UniformGrid x:Name="foundationMatGrid"
                                                     Columns="8"
                                                     Rows="6" />
                                        <Canvas IsHitTestVisible="False">
                                            <Rectangle x:Name="foundationRotatedBoundsRect"
                                                       Width="186"
                                                       Height="155"
                                                       Canvas.Left="67"
                                                       Canvas.Top="3"
                                                       StrokeThickness="2"
                                                       StrokeDashArray="4 3"
                                                       Visibility="Collapsed"
                                                       AutomationProperties.AutomationId="OpenVisionLearnFoundationRotatedBoundsRect" />
                                            <Rectangle x:Name="foundationRotatedRect"
                                                       Width="160"
                                                       Height="96"
                                                       Canvas.Left="80"
                                                       Canvas.Top="32"
                                                       RenderTransformOrigin="0.5,0.5"
                                                       StrokeThickness="3"
                                                       Visibility="Collapsed"
                                                       AutomationProperties.AutomationId="OpenVisionLearnFoundationRotatedRect">
                                                <Rectangle.RenderTransform>
                                                    <RotateTransform Angle="25" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <Ellipse x:Name="foundationRotatedCenterMarker"
                                                     Width="14"
                                                     Height="14"
                                                     Canvas.Left="153"
                                                     Canvas.Top="73"
                                                     Stroke="White"
                                                     StrokeThickness="2"
                                                     Visibility="Collapsed"
                                                     AutomationProperties.AutomationId="OpenVisionLearnFoundationRotatedCenterMarker" />
                                            <Rectangle x:Name="foundationRoiRect"
                                                       Width="160"
                                                       Height="96"
                                                       Canvas.Left="80"
                                                       Canvas.Top="32"
                                                       StrokeThickness="3"
                                                       StrokeDashArray="5 3"
                                                       Visibility="Collapsed" />
                                            <Ellipse x:Name="foundationPointMarker"
                                                     Width="14"
                                                     Height="14"
                                                     Canvas.Left="73"
                                                     Canvas.Top="25"
                                                     Stroke="White"
                                                     StrokeThickness="2"
                                                     Visibility="Collapsed" />
                                        </Canvas>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="도구 파라미터에서 읽는 방법"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Point (2,1): ROI의 시작 X/Y 위치" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Size (4,3): 폭 4, 높이 3" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Rect: 시작 위치와 크기를 합친 사각 영역" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="CvROI = 2,1,4,3 (X,Y,Width,Height)" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Mat ROI: 원본 Mat에서 Rect 영역만 잘라낸 이미지" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="RotatedRect: 중심점 + 크기 + 회전각" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="BoundingRect: 회전 영역 전체를 감싸는 축 정렬 사각형" />
                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="이 예시의 CvROI 값은 Blob, Contour, Line 같은 도구의 ROI 입력 형식과 같습니다." />
                                    <TextBlock Margin="0,12,0,0"
                                               FontWeight="SemiBold"
                                               Text="관련 도구에서 같은 값 찾기" />
                                    <UniformGrid Margin="0,6,0,0"
                                                 Columns="3"
                                                 Rows="1">
