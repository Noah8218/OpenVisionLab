<Window x:Class="OpenVisionLab.OpenVisionLearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenVisionLab"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OpenVisionLab Learn"
        Width="1040"
        Height="700"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="OpenVisionLearnWindow">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:SharedResourceDictionary Source="LearnResources.xaml" />
    </Window.Resources>

    <Border BorderBrush="#157C86"
            BorderThickness="1"
            Background="#EEF2F6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:OpenVisionWindowTitleBar x:Name="learnTitleBar"
                                            Grid.Row="0"
                                            TitleText="OpenVisionLab Learn"
                                            AutomationProperties.AutomationId="OpenVisionLearnTitleBar" />

    <Grid Grid.Row="1"
          Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource LearnPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Learn"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               Text="Learn에서 개념을 익히고 샘플과 도구를 연결합니다. 실제 파라미터는 각 Tool View에서 조정합니다." />
                </StackPanel>
                <ListBox x:Name="topicList"
                         Grid.Row="2"
                         AutomationProperties.AutomationId="OpenVisionLearnTopicList"
                         BorderThickness="0"
                         Background="Transparent"
                         DisplayMemberPath="."
                         SelectedIndex="2"
                         SelectionChanged="TopicList_SelectionChanged">
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource LearnPanelStyle}">
                <StackPanel>
                    <TextBlock x:Name="txtTopicTitle"
                               Text="3. 이진화 / Threshold"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="txtTopicSubtitle"
                               Margin="0,4,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               Text="세부 문서: Arithmetic, RotateScale, Color/HSV, Pipeline/Layer, Metrics/Acceptance." />
                    <StackPanel Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="92"
                                Padding="12,6"
                                Content="현재 문서"
                                ToolTip="현재 학습 주제의 상세 문서를 엽니다."
                                Click="OpenLearnDocsButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnOpenDocsButton" />
                        <Button MinWidth="112"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Content="기초 용어"
                                ToolTip="Point, Rect, Mat, ROI, Layer 기초 문서를 엽니다."
                                Click="OpenFoundationDocsButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnOpenFoundationDocsButton" />
                        <Button x:Name="btnPracticeSamples"
                                MinWidth="118"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Content="실습 샘플"
                                IsEnabled="False"
                                ToolTip="현재 주제와 관련된 공개 실습 샘플을 엽니다."
                                Click="OpenPracticeSamplesButton_Click"
                                AutomationProperties.AutomationId="OpenVisionLearnPracticeSamplesButton" />
                    </StackPanel>
                    <TextBlock x:Name="txtTopicPractice"
                               Margin="0,8,0,0"
                               Style="{StaticResource LearnMutedTextStyle}"
                               TextWrapping="Wrap"
                               Text="실습: 샘플에서 입력 이미지와 결과 지표를 확인한 뒤 관련 Tool View에서 같은 파라미터를 찾아보세요." />
                    <Expander x:Name="practiceWorkflowExpander"
                              Margin="0,8,0,0"
                              Header="실습 순서"
                              FontWeight="SemiBold"
                              IsExpanded="False"
                              AutomationProperties.AutomationId="OpenVisionLearnPracticeWorkflowPanel">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource LearnMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="실습 샘플 열기 → Good/Bad 쌍 선택 → 관련 도구 열기 → Preview 또는 Pipeline Review 실행 → 오버레이와 지표 비교 → 레시피 저장" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="결과를 판단할 때는 입력 이미지, 출력 이미지, 핵심 지표가 같은 검사 목적을 설명하는지 함께 확인하세요." />
                        </StackPanel>
                    </Expander>
                    <StackPanel x:Name="animationLegendPanel"
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                AutomationProperties.AutomationId="OpenVisionLearnAnimationLegend">
                        <TextBlock Text="애니메이션 색상"
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.NeutralBrush}" />
                        <TextBlock Text="중립" Margin="0,0,10,0" Style="{StaticResource LearnMutedTextStyle}" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.CandidateBrush}" />
                        <TextBlock Text="후보" Margin="0,0,10,0" Style="{StaticResource LearnMutedTextStyle}" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.PassBrush}" />
                        <TextBlock Text="OK" Margin="0,0,10,0" Style="{StaticResource LearnMutedTextStyle}" />
                        <Border Width="12" Height="12" Margin="0,2,4,0" Background="{StaticResource Learn.Animation.WarningBrush}" />
                        <TextBlock Text="주의/이상치" Style="{StaticResource LearnMutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <local:FoundationLearnView x:Name="foundationLearnView" Grid.Row="2" Visibility="Collapsed" />

            <local:GrayscaleLearnView x:Name="grayscaleLearnView" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" />


            <local:GeometryLearnView x:Name="geometryLearnView" Grid.Row="2" Visibility="Collapsed" />
            <Border x:Name="colorHsvTopicPanel"
                    Grid.Row="2"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="색상 검사는 색상·채도·밝기를 나누어 비교합니다."
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="RGB/BGR은 원본 색 성분을 저장합니다. HSV에서는 Hue가 색상 계열, Saturation이 색의 선명도, Value가 밝기를 나타내므로 색 영역을 범위로 정하기 쉽습니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="색상 검사는 BGR을 HSV로 해석해 원하는 색 범위를 마스크로 분리합니다. Hue, Saturation, Value 범위를 조정하고 결과 마스크와 MaskPixelRatio를 비교하세요." />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnColorHsvPlay"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Play"
                                    Click="ColorHsvPlayButton_Click"
                                    ToolTip="BGR 채널 분리/결합, HSV 변환, 범위 게이트, 마스크 단계를 자동으로 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnColorHsvPlayButton" />
                            <Button Grid.Column="2"
                                    MinWidth="78"
                                    Height="30"
                                    Content="Step"
                                    Click="ColorHsvStepButton_Click"
                                    ToolTip="다음 Color/HSV 판정 단계를 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnColorHsvStepButton" />
                            <Button Grid.Column="4"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Reset"
                                    Click="ColorHsvResetButton_Click"
                                    ToolTip="입력 색상 확인 단계로 되돌립니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnColorHsvResetButton" />
                            <TextBlock x:Name="txtColorHsvAnimationStatus"
                                       Grid.Column="6"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LearnAnimationStatusStyle}"
                                       AutomationProperties.Name="Color HSV animation status"
                                       AutomationProperties.AutomationId="OpenVisionLearnColorHsvAnimationStatus" />
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnColorSampleEvidence">
                            <StackPanel>
                                <TextBlock Text="공개 HSV 실습 샘플"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="실습 샘플에서 Public_HSV_ColorPatch_Good와 Public_HSV_ColorPatch_Missing_Bad를 열어 색 마스크를 비교합니다. 먼저 MaskPixelRatio를 확인하고 Good/Bad 결과에서 선택 영역이 어떻게 달라지는지 검토하세요." />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="채널로 색 읽기"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="같은 색 픽셀도 BGR과 HSV에서는 서로 다른 세 값으로 표현됩니다."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <Grid Margin="0,0,0,6"
                                          AutomationProperties.AutomationId="OpenVisionLearnColorHsvConversionPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="83" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="83" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="colorBgrPixelCard"
                                                Height="52"
                                                Background="#69B919"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorBgrPixelCard">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="BGR Vec3b"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock x:Name="txtColorBgrPixelValue"
                                                           Margin="0,3,0,0"
                                                           Text="(25,185,105)"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="colorHsvConversionArrow"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="OpenVisionLearnColorHsvConversionArrow">
                                            <TextBlock Text="> CvtColor"
                                                       FontSize="8"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="BGR2HSV"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <Border x:Name="colorHsvPixelCard"
                                                Grid.Column="2"
                                                Height="52"
                                                Background="#69B919"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorHsvPixelCard">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="HSV Vec3b"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock x:Name="txtColorHsvPixelValue"
                                                           Margin="0,3,0,0"
                                                           Text="(45,221,185)"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="colorBgrSplitMergePanel"
                                                Margin="0,0,0,6"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorBgrSplitMergePanel">
                                        <TextBlock x:Name="txtColorBgrSplitTitle"
                                                   Text="Cv2.Split(bgrMat) -> B / G / R (CV_8UC1)"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   AutomationProperties.AutomationId="OpenVisionLearnColorBgrSplitTitle" />
                                        <UniformGrid x:Name="colorBgrSplitChannels"
                                                     Margin="0,3,0,3"
                                                     Columns="3"
                                                     Rows="1"
                                                     AutomationProperties.AutomationId="OpenVisionLearnColorBgrSplitChannels">
                                            <Border Height="34"
                                                    Margin="0,0,5,0"
                                                    Background="#191919"
                                                    BorderBrush="#2563EB"
                                                    BorderThickness="2"
                                                    CornerRadius="4">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="B 채널"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="25"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Height="34"
                                                    Margin="0,0,5,0"
                                                    Background="#B9B9B9"
                                                    BorderBrush="#16A34A"
                                                    BorderThickness="2"
                                                    CornerRadius="4">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="G 채널"
                                                               Foreground="#111827"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="185"
                                                               Foreground="#111827"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border Height="34"
                                                    Background="#696969"
                                                    BorderBrush="#DC2626"
                                                    BorderThickness="2"
                                                    CornerRadius="4">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="R 채널"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="105"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <Border x:Name="colorBgrMergeResult"
                                                Height="24"
                                                Background="#E8F4F5"
                                                BorderBrush="#A5D4DC"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorBgrMergeResult">
                                            <TextBlock x:Name="txtColorBgrMergeResult"
                                                       Text="Cv2.Merge(B,G,R) -> BGR Mat (25,185,105)"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <UniformGrid Columns="3"
                                                 Rows="1">
                                        <Border x:Name="colorHueChannel"
                                                Height="44"
                                                Margin="0,0,6,0"
                                                Background="#DC2626"
                                                CornerRadius="4">
                                            <TextBlock Text="Hue"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="colorSaturationChannel"
                                                Height="44"
                                                Margin="0,0,6,0"
                                                Background="#2563EB"
                                                CornerRadius="4">
                                            <TextBlock Text="Saturation"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="colorValueChannel"
                                                Height="44"
                                                Background="#6B7280"
                                                CornerRadius="4">
                                            <TextBlock Text="Value"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="HSV 범위 판정"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="btnColorHsvOpenTool"
                                                Grid.Column="1"
                                                MinWidth="112"
                                                Height="30"
                                                Padding="10,4"
                                                Content="HSV Tool 열기"
                                                IsEnabled="False"
                                                Tag="HSV"
                                                ToolTip="HSV Tool View의 Hue, Saturation, Value 범위와 ROI 위치를 엽니다."
                                                Click="OpenRelatedToolButton_Click"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorHsvOpenToolButton" />
                                    </Grid>
                                    <TextBlock x:Name="txtColorHsvFormula"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <TextBlock x:Name="txtColorHsvMeaning"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <StackPanel x:Name="colorHsvToolLocationPanel"
                                                Margin="0,8,0,0"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorHsvToolLocationPanel">
                                        <Separator Margin="0,0,0,7" />
                                        <TextBlock x:Name="txtColorHsvToolLocationTitle"
                                                   FontWeight="SemiBold"
                                                   Text="찾을 위치: HSV Tool View > Hue / Saturation / Value 범위, ROI, OutputLayer"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="OpenVisionLearnColorHsvToolLocationTitle" />
                                        <TextBlock x:Name="txtColorHsvToolLocationDetail"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource LearnMutedTextStyle}"
                                                   Text="입력 이미지와 HSV 마스크 출력 위치를 확인하고 Preview에서 선택된 색 영역을 비교하세요."
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="OpenVisionLearnColorHsvToolLocationDetail" />
                                    </StackPanel>
                                    <StackPanel x:Name="colorHsvTypeGuidePanel"
                                                Margin="0,8,0,0"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorHsvTypeGuidePanel">
                                        <Separator Margin="0,0,0,7" />
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="OpenCvSharp 데이터 형식" />
                                        <TextBlock x:Name="txtColorHsvVec3bType"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource LearnMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="OpenVisionLearnColorHsvVec3bType" />
                                        <TextBlock x:Name="txtColorHsvScalarBounds"
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource LearnMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="OpenVisionLearnColorHsvScalarBounds" />
                                        <TextBlock x:Name="txtColorHsvInRange"
                                                   Margin="0,3,0,0"
                                                   Style="{StaticResource LearnMutedTextStyle}"
                                                   Text="Cv2.InRange(hsvMat, lower, upper, mask): 각 Vec3b 채널이 범위 안이면 255, 밖이면 0"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="OpenVisionLearnColorHsvInRange" />
                                    </StackPanel>
                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="확인 순서: 배경에 비슷한 색이 있으면 ROI를 좁히고, HSV 마스크를 출력 Layer에서 확인한 뒤 MaskPixelRatio 또는 후속 ResultCount/Area로 Good/Bad를 비교합니다." />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="colorHsvPreviewSwatch"
                                        Grid.Column="0"
                                        Height="82"
                                        CornerRadius="6"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">
                                    <TextBlock x:Name="txtColorHsvPreviewLabel"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Hue"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="txtColorHsvHue"
                                                       Grid.Column="1"
                                                       Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                        </Grid>
                                        <Border Height="12"
                                                Margin="0,6,0,0"
                                                CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5"
                                                                     EndPoint="1,0.5">
                                                    <GradientStop Color="#EF4444"
                                                                  Offset="0" />
                                                    <GradientStop Color="#F59E0B"
                                                                  Offset="0.18" />
                                                    <GradientStop Color="#22C55E"
                                                                  Offset="0.38" />
                                                    <GradientStop Color="#06B6D4"
                                                                  Offset="0.58" />
                                                    <GradientStop Color="#3B82F6"
                                                                  Offset="0.75" />
                                                    <GradientStop Color="#EF4444"
                                                                  Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Slider x:Name="colorHueSlider"
                                                Margin="0,6,0,0"
                                                Minimum="0"
                                                Maximum="179"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="ColorHsvSlider_ValueChanged"
                                                AutomationProperties.Name="Hue value from 0 to 179"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorHueSlider" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Value"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="txtColorHsvValue"
                                                       Grid.Column="1"
                                                       Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                        </Grid>
                                        <Slider x:Name="colorValueSlider"
                                                Margin="0,24,0,0"
                                                Minimum="40"
                                                Maximum="255"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                IsMoveToPointEnabled="True"
                                                ValueChanged="ColorHsvSlider_ValueChanged"
                                                AutomationProperties.Name="Minimum brightness value from 40 to 255"
                                                AutomationProperties.AutomationId="OpenVisionLearnColorValueSlider" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>


            <local:BinaryLearnView x:Name="binaryLearnView" Grid.Row="2" Visibility="Collapsed" />



            <local:LineLearnView x:Name="lineLearnView" Grid.Row="2" Visibility="Collapsed" />


            <local:MatchingLearnView x:Name="matchingLearnView" Grid.Row="2" Visibility="Collapsed" />

            <local:LayerRecipeLearnView x:Name="layerRecipeLearnView" Grid.Row="2" Visibility="Collapsed" />

            <local:MetricsAcceptanceLearnView x:Name="metricsAcceptanceLearnView"
                                               Grid.Row="2"
                                               Visibility="Collapsed" />


        </Grid>
    </Grid>
        </Grid>
    </Border>
</Window>
