                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="OpenVisionLab에서의 의미"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Threshold는 보통 Blob, Contour, Morphology 앞에서 밝은 대상과 어두운 배경을 분리할 때 사용합니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="예제 값 적용 후 Tool View의 Preview를 눌러 결과 이미지와 지표 변화를 확인하세요." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="애니메이션">
                    <Grid Margin="0,10,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtThresholdValue"
                                               FontWeight="SemiBold"
                                               Text="Threshold = 127" />
                                    <TextBlock x:Name="txtMaxValue"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                                               Text="MaxValue = 255" />
                                </Grid>

                                <Grid x:Name="thresholdBarHost"
                                      Grid.Row="2"
                                      SizeChanged="ThresholdBarHost_SizeChanged">
                                    <Border CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#111827" Offset="0" />
                                                <GradientStop Color="#6B7280" Offset="0.50" />
                                                <GradientStop Color="#FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="thresholdMarker"
                                            Width="4"
                                            Background="#EF4444"
                                            HorizontalAlignment="Left"
                                            CornerRadius="2">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="thresholdMarkerTransform" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>

                                <Slider x:Name="thresholdSlider"
                                        Grid.Row="4"
                                        Minimum="0"
                                        Maximum="255"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="ThresholdSlider_ValueChanged"
                                        AutomationProperties.Name="Threshold in GV"
                                        AutomationProperties.AutomationId="OpenVisionLearnThresholdSlider" />

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="0 검정"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="255 흰색"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="예제 GV"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="각 칸은 하나의 예제 픽셀입니다."
                                               FontSize="11"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                    <UniformGrid x:Name="sampleGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="이진화 결과"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtFormula"
                                               Margin="0,3,0,10"
                                               FontSize="11"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                    <UniformGrid x:Name="resultGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="툴 적용">
                    <Border Margin="0,10,8,0"
                            Style="{StaticResource LearnPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Tool로 돌아가는 방법"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="1. 애니메이션 탭에서 Threshold와 BinaryInv를 조정합니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="2. Apply to tool을 누르면 현재 열린 Threshold Tool의 값만 바뀝니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="3. 실제 결과 이미지는 Threshold Tool에서 Run Preview를 눌러 확인합니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="4. 결과가 좋으면 Add Pipeline으로 recipe step을 저장합니다." />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <Grid x:Name="thresholdControls"
                  Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkInvert"
                          Grid.Column="0"
                          Content="BinaryInv"
                          VerticalAlignment="Center"
                          Checked="InvertCheckBox_Changed"
                          Unchecked="InvertCheckBox_Changed"
                          AutomationProperties.AutomationId="OpenVisionLearnThresholdInvertCheckBox" />
                <Button x:Name="btnAnimate"
                        Grid.Column="1"
                        MinWidth="84"
                        Height="32"
                        Content="Play"
                        Click="AnimateButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnThresholdAnimationButton" />
                <Button x:Name="btnApply"
                        Grid.Column="3"
                        MinWidth="122"
                        Height="32"
                        Content="Apply to tool"
                        Click="ApplyButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnThresholdApplyButton" />
                <Button Grid.Column="5"
                        MinWidth="78"
                        Height="32"
                        Content="Close"
                        Click="CloseButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnCloseButton" />
            </Grid>
        </Grid>
    </Grid>
        </Grid>
    </Border>
</Window>
