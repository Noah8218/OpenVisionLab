<UserControl x:Class="OpenVisionLab.GrayscaleLearnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab"
             Focusable="False">
    <UserControl.Resources>
        <local:SharedResourceDictionary Source="LearnResources.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
            <Border x:Name="brightnessTopicPanel"
                    Grid.Row="0"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="왜 밝기와 히스토그램을 먼저 보나요?"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="밝기는 각 픽셀의 GV가 얼마나 큰지를 뜻합니다. 조명이 변하거나 대상이 어두워지면 같은 Threshold 값도 전혀 다른 결과를 만들 수 있습니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="히스토그램은 이미지 안에 어떤 밝기 값이 얼마나 많은지 세어 놓은 표입니다. 어두운 값에 몰려 있으면 전체가 어둡고, 밝은 값에 몰려 있으면 전체가 밝습니다." />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="관련 Tool View"
                                       FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button x:Name="btnBrightnessOpenMeanTool"
                                        MinWidth="118"
                                        Height="30"
                                        Padding="10,4"
                                        Content="Mean Tool 열기"
                                        IsEnabled="False"
                                        Tag="Mean"
                                        ToolTip="Mean Tool View의 Mean Type, Min Mean, Max Mean 위치를 엽니다."
                                        Click="OpenRelatedToolButton_Click"
                                        AutomationProperties.AutomationId="OpenVisionLearnBrightnessOpenMeanToolButton" />
                                <Button x:Name="btnBrightnessOpenHistogramTool"
                                        Margin="8,0,0,0"
                                        MinWidth="142"
                                        Height="30"
                                        Padding="10,4"
                                        Content="Histogram Tool 열기"
                                        IsEnabled="False"
                                        Tag="Histogram"
                                        ToolTip="Histogram Tool View의 Type과 보정 파라미터 위치를 엽니다."
                                        Click="OpenRelatedToolButton_Click"
                                        AutomationProperties.AutomationId="OpenVisionLearnBrightnessOpenHistogramToolButton" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="brightnessToolLocationPanel"
                                    Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="OpenVisionLearnBrightnessToolLocationPanel">
                            <Separator Margin="0,0,0,7" />
                            <TextBlock x:Name="txtBrightnessToolLocationTitle"
                                       FontWeight="SemiBold"
                                       Text="찾을 위치: Mean > Mean Type / Min Mean / Max Mean | Histogram > Type / Clip Limit / Tile Grid"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnBrightnessToolLocationTitle" />
                            <TextBlock x:Name="txtBrightnessToolLocationDetail"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="입력과 출력 레이어를 확인하고 Preview 또는 Pipeline Review에서 평균 GV와 분포 변화를 비교하세요."
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnBrightnessToolLocationDetail" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnBrightnessPlay"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Play"
                                    Click="BrightnessPlayButton_Click"
                                    ToolTip="GV 보정과 히스토그램 이동을 자동으로 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnBrightnessPlayButton" />
                            <Button Grid.Column="2"
                                    MinWidth="78"
                                    Height="30"
                                    Content="Step"
                                    Click="BrightnessStepButton_Click"
                                    ToolTip="다음 밝기 학습 단계를 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnBrightnessStepButton" />
                            <Button Grid.Column="4"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Reset"
                                    Click="BrightnessResetButton_Click"
                                    ToolTip="원본 GV 확인 단계로 되돌립니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnBrightnessResetButton" />
                            <TextBlock x:Name="txtBrightnessAnimationStatus"
                                       Grid.Column="6"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LearnAnimationStatusStyle}"
                                       AutomationProperties.Name="Brightness animation status"
                                       AutomationProperties.AutomationId="OpenVisionLearnBrightnessAnimationStatus" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="원본 GV 샘플"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="각 칸은 이미지 안의 픽셀 밝기 예시입니다."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="brightnessInputGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="밝기 보정 후"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtBrightnessFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="brightnessOutputGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="미니 히스토그램"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtBrightnessOffset"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                                <Slider x:Name="brightnessOffsetSlider"
                                        Grid.Row="2"
                                        Minimum="-80"
                                        Maximum="80"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="BrightnessOffsetSlider_ValueChanged"
                                        AutomationProperties.Name="Brightness offset in GV"
                                        AutomationProperties.AutomationId="OpenVisionLearnBrightnessOffsetSlider" />
                                <UniformGrid x:Name="histogramGrid"
                                             Grid.Row="4"
                                             Columns="8"
                                             Rows="1" />
                                <TextBlock Grid.Row="5"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="Threshold를 정하기 전에는 대상과 배경의 밝기 분포가 떨어져 있는지 확인합니다. 분포가 겹치면 Threshold 하나로 안정적인 검출이 어렵습니다." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="arithmeticTopicPanel"
                    Grid.Row="0"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Arithmetic는 한 개 또는 두 개 Layer의 픽셀 값을 계산합니다."
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="밝기 보정, 영상 차이 비교, 마스크 결합이 필요할 때 사용합니다. 먼저 입력 Layer와 이진 영상의 흰색/검정 의미를 확인하세요." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Arithmetic는 입력 A와 B를 픽셀 단위로 계산해 새 결과를 만듭니다. 두 입력과 연산 종류를 선택한 뒤 Preview에서 계산 결과를 비교하세요." />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="관련 Tool View"
                                       FontWeight="SemiBold" />
                            <Button x:Name="btnArithmeticOpenTool"
                                    Grid.Column="1"
                                    MinWidth="142"
                                    Height="30"
                                    Padding="10,4"
                                    Content="Arithmetic Tool 열기"
                                    IsEnabled="False"
                                    Tag="Arithmetic"
                                    ToolTip="Arithmetic Tool View의 입력 A/B, 연산 종류, Output Layer 위치를 엽니다."
                                    Click="OpenRelatedToolButton_Click"
                                    AutomationProperties.AutomationId="OpenVisionLearnArithmeticOpenToolButton" />
                        </Grid>
                        <StackPanel x:Name="arithmeticToolLocationPanel"
                                    Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="OpenVisionLearnArithmeticToolLocationPanel">
                            <Separator Margin="0,0,0,7" />
                            <TextBlock x:Name="txtArithmeticToolLocationTitle"
                                       FontWeight="SemiBold"
                                       Text="찾을 위치: Input A / Input B / Output Layer, Mode, Arithmetic Type, Input B Source"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnArithmeticToolLocationTitle" />
                            <TextBlock x:Name="txtArithmeticToolLocationDetail"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="두 입력 또는 Constant/Offset 모드를 선택하고 Preview에서 원본과 계산 결과를 비교하세요."
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnArithmeticToolLocationDetail" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnArithmeticPlay"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Play"
                                    Click="ArithmeticPlayButton_Click"
                                    ToolTip="Input A/B에서 Output까지의 연산 단계를 자동으로 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnArithmeticPlayButton" />
                            <Button Grid.Column="2"
                                    MinWidth="78"
                                    Height="30"
                                    Content="Step"
                                    Click="ArithmeticStepButton_Click"
                                    ToolTip="다음 Arithmetic 계산 단계를 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnArithmeticStepButton" />
                            <Button Grid.Column="4"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Reset"
                                    Click="ArithmeticResetButton_Click"
                                    ToolTip="Input A/B 확인 단계로 되돌립니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnArithmeticResetButton" />
                            <TextBlock x:Name="txtArithmeticAnimationStatus"
                                       Grid.Column="6"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LearnAnimationStatusStyle}"
                                       AutomationProperties.Name="Arithmetic animation status"
                                       AutomationProperties.AutomationId="OpenVisionLearnArithmeticAnimationStatus" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="입력 Layer A"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="첫 번째 영상 또는 마스크"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="arithmeticInputAGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="입력 Layer B"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="두 번째 영상, 마스크 또는 상수"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="arithmeticInputBGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="출력 Layer"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtArithmeticFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="arithmeticResultGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="연산"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="arithmeticModeCombo"
                                              Grid.Column="2"
                                              SelectedIndex="2"
                                              SelectionChanged="ArithmeticModeCombo_SelectionChanged"
                                              AutomationProperties.Name="Arithmetic operation"
                                              AutomationProperties.AutomationId="OpenVisionLearnArithmeticModeCombo">
                                        <ComboBoxItem Content="Add" />
                                        <ComboBoxItem Content="Subtract" />
                                        <ComboBoxItem Content="AbsDiff" />
                                        <ComboBoxItem Content="Bitwise AND" />
                                        <ComboBoxItem Content="Bitwise OR" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="txtArithmeticMeaning"
                                           Grid.Row="2"
                                           Style="{StaticResource LearnMutedTextStyle}" />
                                <TextBlock Grid.Row="4"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="확인 순서: 입력 A/B가 의도한 영상인지 확인하고, 이진 영상의 흰색/검정 의미를 정한 뒤, 출력 Layer에서 계산 결과를 비교합니다." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="filterTopicPanel"
                    Grid.Row="0"
                    Margin="0,10,8,0"
                    Style="{StaticResource LearnPanelStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Margin="0,0,0,12"
                                Style="{StaticResource LearnPanelStyle}"
                                AutomationProperties.AutomationId="OpenVisionLearnFilteringPracticePanel">
                            <StackPanel>
                                <TextBlock Text="공개 샘플로 확인"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="Good: Public_Filter_Denoise_Good  |  Bad: Public_Filter_Denoise_Missing_Bad" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="Pipeline: Public_Filter_Denoise  |  판정: ResultCount 4는 OK, 2는 NG" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="상단 실습 샘플 버튼으로 두 장을 연 뒤 Filter Tool에서 Median Kernel을 확인하고, Preview 또는 Pipeline Review를 직접 실행해 노이즈 제거와 최종 개수를 비교합니다." />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="필터는 주변 픽셀을 같이 보는 연산입니다"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="Threshold는 픽셀 하나를 기준값과 비교하지만, 필터링은 중심 픽셀 주변의 작은 영역을 같이 계산합니다. 그래서 노이즈를 줄이거나 경계를 강조할 수 있습니다." />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource LearnMutedTextStyle}"
                                   Text="OpenVisionLab에서는 필터링 결과를 별도 Output 레이어에 만든 뒤, 그 레이어를 다음 Threshold, Blob, Contour, Line 도구의 Input으로 연결해 확인합니다." />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="관련 Tool View"
                                       FontWeight="SemiBold" />
                            <Button x:Name="btnFilteringOpenTool"
                                    Grid.Column="1"
                                    MinWidth="126"
                                    Height="30"
                                    Padding="10,4"
                                    Content="Filter Tool 열기"
                                    IsEnabled="False"
                                    Tag="Filter"
                                    ToolTip="Filter Tool View의 Filter Type, Kernel, Border Type 위치를 엽니다."
                                    Click="OpenRelatedToolButton_Click"
                                    AutomationProperties.AutomationId="OpenVisionLearnFilteringOpenToolButton" />
                        </Grid>
                        <StackPanel x:Name="filteringToolLocationPanel"
                                    Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="OpenVisionLearnFilteringToolLocationPanel">
                            <Separator Margin="0,0,0,7" />
                            <TextBlock x:Name="txtFilteringToolLocationTitle"
                                       FontWeight="SemiBold"
                                       Text="찾을 위치: Input/Output Layer, Filter Type, Border Type, Kernel Width/Height"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnFilteringToolLocationTitle" />
                            <TextBlock x:Name="txtFilteringToolLocationDetail"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="Median은 Median Kernel을, Bilateral은 Diameter와 Sigma Color/Space를 조정한 뒤 Preview에서 노이즈와 경계 보존 정도를 비교하세요."
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="OpenVisionLearnFilteringToolLocationDetail" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnFilterPlay"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Play"
                                    Click="FilterPlayButton_Click"
                                    ToolTip="3x3 커널 계산 단계를 자동으로 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnFilterPlayButton" />
                            <Button Grid.Column="2"
                                    MinWidth="78"
                                    Height="30"
                                    Content="Step"
                                    Click="FilterStepButton_Click"
                                    ToolTip="다음 필터 계산 단계를 보여줍니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnFilterStepButton" />
                            <Button Grid.Column="4"
                                    MinWidth="72"
                                    Height="30"
                                    Content="Reset"
                                    Click="FilterResetButton_Click"
                                    ToolTip="원본 3x3 GV 확인 단계로 되돌립니다."
                                    AutomationProperties.AutomationId="OpenVisionLearnFilterResetButton" />
                            <TextBlock x:Name="txtFilterAnimationStatus"
                                       Grid.Column="6"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource LearnAnimationStatusStyle}"
                                       AutomationProperties.Name="Filter animation status"
                                       AutomationProperties.AutomationId="OpenVisionLearnFilterAnimationStatus" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="원본 3x3 GV"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="가운데 220은 작은 밝은 노이즈 예시입니다."
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="filterInputGrid"
                                                 Columns="3"
                                                 Rows="3" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="필터 적용 후"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtFilterFormula"
                                               Margin="0,3,0,10"
                                               Style="{StaticResource LearnMutedTextStyle}" />
                                    <UniformGrid x:Name="filterOutputGrid"
                                                 Columns="3"
                                                 Rows="3" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="필터 종류"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="filterModeCombo"
                                              Grid.Column="2"
                                              SelectedIndex="0"
                                              SelectionChanged="FilterModeCombo_SelectionChanged"
                                              AutomationProperties.Name="Filter mode"
                                              AutomationProperties.AutomationId="OpenVisionLearnFilterModeCombo">
                                        <ComboBoxItem Content="Mean blur" />
                                        <ComboBoxItem Content="Median" />
                                        <ComboBoxItem Content="Sharpen" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="txtFilterMeaning"
                                           Grid.Row="2"
                                           Style="{StaticResource LearnMutedTextStyle}" />
                                <TextBlock Grid.Row="4"
                                           Style="{StaticResource LearnMutedTextStyle}"
                                           Text="필터링만으로 검사가 끝나는 경우는 드뭅니다. 보통 노이즈를 정리한 뒤 Threshold나 Edge/Line 같은 다음 도구가 더 안정적으로 동작하도록 준비합니다." />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl x:Name="thresholdTabs"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="OpenVisionLearnThresholdTabs">
                <TabItem Header="개념">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,8,0">
                            <Border Style="{StaticResource LearnPanelStyle}"
                                    AutomationProperties.AutomationId="OpenVisionLearnThresholdPracticePanel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="공개 샘플로 확인"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource LearnMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Good: Public_Threshold_BandPads_Good  |  Bad: Public_Threshold_BandPads_Missing_Bad" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource LearnMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Pipeline: Public_Threshold_BandPads  |  판정: ResultCount 4는 OK, 1은 NG" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource LearnMutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="실습 샘플을 연 뒤 Threshold Tool에서 기준 GV를 확인하고, Preview 또는 Pipeline Review를 직접 실행해 결과를 비교합니다." />
                                    </StackPanel>
                                    <Button x:Name="btnThresholdOpenTool"
                                            Grid.Column="1"
                                            MinWidth="136"
                                            Height="30"
                                            Margin="12,0,0,0"
                                            Padding="10,4"
                                            VerticalAlignment="Top"
                                            Content="Threshold Tool 열기"
                                            IsEnabled="False"
                                            Tag="Threshold"
                                            ToolTip="Threshold Tool View의 기준 GV, MaxValue, Binary/BinaryInv 위치를 엽니다."
                                            Click="OpenRelatedToolButton_Click"
                                            AutomationProperties.AutomationId="OpenVisionLearnThresholdOpenToolButton" />
                                </Grid>
                            </Border>
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="핵심 키워드"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="GV: Gray Value입니다. 0은 검정, 255는 흰색에 가까운 밝기 숫자입니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Threshold: 픽셀 GV와 비교하는 기준값입니다. 기준보다 밝은지 어두운지로 결과가 갈립니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="MaxValue: 조건을 만족한 픽셀을 흰색으로 만들 때 쓰는 값입니다. 보통 255입니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Binary: GV가 기준값 이상이면 MaxValue, 아니면 0입니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="BinaryInv: Binary의 반대입니다. 밝은 영역을 검정으로, 어두운 영역을 흰색으로 만듭니다." />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="OpenVisionLab에서의 의미"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="Threshold는 보통 Blob, Contour, Morphology 앞에서 밝은 대상과 어두운 배경을 분리할 때 사용합니다." />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource LearnMutedTextStyle}"
                                               Text="예제 값 적용 후 Tool View의 Preview를 눌러 결과 이미지와 지표 변화를 확인하세요." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="애니메이션">
                    <Grid Margin="0,10,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource LearnPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="44" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtThresholdValue"
                                               FontWeight="SemiBold"
                                               Text="Threshold = 127" />
                                    <TextBlock x:Name="txtMaxValue"
                                               Grid.Column="1"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                                               Text="MaxValue = 255" />
                                </Grid>

                                <Grid x:Name="thresholdBarHost"
                                      Grid.Row="2"
                                      SizeChanged="ThresholdBarHost_SizeChanged">
                                    <Border CornerRadius="3">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#111827" Offset="0" />
                                                <GradientStop Color="#6B7280" Offset="0.50" />
                                                <GradientStop Color="#FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="thresholdMarker"
                                            Width="4"
                                            Background="#EF4444"
                                            HorizontalAlignment="Left"
                                            CornerRadius="2">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="thresholdMarkerTransform" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>

                                <Slider x:Name="thresholdSlider"
                                        Grid.Row="4"
                                        Minimum="0"
                                        Maximum="255"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="ThresholdSlider_ValueChanged"
                                        AutomationProperties.Name="Threshold in GV"
                                        AutomationProperties.AutomationId="OpenVisionLearnThresholdSlider" />

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="0 검정"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="255 흰색"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="예제 GV"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="각 칸은 하나의 예제 픽셀입니다."
                                               FontSize="11"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}" />
                                    <UniformGrid x:Name="sampleGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource LearnPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="이진화 결과"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtFormula"
                                               Margin="0,3,0,10"
                                               FontSize="11"
                                               Foreground="{StaticResource VisionTool.SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                    <UniformGrid x:Name="resultGrid"
                                                 Columns="4"
                                                 Rows="2" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="툴 적용">
                    <Border Margin="0,10,8,0"
                            Style="{StaticResource LearnPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Tool로 돌아가는 방법"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="1. 애니메이션 탭에서 Threshold와 BinaryInv를 조정합니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="2. Apply to tool을 누르면 현재 열린 Threshold Tool의 값만 바뀝니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="3. 실제 결과 이미지는 Threshold Tool에서 Run Preview를 눌러 확인합니다." />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource LearnMutedTextStyle}"
                                       Text="4. 결과가 좋으면 Add Pipeline으로 recipe step을 저장합니다." />
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <Grid x:Name="thresholdControls"
                  Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="chkInvert"
                          Grid.Column="0"
                          Content="BinaryInv"
                          VerticalAlignment="Center"
                          Checked="InvertCheckBox_Changed"
                          Unchecked="InvertCheckBox_Changed"
                          AutomationProperties.AutomationId="OpenVisionLearnThresholdInvertCheckBox" />
                <Button x:Name="btnAnimate"
                        Grid.Column="1"
                        MinWidth="84"
                        Height="32"
                        Content="Play"
                        Click="AnimateButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnThresholdAnimationButton" />
                <Button x:Name="btnApply"
                        Grid.Column="3"
                        MinWidth="122"
                        Height="32"
                        Content="Apply to tool"
                        Click="ApplyButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnThresholdApplyButton" />
                <Button Grid.Column="5"
                        MinWidth="78"
                        Height="32"
                        Content="Close"
                        Click="CloseButton_Click"
                        AutomationProperties.AutomationId="OpenVisionLearnCloseButton" />
            </Grid>
    </Grid>
</UserControl>
