<local:VisionToolSingleInputPropertyToolViewBase x:Class="OpenVisionLab.LineToolWpfView"
                                                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                                                 xmlns:local="clr-namespace:OpenVisionLab">
    <local:VisionToolSingleInputPropertyToolViewBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="../Tooling/Presentation/VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:VisionToolSingleInputPropertyToolViewBase.Resources>

    <Grid>
        <local:VisionToolSingleInputPropertyToolShell x:Name="toolShell"
                                                      TitleIconKind="VectorLine"
                                                      LearnButtonVisibility="Visible"
                                                      LearnButtonText="Learn Line"
                                                      LearnTopicIndex="8" />

        <StackPanel x:Name="lineToolContentHost"
                    Visibility="Collapsed">
            <Border x:Name="purposeContentHost"
                    Background="{DynamicResource OpenVision.Workbench.PanelAltBrush}"
                    BorderBrush="{DynamicResource OpenVision.Workbench.FieldBorderBrush}"
                    BorderThickness="1"
                    Padding="6,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock x:Name="txtPurposeLabel"
                                   Text="Purpose"
                                   Width="64"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <RadioButton x:Name="rdoPurposeEdge"
                                     Content="Edge"
                                     GroupName="LinePurpose"
                                     AutomationProperties.AutomationId="LineToolPurposeEdge"
                                     Style="{StaticResource VisionTool.SegmentedRadioButtonStyle}"
                                     IsChecked="True" />
                        <RadioButton x:Name="rdoPurposeMeasure"
                                     Content="Measure"
                                     GroupName="LinePurpose"
                                     AutomationProperties.AutomationId="LineToolPurposeMeasure"
                                     Style="{StaticResource VisionTool.SegmentedRadioButtonStyle}" />
                        <RadioButton x:Name="rdoPurposeIntersection"
                                     Content="Intersection"
                                     GroupName="LinePurpose"
                                     AutomationProperties.AutomationId="LineToolPurposeIntersection"
                                     Style="{StaticResource VisionTool.SegmentedRadioButtonStyle}" />
                        <Button x:Name="btnOpenSignalInspector"
                                Height="28"
                                MinWidth="112"
                                Margin="8,0,0,0"
                                Padding="8,0"
                                Click="OpenSignalInspector_Click"
                                Content="Review signal"
                                Visibility="Collapsed"
                                ToolTip="Review the representative scan intensity and edge response"
                                AutomationProperties.AutomationId="LineSignalInspectorOpenButton" />
                        <Border x:Name="signalEvidenceCue"
                                MaxWidth="140"
                                MinHeight="28"
                                Margin="6,0,0,0"
                                Padding="9,5"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                Background="{StaticResource VisionTool.HeaderBrush}"
                                BorderBrush="{StaticResource VisionTool.AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                AutomationProperties.AutomationId="LineSignalEvidenceCue">
                            <TextBlock x:Name="txtSignalEvidenceCue"
                                       Foreground="{StaticResource VisionTool.PrimaryTextBrush}"
                                       Text="Signal updated"
                                       TextTrimming="None" />
                        </Border>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="txtLineSelectorLabel"
                                   Text="Setting"
                                   Width="64"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <RadioButton x:Name="rdoLineA"
                                     Content="Line A"
                                     GroupName="LineSetting"
                                     AutomationProperties.AutomationId="LineToolSettingA"
                                     Style="{StaticResource VisionTool.SegmentedRadioButtonStyle}"
                                     IsChecked="True" />
                        <RadioButton x:Name="rdoLineB"
                                     Content="Line B"
                                     GroupName="LineSetting"
                                     AutomationProperties.AutomationId="LineToolSettingB"
                                     Style="{StaticResource VisionTool.SegmentedRadioButtonStyle}" />
                        <Button x:Name="btnEditSelectedRoi"
                                Width="Auto"
                                Height="30"
                                MinHeight="30"
                                Padding="8,0"
                                Margin="4,0,0,0"
                                Style="{StaticResource VisionTool.IconButtonStyle}"
                                AutomationProperties.AutomationId="LineToolEditSelectedRoi"
                                ToolTip="Edit selected line ROI">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CropFree"
                                                            Width="17"
                                                            Height="17"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock x:Name="txtEditSelectedRoiCaption"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="txtPurposeHint"
                               Grid.Row="2"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               LineHeight="17.25"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource OpenVision.Workbench.SecondaryTextBrush}"
                               AutomationProperties.AutomationId="LineToolPurposeNote"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid x:Name="lineSignalInspectorOverlay"
              Margin="14"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              IsHitTestVisible="True"
              AutomationProperties.AutomationId="LineSignalInspectorOverlay">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="2"
                    Padding="10"
                    Background="{StaticResource VisionTool.SurfaceBrush}"
                    BorderBrush="{StaticResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="btnCloseSignalInspector"
                            HorizontalAlignment="Left"
                            MinWidth="132"
                            Height="30"
                            Padding="10,0"
                            Click="CloseSignalInspector_Click"
                            Content="Back to parameters"
                            AutomationProperties.AutomationId="LineSignalInspectorBackButton" />
                    <local:VisionToolSignalInspectorView x:Name="signalInspector"
                                                         Grid.Row="2"
                                                         VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:VisionToolSingleInputPropertyToolViewBase>
