<UserControl x:Class="OpenVisionLab.AutoMPointTeachingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Border Background="Transparent"
            BorderThickness="0"
            Padding="0">
        <Expander x:Name="detailsExpander"
                  IsExpanded="False"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.AutomationId="AutoMPointDetailsExpander">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ImageSearch"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource VisionTool.AccentBrush}" />
                    <TextBlock x:Name="titleText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="Auto MPoint" />
                    <Border Margin="8,0,0,0"
                            Padding="6,0"
                            Background="{DynamicResource VisionTool.SurfaceBrush}"
                            BorderThickness="0"
                            CornerRadius="8">
                        <TextBlock x:Name="suggestedText"
                                   FontSize="9"
                                   Foreground="{DynamicResource VisionTool.SecondaryTextBrush}"
                                   Text="Suggested" />
                    </Border>
                </StackPanel>
            </Expander.Header>
            <Border Margin="0,6,0,0"
                    Padding="7"
                    Background="{DynamicResource VisionTool.PanelBrush}"
                    BorderBrush="{DynamicResource VisionTool.HeaderBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal">
                        <Button x:Name="representativeImagesButton"
                                Height="28"
                                Padding="8,2"
                                AutomationProperties.AutomationId="AutoMPointRepresentativeImages">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ImageMultipleOutline"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,5,0"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock x:Name="representativeImagesText"
                                           VerticalAlignment="Center"
                                           Text="Representative images" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="representativeCountText"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource VisionTool.SecondaryTextBrush}"
                                   Text="0 selected" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="analyzeButton"
                                Grid.Column="0"
                                Height="30"
                                Padding="9,2"
                                AutomationProperties.AutomationId="AutoMPointAnalyzeCandidates">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="MagnifyScan"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,5,0"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock x:Name="analyzeText"
                                           VerticalAlignment="Center"
                                           Text="Analyze candidates" />
                            </StackPanel>
                        </Button>
                        <ListBox x:Name="candidateList"
                                 Grid.Column="2"
                                 Height="54"
                                 FontFamily="Consolas"
                                 FontSize="10"
                                 AutomationProperties.AutomationId="AutoMPointCandidateList" />
                        <Button x:Name="usePatternButton"
                                Grid.Column="4"
                                Height="30"
                                Padding="9,2"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="AutoMPointUsePattern">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CheckCircleOutline"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,5,0"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock x:Name="usePatternText"
                                           VerticalAlignment="Center"
                                           Text="Use this pattern" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="reportButton"
                            Grid.Row="4"
                            Height="28"
                            Padding="8,2"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="AutoMPointExportReport">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocumentOutline"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,5,0"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock x:Name="reportText"
                                       VerticalAlignment="Center"
                                       Text="Save N-image report" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="statusText"
                               Grid.Row="6"
                               FontSize="10.5"
                               Foreground="{DynamicResource VisionTool.SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Text="Choose the analysis settings in PropertyGrid, then analyze explicitly." />
                </Grid>
            </Border>
        </Expander>
    </Border>
</UserControl>
