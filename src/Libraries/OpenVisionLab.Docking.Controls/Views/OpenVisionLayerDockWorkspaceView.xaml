<UserControl x:Class="OpenVisionLab.Docking.Controls.OpenVisionLayerDockWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
             xmlns:local="clr-namespace:OpenVisionLab.Docking.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenVisionLab.Docking.Controls;component/Views/OpenVisionLayerDockWorkspaceView.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <avalonDock:DockingManager x:Name="layerDockingManager"
                                   AnchorablePaneControlStyle="{StaticResource DockedLayerAnchorablePaneControlStyle}"
                                   AnchorableHeaderTemplate="{StaticResource DockedLayerTabHeaderTemplate}">
            <avalonDock:DockingManager.Style>
                <Style TargetType="avalonDock:DockingManager">
                    <Setter Property="Background" Value="#05090A"/><Setter Property="Foreground" Value="#D7ECEE"/><Setter Property="BorderBrush" Value="#157C86"/><Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsPresetLayout, RelativeSource={RelativeSource AncestorType=local:OpenVisionLayerDockWorkspaceView}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource OpenVision.Workbench.CanvasBrush}"/><Setter Property="Foreground" Value="{DynamicResource OpenVision.Workbench.TextBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource OpenVision.Workbench.LineBrush}"/><Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger></Style.Triggers>
                </Style>
            </avalonDock:DockingManager.Style>
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutAnchorablePane x:Name="layerAnchorablePane" />
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <local:OpenVisionLayerDockingGuideOverlayView x:Name="dockingGuideOverlay"
                                                      Panel.ZIndex="20"
                                                      IsHitTestVisible="False"
                                                      Visibility="Collapsed" />
    </Grid>
</UserControl>
