<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="RoiArray.SurfaceBrush" Color="#F7FAFB" />
    <SolidColorBrush x:Key="RoiArray.TextBrush" Color="#17323B" />
    <SolidColorBrush x:Key="RoiArray.HoverBrush" Color="#E4F1F3" />
    <SolidColorBrush x:Key="RoiArray.PressedBrush" Color="#C9E3E7" />
    <SolidColorBrush x:Key="RoiArray.FocusBrush" Color="#137C86" />
    <Style x:Key="RoiArray.ButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource RoiArray.TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#8299A2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="focusCue" Margin="2" CornerRadius="4" BorderBrush="{DynamicResource RoiArray.FocusBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chrome" Property="Background" Value="{DynamicResource RoiArray.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="chrome" Property="Background" Value="{DynamicResource RoiArray.PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusCue" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource RoiArray.FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="chrome" Property="Background" Value="#E5EBED" />
                            <Setter TargetName="chrome" Property="BorderBrush" Value="#B1C0C6" />
                            <Setter Property="Foreground" Value="#5C727C" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RoiArray.PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoiArray.ButtonStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="RoiArray.HoverBrush" Color="#116A72" />
            <SolidColorBrush x:Key="RoiArray.PressedBrush" Color="#0E5960" />
            <SolidColorBrush x:Key="RoiArray.FocusBrush" Color="#A8D8DE" />
        </Style.Resources>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#137C86" />
        <Setter Property="BorderBrush" Value="#137C86" />
    </Style>
    <Style x:Key="RoiArray.FieldStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource RoiArray.TextBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#8299A2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <Border x:Name="focusCue" Margin="2" CornerRadius="4" BorderBrush="#137C86" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="focusCue" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="chrome" Property="Background" Value="#E5EBED" />
                            <Setter Property="Foreground" Value="#5C727C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
