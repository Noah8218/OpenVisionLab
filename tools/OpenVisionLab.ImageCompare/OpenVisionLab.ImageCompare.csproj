<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\lens.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>OpenVisionLab.ImageCompare</AssemblyName>
    <RootNamespace>OpenVisionLab.ImageCompare</RootNamespace>
    <ImageCompareIncludeSymbols Condition="'$(ImageCompareIncludeSymbols)' == ''">false</ImageCompareIncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Library\OpenVisionLab.Localization\OpenVisionLab.Localization.csproj" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.27" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\..\UI\Popup\Wpf\ImageCompareWindow.xaml">
      <Link>ImageCompareWindow.xaml</Link>
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Compile Include="..\..\UI\Popup\Wpf\ImageCompareWindow.xaml.cs">
      <Link>ImageCompareWindow.xaml.cs</Link>
      <DependentUpon>ImageCompareWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="..\..\UI\Popup\Wpf\ViewModels\ImageCompareViewModel.cs">
      <Link>ViewModels\ImageCompareViewModel.cs</Link>
    </Compile>
  </ItemGroup>

  <Target Name="RemoveUnusedImageCompareRuntimeFiles" AfterTargets="Publish">
    <ItemGroup>
      <UnusedImageCompareRuntimeFiles Include="$(PublishDir)cvextern.dll" />
      <UnusedImageCompareRuntimeFiles Include="$(PublishDir)opencv_ffmpeg400_64.dll" />
      <UnusedImageCompareRuntimeFiles Include="$(PublishDir)*.pdb" Condition="'$(ImageCompareIncludeSymbols)' != 'true'" />
    </ItemGroup>
    <Delete Files="@(UnusedImageCompareRuntimeFiles)" TreatErrorsAsWarnings="false" />
  </Target>
</Project>
