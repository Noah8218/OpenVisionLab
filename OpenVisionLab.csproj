<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Deterministic>false</Deterministic>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationIcon>lens.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>C:\실행폴더</BaseOutputPath>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE;DEBUG;Release;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Side_2|AnyCPU'">
    <OutputPath>bin\Side_2\</OutputPath>
    <DefineConstants>TRACE;DEBUG;TEST;OPENCV</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Side_2|x86'">
    <OutputPath>bin\x86\Side_2\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Side_2|x64'">
    <OutputPath>bin\x64\Side_2\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FontAwesome.Sharp">
      <HintPath>dll\FontAwesome.Sharp.dll</HintPath>
    </Reference>
    <Reference Include="Vila.Core">
      <HintPath>dll\Vila.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Controls.WpfPropertyGrid">
      <HintPath>$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll</HintPath>
      <Private>True</Private>
      <Aliases>WpfPropertyGridOriginal</Aliases>
    </Reference>
    <Reference Include="Lib.Common">
      <HintPath>$(OpenVisionLabLibraryNoahDllRoot)Lib.Common.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Lib.OpenCV">
      <HintPath>$(OpenVisionLabLibraryNoahDllRoot)Lib.OpenCV.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Lib.OpenCV.Blob">
      <HintPath>$(OpenVisionLabLibraryNoahDllRoot)Lib.OpenCV.Blob.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenCvSharp">
      <HintPath>$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenCvSharp.Blob">
      <HintPath>$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.Blob.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="OpenCvSharp.Extensions">
      <HintPath>$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.Extensions.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.27" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Library\PropertyGrid.Abstractions\PropertyGrid.Abstractions.csproj" />
    <ProjectReference Include="Library\WpfPropertyGridBridge\WpfPropertyGridBridge.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.Display.Core\OpenVisionLab.Display.Core.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.ImageCanvas\OpenVisionLab.ImageCanvas.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.ImageSpace.Core\OpenVisionLab.ImageSpace.Core.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.Logging\OpenVisionLab.Logging.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.Logging.Controls\OpenVisionLab.Logging.Controls.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.Pipeline.Controls\OpenVisionLab.Pipeline.Controls.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.Localization\OpenVisionLab.Localization.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.History\OpenVisionLab.History.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.Mvvm\OpenVisionLab.Mvvm.csproj" />
    <ProjectReference Include="Library\OpenVisionLab.Docking.Controls\OpenVisionLab.Docking.Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Library\OpenVisionLab.Docking.Controls\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.Logging\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.Logging.Controls\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.History\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.Pipeline.Controls\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.Localization\**\*.cs" />
    <Compile Remove="Library\Controls.Viewer2D\**\*.cs" />
    <Compile Remove="Library\Lib.Common\**\*.cs" />
    <Compile Remove="Library\Lib.OpenCV\**\*.cs" />
    <Compile Remove="Library\Lib.OpenCV.Blob\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.Display.Core\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.ImageCanvas\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.ImageSpace.Core\**\*.cs" />
    <Compile Remove="Library\OpenVisionLab.Mvvm\**\*.cs" />
    <Compile Remove="Library\PropertyGrid.Abstractions\**\*.cs" />
    <Compile Remove="Library\WpfPropertyGridBridge\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="Library\OpenVisionLab.Docking.Controls\**\*.resx" />
    <EmbeddedResource Remove="Library\OpenVisionLab.ImageSpace.Core\**\*.resx" />
    <EmbeddedResource Remove="Library\OpenVisionLab.ImageCanvas\**\*.resx" />
    <EmbeddedResource Remove="Library\OpenVisionLab.Logging\**\*.resx" />
    <EmbeddedResource Remove="Library\OpenVisionLab.Logging.Controls\**\*.resx" />
    <EmbeddedResource Remove="Library\OpenVisionLab.Mvvm\**\*.resx" />
    <EmbeddedResource Remove="Library\OpenVisionLab.Localization\**\*" />
    <EmbeddedResource Remove="Library\Controls.Viewer2D\**\*.resx" />
    <Page Remove="Library\OpenVisionLab.Docking.Controls\**\*.xaml" />
    <Page Remove="Library\OpenVisionLab.Logging\**\*.xaml" />
    <Page Remove="Library\OpenVisionLab.Logging.Controls\**\*.xaml" />
    <Page Remove="Library\OpenVisionLab.ImageCanvas\**\*.xaml" />
    <Page Remove="Library\OpenVisionLab.Mvvm\**\*.xaml" />
    <Page Remove="Library\Controls.Viewer2D\**\*.xaml" />
    <None Remove="Library\OpenVisionLab.Docking.Controls\**\*" />
    <None Remove="Library\OpenVisionLab.Display.Core\**\*" />
    <None Remove="Library\OpenVisionLab.ImageCanvas\**\*" />
    <None Remove="Library\OpenVisionLab.ImageSpace.Core\**\*" />
    <None Remove="Library\PropertyGrid.Abstractions\**\*" />
    <None Remove="Library\WpfPropertyGridBridge\**\*" />
    <None Remove="Library\OpenVisionLab.Logging\**\*" />
    <None Remove="Library\OpenVisionLab.Logging.Controls\**\*" />
    <None Remove="Library\OpenVisionLab.History\**\*" />
    <None Remove="Library\OpenVisionLab.Pipeline.Controls\**\*" />
    <None Remove="Library\OpenVisionLab.Localization\**\*" />
    <None Remove="Library\OpenVisionLab.Mvvm\**\*" />
    <None Remove="Library\Controls.Viewer2D\**\*" />
    <None Remove="Library\Lib.Common\**\*" />
    <None Remove="Library\Lib.OpenCV\**\*" />
    <None Remove="Library\Lib.OpenCV.Blob\**\*" />
    <None Remove="tools\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.dll">
      <Link>OpenCvSharp.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.Blob.dll">
      <Link>OpenCvSharp.Blob.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.Extensions.dll">
      <Link>OpenCvSharp.Extensions.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(OpenVisionLabOpenCvSharpDllRoot)OpenCvSharpExtern.dll">
      <Link>OpenCvSharpExtern.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="lens.ico" />
  </ItemGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <Target Name="ValidateVendoredNoahReferences" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <RequiredNoahRuntime Include="$(OpenVisionLabLibraryNoahDllRoot)Lib.Common.dll" />
      <RequiredNoahRuntime Include="$(OpenVisionLabLibraryNoahDllRoot)Lib.OpenCV.dll" />
      <RequiredNoahRuntime Include="$(OpenVisionLabLibraryNoahDllRoot)Lib.OpenCV.Blob.dll" />
      <RequiredNoahRuntime Include="$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.dll" />
      <RequiredNoahRuntime Include="$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.Blob.dll" />
      <RequiredNoahRuntime Include="$(OpenVisionLabLibraryNoahDllRoot)OpenCvSharp.Extensions.dll" />
      <RequiredOpenCvSharpRuntime Include="$(OpenVisionLabOpenCvSharpDllRoot)OpenCvSharpExtern.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredNoahRuntime.Identity)')" Text="Missing vendored Library-Noah runtime: %(RequiredNoahRuntime.Identity). Restore dll\Library-Noah from the repository or refresh the vendor DLLs." />
    <Error Condition="!Exists('%(RequiredOpenCvSharpRuntime.Identity)')" Text="Missing shared OpenCVSharp native runtime: %(RequiredOpenCvSharpRuntime.Identity). Restore dll\OpenCVSharp\OpenCvSharpExtern.dll from the repository." />
  </Target>

  <Target Name="ValidateWpgPropertyGridReference" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll')">
    <Error Text="Missing WPG runtime: $(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll. Restore the prepared WPG DLL from the repository." />
  </Target>

  <Target Name="CopyWpgPropertyGridToRuntimeOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="Exists('$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll')">
    <ItemGroup>
      <WpgRuntimeArtifacts Include="$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.dll" />
      <WpgRuntimeArtifacts Include="$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.xml" Condition="Exists('$(OpenVisionLabDllRoot)System.Windows.Controls.WpfPropertyGrid.xml')" />
    </ItemGroup>

    <Copy SourceFiles="@(WpgRuntimeArtifacts)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
