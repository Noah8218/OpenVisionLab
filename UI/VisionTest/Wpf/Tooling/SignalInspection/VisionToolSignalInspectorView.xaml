<UserControl x:Class="OpenVisionLab.VisionToolSignalInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab"
             Visibility="Collapsed"
             AutomationProperties.AutomationId="VisionToolSignalInspector">
    <Border Padding="10"
            Background="#F8FAFB"
            BorderBrush="#BFD0D8"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="190" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="titleText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#243040"
                               Text="Signal Inspector" />
                    <Border Margin="8,0,0,0"
                            Padding="6,2"
                            Background="#D8ECEE"
                            BorderBrush="#157C86"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock x:Name="evidenceBadgeText"
                                   FontSize="10"
                                   Foreground="#0D5961"
                                   Text="Current Preview evidence" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="resetButton"
                            MinWidth="54"
                            Height="26"
                            Margin="0,0,6,0"
                            Padding="8,0"
                            Click="ResetButton_Click"
                            ToolTip="Reset signal zoom and pan"
                            AutomationProperties.AutomationId="VisionToolSignalReset"
                            AutomationProperties.Name="Reset signal zoom and pan">
                        <TextBlock Text="Reset" />
                    </Button>
                    <Button x:Name="exportButton"
                            MinWidth="54"
                            Height="26"
                            Padding="8,0"
                            Click="ExportButton_Click"
                            ToolTip="Export signal evidence as TSV"
                            AutomationProperties.AutomationId="VisionToolSignalExport"
                            AutomationProperties.Name="Export signal evidence as TSV">
                        <TextBlock Text="TSV" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="provenanceText"
                       Grid.Row="1"
                       Margin="0,6,0,6"
                       FontSize="10.5"
                       Foreground="#657487"
                       TextWrapping="Wrap" />

            <local:VisionToolSignalPlotSurface x:Name="plotSurface"
                                               Grid.Row="2"
                                               MinWidth="280"
                                               ToolTip="Mouse wheel: zoom. Left drag: pan. Drag an editable marker to teach on release."
                                               AutomationProperties.AutomationId="VisionToolSignalPlot"
                                               AutomationProperties.Name="Signal plot with optional teaching markers" />

            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="cursorText"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="10.5"
                           Foreground="#243040"
                           Text="Move pointer over plot to inspect values." />
                <StackPanel x:Name="legendPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
