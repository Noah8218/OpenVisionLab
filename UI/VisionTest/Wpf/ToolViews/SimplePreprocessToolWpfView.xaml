<local:VisionToolSingleInputCustomToolViewBase x:Class="OpenVisionLab.SimplePreprocessToolWpfView"
                                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                               xmlns:local="clr-namespace:OpenVisionLab"
                                               MinWidth="860"
                                               MinHeight="560"
                                               Background="#EEF2F6">
    <local:VisionToolSingleInputCustomToolViewBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SharedResourceDictionary Source="../Tooling/Presentation/VisionToolWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:VisionToolSingleInputCustomToolViewBase.Resources>

    <Grid>
        <local:VisionToolSingleInputPropertyToolShell x:Name="toolShell"
                                                      TitleIconKind="Tune"
                                                      PropertyGridHostVisibility="Collapsed"
                                                      ParameterContentVisibility="Visible" />

        <ScrollViewer x:Name="parameterContentHost"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="parameterPanel" Margin="0,0,10,0">
                <local:VisionToolSignalInspectorView x:Name="signalInspector"
                                                     Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:VisionToolSingleInputCustomToolViewBase>
