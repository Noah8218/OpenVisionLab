                                                         Padding="6"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         AutomationProperties.AutomationId="HostRecipeLlmDependencyReport"
                                                         Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                         BorderBrush="#38535C"
                                                         Background="#101A1F"
                                                         Text="{Binding RecipeCommands.LlmXmlDraftDependencyReport, Mode=OneWay}" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,4,0,2"
                                                           Text="{Binding RecipeCommands.LlmDependencyPathRowsText}"
                                                           Foreground="#A8CBD1"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                                <ListBox Grid.Row="3"
                                                         AutomationProperties.AutomationId="HostRecipeLlmDependencyPathList"
                                                         Background="#101A1F"
                                                         BorderBrush="#38535C"
                                                         BorderThickness="1"
                                                         ItemsSource="{Binding RecipeCommands.LlmXmlDraftDependencyRows}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ListBoxItem}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="Background" Value="#101A1F" />
                                                            <Setter Property="BorderBrush" Value="#243941" />
                                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                            <Setter Property="Padding" Value="0" />
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="5,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="52" />
                                                                    <ColumnDefinition Width="0.9*" />
                                                                    <ColumnDefinition Width="72" />
                                                                    <ColumnDefinition Width="1.05*" />
                                                                    <ColumnDefinition Width="1.7*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Status}"
                                                                           Foreground="#D7FFF4"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding StepName}"
                                                                           ToolTip="{Binding StepName}"
                                                                           Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                                           FontSize="10"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="2"
                                                                           Margin="6,0,0,0"
                                                                           Text="{Binding ParameterName}"
                                                                           ToolTip="{Binding ParameterName}"
                                                                           Foreground="#A8CBD1"
                                                                           FontSize="10"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="3"
                                                                           Margin="6,0,0,0"
                                                                           Text="{Binding Path}"
                                                                           ToolTip="{Binding Path}"
                                                                           Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                                           FontSize="10"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="4"
                                                                           Margin="6,0,0,0"
                                                                           Text="{Binding Action}"
                                                                           ToolTip="{Binding Action}"
                                                                           Foreground="#95D6B8"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                             <Grid Grid.Row="2">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding RecipeCommands.LlmDraftReviewReportText}"
                                                           Foreground="#A8CBD1"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBox Grid.Row="1"
                                                         Margin="0,3,0,0"
                                                         Padding="6"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         AutomationProperties.AutomationId="HostRecipeLlmDraftReviewReport"
                                                         Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                         BorderBrush="#38535C"
                                                          Background="#101A1F"
                                                          Text="{Binding RecipeCommands.LlmXmlDraftReviewReport, Mode=OneWay}" />
                                             </Grid>
                                             <Grid Grid.Row="2" Grid.Column="2">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="*" />
                                                 </Grid.RowDefinitions>
                                                 <TextBlock Text="{Binding RecipeCommands.LlmDraftDiffReportText}"
                                                            Foreground="#A8CBD1"
                                                            FontSize="11"
                                                            FontWeight="SemiBold" />
                                                 <TextBox Grid.Row="1"
                                                          Margin="0,3,0,0"
                                                          Padding="6"
                                                          IsReadOnly="True"
                                                          TextWrapping="Wrap"
                                                          VerticalScrollBarVisibility="Auto"
                                                          AutomationProperties.AutomationId="HostRecipeLlmDiffReport"
                                                          Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                          BorderBrush="#38535C"
                                                          Background="#101A1F"
                                                          Text="{Binding RecipeCommands.LlmXmlDraftDiffReport, Mode=OneWay}" />
                                             </Grid>
                                             <Grid Grid.Row="4" Grid.ColumnSpan="3">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="34" />
                                                    <RowDefinition Height="4" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding RecipeCommands.LlmXmlValidationReportText}"
                                                           Foreground="#A8CBD1"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBox Grid.Row="1"
                                                         Margin="0,3,0,0"
                                                         Padding="6"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         AutomationProperties.AutomationId="HostRecipeLlmValidationReport"
                                                         Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                         BorderBrush="#38535C"
                                                         Background="#101A1F"
                                                         Text="{Binding RecipeCommands.SelectedRecipeSummary.LlmXmlValidationReport, Mode=OneWay}" />
                                                <ListBox Grid.Row="3"
                                                         AutomationProperties.AutomationId="HostRecipeLlmValidationIssueList"
                                                         Background="#101A1F"
                                                         BorderBrush="#38535C"
                                                         BorderThickness="1"
                                                         ItemsSource="{Binding RecipeCommands.SelectedRecipeSummary.LlmXmlValidationIssues}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ListBoxItem}">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="Background" Value="#101A1F" />
                                                            <Setter Property="BorderBrush" Value="#243941" />
                                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                            <Setter Property="Padding" Value="0" />
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="5,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="1.15*" />
                                                                    <ColumnDefinition Width="1.35*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Severity}"
                                                                           Foreground="#F5FAFC"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Explanation}"
                                                                           ToolTip="{Binding Explanation}"
                                                                           Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Grid.Column="2"
                                                                           Margin="6,0,0,0"
                                                                           Text="{Binding Action}"
                                                                           ToolTip="{Binding Action}"
                                                                           Foreground="#95D6B8"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem x:Name="tabRecipeLlmBrowserAssist"
                                     Header="{Binding RecipeCommands.RecipeLlmBrowserAssistTabText}"
                                     Style="{StaticResource RecipeAdvancedTabItemStyle}"
                                     AutomationProperties.AutomationId="HostRecipeLlmBrowserAssistTab">
                                <Grid Margin="0,8,0,0"
                                      AutomationProperties.AutomationId="HostRecipeLlmBrowserAssistPanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="10,8"
                                            Background="#15252A"
                                            BorderBrush="#38535C"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecipeCommands.LlmBrowserAssistTitleText}"
                                                       Foreground="#F5FAFC"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding RecipeCommands.LlmBrowserAssistBoundaryText}"
                                                       Foreground="#A8CBD1"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="0,7,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="108" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Height="26"
                                                Margin="0,0,5,0"
                                                AutomationProperties.AutomationId="HostRecipeBrowserAssistOpenChatGptButton"
                                                Click="HandleOpenRecipeLlmBrowserAssistChatGpt">
                                            <TextBlock Text="{Binding RecipeCommands.OpenLlmBrowserAssistChatGptText}" FontSize="11" />
                                        </Button>
                                        <Button Grid.Column="1"
                                                Height="26"
                                                Margin="0,0,5,0"
                                                AutomationProperties.AutomationId="HostRecipeBrowserAssistOpenExternalButton"
                                                Click="HandleOpenRecipeLlmBrowserAssistExternal">
                                            <TextBlock Text="{Binding RecipeCommands.OpenLlmBrowserAssistExternalText}" FontSize="11" />
                                        </Button>
                                        <Button Grid.Column="2"
                                                Height="26"
                                                Margin="0,0,5,0"
                                                AutomationProperties.AutomationId="HostRecipeBrowserAssistCopyPromptButton"
                                                Command="{Binding RecipeCommands.CopyLlmPromptCommand}">
                                            <TextBlock Text="{Binding RecipeCommands.CopyLlmPromptText}" FontSize="11" />
                                        </Button>
                                        <Button Grid.Column="3"
                                                Height="26"
                                                Margin="0,0,8,0"
                                                AutomationProperties.AutomationId="HostRecipeBrowserAssistPasteXmlButton"
                                                Command="{Binding RecipeCommands.PasteLlmXmlDraftFromClipboardCommand}">
                                            <TextBlock Text="{Binding RecipeCommands.PasteLlmXmlDraftText}" FontSize="11" />
                                        </Button>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding RecipeCommands.LlmBrowserAssistStatusText}"
                                                   Foreground="#95D6B8"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Grid.Row="2"
                                            BorderBrush="#38535C"
                                            BorderThickness="1"
                                            Background="#101A1F">
                                        <Grid>
                                            <Border x:Name="recipeLlmBrowserAssistPlaceholder"
                                                    Padding="18"
                                                    Background="#101A1F"
                                                    AutomationProperties.AutomationId="HostRecipeBrowserAssistPlaceholder">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding RecipeCommands.LlmBrowserAssistStatusText}"
                                                           Foreground="#A8CBD1"
                                                           FontSize="12"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <webView2:WebView2 x:Name="recipeLlmBrowserAssistWebView"
                                                                Visibility="Collapsed"
                                                                AutomationProperties.AutomationId="HostRecipeLlmBrowserAssistWebView" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="tabRecipePreview"
                                     Header="{Binding RecipeCommands.RecipePreviewTabText}"
                                     Style="{StaticResource RecipeAdvancedTabItemStyle}"
                                     AutomationProperties.AutomationId="HostRecipePreviewTab">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding RecipeCommands.PipelinePreviewStepListText}"
                                               Foreground="#A8CBD1"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <ListBox Grid.Row="1"
                                             Margin="0,4,0,0"
                                             AutomationProperties.AutomationId="HostRecipePipelinePreviewStepList"
                                             Background="#101A1F"
                                             BorderBrush="#38535C"
                                             BorderThickness="1"
                                             ItemsSource="{Binding RecipeCommands.SelectedRecipeSummary.PipelinePreviewSteps}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               Foreground="#F5FAFC"
                                                               FontWeight="SemiBold"
                                                               MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding DetailText}"
                                                               ToolTip="{Binding FullDetailText}"
                                                               Foreground="#A8CBD1"
                                                               FontSize="11"
                                                               MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
                <Grid Grid.Row="3"
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="HostRecipeManagerNameStrip">
                    <Grid x:Name="recipeBasicLifecyclePanel">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=recipeAdvancedReviewToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RecipeCommands.EditRecipeNameLabelText}"
                                   Foreground="#A8CBD1"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Height="26"
                                 Padding="7,2"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="HostRecipeNameEditor"
                                 Foreground="{StaticResource ShellHost.FieldTextBrush}"
                                 CaretBrush="#8FE8F0"
                                 BorderBrush="{StaticResource ShellHost.FieldBorderBrush}"
                                 Background="{StaticResource ShellHost.FieldBrush}"
                                 Text="{Binding RecipeCommands.EditRecipeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Grid.Column="2"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="HostRecipeManagerCommandStrip">
                            <Button MinWidth="86"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    AutomationProperties.AutomationId="HostRecipeCreateNamedButton"
                                    Command="{Binding RecipeCommands.CreateNamedRecipeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="13" Height="13" Margin="0,1,5,0" />
                                    <TextBlock Text="{Binding RecipeCommands.CreateNamedRecipeText}" />
                                </StackPanel>
                            </Button>
                            <Button MinWidth="74"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    AutomationProperties.AutomationId="HostRecipeDuplicateButton"
                                    Command="{Binding RecipeCommands.DuplicateRecipeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ImageMultipleOutline" Width="13" Height="13" Margin="0,1,5,0" />
                                    <TextBlock Text="{Binding RecipeCommands.DuplicateRecipeText}" />
                                </StackPanel>
                            </Button>
                            <Button MinWidth="86"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    AutomationProperties.AutomationId="HostRecipeRenameButton"
                                    Command="{Binding RecipeCommands.RenameRecipeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PencilOutline" Width="13" Height="13" Margin="0,1,5,0" />
                                    <TextBlock Text="{Binding RecipeCommands.RenameRecipeText}" />
                                </StackPanel>
                            </Button>
                            <Button MinWidth="72"
                                    Height="28"
                                    AutomationProperties.AutomationId="HostRecipeDeleteButton"
                                    Command="{Binding RecipeCommands.DeleteRecipeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="LayersOffOutline" Width="13" Height="13" Margin="0,1,5,0" />
                                    <TextBlock Text="{Binding RecipeCommands.DeleteRecipeText}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="HostRecipeEditValidation"
                                   Foreground="#A8CBD1"
                                   FontSize="10"
                                   Text="{Binding RecipeCommands.RecipeEditValidationText}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <WrapPanel HorizontalAlignment="Right"
                               Visibility="{Binding IsChecked, ElementName=recipeAdvancedReviewToggle, Converter={StaticResource ShellHost.BooleanToVisibilityConverter}}"
                               AutomationProperties.AutomationId="HostRecipeAdvancedTransferCommands">
                        <Button MinWidth="112"
                                Height="28"
                                Margin="0,0,6,0"
                                AutomationProperties.AutomationId="HostRecipeImportXmlButton"
                                Command="{Binding RecipeCommands.ImportPipelineXmlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ImagePlusOutline" Width="13" Height="13" Margin="0,1,5,0" />
                                <TextBlock Text="{Binding RecipeCommands.ImportPipelineXmlText}" />
                            </StackPanel>
                        </Button>
                        <Button MinWidth="112"
                                Height="28"
                                Margin="0,0,6,0"
                                AutomationProperties.AutomationId="HostRecipeExportXmlButton"
                                Command="{Binding RecipeCommands.ExportPipelineXmlCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ImageMultipleOutline" Width="13" Height="13" Margin="0,1,5,0" />
                                <TextBlock Text="{Binding RecipeCommands.ExportPipelineXmlText}" />
                            </StackPanel>
                        </Button>
                        <Button MinWidth="112"
                                Height="28"
                                AutomationProperties.AutomationId="HostRecipeExportReviewBundleButton"
                                AutomationProperties.Name="{Binding RecipeCommands.ExportRecipeReviewBundleText}"
                                ToolTip="{Binding RecipeCommands.ExportRecipeReviewBundleToolTipText}"
                                Command="{Binding RecipeCommands.ExportRecipeReviewBundleCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FileExport" Width="13" Height="13" Margin="0,1,5,0" />
                                <TextBlock Text="{Binding RecipeCommands.ExportRecipeReviewBundleText}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Background="{StaticResource ShellHost.ChromeDarkBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ShellStatusRecipe">
                <iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline"
                                            Width="15"
                                            Height="15"
                                            Foreground="#8AD7DA"
                                            Margin="0,0,7,0" />
                <TextBlock Text="{Binding SelectedItem, ElementName=cbHostRecipe}"
                           ToolTip="{Binding SelectedItem, ElementName=cbHostRecipe}"
                           Foreground="#EAF5F7"
                           FontWeight="SemiBold"
                           MaxWidth="260"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       x:Name="statusHostReady"
                       Text="{Binding StatusText}"
                       Foreground="#D7ECEE"
                       VerticalAlignment="Center"
                       Margin="12,0" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ShellStatusLayer">
                    <iconPacks:PackIconMaterial Kind="ImageMultipleOutline"
                                                Width="15"
                                                Height="15"
                                                Foreground="#8AD7DA"
                                                Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Text, ElementName=txtHostWorkspaceLayerTitle}"
                               ToolTip="{Binding Text, ElementName=txtHostWorkspaceLayerTitle}"
                               Foreground="#D7ECEE"
                               MaxWidth="150"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Width="1" Height="16" Background="#4D6971" Margin="14,0" />
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ShellStatusTool">
                    <iconPacks:PackIconMaterial Kind="Tools"
                                                Width="15"
                                                Height="15"
                                                Foreground="#8AD7DA"
                                                Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Text, ElementName=txtHostSelectedTool}"
                               ToolTip="{Binding Text, ElementName=txtHostSelectedTool}"
                               Foreground="#D7ECEE"
                               MaxWidth="180"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="txtToolOpenTimingDiagnostics"
                       Grid.Column="2"
                       Width="1"
                       Height="1"
                       Opacity="0.01"
                       IsHitTestVisible="False"
                       AutomationProperties.AutomationId="OpenVisionToolOpenTimingDiagnostics"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
        </Grid>
    </Grid>
</UserControl>
