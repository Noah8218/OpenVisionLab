<UserControl x:Class="OpenVisionLab.OpenVisionPipelineReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:pipeline="clr-namespace:OpenVisionLab.Pipeline.Controls;assembly=OpenVisionLab.Pipeline.Controls"
             MinWidth="860"
             MinHeight="560"
             Background="#EEF2F6">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Wpf/OpenVisionLabWpfTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PipelineReview.SurfaceBrush" Color="#EEF2F6" />
            <SolidColorBrush x:Key="PipelineReview.PanelBrush" Color="#F8FBFD" />
            <SolidColorBrush x:Key="PipelineReview.HeaderBrush" Color="#E4EEF2" />
            <SolidColorBrush x:Key="PipelineReview.LineBrush" Color="#CCDCE2" />
            <SolidColorBrush x:Key="PipelineReview.TextBrush" Color="#243040" />
            <SolidColorBrush x:Key="PipelineReview.MutedTextBrush" Color="#657487" />
            <SolidColorBrush x:Key="PipelineReview.AccentBrush" Color="#157C86" />
            <SolidColorBrush x:Key="PipelineReview.AccentSoftBrush" Color="#D8ECEE" />
            <SolidColorBrush x:Key="PipelineReview.OkBrush" Color="#0D7A55" />
            <SolidColorBrush x:Key="PipelineReview.DarkPreviewBrush" Color="#05090A" />
            <BooleanToVisibilityConverter x:Key="PipelineReview.BooleanToVisibilityConverter" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PipelineReview.TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource PipelineReview.AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ReviewPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PipelineReview.PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PipelineReview.LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="SummaryCardStyle" TargetType="Border" BasedOn="{StaticResource ReviewPanelStyle}">
                <Setter Property="MinHeight" Value="76" />
                <Setter Property="Padding" Value="10,8" />
            </Style>

            <Style x:Key="SummaryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="SummaryValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>

            <Style x:Key="SummaryMetaStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource PipelineReview.MutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <Style x:Key="PreviewWellStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PipelineReview.DarkPreviewBrush}" />
                <Setter Property="BorderBrush" Value="#48636C" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="GuideChipStyle" TargetType="Border">
                <Setter Property="Background" Value="#F4FAFB" />
                <Setter Property="BorderBrush" Value="{StaticResource PipelineReview.LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
            </Style>

            <Style x:Key="ReadinessChipStyle" TargetType="Border">
                <Setter Property="Background" Value="#F2F4F6" />
                <Setter Property="BorderBrush" Value="#C9D1D6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="3,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                        <Setter Property="Background" Value="#E4F3EB" />
                        <Setter Property="BorderBrush" Value="#82BDA2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCheck}" Value="True">
                        <Setter Property="Background" Value="#FFF0D2" />
                        <Setter Property="BorderBrush" Value="#D09A36" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAdvisory}" Value="True">
                        <Setter Property="Background" Value="#E8F1F5" />
                        <Setter Property="BorderBrush" Value="#87AAB6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PipelineReview.SurfaceBrush}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PipelineReview.HeaderBrush}"
                BorderBrush="{StaticResource PipelineReview.LineBrush}"
                BorderThickness="1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="btnReturnToRecipe"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="PipelineReviewReturnToRecipeButton"
                        Height="30"
                        Padding="9,0"
                        Click="BtnReturnToRecipe_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ChevronLeft"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center" />
                        <TextBlock x:Name="txtReturnToRecipeButton"
                                   Text="Return to Recipe"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <iconPacks:PackIconMaterial Grid.Column="2"
                                            Kind="SourceBranch"
                                            Width="20"
                                            Height="20"
                                            Foreground="{StaticResource PipelineReview.AccentBrush}" />
                <StackPanel Grid.Column="4">
                    <TextBlock x:Name="txtPipelineTitle"
                               Text="{Binding PipelineTitle}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="txtPipelineMeta"
                               Text="{Binding PipelineMeta}"
                               Foreground="{StaticResource PipelineReview.MutedTextBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="txtRecipeContext"
                               AutomationProperties.AutomationId="PipelineReviewRecipeContext"
                               Text="{Binding RecipeContextText}"
                               Foreground="{StaticResource PipelineReview.MutedTextBrush}"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RecipeContextText}" />
                    <TextBlock x:Name="txtReviewProgress"
                               Text="{Binding ReviewProgressText}"
                               Foreground="{StaticResource PipelineReview.AccentBrush}"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnPreviousStep"
                            Height="30"
                            MinWidth="72"
                            Padding="9,0"
                            Margin="0,0,6,0"
                            IsEnabled="{Binding CanSelectPreviousStep}"
                            Click="BtnPreviousStep_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock x:Name="txtPreviousStepButton"
                                       Text="Previous"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnNextStep"
                            Height="30"
                            MinWidth="72"
                            Padding="9,0"
                            Margin="0,0,6,0"
                            IsEnabled="{Binding CanSelectNextStep}"
                            Click="BtnNextStep_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtNextStepButton"
                                       Text="Next"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <iconPacks:PackIconMaterial Kind="ChevronRight"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnFirstIssueStep"
                            AutomationProperties.AutomationId="PipelineReviewFirstIssueStepButton"
                            Height="30"
                            MinWidth="82"
                            Padding="9,0"
                            IsEnabled="{Binding CanSelectFirstIssueStep}"
                            Click="BtnFirstIssueStep_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock x:Name="txtFirstIssueStepButton"
                                       Text="NG Step"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    <Button x:Name="btnOpenSelectedToolLearn"
                            AutomationProperties.AutomationId="PipelineReviewOpenSelectedToolLearnButton"
                            Height="30"
                            MinWidth="92"
                            Padding="9,0"
                            Margin="6,0,0,0"
                            Visibility="{Binding CanOpenSelectedToolLearn, Converter={StaticResource PipelineReview.BooleanToVisibilityConverter}}"
                            IsEnabled="{Binding CanOpenSelectedToolLearn}"
                            Click="BtnOpenSelectedToolLearn_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BookOpenPageVariantOutline"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock x:Name="txtOpenSelectedToolLearnButton"
                                       Text="Learn Tool"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="btnRunReview"
                        Grid.Column="7"
                        AutomationProperties.AutomationId="PipelineReviewRunReviewButton"
                        Height="30"
                        Padding="12,0"
                        IsEnabled="{Binding CanRunReview}"
                        Click="BtnRunReview_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Play"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RunReviewButtonText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                AutomationProperties.AutomationId="PipelineReviewReadinessStrip"
                Background="#F8FBFD"
                BorderBrush="{StaticResource PipelineReview.LineBrush}"
                BorderThickness="1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="4,0,6,0">
                    <TextBlock x:Name="lblReadiness"
                               Text="Inspection readiness"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock AutomationProperties.AutomationId="PipelineReviewReadinessSummary"
                               Text="{Binding ReadinessSummaryText}"
                               Foreground="{StaticResource PipelineReview.MutedTextBrush}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               ToolTip="{Binding ReadinessSummaryText}" />
                </StackPanel>
                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding ReadinessItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border AutomationProperties.AutomationId="{Binding AutomationId}"
                                    Style="{StaticResource ReadinessChipStyle}"
                                    ToolTip="{Binding StatusText}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#7A8792" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PipelineReview.OkBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCheck}" Value="True">
                                                        <Setter Property="Background" Value="#B87500" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAdvisory}" Value="True">
                                                        <Setter Property="Background" Value="#467D91" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" />
                                        <TextBlock AutomationProperties.AutomationId="{Binding StatusAutomationId}"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{StaticResource PipelineReview.MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                AutomationProperties.AutomationId="PipelineReviewGuideStrip"
                Background="{StaticResource PipelineReview.AccentSoftBrush}"
                BorderBrush="{StaticResource PipelineReview.LineBrush}"
                BorderThickness="1"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.65*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GuideChipStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="MapMarkerPath"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource PipelineReview.AccentBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="lblReviewGuideStage"
                                       Text="Review"
                                       Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding ReviewGuideStageText}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GuideChipStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="SourceBranch"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource PipelineReview.AccentBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="lblReviewGuideCurrent"
                                       Text="Current Step"
                                       Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding ReviewGuideCurrentStepText}"
                                       FontWeight="SemiBold"
                                       ToolTip="{Binding ReviewGuideCurrentStepText}" />
                        </StackPanel>
                    </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource GuideChipStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="ClipboardCheckOutline"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource PipelineReview.AccentBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="lblReviewGuideNext"
                                       Text="Next Check"
                                       Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding ReviewGuideNextActionText}"
                                       FontWeight="SemiBold"
                                       ToolTip="{Binding ReviewGuideNextActionText}" />
                        </StackPanel>
                    </Grid>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource GuideChipStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="CheckDecagram"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource PipelineReview.OkBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="lblReviewGuideDecision"
                                       Text="Decision"
                                       Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding ReviewGuideResultDecisionText}"
                                       FontWeight="SemiBold"
                                       ToolTip="{Binding ReviewGuideResultDecisionText}" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        AutomationProperties.AutomationId="PipelineReviewGuideDetail"
                        Background="#F8FCFD"
                        BorderBrush="{StaticResource PipelineReview.LineBrush}"
                        BorderThickness="1"
                        Padding="9,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="InformationOutline"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource PipelineReview.AccentBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding ReviewGuideDetailText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       ToolTip="{Binding ReviewGuideDetailText}" />
                            <Grid Margin="0,8,0,0"
                                  Visibility="{Binding HasReviewGuideTriage, Converter={StaticResource PipelineReview.BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="lblReviewGuideTriageFailure"
                                               Text="Cause"
                                               Style="{StaticResource SummaryLabelStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="PipelineReviewGuideTriageFailure"
                                               Text="{Binding ReviewGuideTriageFailureText}"
                                               Foreground="{StaticResource PipelineReview.TextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               ToolTip="{Binding ReviewGuideTriageFailureText}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource PipelineReview.LineBrush}" />
                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock x:Name="lblReviewGuideTriageAdjustment"
                                               Text="Adjust"
                                               Style="{StaticResource SummaryLabelStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="PipelineReviewGuideTriageAdjustment"
                                               Text="{Binding ReviewGuideTriageAdjustmentText}"
                                               Foreground="{StaticResource PipelineReview.TextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               ToolTip="{Binding ReviewGuideTriageAdjustmentText}" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="{StaticResource PipelineReview.LineBrush}" />
                                <StackPanel Grid.Column="4" Margin="8,0,0,0">
                                    <TextBlock x:Name="lblReviewGuideTriageRerun"
                                               Text="Rerun"
                                               Style="{StaticResource SummaryLabelStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="PipelineReviewGuideTriageRerun"
                                               Text="{Binding ReviewGuideTriageRerunText}"
                                               Foreground="{StaticResource PipelineReview.AccentBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               ToolTip="{Binding ReviewGuideTriageRerunText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Grid.Row="2"
                                                    Grid.Column="0"
                                                    Kind="CompareHorizontal"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource PipelineReview.AccentBrush}"
                                                    Visibility="{Binding HasReviewGuidePairText, Converter={StaticResource PipelineReview.BooleanToVisibilityConverter}}" />
                        <StackPanel Grid.Row="2"
                                    Grid.Column="2"
                                    Visibility="{Binding HasReviewGuidePairText, Converter={StaticResource PipelineReview.BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblReviewGuidePair"
                                           Text="Good/Bad Pair"
                                           Style="{StaticResource SummaryLabelStyle}" />
                                <Button Grid.Column="1"
                                        AutomationProperties.AutomationId="PipelineReviewOpenPairSampleButton"
                                        MinWidth="118"
                                        Height="26"
                                        Padding="8,0"
                                        Margin="10,0,0,0"
                                        IsEnabled="{Binding CanOpenReviewGuidePairAction}"
                                        Visibility="{Binding CanOpenReviewGuidePairAction, Converter={StaticResource PipelineReview.BooleanToVisibilityConverter}}"
                                        Click="BtnOpenPairSample_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CompareHorizontal"
                                                                    Width="14"
                                                                    Height="14"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ReviewGuidePairActionText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock AutomationProperties.AutomationId="PipelineReviewGuidePair"
                                       Text="{Binding ReviewGuidePairText}"
                                       Foreground="{StaticResource PipelineReview.TextBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       ToolTip="{Binding ReviewGuidePairText}" />
                            <StackPanel Margin="0,5,0,0"
                                        Visibility="{Binding HasReviewGuidePairMetricText, Converter={StaticResource PipelineReview.BooleanToVisibilityConverter}}">
                                <TextBlock x:Name="lblReviewGuidePairMetric"
                                           Text="Metric Check"
                                           Style="{StaticResource SummaryLabelStyle}" />
                                <TextBlock AutomationProperties.AutomationId="PipelineReviewGuidePairMetric"
                                           Text="{Binding ReviewGuidePairMetricText}"
                                           Foreground="{StaticResource PipelineReview.AccentBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           ToolTip="{Binding ReviewGuidePairMetricText}" />
                            </StackPanel>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Grid.Row="4"
                                                    Grid.Column="0"
                                                    Kind="FormatListChecks"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource PipelineReview.OkBrush}" />
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock x:Name="lblReviewGuideChecklist"
                                       Text="Review Habit"
                                       Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock AutomationProperties.AutomationId="PipelineReviewGuideChecklist"
                                       Text="{Binding ReviewGuideChecklistText}"
                                       Foreground="{StaticResource PipelineReview.MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       ToolTip="{Binding ReviewGuideChecklistText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="6" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ReviewPanelStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="lblStepFlow" Text="Step Flow" Style="{StaticResource SectionTitleStyle}" />
                    <Border Grid.Row="2"
                            AutomationProperties.AutomationId="PipelineReviewStepFlowOperatorFocus"
                            Background="#EAF7F8"
                            BorderBrush="{StaticResource PipelineReview.LineBrush}"
                            BorderThickness="1"
                            Padding="7,5"
