                                       Foreground="{StaticResource PipelineReview.AccentBrush}"
                                       FontWeight="SemiBold"
                                       Text="Typed features 0 / same-run, pixel-only" />
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PreviewWellStyle}">
                                <Grid>
                                    <Image x:Name="imgGeometryResultPreview"
                                           AutomationProperties.AutomationId="PipelineReviewGeometryHighlightPreview"
                                           Stretch="Uniform"
                                           Cursor="Cross"
                                           MouseLeftButtonDown="ImgGeometryResultPreview_MouseLeftButtonDown"
                                           Source="{Binding OutputPreviewImage}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC102027" Padding="5,2">
                                        <TextBlock x:Name="lblGeometryHighlight" Text="Selected geometry highlight" Foreground="White" FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="geometryResultsGrid"
                                      Grid.Row="2" Grid.Column="2"
                                      AutomationProperties.AutomationId="PipelineReviewGeometryResultsTable"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="GeometryResultsGrid_SelectionChanged"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Step / Feature" Binding="{Binding Identity}" Width="150" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
                                    <DataGridTextColumn Header="Geometry" Binding="{Binding GeometryText}" Width="220" />
                                    <DataGridTextColumn Header="Coordinate layer" Binding="{Binding CoordinateLayer}" Width="110" />
                                    <DataGridTextColumn Header="Fit evidence" Binding="{Binding QualityText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="scaleCalibrationTab"
                             Header="Scale Calibration"
                             AutomationProperties.AutomationId="PipelineReviewScaleCalibrationTab">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PreviewWellStyle}">
                                <Grid>
                                    <Image x:Name="imgScaleCalibrationPreview"
                                           AutomationProperties.AutomationId="PipelineReviewScaleCalibrationPreview"
                                           Source="{Binding ScaleCalibrationPreviewImage}"
                                           Stretch="Uniform" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D51A3038" Padding="5,2">
                                        <TextBlock x:Name="lblScaleCalibrationPreview"
                                                   Text="Point A/B evidence"
                                                   Foreground="White"
                                                   FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource ReviewPanelStyle}" Padding="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="lblScaleCalibrationInputs"
                                               Text="Same-run point evidence"
                                               FontSize="10"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="A" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox x:Name="cmbScalePointA"
                                                  Grid.Column="1"
                                                  AutomationProperties.AutomationId="PipelineReviewScalePointA"
                                                  DisplayMemberPath="Identity"
                                                  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.Identity}"
                                                  SelectionChanged="ScalePoint_SelectionChanged" />
                                        <TextBlock Grid.Column="3" Text="B" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox x:Name="cmbScalePointB"
                                                  Grid.Column="4"
                                                  AutomationProperties.AutomationId="PipelineReviewScalePointB"
                                                  DisplayMemberPath="Identity"
                                                  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.Identity}"
                                                  SelectionChanged="ScalePoint_SelectionChanged" />
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblScaleKnownDistance" Text="Real" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" />
                                        <TextBox x:Name="txtScaleKnownDistance"
                                                 Grid.Column="1"
                                                 AutomationProperties.AutomationId="PipelineReviewScaleKnownDistance"
                                                 Text="10" />
                                        <ComboBox x:Name="cmbScaleUnit"
                                                  Grid.Column="3"
                                                  AutomationProperties.AutomationId="PipelineReviewScaleUnit" />
                                        <Button x:Name="btnCalculateScaleCalibration"
                                                Grid.Column="5"
                                                AutomationProperties.AutomationId="PipelineReviewCalculateScaleButton"
                                                Height="24"
                                                Padding="5,0"
                                                Click="BtnCalculateScaleCalibration_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="ChartTimelineVariant" Width="13" Height="13" Margin="0,0,4,0" />
                                                <TextBlock x:Name="txtCalculateScaleCalibrationButton" Text="Calculate + save" FontSize="9" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource ReviewPanelStyle}" Padding="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="lblScaleCalibrationResult"
                                               Text="Saved scale (mm/px)"
                                               FontSize="10"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="txtScaleCalibrationResult"
                                               Grid.Row="1"
                                               AutomationProperties.AutomationId="PipelineReviewScaleResult"
                                               Text="Not taught"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PipelineReview.AccentBrush}"
                                               Margin="0,3,0,0"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               MaxHeight="30" />
                                    <Grid Grid.Row="2" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.05*" />
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="0.95*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbScaleTargetStep"
                                                  AutomationProperties.AutomationId="PipelineReviewScaleTargetStep"
                                                  DisplayMemberPath="DisplayText"
                                                  ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=SelectedItem.DisplayText}" />
                                        <Button x:Name="btnApplyScaleCalibration"
                                                Grid.Column="2"
                                                AutomationProperties.AutomationId="PipelineReviewApplyScaleButton"
                                                Height="24"
                                                Padding="5,0"
                                                Click="BtnApplyScaleCalibration_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="ContentSave" Width="13" Height="13" Margin="0,0,4,0" />
                                                <TextBlock x:Name="txtApplyScaleCalibrationButton" Text="Apply to Step" FontSize="9" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="txtScaleCalibrationStatus"
                                               Grid.Row="3"
                                               AutomationProperties.AutomationId="PipelineReviewScaleStatus"
                                               Text="Run Review to obtain two typed points."
                                               Foreground="{StaticResource PipelineReview.MutedTextBrush}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                                               Margin="0,3,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="8"
                   Text="{Binding StatusText}"
                   Foreground="{StaticResource PipelineReview.MutedTextBrush}" />
    </Grid>
</UserControl>
