<Window x:Class="OpenVisionLab.OpenVisionRecipePendingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="560"
        Height="330"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="RecipePendingEditDialog"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PendingEditButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#26373D" />
            <Setter Property="BorderBrush" Value="#55727B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EAF5F7" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#35505A" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="#3DB6C6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#173E47" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PendingEditPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PendingEditButtonStyle}">
            <Setter Property="Background" Value="#168D9D" />
            <Setter Property="BorderBrush" Value="#3DD1E0" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="PendingEditDangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PendingEditButtonStyle}">
            <Setter Property="Background" Value="#3D2D2D" />
            <Setter Property="BorderBrush" Value="#966060" />
            <Setter Property="Foreground" Value="#FFD9D9" />
        </Style>
    </Window.Resources>

    <Border Background="#141C20"
            BorderBrush="#4C6972"
            BorderThickness="1"
            AutomationProperties.AutomationId="RecipePendingEditDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#222D32"
                    BorderBrush="#3B5058"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ContentSaveAlertOutline"
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    Foreground="#F4C86A" />
                        <TextBlock Text="{Binding TitleText}"
                                   Foreground="#F3F8FA"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="42"
                            Height="42"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#D6E6EA"
                            ToolTip="{Binding CancelButtonText}"
                            AutomationProperties.AutomationId="RecipePendingEditCloseButton"
                            AutomationProperties.Name="{Binding CancelButtonText}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Cancel_Click">
                        <iconPacks:PackIconMaterial Kind="Close"
                                                    Width="16"
                                                    Height="16" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding HeadingText}"
                           Foreground="#F4C86A"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="1"
                           Margin="0,9,0,0"
                           Text="{Binding DetailText}"
                           Foreground="#B8CDD3"
                           FontSize="12"
                           LineHeight="19"
                           TextWrapping="Wrap" />

                <Border Grid.Row="2"
                        Margin="0,16,0,18"
                        Padding="12,10"
                        Background="#0F171A"
                        BorderBrush="#31464D"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding CurrentContextText}"
                                   Foreground="#D8E8EC"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,5,0,0"
                                   Text="{Binding TargetContextText}"
                                   Foreground="#8FB4BC"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource PendingEditButtonStyle}"
                            IsCancel="True"
                            AutomationProperties.AutomationId="RecipePendingEditCancelButton"
                            Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CancelButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PendingEditDangerButtonStyle}"
                            AutomationProperties.AutomationId="RecipePendingEditDiscardButton"
                            Click="Discard_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="DeleteSweepOutline"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DiscardButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PendingEditPrimaryButtonStyle}"
                            IsDefault="True"
                            AutomationProperties.AutomationId="RecipePendingEditApplyButton"
                            Click="Apply_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSaveCheckOutline"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ApplyButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
